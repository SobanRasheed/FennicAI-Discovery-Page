{
  "name": "api-blogging-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/generate-sitemap.mjs && node scripts/check-site.mjs",
    "check:site": "node scripts/check-site.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "db:migrate:local": "wrangler d1 migrations apply medical-study-notes --local",
    "db:migrate": "wrangler d1 migrations apply medical-study-notes --remote",
    "db:seed-admin": "node scripts/seed-admin.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/extension-subscript": "^3.0.0",
    "@tiptap/extension-superscript": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-text-align": "^3.0.0",
    "@tiptap/extension-underline": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "astro": "^7.3.1",
    "mammoth": "^1.12.2",
    "sanitize-html": "^2.14.0"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.13.0",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "wrangler": true
  }
}
