{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "medical-study-notes",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "medical-study-notes",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "medical-study-notes-media"
    }
  ],
  "vars": {
    "SITE_URL": "https://devsyllabus.com"
  }
  // Secrets (set with `wrangler secret put`, never committed):
  //   ADMIN_INITIAL_EMAIL    — bootstrap admin login
  //   ADMIN_INITIAL_PASSWORD — bootstrap admin password
}
