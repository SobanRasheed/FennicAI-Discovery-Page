{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "medical-study-notes",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "medical-study-notes",
      "database_id": "bcc136ba-8933-42c1-be61-705030835497",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "medical-study-notes-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "30213ff2c3f840708d64ada78ada5905"
    }
  ],
  // Serve the Worker on the site's own domain (creates/owns the DNS record).
  "routes": [
    {
      "pattern": "medicalstudynotes.tech",
      "custom_domain": true
    }
  ],
  "vars": {
    "SITE_URL": "https://medicalstudynotes.tech"
  }
  // Secrets (set with `wrangler secret put`, never committed):
  //   ADMIN_INITIAL_EMAIL    — bootstrap admin login
  //   ADMIN_INITIAL_PASSWORD — bootstrap admin password
}
