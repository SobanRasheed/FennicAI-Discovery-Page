---
/**
 * LegalLayout: the shared shell for the policy pages — Privacy Policy, Terms
 * of Use, and the Medical Disclaimer. All three have the same anatomy in the
 * designs, so they share one layout rather than three near-copies:
 *
 *   band hero: crumbs → kicker → H1 → standfirst → meta/features,
 *              books illustration + pull-quote aside
 *   two columns: numbered <section>s | "On this page" rail with the
 *              quote card and the "Have questions?" contact card
 *
 * Sections are passed as data so the table of contents and the body cannot
 * drift apart — the rail is generated from the same array that renders the
 * headings, and each id is derived once.
 */
import Layout from './Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import JsonLd from '../components/JsonLd.astro';
import Icon from '../components/Icon.astro';

export interface LegalSection {
  /** Heading text including its number, e.g. "1. Introduction". */
  heading: string;
  /** Stable anchor id. Derived from the heading when omitted. */
  id?: string;
}

interface Props {
  /** Document title (the <title> tag). */
  title: string;
  /** Display heading — the H1 and the breadcrumb label. */
  heading: string;
  description: string;
  path: string;
  kicker?: string;
  standfirst: string;
  updated?: Date;
  readingTime?: string;
  /** Optional hero feature cells (the disclaimer's three pull-out points). */
  features?: { icon: string; label: string }[];
  sections: LegalSection[];
  /** The pull quote in the hero aside. */
  heroQuote: string;
  heroQuoteAttribution?: string;
  /** The quote card under the table of contents. */
  quote: string;
  /** Text of the closing card, e.g. "Need clarification about these Terms?" */
  contactPrompt?: string;
  footerSubjects?: { href: string; label: string }[];
}

const {
  title,
  heading,
  description,
  path,
  kicker = 'Legal',
  standfirst,
  updated,
  readingTime,
  features = [],
  sections,
  heroQuote,
  heroQuoteAttribution,
  quote,
  contactPrompt = 'Contact us if anything here needs clarifying.',
  footerSubjects = [],
} = Astro.props;

/** Same derivation the pages use for their heading ids. */
export const legalSectionId = (heading: string) =>
  heading
    .toLowerCase()
    .replace(/^\d+\.\s*/, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const toc = sections.map((s) => ({ ...s, id: s.id ?? legalSectionId(s.heading) }));

const updatedISO = updated?.toISOString();
const updatedLabel = updated?.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const siteHref = Astro.site?.href ?? '';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: heading,
  description,
  url: new URL(path, Astro.site).href,
  ...(updatedISO ? { dateModified: updatedISO } : {}),
  inLanguage: 'en',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Medical Study Notes',
    url: siteHref,
  },
};
---

<Layout {title} {description} {path} {footerSubjects} wide>
  <JsonLd data={jsonLd} />

  <PageHeader
    kicker={kicker}
    title={heading}
    lead={standfirst}
    crumbs={[{ href: '/', label: 'Home' }, { label: heading }]}
    tone="band"
    asideWide
  >
    {(updatedLabel || readingTime) && (
      <p class="legal-meta">
        {updatedLabel && (
          <span class="meta-item">
            <Icon name="calendar" size={14} />
            Last updated: <time datetime={updatedISO}>{updatedLabel}</time>
          </span>
        )}
        {readingTime && (
          <span class="meta-item"><Icon name="clock" size={14} />{readingTime}</span>
        )}
      </p>
    )}

    {features.length > 0 && (
      <ul class="legal-features">
        {features.map((feature) => (
          <li>
            <Icon name={feature.icon} size={27} />
            <div>
              <strong>{feature.label}</strong>
            </div>
          </li>
        ))}
      </ul>
    )}

    <Fragment slot="aside">
      <div class="legal-hero-side">
        <img
          class="legal-hero-art"
          src="/assets/icons/blog-hero-books.png"
          alt="A stack of study books and notes"
          width="808"
          height="641"
          loading="eager"
          decoding="async"
        />

        <figure class="legal-quote">
          <span class="quote-mark" aria-hidden="true">“</span>
          <blockquote>
            <p>{heroQuote}</p>
          </blockquote>
          {heroQuoteAttribution && (
            <>
              <span class="quote-rule" aria-hidden="true"></span>
              <figcaption>{heroQuoteAttribution}</figcaption>
            </>
          )}
        </figure>
      </div>
    </Fragment>
  </PageHeader>

  <div class="container legal-body">
    <div class="legal-doc doc">
      <slot />
    </div>

    <aside class="legal-rail" aria-label="Page contents">
      <nav class="panel panel-pad legal-toc">
        <h2 class="legal-toc-head"><Icon name="list" size={15} />On this page</h2>
        <ol class="legal-toc-list">
          {toc.map((s) => (
            <li><a href={`#${s.id}`}>{s.heading}</a></li>
          ))}
        </ol>
        <p class="legal-print">
          <button class="link-arrow legal-print-btn" type="button" data-print>
            <Icon name="print" size={14} />Print / Save as PDF
          </button>
        </p>
      </nav>

      <figure class="rail-quote">
        <blockquote>
          <p>{quote}</p>
        </blockquote>
      </figure>

      <div class="panel panel-pad legal-contact">
        <h2 class="legal-contact-head">Have questions?</h2>
        <p class="legal-contact-body">{contactPrompt}</p>
        <a class="btn btn-secondary legal-contact-btn" href="/contact/">
          Contact us
          <Icon name="arrow-right" size={14} />
        </a>
      </div>
    </aside>
  </div>
</Layout>

<script>
  // Progressive enhancement: the print control only appears useful with JS, so
  // it stays a button and does nothing without it. Every modern browser's
  // print dialog can save the page as a PDF, which is why the label says so.
  document
    .querySelector<HTMLButtonElement>('[data-print]')
    ?.addEventListener('click', () => window.print());
</script>

<style>
  /* --- hero meta row / feature cells -------------------------------------- */
  .legal-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin: var(--space-8) 0 0;
    color: var(--mute);
    font-size: var(--text-body-sm);
  }

  .legal-meta .meta-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .legal-meta svg {
    color: var(--primary);
  }

  .legal-features {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-6);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .legal-features li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .legal-features svg {
    flex-shrink: 0;
    color: var(--primary);
  }

  .legal-features strong {
    display: block;
    color: var(--primary);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: var(--weight-semibold);
    line-height: 1.3;
  }

  @media (min-width: 760px) {
    .legal-features li + li {
      padding-left: var(--space-6);
      border-left: 1px solid #d9e2d6;
    }
  }

  /* --- hero aside: books illustration beside the quote panel ---------------- */
  .legal-hero-side {
    display: grid;
    gap: var(--space-4);
    align-items: center;
  }

  @media (min-width: 640px) {
    .legal-hero-side {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    }
  }

  .legal-hero-art {
    width: 100%;
    aspect-ratio: 335 / 250;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .legal-quote {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: var(--space-6);
    border-radius: 6px;
    background: var(--quote-surface);
  }

  .quote-mark {
    color: var(--primary);
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: var(--weight-semibold);
    line-height: 0.5;
    margin-bottom: var(--space-4);
  }

  .legal-quote blockquote {
    margin: 0;
  }

  .legal-quote p {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-style: italic;
    font-weight: var(--weight-medium);
    line-height: 1.5;
    text-wrap: balance;
  }

  .quote-rule {
    width: 26px;
    height: 2px;
    margin: var(--space-5) 0 var(--space-3);
    background: var(--primary);
  }

  .legal-quote figcaption {
    color: var(--mute);
    font-family: var(--font-sans);
    font-size: 0.6563rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* --- body + rail ----------------------------------------------------- */
  .legal-body {
    display: grid;
    gap: var(--space-10);
    padding-block: var(--space-12) var(--space-16);
  }

  @media (min-width: 1024px) {
    .legal-body {
      grid-template-columns: minmax(0, 1fr) 19rem;
      gap: var(--space-12);
      align-items: start;
    }
  }

  .legal-doc {
    min-width: 0;
  }

  /* Numbered sections carry a hairline above so the document reads as a set
     of clauses rather than continuous prose. */
  .legal-doc :global(section) {
    padding-top: var(--space-8);
    border-top: 1px solid var(--border);
  }

  .legal-doc :global(section:first-child) {
    padding-top: 0;
    border-top: 0;
  }

  .legal-doc :global(h2) {
    scroll-margin-top: calc(var(--header-height) + var(--space-6));
    font-size: clamp(1.25rem, 1.15rem + 0.4vw, 1.5rem);
  }

  .legal-rail {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
  }

  .legal-toc-head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    font-size: var(--text-body);
  }

  .legal-toc-head svg {
    color: var(--primary);
  }

  .legal-toc-list {
    margin: 0;
    padding-left: var(--space-4);
    color: var(--faint);
    font-size: var(--text-body-sm);
  }

  .legal-toc-list li + li {
    margin-top: var(--space-2);
  }

  .legal-toc-list a {
    color: var(--body);
    text-decoration: none;
  }

  .legal-toc-list a:hover {
    color: var(--primary);
  }

  .legal-print {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }

  .legal-print-btn {
    padding: 0;
    border: 0;
    background: none;
    font-family: inherit;
    cursor: pointer;
  }

  /* The arrow belongs to "more" links, not to a print action. */
  .legal-print-btn::after {
    content: none;
  }

  /* --- rail quote card --------------------------------------------------- */
  .rail-quote {
    margin: 0;
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background: var(--quote-surface);
  }

  .rail-quote blockquote {
    margin: 0;
  }

  .rail-quote p {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-style: italic;
    font-weight: var(--weight-medium);
    line-height: 1.55;
    text-wrap: balance;
  }

  /* --- rail contact card -------------------------------------------------- */
  .legal-contact-head {
    font-size: var(--text-display-sm);
  }

  .legal-contact-body {
    margin-top: var(--space-1);
    color: var(--mute);
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
  }

  .legal-contact-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  @media print {
    .legal-rail {
      display: none;
    }
  }
</style>
