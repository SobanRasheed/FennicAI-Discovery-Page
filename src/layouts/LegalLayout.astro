---
/**
 * LegalLayout: the shared shell for the policy pages — Privacy Policy, Terms
 * of Use, and the Medical Disclaimer. All three have the same anatomy in the
 * designs, so they share one layout rather than three near-copies:
 *
 *   breadcrumb → kicker → H1 → standfirst → updated/read-time meta
 *   two columns: numbered <section>s | sticky "On this page" rail
 *   a closing quote band and a "Have questions?" contact card
 *
 * Sections are passed as data so the table of contents and the body cannot
 * drift apart — the rail is generated from the same array that renders the
 * headings, and each id is derived once.
 */
import Layout from './Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import JsonLd from '../components/JsonLd.astro';
import QuoteBand from '../components/QuoteBand.astro';
import Icon from '../components/Icon.astro';

export interface LegalSection {
  /** Heading text including its number, e.g. "1. Introduction". */
  heading: string;
  /** Stable anchor id. Derived from the heading when omitted. */
  id?: string;
}

interface Props {
  title: string;
  description: string;
  path: string;
  kicker?: string;
  standfirst: string;
  updated: Date;
  readingTime?: string;
  sections: LegalSection[];
  quote: string;
  quoteAttribution?: string;
  /** Text of the closing card, e.g. "Need clarification about these Terms?" */
  contactPrompt?: string;
  footerSubjects?: { href: string; label: string }[];
}

const {
  title,
  description,
  path,
  kicker = 'Legal',
  standfirst,
  updated,
  readingTime,
  sections,
  quote,
  quoteAttribution,
  contactPrompt = 'Contact us if anything here needs clarifying.',
  footerSubjects = [],
} = Astro.props;

/** Same derivation the pages use for their heading ids. */
export const legalSectionId = (heading: string) =>
  heading
    .toLowerCase()
    .replace(/^\d+\.\s*/, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const toc = sections.map((s) => ({ ...s, id: s.id ?? legalSectionId(s.heading) }));

const updatedISO = updated.toISOString();
const updatedLabel = updated.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: new URL(path, Astro.site).href,
  dateModified: updatedISO,
  inLanguage: 'en',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Medical Study Notes',
    url: Astro.site!.href,
  },
};
---

<Layout {title} {description} {path} {footerSubjects} wide>
  <JsonLd data={jsonLd} />

  <div class="legal-hero">
    <div class="container">
      <Breadcrumbs crumbs={[{ href: '/', label: 'Home' }, { label: title }]} />
      <p class="kicker legal-kicker">{kicker}</p>
      <h1>{title}</h1>
      <p class="lead legal-standfirst">{standfirst}</p>
      <p class="legal-meta">
        <span class="meta-item">
          <Icon name="calendar" size={14} />
          Last updated:{' '}
          <time datetime={updatedISO}>{updatedLabel}</time>
        </span>
        {readingTime && (
          <span class="meta-item"><Icon name="clock" size={14} />{readingTime}</span>
        )}
      </p>
    </div>
  </div>

  <div class="container legal-body">
    <div class="legal-doc doc">
      <slot />
    </div>

    <aside class="legal-rail" aria-label="Page contents">
      <nav class="panel panel-pad legal-toc">
        <h2 class="legal-toc-head"><Icon name="list" size={15} />On this page</h2>
        <ol class="legal-toc-list">
          {toc.map((s) => (
            <li><a href={`#${s.id}`}>{s.heading}</a></li>
          ))}
        </ol>
        <p class="legal-print">
          <button class="link-arrow legal-print-btn" type="button" data-print>
            <Icon name="print" size={14} />Print this page
          </button>
        </p>
      </nav>
    </aside>
  </div>

  <QuoteBand {quote} attribution={quoteAttribution} icon="shield" />

  <div class="container legal-foot">
    <div class="panel panel-pad legal-contact">
      <div>
        <h2 class="legal-contact-head">Have questions?</h2>
        <p class="legal-contact-body">{contactPrompt}</p>
      </div>
      <a class="btn btn-secondary" href="/contact/">Contact us</a>
    </div>
  </div>
</Layout>

<script>
  // Progressive enhancement: the print control only appears useful with JS, so
  // it stays a button and does nothing without it.
  document
    .querySelector<HTMLButtonElement>('[data-print]')
    ?.addEventListener('click', () => window.print());
</script>

<style>
  .legal-hero {
    padding-block: var(--space-4) var(--space-12);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .legal-kicker {
    margin-top: var(--space-4);
  }

  .legal-hero h1 {
    margin-top: var(--space-2);
  }

  .legal-standfirst {
    margin-top: var(--space-4);
  }

  .legal-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-6);
    color: var(--mute);
    font-size: var(--text-body-sm);
  }

  .legal-meta .meta-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* --- body + rail ----------------------------------------------------- */
  .legal-body {
    display: grid;
    gap: var(--space-12);
    padding-block: var(--space-12);
  }

  @media (min-width: 1024px) {
    .legal-body {
      grid-template-columns: minmax(0, 1fr) 17rem;
      gap: var(--space-16);
      align-items: start;
    }
  }

  .legal-doc {
    min-width: 0;
  }

  /* Numbered sections carry a hairline above so the document reads as a set
     of clauses rather than continuous prose. */
  .legal-doc :global(section) {
    padding-top: var(--space-8);
    border-top: 1px solid var(--border);
  }

  .legal-doc :global(section:first-child) {
    padding-top: 0;
    border-top: 0;
  }

  .legal-doc :global(h2) {
    scroll-margin-top: calc(var(--header-height) + var(--space-6));
    font-size: clamp(1.25rem, 1.15rem + 0.4vw, 1.5rem);
  }

  .legal-rail {
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .legal-toc {
      position: sticky;
      top: calc(var(--header-height) + var(--space-6));
    }
  }

  .legal-toc-head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    font-size: var(--text-body);
  }

  .legal-toc-head svg {
    color: var(--primary);
  }

  .legal-toc-list {
    margin: 0;
    padding-left: var(--space-4);
    color: var(--faint);
    font-size: var(--text-body-sm);
  }

  .legal-toc-list li + li {
    margin-top: var(--space-2);
  }

  .legal-toc-list a {
    color: var(--body);
    text-decoration: none;
  }

  .legal-toc-list a:hover {
    color: var(--primary);
  }

  .legal-print {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }

  .legal-print-btn {
    padding: 0;
    border: 0;
    background: none;
    font-family: inherit;
    cursor: pointer;
  }

  /* The arrow belongs to "more" links, not to a print action. */
  .legal-print-btn::after {
    content: none;
  }

  /* --- closing contact card -------------------------------------------- */
  .legal-foot {
    padding-block: var(--space-12) var(--space-16);
  }

  .legal-contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
    align-items: center;
    justify-content: space-between;
  }

  .legal-contact-head {
    font-size: var(--text-display-sm);
  }

  .legal-contact-body {
    margin-top: var(--space-1);
    color: var(--mute);
    font-size: var(--text-body-sm);
  }

  @media print {
    .legal-rail,
    .legal-foot {
      display: none;
    }
  }
</style>
