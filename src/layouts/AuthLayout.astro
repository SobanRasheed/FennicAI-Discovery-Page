---
/**
 * AuthLayout: the shared shell for /login/ and /register/. Both designs are a
 * two-column band — a narrative panel on the left (kicker, H1, lead, the four
 * benefit rows, and on register a closing quote card) and the form card on
 * the right — over a plain page with the standard header/footer.
 *
 * The form card is slotted, but its internals are styled here (scoped to
 * .auth-form-col with :global) so the login and register cards cannot drift
 * apart — both designs use the identical card, fields, and buttons.
 *
 * These are utility pages: always noindex.
 */
import Layout from './Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from '../utils/collections';

interface Benefit {
  icon: Parameters<typeof Icon>[0]['name'];
  title: string;
  body: string;
}

interface Props {
  title: string;
  description: string;
  path: string;
  kicker: string;
  /** H1 lines, one per design line, joined with <br>. */
  headingLines: string[];
  lead: string;
  /** Optional closing quote card under the benefits (register only). */
  quote?: string;
  quoteAttribution?: string;
  /** Breadcrumb label; defaults to the page title. */
  crumb?: string;
}

const subjects = await getCollection('subjects');
const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.data.title,
}));

const { title, description, path, kicker, headingLines, lead, quote, quoteAttribution, crumb = title } =
  Astro.props;

/** The same four rows both designs promise above the form. */
const benefits: Benefit[] = [
  { icon: 'heart', title: 'Save Your Notes', body: 'Keep your favorite study notes for quick access.' },
  { icon: 'chart', title: 'Track Your Progress', body: 'Monitor your MCQ performance and improvement.' },
  { icon: 'target', title: 'Personalized Experience', body: 'Get recommendations based on your interests.' },
  { icon: 'globe', title: 'Learn Anywhere', body: 'Access your account from any device, anytime.' },
];
---

<Layout {title} {description} {path} noindex {footerSubjects} wide>
  <div class="auth-band">
    <div class="container auth-grid">
      <div class="auth-hero">
        <Breadcrumbs crumbs={[{ href: '/', label: 'Home' }, { label: crumb }]} />
        <p class="kicker">{kicker}</p>
        <h1 class="auth-title">
          {headingLines.map((line, index) => (
            <Fragment>{index > 0 && <br />}{line}</Fragment>
          ))}
        </h1>
        <p class="lead auth-lead">{lead}</p>

        <ul class="auth-benefits">
          {benefits.map((b) => (
            <li class="auth-benefit">
              <span class="auth-benefit-icon" aria-hidden="true"><Icon name={b.icon} size={28} /></span>
              <div>
                <h2 class="auth-benefit-title">{b.title}</h2>
                <p class="auth-benefit-body">{b.body}</p>
              </div>
            </li>
          ))}
        </ul>

        {quote && (
          <figure class="auth-quote">
            <span class="auth-quote-icon" aria-hidden="true"><Icon name="bulb" size={30} /></span>
            <blockquote>“{quote}”</blockquote>
            {quoteAttribution && <figcaption>{quoteAttribution}</figcaption>}
          </figure>
        )}
      </div>

      <div class="auth-form-col">
        <slot />
      </div>
    </div>
  </div>
</Layout>

<style>
  .auth-band {
    padding-block: var(--space-4) var(--space-16);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .auth-grid {
    display: grid;
    gap: var(--space-12);
    padding-block: var(--space-8) var(--space-12);
  }

  @media (min-width: 1024px) {
    .auth-grid {
      grid-template-columns: minmax(0, 1fr) 30rem;
      gap: var(--space-16);
      align-items: start;
    }
  }

  .auth-title {
    margin-top: var(--space-2);
    max-width: 20ch;
    line-height: var(--leading-display);
    text-wrap: initial;
  }

  .auth-lead {
    margin-top: var(--space-4);
    max-width: 36ch;
    font-size: 1.0625rem;
  }

  /* --- benefit rows: tinted square tile + bold title + caption ------------ */
  .auth-benefits {
    display: grid;
    gap: var(--space-6);
    margin: var(--space-10) 0 0;
    padding: 0;
    list-style: none;
  }

  .auth-benefit {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .auth-benefit-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 60px;
    height: 60px;
    border-radius: var(--radius-md);
    background: var(--quote-surface);
    color: var(--primary);
  }

  .auth-benefit-title {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0;
  }

  .auth-benefit-body {
    margin-top: var(--space-1);
    color: var(--mute);
    font-size: var(--text-caption);
  }

  /* --- closing quote card (register) ---------------------------------------- */
  .auth-quote {
    display: flex;
    flex-direction: column;
    margin: var(--space-10) 0 0;
    padding: var(--space-6);
    border-radius: var(--radius-md);
    background: var(--quote-surface);
  }

  .auth-quote-icon {
    color: var(--primary);
  }

  .auth-quote blockquote {
    margin: var(--space-4) 0 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--ink);
  }

  .auth-quote figcaption {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    color: var(--primary);
    font-size: var(--text-micro);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* --- the slotted form card, shared verbatim by login and register --------- */
  .auth-form-col :global(.auth-card) {
    padding: var(--space-8);
  }

  .auth-form-col :global(.auth-card-title) {
    font-family: var(--font-sans);
    font-size: 1.75rem;
    letter-spacing: 0;
    line-height: 1.25;
  }

  .auth-form-col :global(.auth-card-sub) {
    margin-top: var(--space-2);
    color: var(--mute);
    font-size: 0.875rem;
  }

  .auth-form-col :global(.auth-form) {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-7);
  }

  .auth-form-col :global(.auth-form .field > label) {
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
  }

  /* Design fields are taller and roomier than the global input default. */
  .auth-form-col :global(.auth-form .field > label span) {
    color: var(--danger);
  }

  .auth-form-col :global(.auth-form input:not([type='checkbox'])) {
    min-height: 48px;
    padding: var(--space-3) var(--space-5);
  }

  .auth-form-col :global(.auth-submit) {
    width: 100%;
    margin-top: var(--space-1);
  }

  .auth-form-col :global(.auth-or) {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin: var(--space-7) 0;
    color: var(--mute);
    font-size: var(--text-caption);
    text-align: center;
  }

  .auth-form-col :global(.auth-or)::before,
  .auth-form-col :global(.auth-or)::after {
    content: '';
    flex: 1;
    border-top: 1px solid var(--border);
  }

  .auth-form-col :global(.auth-social) {
    display: grid;
    gap: var(--space-3);
  }

  .auth-form-col :global(.auth-social-btn) {
    width: 100%;
    min-height: 44px;
  }

  .auth-form-col :global(.auth-switch) {
    margin: var(--space-7) 0 0;
    color: var(--mute);
    font-size: var(--text-caption);
    text-align: center;
  }

  .auth-form-col :global(.auth-switch a) {
    color: var(--primary);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }

  .auth-form-col :global(.auth-switch a:hover) {
    text-decoration: underline;
  }

  .auth-form-col :global(.auth-secure) {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    background: var(--quote-surface);
    color: var(--mute);
    font-size: 0.6875rem;
    line-height: var(--leading-normal);
  }

  .auth-form-col :global(.auth-secure svg) {
    flex-shrink: 0;
    color: var(--primary);
  }

  .auth-form-col :global(.auth-secure strong) {
    display: block;
    color: var(--ink);
    font-size: 0.875rem;
  }
</style>
