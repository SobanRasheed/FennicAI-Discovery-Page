---
import SEO from '../components/SEO.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
// Self-hosted variable fonts: no third-party font request, no blocking <link>,
// no flash of unstyled text.
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Full-bleed pages (hero bands, article shells) manage their own container. */
  wide?: boolean;
  /** Subject links for the footer column. */
  footerSubjects?: { href: string; label: string }[];
}

const {
  title,
  description,
  path,
  noindex = false,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  wide = false,
  footerSubjects = [],
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="theme-color" content="#145c52" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1211" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <SEO {title} {description} {path} {noindex} {ogType} {publishedTime} {modifiedTime} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <SiteHeader {path} />

    <main id="main" class="page">
      {wide ? <slot /> : <div class="container page-pad"><slot /></div>}
    </main>

    <SiteFooter subjects={footerSubjects} />
  </body>
</html>

<style>
  .page-pad {
    padding-block: var(--space-8) var(--space-16);
  }
</style>
