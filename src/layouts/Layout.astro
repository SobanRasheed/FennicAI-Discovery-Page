---
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
}

const { title, description, path, noindex = false, ogType = 'website', publishedTime, modifiedTime } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <SEO {title} {description} {path} {noindex} {ogType} {publishedTime} {modifiedTime} />
  </head>
  <body>
    <header>
      <a href="/" class="site-name">devsyllabus</a>
      <nav aria-label="Primary">
        <ul>
          <li><a href="/notes/">Study Notes</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/practice/">Practice</a></li>
          <li><a href="/subjects/">Subjects</a></li>
          <li><a href="/topics/">Topics</a></li>
          <li><a href="/search/">Search</a></li>
        </ul>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <nav aria-label="Site sections">
        <div class="footer-col">
          <h2>Study</h2>
          <ul>
            <li><a href="/notes/">All study notes</a></li>
            <li><a href="/subjects/">Subjects</a></li>
            <li><a href="/levels/">Education levels</a></li>
            <li><a href="/topics/">Topic hubs</a></li>
            <li><a href="/practice/">Practice questions</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h2>Read</h2>
          <ul>
            <li><a href="/blog/">Blog</a></li>
            <li><a href="/blog/archive/">Article archive</a></li>
            <li><a href="/authors/">Authors</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h2>About</h2>
          <ul>
            <li><a href="/about/">About devsyllabus</a></li>
            <li><a href="/editorial-policy/">Editorial policy</a></li>
            <li><a href="/faq/">FAQ</a></li>
            <li><a href="/resources/">Resources</a></li>
            <li><a href="/contact/">Contact</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h2>Legal</h2>
          <ul>
            <li><a href="/privacy-policy/">Privacy policy</a></li>
            <li><a href="/terms-of-use/">Terms of use</a></li>
            <li><a href="/cookie-policy/">Cookie policy</a></li>
            <li><a href="/disclaimer/">Disclaimer</a></li>
          </ul>
        </div>
      </nav>
      <p>&copy; devsyllabus. Study notes and guides for computer science courses.</p>
    </footer>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    font-family: system-ui, -apple-system, sans-serif;
    line-height: 1.6;
    color: #1a1a1a;
  }
  main {
    max-width: 46rem;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }
  header {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    max-width: 72rem;
    margin: 0 auto;
    padding: 1rem;
    border-bottom: 1px solid #e5e5e5;
  }
  .site-name {
    font-weight: 700;
    font-size: 1.1rem;
    color: #1a1a1a;
    text-decoration: none;
  }
  header ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.95rem;
  }
  footer {
    border-top: 1px solid #e5e5e5;
    margin-top: 2rem;
    padding: 2rem 1rem 3rem;
    font-size: 0.9rem;
    color: #444;
  }
  footer nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1.5rem;
    max-width: 72rem;
    margin: 0 auto 1.5rem;
  }
  footer h2 {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 0.5rem;
  }
  footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  footer li {
    margin: 0.25rem 0;
  }
  footer > p {
    max-width: 72rem;
    margin: 0 auto;
    font-size: 0.85rem;
    color: #777;
  }
</style>
