---
/**
 * Link card for a study note. Shows the subject/level context so cards on
 * hub and listing pages carry their hierarchy with them.
 *
 * Takes a flat D1-backed shape (subject/level slugs + optional labels), so
 * collection-based and database-backed pages render identically.
 */
interface Props {
  note: {
    slug: string;
    title: string;
    description: string;
    /** Subject slug; the label map covers the eight core subjects. */
    subject: string;
    /** D1 subject title, when the caller already has it. */
    subjectLabel?: string | null;
    /** Level slug; omitted/null hides the level kicker. */
    level?: string | null;
    /** D1 subject label for the level, when the caller already has it. */
    levelLabel?: string | null;
    /** D1 'YYYY-MM-DD HH:MM:SS' timestamp or a Date. */
    updated: string | Date;
    /** Featured image, when the note has one. */
    image?: { src: string; alt?: string | null } | null;
  };
}

const { note } = Astro.props;

const subjectLabels: Record<string, string> = {
  anatomy: 'Anatomy',
  physiology: 'Physiology',
  biochemistry: 'Biochemistry',
  pathology: 'Pathology',
  pharmacology: 'Pharmacology',
  microbiology: 'Microbiology',
  'forensic-medicine': 'Forensic Medicine',
  'community-medicine': 'Community Medicine',
};

const levelLabels: Record<string, string> = {
  'first-professional-mbbs': 'First Professional MBBS',
  'second-professional-mbbs': 'Second Professional MBBS',
  'third-professional-mbbs': 'Third Professional MBBS',
};

const subject = note.subjectLabel ?? subjectLabels[note.subject] ?? note.subject;
const level = note.level
  ? note.levelLabel ?? levelLabels[note.level] ?? note.level
  : null;

/** D1 timestamps are UTC without a zone suffix. */
const updated =
  note.updated instanceof Date ? note.updated : new Date(note.updated + 'Z');
const isoUpdated = updated.toISOString();
const displayUpdated = isoUpdated.slice(0, 10);
---

<article class="ncard" class:list={{ 'ncard-has-image': note.image }}>
  {note.image && (
    <a class="ncard-thumb" href={`/notes/${note.slug}/`} tabindex="-1" aria-hidden="true">
      <img src={note.image.src} alt="" loading="lazy" decoding="async" />
    </a>
  )}
  <div class="ncard-text">
    <p class="ncard-meta">
      <a class="kicker" href={`/subjects/${note.subject}/`}>{subject}</a>
      {level && <span aria-hidden="true">·</span>}
      {level && <a class="kicker" href={`/levels/${note.level}/`}>{level}</a>}
    </p>
    <h3 class="ncard-title"><a href={`/notes/${note.slug}/`}>{note.title}</a></h3>
    <p class="ncard-desc">{note.description}</p>
    <time class="ncard-date" datetime={isoUpdated}>
      Updated {displayUpdated}
    </time>
  </div>
</article>

<style>
  .ncard {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border);
  }

  /* With a featured image the card becomes a thumb + text row. */
  .ncard-has-image {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .ncard-thumb {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--surface-sunken);
  }

  .ncard-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ncard-text {
    min-width: 0;
    flex: 1;
  }

  .ncard-meta {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
    margin: 0 0 var(--space-1);
    color: var(--faint);
  }

  .ncard-title {
    margin: 0 0 var(--space-1);
    font-size: var(--text-body-lg);
  }

  .ncard-title a {
    color: var(--ink);
    text-decoration: none;
    transition: color 0.15s var(--ease);
  }

  .ncard-title a:hover {
    color: var(--primary);
  }

  .ncard-desc {
    margin: 0 0 var(--space-2);
    color: var(--mute);
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
  }

  .ncard-date {
    color: var(--faint);
    font-size: var(--text-caption);
  }
</style>
