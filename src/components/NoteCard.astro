---
/**
 * Link card for a study note. Shows the subject/level context so cards on
 * hub and listing pages carry their hierarchy with them.
 *
 * Restyled onto the design system: a hairline editorial row with mono kicker
 * links and a serif title, matching the entry lists used elsewhere.
 */
interface Props {
  note: {
    slug: string;
    data: {
      title: string;
      description: string;
      subject: string;
      level: string;
      chapter: string;
      updatedDate: Date;
    };
  };
}

const { note } = Astro.props;
import { formatDate } from '../utils/collections';

const subjectLabels: Record<string, string> = {
  anatomy: 'Anatomy',
  physiology: 'Physiology',
  biochemistry: 'Biochemistry',
  pathology: 'Pathology',
  pharmacology: 'Pharmacology',
  microbiology: 'Microbiology',
  'forensic-medicine': 'Forensic Medicine',
  'community-medicine': 'Community Medicine',
};

const levelLabels: Record<string, string> = {
  'first-professional-mbbs': 'First Professional MBBS',
  'second-professional-mbbs': 'Second Professional MBBS',
  'third-professional-mbbs': 'Third Professional MBBS',
};

const subject = subjectLabels[note.data.subject] ?? note.data.subject;
const level = levelLabels[note.data.level] ?? note.data.level;
---

<article class="ncard">
  <p class="ncard-meta">
    <a class="kicker" href={`/subjects/${note.data.subject}/`}>{subject}</a>
    <span aria-hidden="true">·</span>
    <a class="kicker" href={`/levels/${note.data.level}/`}>{level}</a>
  </p>
  <h3 class="ncard-title"><a href={`/notes/${note.slug}/`}>{note.data.title}</a></h3>
  <p class="ncard-desc">{note.data.description}</p>
  <time class="ncard-date" datetime={note.data.updatedDate.toISOString()}>
    Updated {formatDate(note.data.updatedDate)}
  </time>
</article>

<style>
  .ncard {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border);
  }

  .ncard-meta {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
    margin: 0 0 var(--space-1);
    color: var(--faint);
  }

  .ncard-title {
    margin: 0 0 var(--space-1);
    font-size: var(--text-body-lg);
  }

  .ncard-title a {
    color: var(--ink);
    text-decoration: none;
    transition: color 0.15s var(--ease);
  }

  .ncard-title a:hover {
    color: var(--primary);
  }

  .ncard-desc {
    margin: 0 0 var(--space-2);
    color: var(--mute);
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
  }

  .ncard-date {
    color: var(--faint);
    font-size: var(--text-caption);
  }
</style>
