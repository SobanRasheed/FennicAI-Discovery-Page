---
/**
 * ArticleCard: an editorial row for a study note or an article.
 *
 * Two variants, both hairline-separated rows rather than floating cards:
 *   `row`   — kicker column, title, excerpt, trailing date. The dense listing
 *             used for study notes and search results.
 *   `media` — the same row with a small 4:3 thumbnail on the left, used only
 *             where an article genuinely has an image worth showing.
 *
 * No invented metadata: reading time, author, and date each render only when
 * the caller passes a real value.
 */
import Icon from './Icon.astro';

interface Props {
  href: string;
  title: string;
  excerpt?: string;
  /** Subject or category, rendered as the small green caps label. */
  kicker?: string;
  kickerHref?: string;
  date?: Date;
  dateLabel?: string;
  readingMinutes?: number;
  author?: string;
  image?: string;
  imageAlt?: string;
  variant?: 'row' | 'media';
}

const {
  href,
  title,
  excerpt,
  kicker,
  date,
  dateLabel,
  readingMinutes,
  author,
  image,
  imageAlt = '',
  variant = 'row',
} = Astro.props;

const iso = date?.toISOString();
const shown = date
  ? date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
  : null;

const hasMedia = variant === 'media' && !!image;
const metaBits = [readingMinutes ? `${readingMinutes} min read` : null, author].filter(Boolean);
---

<a class:list={['acard', hasMedia && 'acard-media']} href={href}>
  {hasMedia && (
    <span class="acard-thumb">
      <img src={image} alt={imageAlt} loading="lazy" decoding="async" />
    </span>
  )}

  <span class="acard-body">
    {kicker && <span class="kicker acard-kicker">{kicker}</span>}
    <span class="acard-title">{title}</span>
    {excerpt && <span class="acard-excerpt">{excerpt}</span>}
    {(metaBits.length > 0 || shown) && (
      <span class="acard-meta">
        {metaBits.map((bit, i) => (
          <>
            {i > 0 && <span class="acard-dot" aria-hidden="true">·</span>}
            <span>{bit}</span>
          </>
        ))}
        {shown && (
          <>
            {metaBits.length > 0 && <span class="acard-dot" aria-hidden="true">·</span>}
            <time datetime={iso}>{dateLabel ? `${dateLabel} ${shown}` : shown}</time>
          </>
        )}
      </span>
    )}
  </span>

  <span class="acard-chev" aria-hidden="true"><Icon name="chevron-right" size={16} /></span>
</a>

<style>
  .acard {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    color: inherit;
    text-decoration: none;
  }

  .acard-thumb {
    flex-shrink: 0;
    width: 5.5rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface-sunken);
  }

  @media (min-width: 640px) {
    .acard-thumb {
      width: 7.5rem;
    }
  }

  .acard-thumb img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .acard-body {
    flex: 1;
    min-width: 0;
    display: block;
  }

  .acard-kicker {
    margin-bottom: var(--space-1);
  }

  .acard-title {
    display: block;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-body-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    transition: color 0.15s var(--ease);
  }

  .acard:hover .acard-title {
    color: var(--primary);
  }

  .acard-excerpt {
    display: block;
    margin-top: var(--space-1);
    color: var(--mute);
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
  }

  .acard-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: baseline;
    margin-top: var(--space-2);
    color: var(--faint);
    font-size: var(--text-caption);
  }

  .acard-dot {
    color: var(--border-strong);
  }

  .acard-chev {
    display: none;
    flex-shrink: 0;
    align-self: center;
    color: var(--faint);
    transition: color 0.15s var(--ease), transform 0.15s var(--ease-out);
  }

  .acard:hover .acard-chev {
    color: var(--primary);
    transform: translateX(2px);
  }

  @media (min-width: 640px) {
    .acard-chev {
      display: inline-flex;
    }
  }
</style>
