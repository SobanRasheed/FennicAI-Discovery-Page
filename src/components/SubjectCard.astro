---
/**
 * SubjectCard: one bordered row per subject.
 *
 * Deliberately restrained — a small hand-drawn line illustration, a title, a
 * one-line "Study Notes · MCQs" sub, and a chevron. No coloured card per
 * subject, no count badge unless a real count exists.
 */
import Icon from './Icon.astro';
import Illustration, { illustrationForSubject } from './Illustration.astro';

interface Props {
  href: string;
  title: string;
  /** e.g. "Study Notes · MCQs", or a short description. */
  sub?: string;
  /** Real note count. Omitted rather than shown as zero. */
  count?: number;
  /** Subject slug, which picks the line illustration. */
  subject?: string;
  /** Or name a drawing directly when there is no slug. */
  illustration?: import('./Illustration.astro').IllustrationName;
}

const { href, title, sub = 'Study Notes · MCQs', count, subject, illustration } = Astro.props;

const drawing = illustration ?? (subject ? illustrationForSubject(subject) : 'stethoscope');
---

<a class="subject" href={href}>
  <span class="subject-art" aria-hidden="true">
    <Illustration name={drawing} size={34} />
  </span>
  <span class="subject-text">
    <span class="subject-title">{title}</span>
    <span class="subject-sub">{sub}</span>
  </span>
  {count !== undefined && count > 0 && <span class="subject-count">{count}</span>}
  <Icon name="chevron-right" size={16} />
</a>

<style>
  .subject {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s var(--ease), background-color 0.15s var(--ease);
  }

  .subject:hover {
    border-color: var(--primary-border);
    background: var(--primary-surface);
  }

  /* The drawing sits in a square tinted well so the tiles read as a set
     without introducing colour per subject. */
  .subject-art {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface-sunken);
    color: var(--primary);
    transition: border-color 0.15s var(--ease), background-color 0.15s var(--ease);
  }

  .subject:hover .subject-art {
    border-color: var(--primary-border);
    background: var(--surface);
  }

  .subject-text {
    flex: 1;
    min-width: 0;
  }

  .subject-title {
    display: block;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-body-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    transition: color 0.15s var(--ease);
  }

  .subject:hover .subject-title {
    color: var(--primary);
  }

  .subject-sub {
    display: block;
    margin-top: 2px;
    color: var(--mute);
    font-size: var(--text-body-sm);
  }

  .subject-count {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    font-variant-numeric: tabular-nums;
  }

  /* The chevron is the only direct svg child; the illustration is wrapped. */
  .subject > svg {
    color: var(--faint);
    transition: color 0.15s var(--ease), transform 0.15s var(--ease-out);
  }

  .subject:hover > svg {
    color: var(--primary);
    transform: translateX(2px);
  }
</style>
