---
/**
 * Site footer — Figma Screen 01: the brand lockup with a short blurb on the
 * left, five link columns (Subjects, Resources, About, Legal, Follow us)
 * on the right, and the copyright line. Structured as a real <nav> per
 * column group so the link sets are navigable landmarks.
 */
interface Props {
  /** Subject links come from content, so the column is never stale. */
  subjects?: { href: string; label: string }[];
}

const { subjects = [] } = Astro.props;

const resources = [
  { href: '/notes/', label: 'Study Notes' },
  { href: '/practice/', label: 'MCQs' },
  { href: '/past-papers', label: 'Past Papers' },
  { href: '/resources', label: 'Recommended Books' },
  { href: '/topics/', label: 'Diagrams' },
];

const about = [
  { href: '/about/', label: 'About Us' },
  { href: '/editorial-policy/', label: 'Editorial Policy' },
  { href: '/contact', label: 'Contact' },
  { href: '/authors/', label: 'Contribute' },
];

const legal = [
  { href: '/privacy-policy', label: 'Privacy Policy' },
  { href: '/terms-of-use', label: 'Terms of Use' },
  { href: '/disclaimer', label: 'Medical Disclaimer' },
];

const social = [
  { href: 'https://x.com/', label: 'Medical Study Notes on X', icon: '/assets/icons/x-twitter.svg' },
  { href: 'https://youtube.com/', label: 'Medical Study Notes on YouTube', icon: '/assets/icons/youtube.svg' },
  { href: 'https://instagram.com/', label: 'Medical Study Notes on Instagram', icon: '/assets/icons/instagram.svg' },
];

const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="container ftr-inner">
    <div class="ftr-brand">
      <a class="ftr-wordmark" href="/">
        <img class="ftr-mark" src="/assets/icons/book-logo.svg" alt="" width="26" height="26" />
        <span>
          <span class="ftr-name">Medical Study Notes</span>
          <span class="ftr-tagline">Learn · Study · Succeed</span>
        </span>
      </a>
      <p class="ftr-blurb">
        Medical study notes, explanations, MCQs, and educational resources for
        medical students.
      </p>
    </div>

    <div class="ftr-cols">
      {subjects.length > 0 && (
        <nav aria-labelledby="ftr-subjects">
          <h2 id="ftr-subjects">Subjects</h2>
          <ul class="link-list">
            {subjects.slice(0, 5).map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      )}

      <nav aria-labelledby="ftr-resources">
        <h2 id="ftr-resources">Resources</h2>
        <ul class="link-list">
          {resources.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-labelledby="ftr-about">
        <h2 id="ftr-about">About</h2>
        <ul class="link-list">
          {about.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-labelledby="ftr-legal">
        <h2 id="ftr-legal">Legal</h2>
        <ul class="link-list">
          {legal.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="ftr-social">
        <h2>Follow us</h2>
        <ul>
          {social.map((item) => (
            <li>
              <a href={item.href} aria-label={item.label} rel="noopener">
                <img src={item.icon} alt="" width="18" height="18" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="ftr-base">
      <p>© {year} Medical Study Notes. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .ftr {
    margin-top: auto;
    border-top: 1px solid var(--border);
    background: var(--canvas);
  }

  .ftr-inner {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-8) var(--space-6);
  }

  @media (min-width: 900px) {
    .ftr-inner {
      grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
      gap: var(--space-16);
      padding-block: var(--space-8);
    }
  }

  /* --- brand block ---------------------------------------------------- */
  .ftr-wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--ink);
    text-decoration: none;
  }

  .ftr-mark {
    display: block;
    width: 26px;
    height: 26px;
  }

  .ftr-name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: var(--weight-display);
    line-height: 1.2;
  }

  .ftr-tagline {
    display: block;
    color: var(--mute);
    font-size: 0.5938rem;
    letter-spacing: 0.038em;
  }

  .ftr-blurb {
    max-width: 290px;
    margin-top: var(--space-3);
    color: var(--mute);
    font-size: var(--text-caption);
    line-height: 1.65;
  }

  /* --- link columns --------------------------------------------------- */
  .ftr-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8) var(--space-6);
  }

  @media (min-width: 640px) {
    .ftr-cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .ftr-cols {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .ftr-cols h2 {
    margin-bottom: var(--space-3);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    letter-spacing: 0;
    text-transform: none;
  }

  .ftr-cols .link-list a {
    font-size: var(--text-caption);
    line-height: 1.3;
  }

  .ftr-cols .link-list > li + li {
    margin-top: 6px;
  }

  /* --- social column -------------------------------------------------- */
  .ftr-social ul {
    display: flex;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ftr-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    transition: border-color 0.15s var(--ease), background-color 0.15s var(--ease);
  }

  .ftr-social a:hover {
    border-color: var(--primary-border);
    background: var(--primary-surface);
  }

  .ftr-social img {
    display: block;
    width: 18px;
    height: 18px;
  }

  /* --- base line ------------------------------------------------------ */
  .ftr-base {
    display: flex;
    justify-content: flex-end;
    padding-block: var(--space-3) var(--space-4);
    border-top: 1px solid var(--border);
    color: var(--faint);
    font-size: var(--text-micro);
  }
</style>
