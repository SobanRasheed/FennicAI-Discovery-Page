---
/**
 * FAQ block plus matching FAQPage structured data. Google requires the answer
 * text to be present in the rendered HTML, which <details> satisfies — the
 * content is in the DOM whether or not the disclosure is open.
 */
import Icon from './Icon.astro';
import { jsonForScript } from '../utils/json-script';

interface Faq {
  question: string;
  answer: string;
}

interface Props {
  faqs: Faq[];
  heading?: string;
  level?: 2 | 3;
  id?: string;
  /** Suppress the JSON-LD where a page already emits FAQPage schema. */
  schema?: boolean;
}

const {
  faqs,
  heading = 'Frequently asked questions',
  level = 2,
  id = 'faq',
  schema = true,
} = Astro.props;

const Heading = `h${level}` as 'h2' | 'h3';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

{faqs.length > 0 && (
  <section class="section faq" aria-labelledby={id}>
    <Heading id={id} class="faq-heading">{heading}</Heading>
    <div class="faq-list">
      {faqs.map((faq) => (
        <details class="faq-item">
          <summary>
            <span class="faq-q">{faq.question}</span>
            <span class="faq-caret" aria-hidden="true"><Icon name="chevron-down" size={16} /></span>
          </summary>
          <p class="faq-a">{faq.answer}</p>
        </details>
      ))}
    </div>
    {schema && <script type="application/ld+json" set:html={jsonForScript(jsonLd)} />}
  </section>
)}

<style>
  .faq-heading {
    margin-bottom: var(--space-6);
  }

  .faq-list {
    max-width: var(--prose-width);
    border-top: 1px solid var(--border);
  }

  .faq-item {
    border-bottom: 1px solid var(--border);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-q {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-body-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    transition: color 0.15s var(--ease);
  }

  .faq-item summary:hover .faq-q {
    color: var(--primary);
  }

  .faq-caret {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--mute);
    transition: transform 0.15s var(--ease);
  }

  .faq-item[open] .faq-caret {
    transform: rotate(180deg);
    color: var(--primary);
  }

  .faq-a {
    max-width: 68ch;
    padding-bottom: var(--space-4);
    color: var(--body);
    font-size: var(--text-body-sm);
    line-height: var(--leading-prose);
  }
</style>
