---
/**
 * FAQ block + matching FAQPage structured data. Rendered on posts, notes,
 * subject/topic/level hubs, and the site-wide FAQ page. Google's guidance:
 * FAQ content must be visible on the page, which this satisfies.
 */
interface Faq {
  question: string;
  answer: string;
}

interface Props {
  faqs: Faq[];
  heading?: string;
}

const { faqs, heading = 'Frequently Asked Questions' } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

{
  faqs.length > 0 && (
    <section class="faq">
      <h2>{heading}</h2>
      {faqs.map((faq) => (
        <details>
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    </section>
  )
}

<style>
  .faq details {
    border-bottom: 1px solid #e5e5e5;
    padding: 0.75rem 0;
  }
  .faq summary {
    font-weight: 600;
    cursor: pointer;
  }
  .faq p {
    margin: 0.5rem 0 0;
    line-height: 1.6;
  }
</style>
