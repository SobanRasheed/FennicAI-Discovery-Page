---
/**
 * Line-art illustrations in the style of the reference designs: hand-drawn
 * medical and academic drawings, stroke-only, one colour, no fills, no
 * gradients. They are the site's only decorative imagery, so every drawing is
 * a quiet accent — the same weight as a hairline rule, not a hero graphic.
 *
 * Like Icon.astro, everything is inlined: no sprite request, one visual
 * language (2px stroke on a 48px grid, round caps and joins).
 */
export type IllustrationName =
  | 'anatomy'
  | 'cardiovascular'
  | 'microbiology'
  | 'pharmacology'
  | 'biochemistry'
  | 'pathology'
  | 'neurology'
  | 'stethoscope'
  | 'open-book'
  | 'code'
  | 'database'
  | 'browser';

interface Props {
  name: IllustrationName;
  /** Rendered size in px. */
  size?: number;
  class?: string;
  /** Set when the drawing is the only content of its container. */
  label?: string;
}

const { name, size = 48, class: className, label } = Astro.props;

const drawings: Record<IllustrationName, string> = {
