};

/** Map a subject slug to its drawing. Unknown subjects get the stethoscope. */
export function illustrationForSubject(slug: string): IllustrationName {
  const map: Record<string, IllustrationName> = {
    anatomy: 'anatomy',
    'gross-anatomy': 'anatomy',
    physiology: 'cardiovascular',
    cardiovascular: 'cardiovascular',
    'cardiovascular-system': 'cardiovascular',
    microbiology: 'microbiology',
    bacteriology: 'microbiology',
    pharmacology: 'pharmacology',
    'clinical-pharmacology': 'pharmacology',
    biochemistry: 'biochemistry',
    genetics: 'biochemistry',
    pathology: 'pathology',
    histology: 'pathology',
    neurology: 'neurology',
    neuroscience: 'neurology',
    psychiatry: 'neurology',
    'programming-fundamentals': 'code',
    programming: 'code',
    'computer-science': 'code',
    'database-systems': 'database',
    databases: 'database',
    'web-development': 'browser',
    webdev: 'browser',
  };
  return map[slug] ?? 'stethoscope';
}
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={drawings[name]}
/>
