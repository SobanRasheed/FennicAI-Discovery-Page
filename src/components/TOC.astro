---
/**
 * Table of contents built from the page's h2/h3 headings. rehype-slug has
 * already added ids during markdown rendering, so this only extracts them.
 * Only rendered when there are 3+ entries, to avoid a TOC on short pages.
 */
interface Heading {
  depth: 2 | 3;
  text: string;
  slug: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const show = toc.length >= 3;
---

{
  show && (
    <nav aria-label="Table of contents" class="toc">
      <h2 id="on-this-page">On this page</h2>
      <ul>
        {toc.map((heading) => (
          <li class={heading.depth === 3 ? 'toc-h3' : ''}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc {
    border-left: 3px solid #ddd;
    padding-left: 1rem;
    margin: 1.5rem 0;
  }
  .toc h2 {
    font-size: 1rem;
    margin: 0 0 0.5rem;
  }
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc a {
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .toc-h3 {
    padding-left: 1rem;
  }
</style>
