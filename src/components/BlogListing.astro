---
/**
 * Shared blog listing used by /blog/ and /blog/page/N/, so both routes render
 * an identical list and differ only in the slice of posts they receive.
 */
import ArticleCard from './ArticleCard.astro';
import Pagination from './Pagination.astro';

interface Props {
  posts: {
    slug: string;
    data: {
      title: string;
      description: string;
      category: string;
      publishedDate: Date;
      updatedDate?: Date;
      author: string;
    };
  }[];
  totalPosts: number;
  currentPage: number;
  basePath?: string;
  perPage?: number;
}

const {
  posts,
  totalPosts,
  currentPage,
  basePath = '/blog',
  perPage = 6,
} = Astro.props;
---

{posts.length > 0 ? (
  <ul class="entry-list">
    {posts.map((post) => (
      <li>
        <ArticleCard
          href={`/blog/${post.slug}/`}
          title={post.data.title}
          excerpt={post.data.description}
          kicker={post.data.category.replace(/-/g, ' ')}
          date={post.data.publishedDate}
        />
      </li>
    ))}
  </ul>
) : (
  <div class="empty-state">
    <h3>No articles yet</h3>
    <p>Nothing published in this section. Browse <a href="/notes/">study notes</a> instead.</p>
  </div>
)}

<Pagination
  {basePath}
  totalItems={totalPosts}
  itemsPerPage={perPage}
  {currentPage}
/>
