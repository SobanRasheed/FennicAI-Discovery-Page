---
/**
 * Shared blog listing used by /blog/, /blog/page/N/, and the category pages,
 * so every route renders an identical list and differs only in the slice of
 * posts it receives. Posts come from D1 (published articles), so dates arrive
 * as UTC strings and are inflated here.
 */
import ArticleCard from './ArticleCard.astro';
import Pagination from './Pagination.astro';
import type { BlogPostCard } from '../utils/content';

interface Props {
  posts: BlogPostCard[];
  totalPosts: number;
  currentPage: number;
  basePath?: string;
  perPage?: number;
}

const {
  posts,
  totalPosts,
  currentPage,
  basePath = '/blog',
  perPage = 6,
} = Astro.props;

/** D1 timestamps are UTC without a zone suffix. */
const asDate = (s: string | null) => (s ? new Date(s + 'Z') : undefined);

const categoryLabel = (slug: string | null) => (slug ?? 'article').replace(/-/g, ' ');
---

{posts.length > 0 ? (
  <ul class="entry-list">
    {posts.map((post) => (
      <li>
        <ArticleCard
          href={`/blog/${post.slug}/`}
          title={post.title}
          excerpt={post.excerpt}
          kicker={categoryLabel(post.category)}
          date={asDate(post.published_at ?? post.updated_at)}
          readingMinutes={post.reading_minutes}
        />
      </li>
    ))}
  </ul>
) : (
  <div class="empty-state">
    <h3>No articles yet</h3>
    <p>Nothing published in this section. Browse <a href="/notes/">study notes</a> instead.</p>
  </div>
)}

<Pagination
  {basePath}
  totalItems={totalPosts}
  itemsPerPage={perPage}
  {currentPage}
/>
