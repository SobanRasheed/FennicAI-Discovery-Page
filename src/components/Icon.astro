  image:
    '<rect x="3.5" y="4.5" width="17" height="15" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="M4 17l4.8-4.4 4.2 3.6 2.6-2.2L20 18"/>',
  file:
