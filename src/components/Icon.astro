  globe:
    '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18z"/>',
  'graduation-cap':
    '<path d="M2.5 9.5L12 5l9.5 4.5L12 14z"/><path d="M6 11.8v4.2c0 1.5 2.7 3 6 3s6-1.5 6-3v-4.2"/><path d="M21.5 9.5v5"/>',
  envelope:
    '<rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3.5 7l8.5 6 8.5-6"/>',
  chat:
    '<path d="M4 5.5h16v11H9l-5 4z"/><path d="M8 9.5h8"/><path d="M8 12.5h5"/>',
