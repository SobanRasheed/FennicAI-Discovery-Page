  'book-open':
    '<path d="M12 6.5C10 4.8 7 4.5 3.5 5v13c3.5-.5 6.5 0 8.5 1.7 2-1.7 5-2.2 8.5-1.7V5c-3.5-.5-6.5 0-8.5 1.5z"/><path d="M12 6.5v13"/>',
