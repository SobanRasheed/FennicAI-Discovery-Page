---
/**
 * Breadcrumb trail with matching BreadcrumbList structured data. The last
 * crumb is the current page and is not a link, per Google's guidance. Item 1
 * is always Home.
 *
 * On narrow screens the trail scrolls horizontally rather than wrapping into
 * three ragged lines.
 */
interface Crumb {
  label: string;
  href?: string; // omit for the current page
}

interface Props {
  crumbs: Crumb[];
  /** Suppresses the JSON-LD when a page already emits its own BreadcrumbList. */
  schema?: boolean;
}

const { crumbs, schema = true } = Astro.props;

import { jsonForScript } from '../utils/json-script';

const allCrumbs = [{ label: 'Home', href: '/' }, ...crumbs];
const site = Astro.site!;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: allCrumbs.map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.label,
    ...(crumb.href ? { item: new URL(crumb.href, site).href } : {}),
  })),
};
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {allCrumbs.map((crumb, index) => (
      <li>
        {crumb.href && index < allCrumbs.length - 1 ? (
          <a href={crumb.href}>{crumb.label}</a>
        ) : (
          <span aria-current="page">{crumb.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

{schema && <script type="application/ld+json" set:html={jsonForScript(jsonLd)} />}

<style>
  .crumbs {
    /* Full-width scroll on mobile without clipping the focus ring. */
    overflow-x: auto;
    scrollbar-width: none;
    font-size: var(--text-body-sm);
  }

  .crumbs::-webkit-scrollbar {
    display: none;
  }

  .crumbs ol {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    white-space: nowrap;
  }

  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Chevron drawn with borders — no icon request for a separator. */
  .crumbs li + li::before {
    content: '';
    flex-shrink: 0;
    width: 0.3125rem;
    height: 0.3125rem;
    border-top: 1.5px solid var(--faint);
    border-right: 1.5px solid var(--faint);
    transform: rotate(45deg);
  }

  .crumbs a {
    color: var(--mute);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .crumbs [aria-current='page'] {
    color: var(--ink);
    font-weight: var(--weight-medium);
  }
</style>
