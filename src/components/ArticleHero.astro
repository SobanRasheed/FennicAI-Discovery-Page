---
/**
 * ArticleHero: the full-bleed article header from the Figma design
 * (node 1:431 to 1:579), rethemed to this site's tokens.
 *
 * Kept from the design: full-bleed image behind a dark scrim, breadcrumbs
 * sitting on the image, a large headline, a supporting line, and a byline row
 * of hairline-separated metadata.
 *
 * Changed deliberately: sentence case instead of 64px all-caps, no view or
 * share counts (no analytics backend, so they would be invented), and a
 * token-coloured band when the article has no featured image, since most
 * study notes will not have one.
 */
interface Props {
  title: string;
  /** The article excerpt, shown under the headline. */
  standfirst?: string;
  image?: string;
  imageAlt?: string;
  author?: string;
  date?: Date;
  dateLabel?: string;
  readingMinutes?: number;
  /** [{ href, label }], last item is rendered as the current page. */
  crumbs?: { href?: string; label: string }[];
  /** Subject or topic chips, shown above the headline. */
  chips?: { href?: string; label: string }[];
}

const {
  title,
  standfirst,
  image,
  imageAlt = '',
  author,
  date,
  dateLabel = 'Published',
  readingMinutes,
  crumbs = [],
  chips = [],
} = Astro.props;

const isoDate = date?.toISOString();
const shownDate = date
  ? date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;
---

<header class:list={['ahero', !image && 'ahero-plain']}>
  {image && (
    <img class="ahero-bg" src={image} alt={imageAlt} fetchpriority="high" decoding="async" />
  )}

  <div class="container ahero-inner">
    {crumbs.length > 0 && (
      <nav class="ahero-crumbs" aria-label="Breadcrumb">
        <ol>
          {crumbs.map((crumb, i) => (
            <li>
              {crumb.href && i < crumbs.length - 1 ? (
                <a href={crumb.href}>{crumb.label}</a>
              ) : (
                <span aria-current="page">{crumb.label}</span>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}

    {chips.length > 0 && (
      <p class="ahero-chips">
        {chips.map((chip) =>
          chip.href ? (
            <a class="ahero-chip" href={chip.href}>{chip.label}</a>
          ) : (
            <span class="ahero-chip">{chip.label}</span>
          ),
        )}
      </p>
    )}

    <h1 class="ahero-title">{title}</h1>

    {standfirst && <p class="ahero-standfirst">{standfirst}</p>}

    {(author || shownDate || readingMinutes) && (
      <p class="ahero-meta">
        {author && <span>by {author}</span>}
        {shownDate && (
          <>
            {author && <span class="ahero-rule" aria-hidden="true"></span>}
            <span>{dateLabel} <time datetime={isoDate}>{shownDate}</time></span>
          </>
        )}
        {readingMinutes && (
          <>
            <span class="ahero-rule" aria-hidden="true"></span>
            <span class="ahero-read">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v5l3 2" />
              </svg>
              {readingMinutes} min read
            </span>
          </>
        )}
      </p>
    )}
  </div>
</header>

<style>
  .ahero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: 26rem;
    padding-block: var(--space-4xl) var(--space-xl);
    overflow: hidden;
    background: var(--band);
    color: #ffffff;
  }

  @media (min-width: 768px) {
    .ahero {
      min-height: 32rem;
      padding-block: var(--space-5xl) var(--space-xl);
    }
  }

  .ahero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Scrim: the design darkens the photo so the type stays readable over any
     image. Slightly stronger at the bottom where the text sits. */
  .ahero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgb(0 0 0 / 0.38) 0%,
      rgb(0 0 0 / 0.5) 55%,
      rgb(0 0 0 / 0.72) 100%
    );
  }

  /* No featured image: the indigo band plus a soft diagonal, no photo. */
  .ahero-plain {
    background: linear-gradient(135deg, var(--band) 0%, var(--band-soft) 100%);
  }

  .ahero-plain::after {
    background: linear-gradient(180deg, transparent 0%, rgb(0 0 0 / 0.22) 100%);
  }

  .ahero-inner {
    position: relative;
    max-width: 56rem;
    margin-inline: 0;
    padding-inline: var(--space-md);
  }

  @media (min-width: 768px) {
    .ahero-inner {
      padding-inline: var(--space-lg);
    }
  }

  /* Wide viewports: keep the text aligned to the page container gutter
     rather than pinning it to the far left edge of the screen. */
  @media (min-width: 1264px) {
    .ahero-inner {
      margin-inline: auto;
      max-width: var(--page-width);
    }
    .ahero-inner > * {
      max-width: 56rem;
    }
  }

  /* --- breadcrumbs --------------------------------------------------- */
  .ahero-crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    margin: 0 0 var(--space-md);
    padding: 0;
    list-style: none;
    font-size: var(--text-body-sm);
  }

  .ahero-crumbs li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    color: rgb(255 255 255 / 0.82);
  }

  /* Chevron between crumbs, drawn with a border rather than an icon file. */
  .ahero-crumbs li + li::before {
    content: '';
    width: 0.375rem;
    height: 0.375rem;
    border-top: 1.5px solid rgb(255 255 255 / 0.55);
    border-right: 1.5px solid rgb(255 255 255 / 0.55);
    transform: rotate(45deg);
  }

  .ahero-crumbs a {
    color: rgb(255 255 255 / 0.82);
    text-decoration: none;
  }

  .ahero-crumbs a:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .ahero-crumbs [aria-current='page'] {
    color: #ffffff;
    font-weight: var(--weight-medium);
  }

  /* --- chips -------------------------------------------------------- */
  .ahero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xxs);
    margin-bottom: var(--space-md);
  }

  .ahero-chip {
    padding: 0.25rem var(--space-xs);
    border-radius: var(--radius-xs);
    background: rgb(255 255 255 / 0.2);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.24);
    color: #ffffff;
    font-size: var(--text-caption);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }

  a.ahero-chip:hover {
    background: rgb(255 255 255 / 0.32);
    color: #ffffff;
  }

  @media (prefers-reduced-transparency: reduce) {
    .ahero-chip {
      background: rgb(0 0 0 / 0.7);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  /* --- type --------------------------------------------------------- */
  .ahero-title {
    color: #ffffff;
    font-size: clamp(2rem, 1.2rem + 3.4vw, 3.5rem);
    font-weight: var(--weight-display);
    letter-spacing: -0.03em;
    line-height: 1.08;
    text-wrap: balance;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.32);
  }

  .ahero-standfirst {
    max-width: 44ch;
    margin-top: var(--space-md);
    color: rgb(255 255 255 / 0.88);
    font-size: clamp(1.0625rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.5;
  }

  .ahero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-sm);
    margin-top: var(--space-lg);
    color: rgb(255 255 255 / 0.85);
    font-size: var(--text-body-sm);
  }

  .ahero-rule {
    width: 1.25rem;
    height: 1px;
    background: rgb(255 255 255 / 0.5);
  }

  .ahero-read {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xxs);
  }
</style>
