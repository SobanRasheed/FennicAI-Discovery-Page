---
/**
 * Link card for a blog post in listings and related-content blocks.
 *
 * Restyled onto the design system: a hairline editorial row with a mono
 * category kicker, serif title, and quiet date, matching the entry lists.
 */
interface Props {
  post: {
    slug: string;
    data: {
      title: string;
      description: string;
      category: string;
      publishedDate: Date;
      updatedDate?: Date;
      author: string;
    };
  };
  showDate?: boolean;
}

import { formatDate } from '../utils/collections';
const { post, showDate = true } = Astro.props;
---

<article class="pcard">
  <p class="pcard-meta">
    <a class="kicker" href={`/blog/category/${post.data.category}/`}>
      {post.data.category.replace(/-/g, ' ')}
    </a>
    {showDate && (
      <time datetime={post.data.publishedDate.toISOString()}>
        {formatDate(post.data.publishedDate)}
      </time>
    )}
    {post.data.updatedDate && <span>updated {formatDate(post.data.updatedDate)}</span>}
  </p>
  <h3 class="pcard-title"><a href={`/blog/${post.slug}/`}>{post.data.title}</a></h3>
  <p class="pcard-desc">{post.data.description}</p>
</article>

<style>
  .pcard {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border);
  }

  .pcard-meta {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    margin: 0 0 var(--space-1);
    color: var(--faint);
    font-size: var(--text-body-sm);
  }

  .pcard-title {
    margin: 0 0 var(--space-1);
    font-size: var(--text-body-lg);
  }

  .pcard-title a {
    color: var(--ink);
    text-decoration: none;
    transition: color 0.15s var(--ease);
  }

  .pcard-title a:hover {
    color: var(--primary);
  }

  .pcard-desc {
    margin: 0;
    color: var(--mute);
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
  }
</style>
