---
/**
 * Link card for a blog post in listings and related-content blocks.
 *
 * Takes a flat D1-backed shape (category slug + timestamps), so
 * collection-based and database-backed pages render identically.
 */
interface Props {
  post: {
    slug: string;
    title: string;
    description: string;
    /** Category slug; null falls back to the plain /blog/ stream. */
    category: string | null;
    /** D1 'YYYY-MM-DD HH:MM:SS' timestamp or a Date. */
    published: string | Date;
    updated?: string | Date | null;
    /** Featured image, when the post has one. */
    image?: { src: string; alt?: string | null } | null;
  };
  showDate?: boolean;
}

const { post, showDate = true } = Astro.props;

/** D1 timestamps are UTC without a zone suffix. */
const asDate = (v: string | Date) => (v instanceof Date ? v : new Date(v + 'Z'));

const published = asDate(post.published);
const updated = post.updated ? asDate(post.updated) : null;

const kickerHref = post.category ? `/blog/category/${post.category}/` : '/blog/';
const kickerLabel = (post.category ?? 'article').replace(/-/g, ' ');
---

<article class="pcard" class:list={{ 'pcard-has-image': post.image }}>
  {post.image && (
    <a class="pcard-thumb" href={`/blog/${post.slug}/`} tabindex="-1" aria-hidden="true">
      <img src={post.image.src} alt="" loading="lazy" decoding="async" />
    </a>
  )}
  <div class="pcard-text">
    <p class="pcard-meta">
      <a class="kicker" href={kickerHref}>{kickerLabel}</a>
      {showDate && (
        <time datetime={published.toISOString()}>{published.toISOString().slice(0, 10)}</time>
      )}
      {updated && <span>updated {updated.toISOString().slice(0, 10)}</span>}
    </p>
    <h3 class="pcard-title"><a href={`/blog/${post.slug}/`}>{post.title}</a></h3>
    <p class="pcard-desc">{post.description}</p>
  </div>
</article>

<style>
  .pcard {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border);
  }

  /* With a featured image the card becomes a thumb + text row. */
  .pcard-has-image {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .pcard-thumb {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--surface-sunken);
  }

  .pcard-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pcard-text {
    min-width: 0;
    flex: 1;
  }

  .pcard-meta {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    margin: 0 0 var(--space-1);
    color: var(--faint);
    font-size: var(--text-body-sm);
  }

  .pcard-title {
    margin: 0 0 var(--space-1);
    font-size: var(--text-body-lg);
  }

  .pcard-title a {
    color: var(--ink);
    text-decoration: none;
    transition: color 0.15s var(--ease);
  }

  .pcard-title a:hover {
    color: var(--primary);
  }

  .pcard-desc {
    margin: 0;
    color: var(--mute);
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
  }
</style>
