---
/**
 * Site header — Figma Screen 01: the brand lockup (book logo + serif name +
 * tagline), a one-line nav with a Subjects dropdown, an inline search field,
 * and a solid green Login button. 66px tall at desktop, with a 2px green
 * underline sitting on the bottom rule marking the active section.
 *
 * The desktop Subjects dropdown opens on hover/focus-within (CSS only); the
 * mobile menu and search panel are checkbox disclosures, so the header ships
 * zero client-side JavaScript. Both panels close on navigation because each
 * link is a real page load.
 */
import { getCollection } from '../utils/collections';
import Icon from './Icon.astro';

interface Props {
  /** Current path, used to mark the active nav item. */
  path: string;
}

const { path } = Astro.props;

const subjects = (await getCollection('subjects'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
  .slice(0, 8);

const nav = [
  { href: '/notes/', label: 'Study Notes' },
  { href: '/practice/', label: 'MCQs' },
  { href: '/blog/', label: 'Blog' },
  { href: '/resources/', label: 'Resources' },
  { href: '/about/', label: 'About' },
];

const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="hdr">
  <div class="container hdr-inner">
    <a class="hdr-brand" href="/">
      <img class="hdr-logo" src="/assets/icons/book-logo.svg" alt="" width="30" height="30" />
      <span class="hdr-brand-text">
        <span class="hdr-name">Medical Study Notes</span>
        <span class="hdr-tagline">Learn · Study · Succeed</span>
      </span>
    </a>

    <nav class="hdr-nav" aria-label="Primary">
      <ul>
        <li class="hdr-has-sub">
          <a
            href="/subjects/"
            aria-current={isCurrent('/subjects/') ? 'page' : undefined}
          >
            Subjects
            <img class="hdr-chev" src="/assets/icons/chevron-down.svg" alt="" width="14" height="14" />
          </a>
          <div class="hdr-sub">
            <ul>
              {subjects.map((subject) => (
                <li>
                  <a href={`/subjects/${subject.slug}/`}>{subject.data.title}</a>
                </li>
              ))}
            </ul>
            <a class="hdr-sub-all" href="/subjects/">
              All subjects
              <img src="/assets/icons/arrow-right.svg" alt="" width="15" height="15" />
            </a>
          </div>
        </li>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <form class="hdr-search" role="search" action="/search/" method="get">
      <label class="visually-hidden" for="hdr-q">Search medical topics</label>
      <span class="hdr-search-icon" aria-hidden="true">
        <img src="/assets/icons/search.svg" alt="" width="17" height="17" />
      </span>
      <input
        id="hdr-q"
        type="search"
        name="q"
        placeholder="Search medical topics..."
        autocomplete="off"
      />
    </form>

    <a class="hdr-login" href="/login/">
      <img src="/assets/icons/user.svg" alt="" width="15" height="15" />
      <span class="hdr-login-text">Login</span>
    </a>

    {/* --- mobile controls: CSS-only disclosures --------------------------- */}
    <input class="hdr-toggle" type="checkbox" id="hdr-search-toggle" hidden />
    <label class="hdr-icon-btn hdr-search-btn" for="hdr-search-toggle">
      <Icon name="search" size={19} label="Search" />
    </label>

    <input class="hdr-toggle" type="checkbox" id="hdr-menu-toggle" hidden />
    <label class="hdr-icon-btn hdr-menu-btn" for="hdr-menu-toggle">
      <span class="hdr-menu-open"><Icon name="menu" size={20} label="Open menu" /></span>
      <span class="hdr-menu-close"><Icon name="close" size={20} label="Close menu" /></span>
    </label>

    <div class="hdr-panel hdr-panel-search">
      <form role="search" action="/search/" method="get" class="search-field">
        <label class="visually-hidden" for="hdr-q-mobile">Search medical topics</label>
        <Icon name="search" size={16} />
        <input
          id="hdr-q-mobile"
          type="search"
          name="q"
          placeholder="Search anatomy, microbiology..."
          autocomplete="off"
        />
      </form>
    </div>

    <nav class="hdr-panel hdr-panel-menu" aria-label="Mobile">
      <ul>
        <li>
          <a href="/subjects/" aria-current={isCurrent('/subjects/') ? 'page' : undefined}>
            Subjects<Icon name="chevron-right" size={16} />
          </a>
        </li>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}<Icon name="chevron-right" size={16} />
            </a>
          </li>
        ))}
        <li>
          <a href="/search/">Search<Icon name="chevron-right" size={16} /></a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 60;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .hdr-inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--header-height);
    flex-wrap: wrap;
  }

  /* --- brand lockup ---------------------------------------------------- */
  .hdr-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    margin-right: var(--space-4);
    color: var(--ink);
    text-decoration: none;
  }

  .hdr-logo {
    display: block;
    width: 30px;
    height: 30px;
  }

  .hdr-name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: var(--weight-display);
    line-height: 1.1;
    white-space: nowrap;
  }

  .hdr-tagline {
    display: block;
    margin-top: 2px;
    color: var(--mute);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* --- desktop nav ----------------------------------------------------- */
  .hdr-nav {
    display: none;
  }

  .hdr-nav ul {
    display: flex;
    align-items: center;
    gap: 26px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hdr-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--body);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s var(--ease);
  }

  .hdr-nav a:hover {
    color: var(--primary);
  }

  /* Active item: green text plus a 2px underline sitting on the header
     rule, which is how the design marks the current section. */
  .hdr-nav a[aria-current='page'] {
    color: var(--primary);
  }

  .hdr-nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(-1 * (var(--header-height) / 2 - 50%) - 1px);
    height: 2px;
    background: var(--primary);
  }

  .hdr-chev {
    transition: transform 0.15s var(--ease);
  }

  /* --- subjects dropdown (CSS only: hover or keyboard focus) ------------ */
  .hdr-has-sub {
    position: relative;
  }

  .hdr-sub {
    display: none;
    position: absolute;
    top: 100%;
    left: -16px;
    z-index: 70;
    min-width: 230px;
    padding: var(--space-2) 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-overlay);
  }

  .hdr-has-sub:hover .hdr-sub,
  .hdr-has-sub:focus-within .hdr-sub {
    display: block;
  }

  .hdr-has-sub:hover .hdr-chev,
  .hdr-has-sub:focus-within .hdr-chev {
    transform: rotate(180deg);
  }

  .hdr-sub ul {
    display: block;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hdr-sub ul a {
    display: block;
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-caption);
    transition: color 0.15s var(--ease), background-color 0.15s var(--ease);
  }

  .hdr-sub ul a:hover {
    background: var(--primary-surface);
    color: var(--primary);
  }

  .hdr-sub-all {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: var(--space-1);
    padding: var(--space-2) var(--space-4);
    border-top: 1px solid var(--border);
    color: var(--primary);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }

  .hdr-sub-all:hover {
    color: var(--primary-hover);
  }

  /* --- inline search --------------------------------------------------- */
  .hdr-search {
    display: none;
    position: relative;
    flex: 0 1 292px;
    min-width: 0;
    height: 40px;
    margin-left: auto;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    transition: border-color 0.15s var(--ease), box-shadow 0.15s var(--ease);
  }

  .hdr-search:focus-within {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 16%, transparent);
  }

  .hdr-search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    color: var(--mute);
    pointer-events: none;
  }

  .hdr-search input {
    width: 100%;
    height: 100%;
    min-height: 0;
    padding: 0 var(--space-3) 0 38px;
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--ink);
    font-size: var(--text-caption);
  }

  .hdr-search input:focus {
    outline: none;
    box-shadow: none;
  }

  /* --- login button ---------------------------------------------------- */
  .hdr-login {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-shrink: 0;
    height: 40px;
    padding-inline: var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--primary);
    color: var(--on-primary);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s var(--ease);
  }

  .hdr-login:hover {
    background: var(--primary-hover);
    color: var(--on-primary);
  }

  /* Push the login button right when the search field is hidden. */
  .hdr-login {
    margin-left: auto;
  }

  @media (min-width: 1200px) {
    .hdr-login {
      margin-left: 0;
    }
  }

  /* --- mobile controls ------------------------------------------------- */
  .hdr-toggle {
    display: none;
  }

  .hdr-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    color: var(--body);
    cursor: pointer;
    transition: background-color 0.15s var(--ease), color 0.15s var(--ease);
  }

  .hdr-icon-btn:hover {
    background: var(--surface-sunken);
    color: var(--ink);
  }

  .hdr-menu-close,
  .hdr-menu-open {
    display: inline-flex;
  }

  .hdr-menu-close {
    display: none;
  }

  #hdr-menu-toggle:checked ~ .hdr-menu-btn .hdr-menu-open {
    display: none;
  }

  #hdr-menu-toggle:checked ~ .hdr-menu-btn .hdr-menu-close {
    display: inline-flex;
  }

  #hdr-search-toggle:checked ~ .hdr-search-btn,
  #hdr-menu-toggle:checked ~ .hdr-menu-btn {
    background: var(--surface-sunken);
    color: var(--primary);
  }

  /* Keyboard access for the label-as-button pattern. */
  .hdr-toggle:focus-visible ~ .hdr-icon-btn {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  /* --- mobile panels --------------------------------------------------- */
  .hdr-panel {
    display: none;
    flex-basis: 100%;
    padding-block: var(--space-3) var(--space-4);
    border-top: 1px solid var(--border);
  }

  #hdr-search-toggle:checked ~ .hdr-panel-search,
  #hdr-menu-toggle:checked ~ .hdr-panel-menu {
    display: block;
  }

  .hdr-panel-menu ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hdr-panel-menu li + li {
    border-top: 1px solid var(--border);
  }

  .hdr-panel-menu a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    /* 48px tap target */
    padding: var(--space-3) var(--space-1);
    color: var(--ink);
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }

  .hdr-panel-menu a svg {
    color: var(--faint);
  }

  .hdr-panel-menu a[aria-current='page'] {
    color: var(--primary);
  }

  /* --- desktop switch -------------------------------------------------- */
  @media (min-width: 1024px) {
    .hdr-nav {
      display: block;
    }

    .hdr-menu-btn,
    .hdr-panel {
      display: none !important;
    }
  }

  @media (min-width: 1200px) {
    .hdr-search {
      display: block;
    }

    .hdr-search-btn {
      display: none;
    }
  }

  /* Below 400 the brand tagline and login label drop out so the row stays
     on one line. */
  @media (max-width: 400px) {
    .hdr-tagline,
    .hdr-login-text {
      display: none;
    }

    .hdr-brand {
      margin-right: auto;
    }
  }
</style>
