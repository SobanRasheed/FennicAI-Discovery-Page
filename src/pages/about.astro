---
/**
 * About: mission, method, and the site's editorial stance.
 *
 * The Figma stats (100,000+ students, 1,500+ MCQs) are placeholder
 * marketing numbers — the stats bar below reports the real content counts
 * instead, and every claim in the copy matches what the site actually does.
 *
 * Structure follows the design: a band hero with the books illustration and
 * the pull quote, a story column beside mission/vision cards, a stats bar,
 * the why-choose cards, a divider-separated values row, and the community CTA.
 */
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import JsonLd from '../components/JsonLd.astro';
import { getNotes, getQuestions, getBlogPosts, getCollection } from '../utils/collections';

const [notes, questions, posts, subjects] = await Promise.all([
  getNotes(),
  getQuestions(),
  getBlogPosts(),
  getCollection('subjects'),
]);

const pillars = [
  {
    icon: 'book-open',
    title: 'Learn',
    text: 'Clear explanations',
  },
  {
    icon: 'target',
    title: 'Study',
    text: 'Exam-focused content',
  },
  {
    icon: 'star',
    title: 'Succeed',
    text: 'Build a brighter future',
  },
] as const;

const choices = [
  {
    icon: 'shield',
    title: 'Accurate & Reliable',
    text: 'Content is carefully researched and reviewed for accuracy, and each study note lists its sources in a references section.',
  },
  {
    icon: 'users',
    title: 'Student Focused',
    text: 'Designed for students, to meet real learning needs — objectives first, then explanation, then self-test.',
  },
  {
    icon: 'layers',
    title: 'Comprehensive Resources',
    text: 'Study notes, practice questions, and articles — all in one place, organized by subject and chapter.',
  },
  {
    icon: 'refresh',
    title: 'Always Improving',
    text: 'Content is updated when material changes or corrections land, and every page shows its published and last-updated dates.',
  },
] as const;

/** Values row. Handshake and leaf glyphs are not in Icon.astro, so they use
    the icon assets exported from the design. */
const values = [
  { icon: 'bulb', title: 'Excellence', text: 'Strive for the highest quality in our content.' },
  { icon: 'users', title: 'Accessibility', text: 'Keep every resource free and available to all.' },
  { icon: '', title: 'Integrity', text: 'Provide honest and reliable information.', img: '/assets/icons/handshake.svg' },
  { icon: '', title: 'Community', text: 'Support and grow with our learner community.', img: '/assets/icons/leaf.svg' },
] as const;

/** The stats bar: real content counts, not the design's placeholder numbers. */
const stats = [
  { value: notes.length, label: 'Study notes', icon: 'file' },
  { value: questions.length, label: 'Practice questions', icon: 'question' },
  { value: subjects.length, label: 'Subjects', icon: 'book-open' },
  { value: posts.length, label: 'Articles', icon: 'chart' },
] as const;

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.data.title,
}));

const siteHref = Astro.site?.href ?? '';

const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Medical Study Notes',
  url: new URL('/about/', Astro.site).href,
  mainEntity: {
    '@type': 'Organization',
    name: 'Medical Study Notes',
    url: siteHref,
    description:
      'Study notes, practice questions, and articles for the subjects we cover, structured for efficient revision.',
  },
  isPartOf: { '@type': 'WebSite', name: 'Medical Study Notes', url: siteHref },
};
---
<Layout
  title="About — Our Mission and Method | Medical Study Notes"
  description="Who we are, why Medical Study Notes exists, and how our study notes, practice questions, and articles are structured to make revision efficient."
  path="/about/"
  footerSubjects={footerSubjects}
  wide
>
  <JsonLd data={aboutSchema} />

  <PageHeader
    kicker="About Us"
    title="Our Mission is to Support Your Study Journey"
    lead="A student-focused platform providing high-quality study notes, practice questions, and educational resources — free, structured for revision, and organized the way courses actually run."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'About' }]}
    tone="band"
    asideWide
  >
    <ul class="about-features">
      {pillars.map((pillar) => (
        <li>
          <Icon name={pillar.icon} size={27} />
          <div>
            <strong>{pillar.title}</strong>
            <span>{pillar.text}</span>
          </div>
        </li>
      ))}
    </ul>

    <Fragment slot="aside">
      <div class="about-hero-side">
        <img
          class="about-hero-art"
          src="/assets/icons/blog-hero-books.png"
          alt="A stack of study books and notes"
          width="808"
          height="641"
          loading="eager"
          decoding="async"
        />

        <figure class="about-quote">
          <span class="quote-mark" aria-hidden="true">“</span>
          <blockquote>
            <p>Education is the most powerful weapon which you can use to change the world.</p>
          </blockquote>
          <span class="quote-rule" aria-hidden="true"></span>
          <figcaption>Nelson Mandela</figcaption>
        </figure>
      </div>
    </Fragment>
  </PageHeader>

  <div class="container page-body">
    {/* --- story / mission / vision ----------------------------------------- */}
    <section class="section" aria-labelledby="our-story">
      <div class="story-grid">
        <div class="story-copy">
          <h2 id="our-story">Our Story</h2>
          <p>
            This site was created with a simple idea — to make high-quality,
            reliable, and easy-to-understand study material accessible to
            everyone. The material for most courses exists, but it is scattered
            across textbook chapters, lecture slides, and forum threads, each
            written for a different audience. We put it in one place, structured
            the way revision actually works: objectives first, then explanation,
            then self-test.
          </p>
          <p>
            Every page is written by a named author and reviewed before
            publication — read the full
            <a href="/editorial-policy/">editorial policy</a> and the
            <a href="/corrections/">corrections policy</a> for how content is
            written, reviewed, and corrected.
          </p>
        </div>

        <div class="story-cards">
          <div class="smv-card">
            <span class="smv-icon" aria-hidden="true"><Icon name="target" size={26} /></span>
            <div>
              <h3>Our Mission</h3>
              <p>
                To empower students with accurate, high-quality, and accessible
                study resources — notes, worked practice questions, and practical
                guides, all free to read.
              </p>
            </div>
          </div>
          <div class="smv-card">
            <span class="smv-icon" aria-hidden="true"><Icon name="eye" size={26} /></span>
            <div>
              <h3>Our Vision</h3>
              <p>
                To become a trusted and comprehensive platform for the subjects
                we cover, helping students build lasting understanding rather
                than last-minute recall.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* --- real content counts ------------------------------------------------ */}
    <section class="section" aria-label="What we publish today">
      <div class="stats-bar">
        {stats.map((stat) => (
          <div class="stat">
            <Icon name={stat.icon} size={25} />
            <div>
              <p class="stat-value">{stat.value}</p>
              <p class="stat-label">{stat.label}</p>
            </div>
          </div>
        ))}
      </div>

      <p class="publish-note">
        Everything above is live on the site right now. Browse the
        <a href="/notes/">study notes</a>, try the
        <a href="/practice/">practice questions</a>, or read the
        <a href="/blog/">articles</a>.
      </p>
    </section>

    {/* --- why choose ------------------------------------------------------------ */}
    <section class="section" aria-labelledby="why-choose">
      <div class="section-head">
        <h2 id="why-choose">Why choose Medical Study Notes?</h2>
        <p>We are committed to providing the best learning experience for students.</p>
      </div>

      <div class="grid grid-4 why-grid">
        {choices.map((choice) => (
          <div class="why-card">
            <span class="why-icon" aria-hidden="true"><Icon name={choice.icon} size={27} /></span>
            <div>
              <h3>{choice.title}</h3>
              <p>{choice.text}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* --- values ------------------------------------------------------------------- */}
    <section class="section" aria-labelledby="our-values">
      <div class="section-head">
        <h2 id="our-values">Our values</h2>
        <p>The principles that guide everything we do.</p>
      </div>

      <ul class="values-row">
        {values.map((value) => (
          <li class="value">
            {value.img ? (
              <img class="value-img" src={value.img} alt="" width="30" height="30" loading="lazy" decoding="async" />
            ) : (
              <span class="value-icon" aria-hidden="true"><Icon name={value.icon} size={30} /></span>
            )}
            <div>
              <h3>{value.title}</h3>
              <p>{value.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    {/* --- CTA --------------------------------------------------------------------------- */}
    <section class="cta-band" aria-labelledby="join-community">
      <div class="cta-copy">
        <span class="cta-icon" aria-hidden="true"><Icon name="users" size={27} /></span>
        <div>
          <h2 id="join-community">Join Our Growing Community</h2>
          <p>
            Be part of a community of students learning, sharing, and succeeding
            together. Everything on the site is free to read, with no account
            required.
          </p>
        </div>
      </div>
      <a class="btn btn-primary" href="/subjects/">
        Start Learning Today
        <Icon name="arrow-right" size={16} />
      </a>
    </section>
  </div>
</Layout>

<style>
  /* --- hero feature cells --------------------------------------------------- */
  .about-features {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-6);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .about-features li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .about-features svg {
    flex-shrink: 0;
    color: var(--primary);
  }

  .about-features strong {
    display: block;
    color: var(--primary);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: var(--weight-semibold);
    line-height: 1.3;
  }

  .about-features span {
    display: block;
    color: var(--mute);
    font-size: var(--text-caption);
  }

  @media (min-width: 760px) {
    .about-features li + li {
      padding-left: var(--space-6);
      border-left: 1px solid #d9e2d6;
    }
  }

  /* --- header aside: books illustration beside the quote panel --------------- */
  .about-hero-side {
    display: grid;
    gap: var(--space-4);
    align-items: center;
  }

  .about-hero-art {
    display: none;
    width: 100%;
    aspect-ratio: 404 / 320;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .about-quote {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: var(--space-6);
    border-radius: 6px;
    background: var(--quote-surface);
  }

  .quote-mark {
    color: var(--primary);
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: var(--weight-semibold);
    line-height: 0.5;
    margin-bottom: var(--space-4);
  }

  .about-quote blockquote {
    margin: 0;
  }

  .about-quote p {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-style: italic;
    font-weight: var(--weight-medium);
    line-height: 1.5;
    text-wrap: balance;
  }

  .quote-rule {
    width: 26px;
    height: 2px;
    margin: var(--space-5) 0 var(--space-3);
    background: var(--primary);
  }

  .about-quote figcaption {
    color: var(--mute);
    font-family: var(--font-sans);
    font-size: 0.6563rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  @media (min-width: 1024px) {
    .about-hero-art {
      display: block;
    }
  }

  /* --- page ------------------------------------------------------------------ */
  .page-body {
    padding-block: var(--space-12) var(--space-16);
  }

  /* --- story / mission / vision ------------------------------------------------ */
  .story-grid {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .story-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 34rem);
      gap: var(--space-12);
      align-items: start;
    }
  }

  .story-copy h2 {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: var(--weight-display);
    line-height: 1.25;
  }

  .story-copy p {
    margin-top: var(--space-4);
    color: var(--body);
    font-size: var(--text-body);
    line-height: var(--leading-prose);
  }

  .story-copy a {
    color: var(--primary);
    font-weight: var(--weight-medium);
  }

  .story-cards {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .story-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .smv-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background: var(--primary-surface);
  }

  .smv-icon {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--primary);
  }

  .smv-card h3 {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: var(--weight-semibold);
    line-height: 1.3;
  }

  .smv-card p {
    margin-top: var(--space-2);
    color: var(--body);
    font-size: var(--text-caption);
    line-height: 1.68;
  }

  /* --- stats bar -------------------------------------------------------------------- */
  .stats-bar {
    display: grid;
    gap: var(--space-4) var(--space-6);
    padding: var(--space-5) var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--band);
  }

  @media (min-width: 640px) {
    .stats-bar {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .stats-bar {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .stat + .stat {
      padding-left: var(--space-6);
      border-left: 1px solid var(--border);
    }
  }

  .stat {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .stat svg {
    flex-shrink: 0;
    color: var(--primary);
  }

  .stat-value {
    margin: 0;
    color: var(--primary);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: var(--weight-display);
    line-height: 1.25;
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    margin: 0;
    color: var(--mute);
    font-size: var(--text-caption);
    line-height: 1.5;
  }

  .publish-note {
    margin: var(--space-5) 0 0;
    color: var(--body);
    font-size: var(--text-body-sm);
  }

  .publish-note a {
    color: var(--primary);
    font-weight: var(--weight-medium);
  }

  /* --- why choose ----------------------------------------------------------------------- */
  .why-grid {
    gap: var(--space-4);
  }

  .why-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .why-icon {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--primary);
  }

  .why-card h3 {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: var(--weight-semibold);
    line-height: 1.3;
  }

  .why-card p {
    margin-top: var(--space-2);
    color: var(--body);
    font-size: var(--text-caption);
    line-height: 1.68;
  }

  /* --- values row ------------------------------------------------------------------------- */
  .values-row {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .values-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .values-row {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .value + .value {
      padding-left: var(--space-6);
      border-left: 1px solid var(--border);
    }
  }

  .value {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .value-icon,
  .value-img {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--primary);
  }

  .value-img {
    width: 30px;
    height: 30px;
    object-fit: contain;
  }

  .value h3 {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: var(--weight-semibold);
    line-height: 1.3;
  }

  .value p {
    margin-top: var(--space-2);
    color: var(--body);
    font-size: var(--text-caption);
    line-height: 1.68;
  }

  /* --- CTA band ------------------------------------------------------------------------------- */
  .cta-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    margin-top: var(--space-8);
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-md);
    background: var(--primary-surface);
  }

  .cta-copy {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
  }

  .cta-icon {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--primary);
  }

  .cta-copy h2 {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: var(--weight-display);
    line-height: 1.3;
  }

  .cta-copy p {
    margin-top: var(--space-1);
    color: var(--mute);
    font-size: var(--text-caption);
    line-height: 1.55;
  }

  .cta-band .btn {
    flex-shrink: 0;
  }
</style>
