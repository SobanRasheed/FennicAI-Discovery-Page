---
/**
 * /[subject]/ — legacy parallel route. The D1 subject hub now lives at
 * /subjects/[slug]/; this keeps old links working with a permanent redirect.
 */
export const prerender = false;

const subjectSlug = String(Astro.params.subject ?? '');
if (!subjectSlug) {
  return new Response('Not found', { status: 404 });
}

return Astro.redirect(`/subjects/${subjectSlug}/`, 301);
