---
/**
 * /[subject]/ (§5, §7, §16) — public subject hub: Subject → Topic →
 * Study Notes → Related Notes → MCQs. Server-rendered from D1 with
 * edge caching; links into article pages by subject/topic.
 */
import Layout from '../../layouts/Layout.astro';
import {
  getSubjectBySlug,
  listTopicsBySubject,
  listPublishedBySubject,
  getMediaById,
} from '../../utils/content';
import { env } from '../../utils/backend';

export const prerender = false;

const subjectSlug = String(Astro.params.subject ?? '');
const subject = await getSubjectBySlug(Astro.locals, subjectSlug);
if (!subject || !subject.is_active) {
  return new Response('Not found', { status: 404 });
}

const url = Astro.url;
const page = Math.max(1, Number(url.searchParams.get('page')) || 1);
const typeParam = url.searchParams.get('type');
const articleType = typeParam === 'study-note' || typeParam === 'article' ? typeParam : undefined;

const [topics, { rows: articles, total }, mcqCount, subjectImage] = await Promise.all([
  listTopicsBySubject(Astro.locals, subject.id),
  listPublishedBySubject(Astro.locals, subject.id, { articleType, page, perPage: 50 }),
  env(Astro.locals)
    .DB.prepare(`SELECT COUNT(*) AS n FROM mcqs WHERE subject_id = ? AND status = 'published'`)
    .bind(subject.id)
    .first<{ n: number }>(),
  subject.image_media_id ? getMediaById(Astro.locals, subject.image_media_id) : Promise.resolve(null),
]);

const totalPages = Math.max(1, Math.ceil(total / 50));
const title = subject.seo_title || `${subject.title} Study Notes & Guides`;
const description = subject.seo_description || subject.description || `${subject.title} study notes, guides, and practice questions.`;
const path = `/${subject.slug}/`;

Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=86400');

// Group cards by topic for the §7 hierarchy (topic → notes).
const byTopic = new Map<number | null, typeof articles>();
for (const a of articles) {
  const key = a.topic_id;
  if (!byTopic.has(key)) byTopic.set(key, []);
  byTopic.get(key)!.push(a);
}
const topicById = new Map(topics.map((t) => [t.id, t]));
const fmtDate = (d: string) => (d ? new Date(d + 'Z').toISOString().slice(0, 10) : '');
const pageLink = (p: number) => {
  const sp = new URLSearchParams(url.searchParams);
  sp.set('page', String(p));
  return `/${subject.slug}/?${sp.toString()}`;
};
---
<Layout title={`${title} | devsyllabus`} description={description} path={path}>
  <nav aria-label="Breadcrumb" class="breadcrumbs">
    <a href="/">Home</a> › <span>{subject.title}</span>
  </nav>

  <h1>{subject.title}</h1>
  {subjectImage && subjectImage.mime_type.startsWith('image/') && (
    <img src={`/media/${subjectImage.r2_key}`} alt={subjectImage.alt_text || subject.title} class="subject-image" />
  )}
  {subject.description && <p class="description">{subject.description}</p>}
  {subject.introduction && <div class="introduction" set:html={subject.introduction} />}

  <p class="counts">
    {total} published article{total === 1 ? '' : 's'}
    {mcqCount?.n ? <> · {mcqCount.n} practice question{mcqCount.n === 1 ? '' : 's'}</> : ''}
  </p>

  <div class="type-filter">
    <a href={`/${subject.slug}/`} class={!articleType ? 'active' : ''}>All</a>
    <a href={`/${subject.slug}/?type=study-note`} class={articleType === 'study-note' ? 'active' : ''}>Study notes</a>
    <a href={`/${subject.slug}/?type=article`} class={articleType === 'article' ? 'active' : ''}>Articles</a>
  </div>

  {topics.length > 0 && (
    <section aria-labelledby="topics-heading">
      <h2 id="topics-heading">Topics</h2>
      <ul class="topic-list">
        {topics
          .filter((t) => !t.parent_topic_id)
          .map((t) => (
            <li key={t.id}>
              <a id={t.slug} href={`#${t.slug}`}>{t.title}</a>
              {t.description && <span> — {t.description}</span>}
              {topics.some((c) => c.parent_topic_id === t.id) && (
                <ul>
                  {topics.filter((c) => c.parent_topic_id === t.id).map((c) => (
                    <li key={c.id}><a href={`#${c.slug}`}>{c.title}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
      </ul>
    </section>
  )}

  <section aria-labelledby="notes-heading">
    <h2 id="notes-heading">{articleType === 'study-note' ? 'Study notes' : articleType === 'article' ? 'Articles' : 'Latest notes & articles'}</h2>

    {[...byTopic.entries()]
      .sort((a, b) => {
        const ta = a[0] ? topicById.get(a[0])?.sort_order ?? 9999 : -1;
        const tb = b[0] ? topicById.get(b[0])?.sort_order ?? 9999 : -1;
        return ta - tb;
      })
      .map(([topicId, list]) => {
        const topic = topicId ? topicById.get(topicId) : null;
        return (
          <div class="topic-group">
            {topic && <h3 id={topic.slug}>{topic.title}</h3>}
            <ul class="article-list">
              {list.map((a) => (
                <li>
                  <a href={`/${a.subject_slug}/${a.slug}/`}>{a.title}</a>
                  {a.article_type === 'study-note' && <span class="type-tag">Study note</span>}
                  <span class="meta"> · {a.reading_minutes} min · {fmtDate(a.published_at)}</span>
                </li>
              ))}
            </ul>
          </div>
        );
      })}

    {articles.length === 0 && <p>No published content in this subject yet.</p>}
  </section>

  {totalPages > 1 && (
    <nav class="pagination" aria-label="Pagination">
      {page > 1 && <a href={pageLink(page - 1)}>← Previous</a>}
      <span>Page {page} of {totalPages}</span>
      {page < totalPages && <a href={pageLink(page + 1)}>Next →</a>}
    </nav>
  )}
</Layout>

<style>
  .breadcrumbs { font-size: 0.85rem; color: #666; margin-bottom: 1rem; }
  .description { color: #444; }
  .subject-image { max-width: 100%; height: auto; }
  .counts { color: #555; font-size: 0.9rem; }
  .type-filter { display: flex; gap: 0.75rem; margin: 1rem 0; font-size: 0.9rem; }
  .type-filter .active { font-weight: 700; }
  .topic-list { padding-left: 1.25rem; }
  .topic-group h3 { margin-bottom: 0.25rem; }
  .article-list { padding-left: 1.25rem; }
  .article-list li { margin: 0.35rem 0; }
  .type-tag { display: inline-block; margin-left: 0.4rem; padding: 0.05rem 0.4rem; font-size: 0.75rem; background: #eef; border-radius: 3px; }
  .meta { color: #777; font-size: 0.85rem; }
  .pagination { display: flex; gap: 1rem; align-items: center; margin-top: 2rem; }
</style>
