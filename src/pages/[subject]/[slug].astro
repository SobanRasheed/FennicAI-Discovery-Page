---
/**
 * /[subject]/[slug]/ (§15, §16) — the public article / study-note page.
 * Server-rendered from D1: breadcrumbs, byline, sanitized content, medical
 * blocks, MCQs (collapsible, no JS needed), references, related notes,
 * Article + BreadcrumbList structured data. Core content never depends on
 * client-side JS, and responses are cached at the edge.
 *
 * Rendered through the same three-region ArticleLayout shell as the static
 * study notes: TOC rail, reading column at the prose measure, sidebar.
 */
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ArticleHeader from '../../components/ArticleHeader.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import SidebarPanel from '../../components/SidebarPanel.astro';
import FactList from '../../components/FactList.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import ReferenceList from '../../components/ReferenceList.astro';
import Icon from '../../components/Icon.astro';
import { jsonForScript } from '../../utils/json-script';
import {
  getPublishedArticle,
  getArticleExtras,
  getMcqsForArticle,
  listTopicsBySubject,
} from '../../utils/content';

export const prerender = false;

const subjectSlug = String(Astro.params.subject ?? '');
const slug = String(Astro.params.slug ?? '');

const article = await getPublishedArticle(Astro.locals, subjectSlug, slug);
if (!article) {
  return new Response('Not found', { status: 404 });
}

const [extras, mcqs, topics] = await Promise.all([
  getArticleExtras(Astro.locals, article.id),
  getMcqsForArticle(Astro.locals, article.id, true),
  listTopicsBySubject(Astro.locals, article.subject_id),
]);

const topic = article.topic_id ? topics.find((t) => t.id === article.topic_id) : null;
const site = Astro.site!;
const publicPath = `/${article.subject_slug}/${article.slug}/`;
const canonical = article.canonical_url || new URL(publicPath, site).href;

// The stored HTML is sanitized on save; re-sanitize on output as defense in
// depth (§17: output sanitization).
const { sanitizeRichText } = await import('../../utils/richtext');
let contentHtml = sanitizeRichText(article.content_html ?? '');

/**
 * Stored headings carry no ids, so inject slug ids at render time and collect
 * them for the table of contents. The input here is our own sanitized HTML
 * with a known, small tag set, so a scan over the h2/h3 tags is safe.
 */
const slugify = (s: string) =>
  s
    .toLowerCase()
    .replace(/<[^>]+>/g, '')
    .replace(/&[a-z#0-9]+;/g, ' ')
    .replace(/[^a-z0-9\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-') || 'section';

const tocHeadings: { depth: 2 | 3; text: string; slug: string }[] = [];
const usedSlugs = new Set<string>();
contentHtml = contentHtml.replace(
  /<h([23])([^>]*)>([\s\S]*?)<\/h\1>/g,
  (_m, level: string, attrs: string, inner: string) => {
    const text = inner.replace(/<[^>]+>/g, '').trim();
    let id = slugify(inner);
    while (usedSlugs.has(id)) id = `${id}-x`;
    usedSlugs.add(id);
    tocHeadings.push({ depth: Number(level) as 2 | 3, text, slug: id });
    return `<h${level}${attrs} id="${id}">${inner}</h${level}>`;
  },
);
tocHeadings.push(
  ...(mcqs.length > 0 ? [{ depth: 2 as const, text: 'Practice questions', slug: 'practice-questions' }] : []),
  ...(extras.references.length > 0 ? [{ depth: 2 as const, text: 'References', slug: 'references' }] : []),
);

const title = article.seo_title || article.title;
const description = article.meta_description || article.excerpt || '';
const noindex = !article.robots.startsWith('index');

const asDate = (d: string | null) => (d ? new Date(d + 'Z') : undefined);

const breadcrumbs = [
  { name: 'Home', url: new URL('/', site).href },
  { name: article.subject_title, url: new URL(`/${article.subject_slug}/`, site).href },
  ...(topic ? [{ name: topic.title, url: new URL(`/${article.subject_slug}/#${topic.slug}`, site).href }] : []),
  { name: article.title, url: canonical },
];

// Edge caching (§16): browsers get 5 min, Cloudflare revalidates daily.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=86400');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article', // or MedicalArticle? Keep Article for broad support.
  headline: article.title,
  description,
  mainEntityOfPage: canonical,
  datePublished: article.published_at ? new Date(article.published_at + 'Z').toISOString() : undefined,
  dateModified: article.updated_at ? new Date(article.updated_at + 'Z').toISOString() : undefined,
  author: article.author_name ? { '@type': 'Person', name: article.author_name } : undefined,
  articleSection: article.subject_title,
  ...(extras.references.length > 0 && {
    citation: extras.references.map((r) => ({
      '@type': 'CreativeWork',
      name: r.title,
      author: r.authors || undefined,
      datePublished: r.year || undefined,
      url: r.url || undefined,
    })),
  }),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: b.url,
  })),
};
---
<ArticleLayout
  title={`${title} | devsyllabus`}
  description={description}
  path={publicPath}
  noindex={noindex}
  publishedTime={asDate(article.published_at)}
  modifiedTime={asDate(article.updated_at)}
  crumbs={[
    { label: article.subject_title, href: `/${article.subject_slug}/` },
    ...(topic ? [{ label: topic.title }] : []),
    { label: article.title },
  ]}
  crumbSchema={false}
>
  <script type="application/ld+json" set:html={jsonForScript(jsonLd)} />
  <script type="application/ld+json" set:html={jsonForScript(breadcrumbLd)} />

  {/* --- left rail: table of contents plus page actions ----------------- */}
  <Fragment slot="rail">
    <TableOfContents headings={tocHeadings} />

    <div class="rail-actions">
      {extras.references.length > 0 && (
        <a class="rail-action" href="#references">
          <Icon name="file" size={15} />
          Jump to references
        </a>
      )}
      <a class="rail-action" href={`/${article.subject_slug}/`}>
        <Icon name="book" size={15} />
        All {article.subject_title} notes
      </a>
    </div>
  </Fragment>

  {/* --- reading column ------------------------------------------------- */}
  <ArticleHeader
    title={article.title}
    kicker={article.subject_title}
    kickerHref={`/${article.subject_slug}/`}
    standfirst={article.excerpt}
    published={asDate(article.published_at)}
    updated={asDate(article.updated_at)}
    readingMinutes={article.reading_minutes}
    author={article.author_name ?? undefined}
  />

  {article.article_type === 'study-note' && (
    <p class="type-line">
      <span class="tag">Study note</span>
    </p>
  )}

  <div class="prose article-body" set:html={contentHtml} />

  {mcqs.length > 0 && (
    <section class="article-section" aria-labelledby="practice-questions">
      <h2 id="practice-questions">Practice questions</h2>
      <p class="article-section-intro">
        {mcqs.length} question{mcqs.length === 1 ? '' : 's'} on this article, each
        with the full answer and an explanation.
      </p>
      {mcqs.map((m, i) => (
        <div class="mcq">
          <p class="mcq-question"><strong>Q{i + 1}.</strong> {m.question}</p>
          <ol class="mcq-options" type="A">
            {m.options.map((o) => (
              <li>{o.text}{o.is_correct === 1 && <span class="answer-mark" aria-label="(correct answer)">✓</span>}</li>
            ))}
          </ol>
          <details class="mcq-answer">
            <summary>Show answer &amp; explanation</summary>
            <p><strong>Answer:</strong> {m.options.filter((o) => o.is_correct === 1).map((o) => o.label).join(', ')}</p>
            <p>{m.explanation}</p>
          </details>
        </div>
      ))}
    </section>
  )}

  <ReferenceList references={extras.references} />

  <RelatedContent
    items={extras.related.map((r) => ({
      href: `/${r.subject_slug}/${r.slug}/`,
      title: r.title,
      context: r.article_type === 'study-note' ? 'Study note' : undefined,
    }))}
    heading="Continue studying"
    moreHref={`/${article.subject_slug}/`}
    moreLabel={`All ${article.subject_title} notes`}
  />

  {extras.tags.length > 0 && (
    <p class="tags">
      {extras.tags.map((t) => <span class="tag">{t}</span>)}
    </p>
  )}

  {/* --- sidebar -------------------------------------------------------- */}
  <Fragment slot="sidebar">
    <SidebarPanel heading="Quick facts" icon="file" variant="tint">
      <FactList
        items={[
          `Subject: ${article.subject_title}`,
          ...(topic ? [`Topic: ${topic.title}`] : []),
          `${article.reading_minutes} min read`,
          `Type: ${article.article_type === 'study-note' ? 'Study note' : 'Article'}`,
          ...(article.author_name ? [`Author: ${article.author_name}`] : []),
        ]}
      />
    </SidebarPanel>

    {extras.related.length > 0 && (
      <SidebarPanel heading="Related notes" icon="book">
        <RelatedContent
          items={extras.related.map((r) => ({
            href: `/${r.subject_slug}/${r.slug}/`,
            title: r.title,
            context: r.article_type === 'study-note' ? 'Study note' : undefined,
          }))}
          variant="list"
          heading=""
          level={3}
          id="side-related"
        />
      </SidebarPanel>
    )}

    {topics.length > 0 && (
      <SidebarPanel heading="Topics in this subject" icon="layers">
        <ul class="chevron-list">
          {topics.filter((t) => !t.parent_topic_id).map((t) => (
            <li><a href={`/${article.subject_slug}/#${t.slug}`}>{t.title}</a></li>
          ))}
        </ul>
      </SidebarPanel>
    )}
  </Fragment>
</ArticleLayout>

<style>
  .rail-actions {
    display: none;
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }

  @media (min-width: 1024px) {
    .rail-actions {
      display: grid;
      gap: var(--space-1);
    }
  }

  .rail-action {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    color: var(--mute);
    font-size: var(--text-body-sm);
    line-height: var(--leading-snug);
    text-decoration: none;
  }

  .rail-action:hover {
    color: var(--primary);
  }

  .type-line {
    margin-top: var(--space-4);
  }

  .article-body {
    margin-top: var(--space-8);
  }

  /* --- practice questions --------------------------------------------- */
  .article-section {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .article-section > h2 {
    font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem);
  }

  .article-section-intro {
    margin-top: var(--space-3);
    color: var(--mute);
    font-size: var(--text-body-sm);
  }

  .mcq + .mcq {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .mcq-question {
    margin: 0;
    color: var(--ink);
    font-size: var(--text-prose);
    line-height: var(--leading-prose);
  }

  .mcq-options {
    margin: var(--space-3) 0 0;
    padding-left: 1.5rem;
    color: var(--body);
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
  }

  .mcq-options li + li {
    margin-top: var(--space-1);
  }

  .answer-mark {
    margin-left: var(--space-2);
    color: var(--success);
    font-weight: var(--weight-bold);
  }

  .mcq-answer {
    margin-top: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface-sunken);
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
  }

  .mcq-answer summary {
    color: var(--primary);
    font-weight: var(--weight-medium);
    cursor: pointer;
  }

  .mcq-answer p {
    margin: var(--space-2) 0 0;
    color: var(--body);
  }

  /* --- tags ------------------------------------------------------------ */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-10);
  }
</style>
