---
/**
 * /[subject]/[slug]/ — legacy parallel route. Articles now live at /notes/[slug]/
 * (study notes) or /blog/[slug]/ (articles), so resolve the article's type
 * from D1 and redirect permanently; unpublished or unknown slugs 404.
 */
import { getPublishedArticle } from '../../utils/content';

export const prerender = false;

const subjectSlug = String(Astro.params.subject ?? '');
const slug = String(Astro.params.slug ?? '');
if (!subjectSlug || !slug) {
  return new Response('Not found', { status: 404 });
}

const article = await getPublishedArticle(Astro.locals, subjectSlug, slug);
if (!article) {
  return new Response('Not found', { status: 404 });
}

return Astro.redirect(
  article.article_type === 'study-note' ? `/notes/${slug}/` : `/blog/${slug}/`,
  301,
);
---
