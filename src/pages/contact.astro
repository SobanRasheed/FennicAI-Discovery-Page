---
/**
 * Contact. Follows the design: a band hero with the books illustration and
 * quote, a two-column body of "Send us a message" form beside a "Contact
 * information" card, and an FAQ band.
 *
 * The design's phone number, street address, social links, and map are
 * placeholders — none are real, so none are rendered. Email is the real
 * channel: the form's subject select routes the message to the right inbox,
 * and JavaScript assembles a mailto: link on submit (there is no form
 * backend). Without JavaScript the page falls back to plain email links.
 */
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import JsonLd from '../components/JsonLd.astro';
import { getCollection } from '../utils/collections';

const subjects = await getCollection('subjects');

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.data.title,
}));

const CORRECTIONS = 'corrections@devsyllabus.com';
const SUGGESTIONS = 'suggestions@devsyllabus.com';
const GENERAL = 'hello@devsyllabus.com';

/** Subject select → the inbox that owns that kind of message. */
const ROUTES: Record<string, { label: string; email: string }> = {
  correction: { label: 'Report a correction', email: CORRECTIONS },
  suggestion: { label: 'Suggest a topic', email: SUGGESTIONS },
  contribution: { label: 'Content contribution', email: SUGGESTIONS },
  general: { label: 'General question', email: GENERAL },
};

/** Hero feature cells — small icon + title + one-line sub, per the design. */
const features = [
  { icon: 'envelope', title: 'Quick Response', text: 'We aim to reply within a few days' },
  { icon: 'users', title: 'Student Focused', text: 'Your feedback shapes what we publish' },
  { icon: 'chat', title: 'Support & Guidance', text: 'Questions big or small are welcome' },
] as const;

/** Contact information tiles. The design's phone/address/socials tiles are
    placeholders, so the tiles list the real inboxes plus the response time. */
const channels = [
  {
    icon: 'envelope',
    title: 'Email Us',
    text: GENERAL,
    href: `mailto:${GENERAL}`,
  },
  {
    icon: 'alert',
    title: 'Corrections',
    text: CORRECTIONS,
    href: `mailto:${CORRECTIONS}`,
  },
  {
    icon: 'bulb',
    title: 'Suggestions',
    text: SUGGESTIONS,
    href: `mailto:${SUGGESTIONS}`,
  },
  {
    icon: 'clock',
    title: 'Response Time',
    text: 'A few days — corrections first',
  },
] as const;

const contactFaqs = [
  {
    question: 'How quickly will I get a response?',
    answer:
      'We read every message and aim to reply within a few days. Correction reports are prioritised, since accuracy issues affect every reader until they are fixed.',
  },
  {
    question: 'Can I suggest a topic for a study note or article?',
    answer:
      'Yes — suggestions are exactly what the suggestions inbox is for. Tell us the subject, the topic, and what you are trying to learn from it, and we will consider it for the publishing queue.',
  },
];

const siteHref = Astro.site?.href ?? '';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Medical Study Notes',
  url: new URL('/contact/', Astro.site).href,
  mainEntity: {
    '@type': 'Organization',
    name: 'Medical Study Notes',
    url: siteHref,
    email: GENERAL,
  },
  isPartOf: { '@type': 'WebSite', name: 'Medical Study Notes', url: siteHref },
};
---
<Layout
  title="Contact Us — Corrections, Suggestions, and Questions | Medical Study Notes"
  description="Get in touch: report a correction, suggest a topic, contribute content, or ask a general question. Email is the fastest way to reach us."
  path="/contact/"
  footerSubjects={footerSubjects}
  wide
>
  <JsonLd data={contactSchema} />

  <PageHeader
    kicker="Contact Us"
    title="We'd Love to Hear from You"
    lead="Have a question, suggestion, or feedback? We're here to help. Reach out to us and our team will get back to you as soon as possible."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Contact' }]}
    tone="band"
    asideWide
  >
    <ul class="contact-features">
      {features.map((feature) => (
        <li>
          <Icon name={feature.icon} size={27} />
          <div>
            <strong>{feature.title}</strong>
            <span>{feature.text}</span>
          </div>
        </li>
      ))}
    </ul>

    <Fragment slot="aside">
      <div class="contact-hero-side">
        <img
          class="contact-hero-art"
          src="/assets/icons/blog-hero-books.png"
          alt="A stack of study books and notes"
          width="808"
          height="641"
          loading="eager"
          decoding="async"
        />

        <figure class="contact-quote">
          <span class="quote-mark" aria-hidden="true">“</span>
          <blockquote>
            <p>Good communication builds stronger learning communities.</p>
          </blockquote>
          <span class="quote-rule" aria-hidden="true"></span>
          <figcaption>A healthier tomorrow together</figcaption>
        </figure>
      </div>
    </Fragment>
  </PageHeader>

  <div class="container page-body">
    {/* --- form + contact information ----------------------------------------- */}
    <div class="contact-layout">
      <section class="panel panel-pad form-panel" aria-labelledby="send-a-message">
        <h2 id="send-a-message" class="panel-title">Send us a message</h2>
        <p class="panel-intro">
          Fill out the form below and we'll get back to you soon. The subject
          you pick decides which inbox your message goes to — your email app
          opens with everything pre-filled, and you just press send.
        </p>

        <noscript>
          <div class="notice notice-info">
            <p>
              The form needs JavaScript to assemble your message. You can email
              us directly instead:
              <a href={`mailto:${CORRECTIONS}`}>{CORRECTIONS}</a> for corrections,
              <a href={`mailto:${SUGGESTIONS}`}>{SUGGESTIONS}</a> for suggestions,
              or <a href={`mailto:${GENERAL}`}>{GENERAL}</a> for anything else.
            </p>
          </div>
        </noscript>

        <form class="contact-form" data-contact-form>
          <div class="field">
            <label class="label" for="cf-name">Your name <span aria-hidden="true">*</span></label>
            <input class="input" type="text" id="cf-name" name="name" placeholder="Enter your full name" autocomplete="name" required />
          </div>

          <div class="field">
            <label class="label" for="cf-email">Your email <span aria-hidden="true">*</span></label>
            <input class="input" type="email" id="cf-email" name="email" placeholder="Enter your email address" autocomplete="email" required />
          </div>

          <div class="field">
            <label class="label" for="cf-subject">Subject <span aria-hidden="true">*</span></label>
            <select class="input" id="cf-subject" name="route" required>
              {Object.entries(ROUTES).map(([value, route]) => (
                <option value={value}>{route.label}</option>
              ))}
            </select>
          </div>

          <div class="field">
            <label class="label" for="cf-message">Message <span aria-hidden="true">*</span></label>
            <textarea class="input" id="cf-message" name="message" placeholder="Write your message here..." rows="6" required></textarea>
          </div>

          <button class="btn btn-primary send-btn" type="submit">
            <Icon name="envelope" size={15} />
            Send Message
          </button>
          <p class="form-note" role="status" data-form-note></p>
        </form>
      </section>

      <aside class="panel panel-pad info-panel">
        <h2 class="panel-title">Contact information</h2>
        <p class="panel-intro">
          Email is the only channel we run — no phone lines, no offices, no
          ticket queues.
        </p>

        <ul class="channel-grid">
          {channels.map((channel) => (
            <li class="channel">
              <span class="channel-icon" aria-hidden="true"><Icon name={channel.icon} size={20} /></span>
              <div>
                <h3>{channel.title}</h3>
                {channel.href ? (
                  <a class="channel-mail" href={channel.href}>{channel.text}</a>
                ) : (
                  <p class="channel-text">{channel.text}</p>
                )}
              </div>
            </li>
          ))}
        </ul>

        <div class="channel-note">
          <p>
            Before writing, check the <a href="/faq/">FAQ</a> — the answer may
            already be there.
          </p>
        </div>
      </aside>
    </div>

    {/* --- FAQ --------------------------------------------------------------- */}
    <section class="section faq-section" aria-labelledby="contact-faqs">
      <div class="faq-band">
        <div class="section-head">
          <div>
            <h2 id="contact-faqs">Frequently Asked Questions</h2>
            <p>Find quick answers to common questions.</p>
          </div>
          <a class="link-arrow" href="/faq/">View all FAQs <Icon name="arrow-right" size={14} /></a>
        </div>
        <Faq faqs={contactFaqs} level={3} id="contact-faqs" heading="" schema={false} />
      </div>
    </section>
  </div>
  {/* Route map for the mailto script — the form's subject select keys. */}
  <script
    is:inline
    type="application/json"
    id="contact-routes"
    data-contact-routes
    set:html={JSON.stringify(Object.fromEntries(Object.entries(ROUTES).map(([k, v]) => [k, v.email])))}
  />
</Layout>

<script>
  // The form has no backend: on submit, assemble a mailto: URL from the
  // fields and hand the message to the visitor's email app.
  const ROUTES: Record<string, string> = JSON.parse(
    document.querySelector('[data-contact-routes]')?.textContent ?? '{}',
  );

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const note = document.querySelector<HTMLElement>('[data-form-note]');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    const data = new FormData(form);
    const to = ROUTES[String(data.get('route'))] ?? '';
    const name = String(data.get('name') ?? '').trim();
    const from = String(data.get('email') ?? '').trim();
    const body = String(data.get('message') ?? '').trim();

    if (!to || !from || !body) return;

    const subject = `[${name || 'Website'}] via Medical Study Notes contact form`;
    const message = `${body}\n\n— ${name} (${from})`;

    if (note) {
      note.textContent = 'Opening your email app…';
    }

    window.location.href = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(message)}`;
  });
</script>

<style>
  /* --- hero feature cells --------------------------------------------------- */
  .contact-features {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-6);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .contact-features li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .contact-features svg {
    flex-shrink: 0;
    color: var(--primary);
  }

  .contact-features strong {
    display: block;
    color: var(--primary);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: var(--weight-semibold);
    line-height: 1.3;
  }

  .contact-features span {
    display: block;
    color: var(--mute);
    font-size: var(--text-caption);
  }

  @media (min-width: 760px) {
    .contact-features li + li {
      padding-left: var(--space-6);
      border-left: 1px solid #d9e2d6;
    }
  }

  /* --- header aside: books illustration beside the quote panel --------------- */
  .contact-hero-side {
    display: grid;
    gap: var(--space-4);
    align-items: center;
  }

  @media (min-width: 640px) {
    .contact-hero-side {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    }
  }

  .contact-hero-art {
    width: 100%;
    aspect-ratio: 404 / 320;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .contact-quote {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: var(--space-6);
    border-radius: 6px;
    background: var(--quote-surface);
  }

  .quote-mark {
    color: var(--primary);
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: var(--weight-semibold);
    line-height: 0.5;
    margin-bottom: var(--space-4);
  }

  .contact-quote blockquote {
    margin: 0;
  }

  .contact-quote p {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-style: italic;
    font-weight: var(--weight-medium);
    line-height: 1.5;
    text-wrap: balance;
  }

  .quote-rule {
    width: 26px;
    height: 2px;
    margin: var(--space-5) 0 var(--space-3);
    background: var(--primary);
  }

  .contact-quote figcaption {
    color: var(--mute);
    font-family: var(--font-sans);
    font-size: 0.6563rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* --- page ------------------------------------------------------------------ */
  .page-body {
    padding-block: var(--space-12) var(--space-16);
  }

  /* --- form + info layout ------------------------------------------------------ */
  .contact-layout {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .contact-layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  .panel-title {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: var(--weight-display);
    line-height: 1.25;
  }

  .panel-intro {
    margin-top: var(--space-2);
    color: var(--body);
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
  }

  .contact-form {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .contact-form .field {
    display: grid;
    gap: var(--space-2);
  }

  .label {
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-medium);
  }

  .label [aria-hidden] {
    color: var(--primary);
  }

  .input {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    transition: border-color 0.15s var(--ease), box-shadow 0.15s var(--ease);
  }

  .input::placeholder {
    color: var(--faint);
  }

  .input:focus-visible {
    border-color: var(--primary);
    outline: 2px solid var(--focus-ring);
    outline-offset: 1px;
  }

  textarea.input {
    resize: vertical;
    min-height: 7rem;
  }

  .send-btn {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .form-note {
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
  }

  .notice {
    margin-bottom: var(--space-4);
  }

  /* --- contact information tiles --------------------------------------------------- */
  .channel-grid {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .channel-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .channel {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  .channel-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: var(--primary-surface);
    color: var(--primary);
  }

  .channel h3 {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    line-height: 1.3;
  }

  .channel-mail,
  .channel-text {
    display: block;
    margin-top: var(--space-1);
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    line-height: 1.5;
    word-break: break-all;
  }

  .channel-text {
    color: var(--body);
    font-family: var(--font-sans);
  }

  .channel-mail:hover {
    text-decoration: underline;
  }

  /* Tinted note in place of the design's map placeholder. */
  .channel-note {
    margin-top: var(--space-4);
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background: var(--primary-surface);
  }

  .channel-note p {
    color: var(--body);
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
  }

  .channel-note a {
    color: var(--primary);
    font-weight: var(--weight-medium);
  }

  /* --- FAQ band -------------------------------------------------------------------- */
  .faq-band {
    padding: var(--space-6) var(--space-6) var(--space-8);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--band);
  }

  .faq-band .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: 0;
  }

  /* The Faq block renders its own .section — flatten it inside the band. */
  .faq-band :global(.section) {
    padding-block: 0;
    border-top: 0;
  }

  .faq-band h2 {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: var(--weight-display);
    line-height: 1.25;
  }

  .faq-band .section-head p {
    margin-top: var(--space-1);
    color: var(--mute);
    font-size: var(--text-body-sm);
  }

  .faq-band .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--primary);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }

  .faq-band .link-arrow:hover {
    text-decoration: underline;
  }

  .faq-band :global(.faq-list) {
    margin-top: var(--space-6);
  }
</style>
