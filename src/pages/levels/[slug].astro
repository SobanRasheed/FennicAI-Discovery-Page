---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import NoteCard from '../../components/NoteCard.astro';
import { getCollection } from '../../utils/collections';
import { listLevelCounts, listPublishedArticles, listSubjects } from '../../utils/content';

export const prerender = false;

const slug = String(Astro.params.slug ?? '');
const levels = await getCollection('levels');
const level = levels.find((l) => l.slug === slug);
if (!level) {
  return new Response('Not found', { status: 404 });
}
const { data } = level;

const [noteRows, counts, subjectRows] = await Promise.all([
  listPublishedArticles(Astro.locals, {
    articleType: 'study-note',
    level: level.slug,
    perPage: 100,
  }),
  listLevelCounts(Astro.locals),
  listSubjects(Astro.locals),
]);

// Edge caching: browsers get 5 min, Cloudflare revalidates daily.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=86400');

const levelNotes = noteRows.rows.map((n) => ({
  slug: n.slug,
  title: n.title,
  description: n.excerpt,
  subject: n.subject_slug,
  subjectLabel: n.subject_title,
  level: level.slug,
  levelLabel: data.title,
  updated: n.updated_at,
  image: n.media_key ? { src: `/media/${n.media_key}/`, alt: n.media_alt } : null,
}));

// Subjects actually used by this level's notes, with their D1 descriptions.
const levelSubjects = [...new Map(levelNotes.map((n) => [n.subject, n])).values()]
  .map((s) => subjectRows.find((row) => row.slug === s))
  .filter((s): s is (typeof subjectRows)[number] => s !== undefined);

const mcqCount = counts.mcqs[level.slug] ?? 0;

const footerSubjects = subjectRows.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.title,
}));
---

<Layout
  title={`${data.title} Study Notes and Practice Questions | devsyllabus`}
  description={data.description}
  path={`/levels/${level.slug}/`}
  footerSubjects={footerSubjects}
>
  <Breadcrumbs crumbs={[{ label: 'Education Levels', href: '/levels/' }, { label: data.title }]} />

  <div class="doc">
  <h1>{data.title}</h1>
  <p class="overview">{data.introduction}</p>

  <section>
    <h2>Subjects at this level</h2>
    <ul>
      {levelSubjects.map((subject) => (
        <li>
          <a href={`/subjects/${subject.slug}/`}>{subject.title}</a>
          <span> — {subject.description}</span>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>All notes ({levelNotes.length})</h2>
    {levelNotes.length > 0 ? (
      levelNotes.map((note) => <NoteCard note={note} />)
    ) : (
      <p>Notes for this level are in progress.</p>
    )}
  </section>

  {mcqCount > 0 && (
    <section>
      <h2>Practice questions ({mcqCount})</h2>
      <p>
        <a href={`/practice/level/${level.slug}/`}>
          Practice this level's questions
        </a>{' '}
        — multiple choice with worked explanations.
      </p>
    </section>
  )}

  <Faq faqs={data.faqs} />
  </div>
</Layout>

<style>
  .overview {
    font-size: 1.1rem;
  }
</style>
