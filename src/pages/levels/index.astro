---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from '../../utils/collections';
import { listLevelCounts, listSubjects } from '../../utils/content';

export const prerender = false;

const [levels, counts, subjectRows] = await Promise.all([
  getCollection('levels'),
  listLevelCounts(Astro.locals),
  listSubjects(Astro.locals),
]);

// Edge caching: browsers get 5 min, Cloudflare revalidates daily.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=86400');

const kindLabels: Record<string, string> = {
  class: 'School class',
  course: 'University course',
  exam: 'Exam track',
};

/** Real counts only — a level with no published content says so. */
const levelSub = (slug: string) => {
  const notes = counts.notes[slug] ?? 0;
  const mcqs = counts.mcqs[slug] ?? 0;
  const parts = [
    notes > 0 ? `${notes} note${notes === 1 ? '' : 's'}` : null,
    mcqs > 0 ? `${mcqs} MCQ${mcqs === 1 ? 's' : ''}` : null,
  ].filter(Boolean);
  return parts.length > 0 ? parts.join(', ') : 'content in progress';
};

const footerSubjects = subjectRows.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.title,
}));
---

<Layout
  title="Education Levels — Classes, Courses, and Exams | devsyllabus"
  description="Browse devsyllabus study notes and practice questions by education level, from the First Professional MBBS to the Third Professional MBBS."
  path="/levels/"
  footerSubjects={footerSubjects}
>
  <Breadcrumbs crumbs={[{ label: 'Education Levels' }]} />

  <div class="doc">
  <h1>Education levels</h1>
  <p>
    Start from your class, course, or exam and follow the hierarchy down to
    subjects, chapters, and individual notes.
  </p>

  <ul>
    {levels.map((level) => (
      <li>
        <a href={`/levels/${level.slug}/`}>{level.data.title}</a>
        <span> — {kindLabels[level.data.kind]}, {levelSub(level.slug)}</span>
      </li>
    ))}
  </ul>
  </div>
</Layout>
