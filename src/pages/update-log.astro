---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { listPublishedArticles, listSubjects } from '../utils/content';

export const prerender = false;

const [noteRows, postRows, subjectRows] = await Promise.all([
  listPublishedArticles(Astro.locals, { articleType: 'study-note', perPage: 100 }),
  listPublishedArticles(Astro.locals, { articleType: 'article', perPage: 100 }),
  listSubjects(Astro.locals),
]);

// Edge caching: browsers get 5 min, Cloudflare revalidates daily.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=86400');

/** D1 timestamps are UTC without a zone suffix. */
const asDate = (s: string) => new Date(s + 'Z');
const fmt = (s: string) => asDate(s).toISOString().slice(0, 10);

// Every content item with an update history, newest first.
const updated = [
  ...noteRows.rows.map((note) => ({
    title: note.title,
    url: `/notes/${note.slug}/`,
    published: note.published_at,
    updated: note.updated_at,
  })),
  ...postRows.rows.map((post) => ({
    title: post.title,
    url: `/blog/${post.slug}/`,
    published: post.published_at,
    updated: post.updated_at,
  })),
].sort((a, b) => asDate(b.updated).valueOf() - asDate(a.updated).valueOf());

const footerSubjects = subjectRows.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.title,
}));
---

<Layout
  title="Update Log — Recently Updated Pages | devsyllabus"
  description="Every recently updated study note and article on devsyllabus, with the date each page was last revised."
  path="/update-log/"
  footerSubjects={footerSubjects}
>
  <Breadcrumbs crumbs={[{ label: 'Update Log' }]} />

  <div class="doc">
  <h1>Update log</h1>
  <p>
    Pages on devsyllabus are not publish-and-forget: they are revised when
    standards change or corrections land. This page lists every update,
    newest first.
  </p>

  <ul>
    {updated.map((item) => (
      <li>
        <a href={item.url}>{item.title}</a>
        <span> — updated {fmt(item.updated)} (published {fmt(item.published)})</span>
      </li>
    ))}
  </ul>
  </div>
</Layout>
