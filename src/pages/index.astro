---
import Layout from '../layouts/Layout.astro';
import Search from '../components/Search.astro';
import ArticleCard from '../components/ArticleCard.astro';
import JsonLd from '../components/JsonLd.astro';
import Illustration, { illustrationForSubject, type IllustrationName } from '../components/Illustration.astro';
import { listSubjectsWithCounts, listPublishedArticles } from '../utils/content';

export const prerender = false;

const [subjectRows, noteRows, postRows] = await Promise.all([
  listSubjectsWithCounts(Astro.locals),
  listPublishedArticles(Astro.locals, { articleType: 'study-note', perPage: 12 }),
  listPublishedArticles(Astro.locals, { articleType: 'article', perPage: 3 }),
]);

// Edge caching: browsers get 5 min, Cloudflare revalidates daily.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=86400');

/** D1 timestamps are UTC without a zone suffix. */
const asDate = (s: string) => new Date(s + 'Z');

/** The grid holds the eight most note-dense subjects, as in the design. */
const homeSubjects = subjectRows
  .slice()
  .sort((a, b) => b.note_count - a.note_count || a.title.localeCompare(b.title))
  .slice(0, 8);

/** Popular rail: the notes touched most recently. */
const popularNotes = noteRows.rows
  .slice()
  .sort((a, b) => asDate(b.updated_at).valueOf() - asDate(a.updated_at).valueOf())
  .slice(0, 4);

const latestPosts = postRows.rows;

/** Subjects with a PNG icon in /assets/images/; the rest fall back to a drawing. */
const pngSubjects = new Set([
  'anatomy',
  'biochemistry',
  'community-medicine',
  'forensic-medicine',
  'microbiology',
  'pathology',
  'pharmacology',
  'physiology',
]);

const subjectIcon = (slug: string) =>
  pngSubjects.has(slug) ? `/assets/images/subject-${slug}.png` : undefined;

/** The card sub-line: real counts, never invented ones. */
const subjectSub = (noteCount: number, mcqCount: number) => {
  const parts = [
    noteCount > 0 ? `${noteCount} Study Notes` : null,
    mcqCount > 0 ? `${mcqCount} MCQs` : null,
  ].filter(Boolean);
  return parts.length > 0 ? parts.join(' · ') : 'Study subject';
};

/** Decorative line art for the article cards, keyed by category slug. */
const categoryArt: Record<string, IllustrationName> = {
  'study-techniques': 'open-book',
  'exam-preparation': 'stethoscope',
  'subject-guides': 'anatomy',
};
const artForCategory = (slug: string): IllustrationName =>
  categoryArt[slug] ?? 'open-book';

const footerSubjects = subjectRows.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.title,
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Medical Study Notes',
  url: Astro.site!.href,
  description:
    'Structured study notes, explanations, MCQs, and medical resources organised by subject.',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${Astro.site!.href}search/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};
---

<Layout
  title="Medical Study Notes — Study Notes, MCQs, and Revision Guides"
  description="Structured medical study notes, explanations, MCQs, and revision resources organised by subject. Free, referenced, and written for exam preparation."
  path="/"
  footerSubjects={footerSubjects}
  wide
>
  <JsonLd data={jsonLd} />

  {/* --- 1. Hero band ------------------------------------------------------ */}
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="hero-eyebrow">Medical education resource</p>
        <h1 class="hero-title">
          Study medicine<br /><span>with clarity.</span>
        </h1>
        <p class="hero-lead">
          Structured study notes, explanations, MCQs, and medical resources
          organized by subject.
        </p>

        <div class="hero-search">
          <Search
            variant="hero"
            id="hero-search"
            placeholder="Search anatomy, microbiology, pharmacology..."
          />
        </div>

        <a class="more-link hero-more" href="/subjects/">
          Browse all subjects
          <img src="/assets/icons/arrow-right.svg" alt="" width="15" height="15" />
        </a>
      </div>

      <img
        class="hero-art"
        src="/assets/images/hero-heart.png"
        alt=""
        width="394"
        height="382"
        decoding="async"
      />

      <aside class="hero-quote">
        <blockquote>
          <p>“Good medical knowledge improves lives.”</p>
        </blockquote>
        <span class="hero-quote-rule" aria-hidden="true"></span>
        <p class="hero-quote-attr">
          Study today<br />for a better tomorrow
        </p>
      </aside>
    </div>
  </section>

  <main class="container">
    {/* --- 2. Subjects ----------------------------------------------------- */}
    <section class="home-subjects" aria-labelledby="subjects-heading">
      <div class="section-head-row home-head">
        <div>
          <p class="eyebrow">Explore</p>
          <h2 id="subjects-heading">Explore medical subjects</h2>
          <p>Find study notes organized by subject.</p>
        </div>
        <a class="more-link" href="/subjects/">
          View all subjects
          <img src="/assets/icons/arrow-right.svg" alt="" width="15" height="15" />
        </a>
      </div>

      <div class="subject-grid">
        {homeSubjects.map((subject) => (
          <a class="subj-card" href={`/subjects/${subject.slug}/`}>
            <span class="subj-body">
              <span class="subj-art" aria-hidden="true">
                {subjectIcon(subject.slug) ? (
                  <img
                    src={subjectIcon(subject.slug)}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <Illustration name={illustrationForSubject(subject.slug)} size={34} />
                )}
              </span>
              <span class="subj-text">
                <span class="subj-title">{subject.title}</span>
                <span class="subj-sub">
                  {subjectSub(subject.note_count, subject.mcq_count)}
                </span>
              </span>
            </span>
            <img
              class="subj-chev"
              src="/assets/icons/chevron-right.svg"
              alt=""
              width="16"
              height="16"
            />
          </a>
        ))}
      </div>
    </section>

    {/* --- 3. Popular notes beside the latest articles --------------------- */}
    <section class="home-split" aria-label="Popular study notes and latest articles">
      <div class="split-col">
        <div class="section-head split-head">
          <div>
            <p class="eyebrow">Popular</p>
            <h2>Popular study notes</h2>
            <p>Most accessed and important topics for medical students.</p>
          </div>
        </div>

        <ul class="entry-list">
          {popularNotes.map((note) => (
            <li>
              <ArticleCard
                href={`/notes/${note.slug}/`}
                title={note.title}
                excerpt={note.excerpt}
                kicker={note.subject_title}
                date={asDate(note.updated_at)}
              />
            </li>
          ))}
        </ul>

        <a class="more-link split-more" href="/notes/">
          All study notes
          <img src="/assets/icons/arrow-right.svg" alt="" width="15" height="15" />
        </a>
      </div>

      <div class="split-col">
        <div class="section-head split-head">
          <div>
            <p class="eyebrow">Latest</p>
            <h2>Latest from Medical Study Notes</h2>
            <p>Educational articles, exam tips and medical resources.</p>
          </div>
          <a class="more-link split-link" href="/blog/">
            View all articles
            <img src="/assets/icons/arrow-right.svg" alt="" width="15" height="15" />
          </a>
        </div>

        <ul class="entry-list">
          {latestPosts.map((post) => (
            <li>
              <ArticleCard
                href={`/blog/${post.slug}/`}
                title={post.title}
                excerpt={post.excerpt}
                kicker={(post.category ?? 'article').replace(/-/g, ' ')}
                date={asDate(post.published_at)}
                readingMinutes={post.reading_minutes}
                image={post.media_key ? `/media/${post.media_key}/` : undefined}
                imageAlt={post.media_key ? post.media_alt ?? '' : ''}
                illustration={artForCategory(post.category ?? '')}
                variant="media"
              />
            </li>
          ))}
        </ul>

        <a class="more-link split-more" href="/blog/">
          All articles
          <img src="/assets/icons/arrow-right.svg" alt="" width="15" height="15" />
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* --- 1. hero band ------------------------------------------------------ */
  .hero {
    background: var(--band);
  }

  .hero-inner {
    display: grid;
    gap: var(--space-8);
    align-items: start;
    padding-block: 44px 48px;
  }

  .hero-copy {
    max-width: 620px;
  }

  .hero-eyebrow {
    margin: 0;
    color: var(--primary);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: var(--weight-bold);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .hero-title {
    margin-top: 18px;
    font-size: clamp(2.5rem, 1.4rem + 4vw, 3.6875rem);
    line-height: 1.1;
  }

  .hero-title span {
    color: var(--primary);
  }

  .hero-lead {
    max-width: 560px;
    margin-top: 22px;
    color: var(--mute);
    font-size: 1.125rem;
    line-height: 1.45;
  }

  .hero-search {
    margin-top: 26px;
  }

  .hero-more {
    margin-top: 14px;
  }

  .hero-art {
    display: none;
    width: 100%;
    border-radius: var(--radius-tag);
    object-fit: cover;
  }

  .hero-quote {
    display: none;
    flex-direction: column;
    align-items: flex-start;
    padding: 22px 20px 24px 22px;
    border-radius: 6px;
    background: var(--quote-surface);
  }

  .hero-quote p {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-style: italic;
    font-weight: var(--weight-medium);
    line-height: 1.48;
  }

  .hero-quote-rule {
    width: 26px;
    height: 2px;
    margin: 22px 0 14px;
    background: var(--primary);
  }

  .hero-quote-attr {
    color: var(--mute);
    font-family: var(--font-sans);
    font-size: 0.6563rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.1em;
    line-height: 1.7;
    text-transform: uppercase;
  }

  /* --- shared "more" link: green, semibold, real arrow glyph ------------- */
  .more-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--primary);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }

  .more-link img {
    display: block;
    transition: transform 0.15s var(--ease-out);
  }

  .more-link:hover {
    color: var(--primary-hover);
  }

  .more-link:hover img {
    transform: translateX(3px);
  }

  /* --- 2. subjects -------------------------------------------------------- */
  .home-subjects {
    padding-block: 26px 44px;
  }

  .home-head {
    align-items: flex-start;
    margin-bottom: 26px;
  }

  .home-head h2 {
    margin-top: 10px;
  }

  .subject-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px 16px;
  }

  @media (min-width: 640px) {
    .subject-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .subject-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .subj-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 90px;
    padding: var(--space-3) 24px var(--space-3) 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s var(--ease);
  }

  .subj-card:hover {
    border-color: var(--border-strong);
  }

  .subj-body {
    display: flex;
    align-items: center;
    gap: 17px;
    min-width: 0;
  }

  .subj-art {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    overflow: hidden;
    border-radius: 50%;
    background: var(--surface-sunken);
    color: var(--primary);
  }

  .subj-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .subj-text {
    min-width: 0;
  }

  .subj-title {
    display: block;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.0938rem;
    font-weight: var(--weight-display);
    line-height: 1.25;
    transition: color 0.15s var(--ease);
  }

  .subj-card:hover .subj-title {
    color: var(--primary);
  }

  .subj-sub {
    display: block;
    margin-top: 3px;
    color: var(--mute);
    font-size: var(--text-caption);
    line-height: 1.45;
  }

  .subj-chev {
    flex-shrink: 0;
    color: var(--faint);
  }

  /* --- 3. popular / latest split ------------------------------------------ */
  .home-split {
    display: grid;
    gap: var(--space-10);
    padding-block: 40px 64px;
  }

  @media (min-width: 1024px) {
    .home-split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 45px;
    }
  }

  .split-col {
    min-width: 0;
  }

  .split-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    margin-bottom: 12px;
  }

  .split-head h2 {
    margin-top: 10px;
  }

  .split-link {
    margin-top: 6px;
  }

  /* The design separates rows with hairlines between and after them, but not
     above the first row. */
  .home-split .entry-list {
    border-top: 0;
  }

  .split-more {
    margin-top: var(--space-5);
  }

  /* --- responsive hero: art appears beside the copy from 900px, the quote
         card joins at 1280px ---------------------------------------------- */
  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 340px);
      padding-block: 50px 53px;
    }

    .hero-art {
      display: block;
      aspect-ratio: 394 / 382;
    }
  }

  @media (min-width: 1280px) {
    .hero-inner {
      grid-template-columns: minmax(0, 620px) 394px 246px;
      gap: 32px;
    }

    .hero-art {
      max-width: 394px;
    }

    .hero-quote {
      display: flex;
      margin-top: 45px;
    }
  }
</style>
