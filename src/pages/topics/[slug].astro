---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import NoteCard from '../../components/NoteCard.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from '../../utils/collections';
import { listMcqCardsByTag, listPublishedByTag, listSubjects } from '../../utils/content';

export const prerender = false;

const slug = String(Astro.params.slug ?? '');
const topics = await getCollection('topics');
const topic = topics.find((t) => t.slug === slug);
if (!topic) {
  return new Response('Not found', { status: 404 });
}
const { data } = topic;

const [noteRows, postRows, questions, allSubjects] = await Promise.all([
  listPublishedByTag(Astro.locals, topic.slug, { articleType: 'study-note' }),
  listPublishedByTag(Astro.locals, topic.slug, { articleType: 'article' }),
  listMcqCardsByTag(Astro.locals, topic.slug),
  listSubjects(Astro.locals),
]);

// Edge caching: browsers get 5 min, Cloudflare revalidates daily.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=86400');

const notes = noteRows.map((n) => ({
  slug: n.slug,
  title: n.title,
  description: n.excerpt,
  subject: n.subject_slug,
  subjectLabel: n.subject_title,
  level: null,
  updated: n.updated_at,
  image: n.media_key ? { src: `/media/${n.media_key}/`, alt: n.media_alt } : null,
}));

const posts = postRows.map((p) => ({
  slug: p.slug,
  title: p.title,
  description: p.excerpt,
  category: p.category,
  published: p.published_at,
  updated: p.updated_at,
  image: p.media_key ? { src: `/media/${p.media_key}/`, alt: p.media_alt } : null,
}));

// Subjects whose notes carry this topic — for the hierarchy cross-links.
const topicSubjects = [...new Set(notes.map((n) => n.subject))]
  .map((s) => allSubjects.find((row) => row.slug === s))
  .filter((s): s is (typeof allSubjects)[number] => s !== undefined);

const relatedConcepts = topics.filter((t) => data.relatedConcepts.includes(t.slug));

const footerSubjects = allSubjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.title,
}));
---

<Layout
  title={`${data.title}: Notes, Articles, and Practice Questions | devsyllabus`}
  description={data.description}
  path={`/topics/${topic.slug}/`}
  footerSubjects={footerSubjects}
>
  <Breadcrumbs crumbs={[{ label: 'Topic Hubs', href: '/topics/' }, { label: data.title }]} />

  <div class="doc">
  <h1>{data.title}</h1>
  <p class="overview">{data.description}</p>

  <section>
    <h2>In plain language</h2>
    <p>{data.beginnerExplanation}</p>
  </section>

  {topicSubjects.length > 0 && (
    <section>
      <h2>Part of these subjects</h2>
      <ul>
        {topicSubjects.map((subject) => (
          <li><a href={`/subjects/${subject.slug}/`}>{subject.title}</a></li>
        ))}
      </ul>
    </section>
  )}

  {notes.length > 0 && (
    <section>
      <h2>Study notes</h2>
      {notes.map((note) => <NoteCard note={note} />)}
    </section>
  )}

  {posts.length > 0 && (
    <section>
      <h2>Articles</h2>
      {posts.map((post) => <PostCard post={post} />)}
    </section>
  )}

  {questions.length > 0 && (
    <section>
      <h2>Practice questions</h2>
      <ul>
        {questions.map((q) => (
          <li>
            <a href={`/practice/${q.slug}/`}>{q.question}</a>
            <span> (MCQ, {q.difficulty})</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {relatedConcepts.length > 0 && (
    <section>
      <h2>Related concepts</h2>
      <ul>
        {relatedConcepts.map((concept) => (
          <li><a href={`/topics/${concept.slug}/`}>{concept.data.title}</a></li>
        ))}
      </ul>
    </section>
  )}

  <Faq faqs={data.faqs} />
  </div>
</Layout>

<style>
  .overview {
    font-size: 1.1rem;
  }
</style>
