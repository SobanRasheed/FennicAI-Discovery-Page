---
/**
 * Quiz history (Figma "Screen 22 / Quiz History", node 302:2679). Every number
 * here is computed from the browser-local history the quiz runner records when
 * a quiz is finished — quizzes taken, average, best, questions answered,
 * per-subject averages, and achievements that are earned by actual activity,
 * never displayed as pre-unlocked badges.
 */
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatCards from '../../components/StatCards.astro';
import SidebarPanel from '../../components/SidebarPanel.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from '../../utils/collections';

const subjects = await getCollection('subjects');

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.data.title,
}));
---
<Layout
  title="Quiz History | Medical Study Notes"
  description="Your practice record: quiz results, scores by subject, and progress over time — kept in this browser."
  path="/dashboard/quiz-history/"
  noindex
  footerSubjects={footerSubjects}
  wide
>
  <PageHeader
    kicker="Quiz History"
    title="Your Quiz History"
    lead="Track your practice and see how you improve over time. Results are recorded in this browser each time you finish a quiz — no account, nothing sent to our servers."
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Dashboard', href: '/dashboard/' },
      { label: 'Quiz History' },
    ]}
  >
    <Fragment slot="aside">
      <aside class="quiz-chip">
        <span class="quiz-chip-icon" aria-hidden="true"><Icon name="clipboard-check" size={22} /></span>
        <span class="quiz-chip-text">
          <strong class="quiz-chip-value" data-chip-count>—</strong>
          <span class="quiz-chip-label">Quizzes taken</span>
        </span>
      </aside>
    </Fragment>
  </PageHeader>

  <div class="container page-body">
    <section class="section" aria-label="Quiz summary">
      <div data-quiz-stats>
        <StatCards
          stats={[
            { value: '—', label: 'Quizzes taken', icon: 'clipboard-check' },
            { value: '—', label: 'Average score', icon: 'target' },
            { value: '—', label: 'Best score', icon: 'star' },
            { value: '—', label: 'Questions answered', icon: 'chart' },
          ]}
        />
      </div>
    </section>

    <div class="history-layout">
      <section class="section" aria-labelledby="recent-title">
        <div class="section-head">
          <div>
            <h2 id="recent-title">Recent quizzes</h2>
            <p>Your latest attempts, newest first.</p>
          </div>
          <a class="link-arrow" href="/practice/">Practice more <Icon name="arrow-right" size={14} /></a>
        </div>

        <ul class="quiz-list" data-quiz-list></ul>

        <div class="empty-state panel panel-pad" data-quiz-empty hidden>
          <h3>No quizzes yet</h3>
          <p>Take a subject quiz and your results will be recorded here.</p>
          <a class="btn btn-primary" href="/practice/">Start practicing</a>
        </div>
      </section>

      <div class="history-rail">
        <div data-subject-panel hidden>
          <SidebarPanel heading="Performance by subject" icon="chart">
            <div class="subject-bars" data-subject-bars></div>
          </SidebarPanel>
        </div>

        <div data-achievements hidden>
          <SidebarPanel heading="Achievements" icon="star">
            <ul class="achievement-list" data-achievement-list></ul>
          </SidebarPanel>
        </div>

        <SidebarPanel variant="tint" heading="Study tip" icon="bulb">
          <p class="rail-copy">
            Retake quizzes after a week to measure long-term recall.
          </p>
        </SidebarPanel>

        <SidebarPanel heading="Where things live" icon="shield">
          <p class="rail-copy">
            Quiz history is stored only in this browser, capped at the most
            recent 50 attempts. Clearing site data clears it.
          </p>
          <ul class="chevron-list">
            <li><a href="/dashboard/">Your dashboard</a></li>
            <li><a href="/dashboard/saved/">Saved items</a></li>
          </ul>
        </SidebarPanel>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { readQuizHistory, fmtDate } from '../../scripts/local-data';

  const escape = (value: string) =>
    value.replace(/[&<>"']/g, (ch) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch]!,
    );

  const icon = (paths: string, size = 16) =>
    `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;
  const CLIPBOARD_CHECK =
    '<rect x="5" y="4.5" width="14" height="17" rx="2"/><path d="M9 4.5h6v3H9z"/><path d="M9 13.5l2.2 2.2 4-4.2"/>';
  const STAR = '<path d="M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.9-5.2-2.8-5.2 2.8 1-5.9L3.5 9.7l5.9-.8z"/>';
  const TARGET = '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5.5"/><circle cx="12" cy="12" r="2"/>';
  const CALENDAR =
    '<rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 10h17"/><path d="M8 3.5V6"/><path d="M16 3.5V6"/>';

  const history = readQuizHistory();

  // --- stats + hero chip ----------------------------------------------------
  const chip = document.querySelector<HTMLElement>('[data-chip-count]');
  if (chip) chip.textContent = String(history.length);

  const tiles = document.querySelectorAll<HTMLElement>('[data-quiz-stats] .stat-value');
  const answered = history.reduce((sum, r) => sum + r.total, 0);
  const avg = history.length
    ? Math.round(history.reduce((sum, r) => sum + r.pct, 0) / history.length)
    : null;

  const values = [
    String(history.length),
    history.length ? `${avg}%` : '—',
    history.length ? `${Math.max(...history.map((r) => r.pct))}%` : '—',
    String(answered),
  ];
  tiles.forEach((tile, i) => {
    tile.textContent = values[i] ?? '—';
  });

  // --- recent quizzes ----------------------------------------------------------
  const list = document.querySelector<HTMLUListElement>('[data-quiz-list]');
  const empty = document.querySelector<HTMLElement>('[data-quiz-empty]');

  if (list) {
    if (history.length === 0) {
      list.hidden = true;
      empty?.removeAttribute('hidden');
    } else {
      list.innerHTML = history
        .slice(0, 10)
        .map(
          (r) => `
          <li class="quiz-row panel">
            <span class="quiz-icon" aria-hidden="true">${icon(CLIPBOARD_CHECK, 18)}</span>
            <div class="quiz-text">
              <h3>${escape(r.subject)} MCQs</h3>
              <p class="quiz-meta">${escape(r.subject)} · ${fmtDate(r.date)} · ${r.correct}/${r.total} correct</p>
            </div>
            <div class="quiz-row-side">
              <span class="quiz-score">${r.pct}%</span>
              <a class="btn btn-sm btn-secondary" href="/practice/quiz/${encodeURIComponent(r.subjectSlug)}/">Retake</a>
            </div>
          </li>`,
        )
        .join('');
    }
  }

  // --- performance by subject (rail) ----------------------------------------------
  const bySubjectPanel = document.querySelector<HTMLElement>('[data-subject-panel]');
  const barsEl = document.querySelector<HTMLElement>('[data-subject-bars]');

  if (bySubjectPanel && barsEl && history.length > 0) {
    // Average per subject, most-practiced first.
    const groups = new Map<string, { subject: string; subjectSlug: string; total: number; sum: number }>();
    for (const r of history) {
      const entry = groups.get(r.subjectSlug) ?? {
        subject: r.subject,
        subjectSlug: r.subjectSlug,
        total: 0,
        sum: 0,
      };
      entry.total += 1;
      entry.sum += r.pct;
      groups.set(r.subjectSlug, entry);
    }
    const rows = [...groups.values()].sort((a, b) => b.total - a.total);

    barsEl.innerHTML = rows
      .map((row) => {
        const pct = Math.round(row.sum / row.total);
        return `
        <div class="subject-bar">
          <div class="subject-bar-head">
            <span class="subject-name">${escape(row.subject)}</span>
            <span class="subject-pct">${pct}%</span>
          </div>
          <div class="bar-track" role="img" aria-label="${escape(row.subject)}: ${pct}% average over ${row.total} attempt${row.total === 1 ? '' : 's'}">
            <div class="bar-fill" style="width: ${pct}%"></div>
          </div>
        </div>`;
      })
      .join('');

    bySubjectPanel.removeAttribute('hidden');
  }

  // --- achievements (rail) -----------------------------------------------------------
  const achievementsEl = document.querySelector<HTMLElement>('[data-achievements]');
  const achievementList = document.querySelector<HTMLUListElement>('[data-achievement-list]');

  if (achievementsEl && achievementList) {
    // Each achievement is only listed when the history actually earns it.
    const above80 = history.filter((r) => r.pct >= 80).length;
    const distinctDays = new Set(history.map((r) => r.date.slice(0, 10))).size;

    const earned: { icon: string; title: string; detail: string }[] = [];
    if (history.length > 0) {
      earned.push({ icon: STAR, title: 'First quiz completed', detail: 'Getting started' });
    }
    if (above80 > 0) {
      earned.push({
        icon: TARGET,
        title: 'Scored above 80%',
        detail: `${above80} quiz${above80 === 1 ? '' : 'zes'}`,
      });
    }
    if (distinctDays >= 3) {
      earned.push({
        icon: CALENDAR,
        title: 'Practiced on multiple days',
        detail: `${distinctDays} separate days`,
      });
    }

    if (earned.length > 0) {
      achievementList.innerHTML = earned
        .map(
          (a) => `
          <li class="achievement">
            <span class="achievement-icon" aria-hidden="true">${icon(a.icon)}</span>
            <div class="achievement-text">
              <h3>${escape(a.title)}</h3>
              <p>${escape(a.detail)}</p>
            </div>
          </li>`,
        )
        .join('');
      achievementsEl.removeAttribute('hidden');
    }
  }
</script>

<style>
  /* --- hero chip (Figma: tinted, clipboard icon + count + label) -------------- */
  .quiz-chip {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--quote-surface);
  }

  .quiz-chip-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--primary);
  }

  .quiz-chip-value {
    display: block;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 1.375rem;
    font-weight: var(--weight-semibold);
    line-height: 1.1;
  }

  .quiz-chip-label {
    display: block;
    margin-top: var(--space-1);
    color: var(--mute);
    font-size: var(--text-micro);
    line-height: var(--leading-snug);
  }

  .page-body {
    padding-block: var(--space-12) var(--space-16);
  }

  /* --- layout ------------------------------------------------------------------ */
  .history-layout {
    display: grid;
    gap: var(--space-10);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .history-layout {
      grid-template-columns: minmax(0, 1fr) 20rem;
    }
  }

  .history-rail {
    display: grid;
    gap: var(--space-5);
  }

  .rail-copy {
    color: var(--ink);
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
  }

  /* --- quiz rows (Figma: 68px rows, 36px tinted icon tile, score pill) -------- */
  .quiz-list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .quiz-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3);
    border-radius: var(--radius-lg);
  }

  .quiz-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: var(--quote-surface);
    color: var(--primary);
  }

  .quiz-text {
    min-width: 0;
    flex: 1;
  }

  .quiz-row h3 {
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  .quiz-meta {
    margin-top: var(--space-1);
    color: var(--mute);
    font-size: var(--text-caption);
  }

  .quiz-row-side {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .quiz-score {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3rem;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-tag);
    background: var(--quote-surface);
    color: var(--primary);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
  }

  /* --- performance by subject (Figma rail card: label, % right, 6px track) ----- */
  .subject-bars {
    display: grid;
    gap: var(--space-4);
  }

  .subject-bar-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .subject-name {
    color: var(--ink);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
  }

  .subject-pct {
    color: var(--primary);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
  }

  .bar-track {
    width: 100%;
    height: 6px;
    border-radius: 3px;
    background: var(--quote-surface);
    overflow: hidden;
  }

  .bar-fill {
    height: 100%;
    border-radius: 3px;
    background: var(--primary);
  }

  /* --- achievements (Figma rail card: 16px icon, 13px title, 11px detail) ------- */
  .achievement-list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .achievement {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .achievement-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    background: var(--primary-surface);
    color: var(--primary);
  }

  .achievement-text {
    min-width: 0;
  }

  .achievement h3 {
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .achievement p {
    margin-top: var(--space-1);
    color: var(--mute);
    font-size: var(--text-micro);
    line-height: var(--leading-snug);
  }

  /* --- empty state ------------------------------------------------------------------- */
  .empty-state[hidden] {
    display: none;
  }

  .empty-state h3 {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-body-lg);
    font-weight: var(--weight-semibold);
  }

  .empty-state p {
    margin: var(--space-2) 0 var(--space-4);
    color: var(--body);
    font-size: var(--text-body-sm);
  }
</style>
