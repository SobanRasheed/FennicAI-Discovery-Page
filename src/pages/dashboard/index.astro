---
/**
 * The student dashboard. The Figma screen assumes an account with server-side
 * progress tracking ("Ayesha", 72%-complete courses, a weekly-activity chart);
 * none of that exists, so this page is honest about what it is: a view of the
 * visitor's own activity stored in their browser — saved items and quiz
 * results — plus genuinely fresh content from the site. Stats render as
 * placeholders server-side and are filled in by the script.
 */
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatCards from '../../components/StatCards.astro';
import SidebarPanel from '../../components/SidebarPanel.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import Illustration, { illustrationForSubject } from '../../components/Illustration.astro';
import Icon from '../../components/Icon.astro';
import { getNotes, getBlogPosts, getCollection, isoDate } from '../../utils/collections';

const [notes, posts, subjects] = await Promise.all([
  getNotes(),
  getBlogPosts(),
  getCollection('subjects'),
]);

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.data.title,
}));

/** Reading time at 200 wpm, same rule as everywhere else. */
const minutes = (body: string | undefined) =>
  Math.max(1, Math.round((body ?? '').split(/\s+/).filter(Boolean).length / 200));

/** Freshest notes first — what "continue learning" honestly becomes. */
const freshNotes = [...notes]
  .sort((a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf())
  .slice(0, 3);

const freshPosts = posts.slice(0, 3);

/** Subjects with a PNG icon in /assets/landing/; the rest fall back to a drawing. */
const pngSubjects = new Set([
  'anatomy',
  'biochemistry',
  'community-medicine',
  'forensic-medicine',
  'microbiology',
  'pathology',
  'pharmacology',
  'physiology',
]);

const subjectIcon = (slug: string) =>
  pngSubjects.has(slug) ? `/assets/landing/subject-${slug}.png` : undefined;
---
<Layout
  title="Dashboard | Medical Study Notes"
  description="Your study activity: saved notes, quiz results, and the latest study material."
  path="/dashboard/"
  noindex
  footerSubjects={footerSubjects}
  wide
>
  <PageHeader
    kicker="Student Dashboard"
    title="Welcome back"
    lead="Your study activity — saved items and quiz results — lives in this browser. There's no account and nothing is tracked on our servers."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Dashboard' }]}
  >
    <Fragment slot="aside">
      <aside class="dash-chip">
        <span class="dash-chip-icon" aria-hidden="true"><Icon name="graduation-cap" size={28} /></span>
        <p class="dash-chip-label">Keep it up</p>
        <p class="dash-chip-body">
          Every note you save and quiz you take is counted here — from this browser alone.
        </p>
      </aside>
    </Fragment>
  </PageHeader>

  <div class="container page-body">
    {/* --- activity stats (filled in client-side) ------------------------- */}
    <section class="section" aria-label="Your activity">
      <div data-dash-stats>
        <StatCards
          stats={[
            { value: '—', label: 'Items saved', icon: 'bookmark' },
            { value: '—', label: 'Quizzes taken', icon: 'clipboard-check' },
            { value: '—', label: 'Average score', icon: 'target' },
            { value: '—', label: 'Best score', icon: 'star' },
          ]}
        />
      </div>
      <p class="stats-note">
        Counted from this browser's saved list and quiz history —
        <a href="/dashboard/saved/">see saved items</a> or
        <a href="/dashboard/quiz-history/">see quiz history</a>.
      </p>
    </section>

    <div class="dash-layout">
      {/* --- main column -------------------------------------------------- */}
      <div class="dash-main">
        <section class="section" aria-labelledby="fresh-notes">
          <div class="section-head">
            <div>
              <h2 id="fresh-notes">Keep learning</h2>
              <p>Pick up right where you left off — the most recently updated notes.</p>
            </div>
            <a class="link-arrow" href="/notes/">View all <Icon name="arrow-right" size={14} /></a>
          </div>

          <ul class="continue-list">
            {freshNotes.map((note) => (
              <li class="continue-item panel">
                <span class="continue-art" aria-hidden="true">
                  {subjectIcon(note.data.subject) ? (
                    <img src={subjectIcon(note.data.subject)} alt="" loading="lazy" decoding="async" />
                  ) : (
                    <Illustration name={illustrationForSubject(note.data.subject)} size={30} />
                  )}
                </span>
                <div class="continue-text">
                  <h3><a href={`/notes/${note.slug}/`}>{note.data.title}</a></h3>
                  <p class="continue-meta">
                    {subjects.find((s) => s.slug === note.data.subject)?.data.title}
                    · Updated {isoDate(note.data.updatedDate)}
                    · {minutes(note.body)} min read
                  </p>
                </div>
                <a class="btn btn-sm btn-primary continue-btn" href={`/notes/${note.slug}/`}>
                  Read
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section class="section" aria-labelledby="recent-quizzes">
          <div class="section-head">
            <div>
              <h2 id="recent-quizzes">Recent quiz results</h2>
              <p>Your latest MCQ attempts.</p>
            </div>
            <a class="link-arrow" href="/dashboard/quiz-history/">View all <Icon name="arrow-right" size={14} /></a>
          </div>

          <ul class="quiz-list" data-quiz-list></ul>

          <div class="empty-state panel panel-pad" data-quiz-empty hidden>
            <h3>No quizzes yet</h3>
            <p>Take a subject quiz and your results will show up here.</p>
            <a class="btn btn-primary" href="/practice/">Start practicing</a>
          </div>
        </section>
      </div>

      {/* --- rail ----------------------------------------------------------- */}
      <div class="dash-rail">
        <SidebarPanel heading="Recommended for You" icon="star">
          <RelatedContent
            items={freshPosts.map((post) => ({
              href: `/blog/${post.slug}/`,
              title: post.data.title,
              context: post.data.category.replace(/-/g, ' '),
            }))}
            variant="list"
            heading=""
            level={3}
            id="dash-posts"
          />
        </SidebarPanel>

        <figure class="dash-tip">
          <span class="dash-tip-icon" aria-hidden="true"><Icon name="bulb" size={30} /></span>
          <blockquote>
            <p>Consistency beats intensity. A little every day grows into mastery.</p>
          </blockquote>
          <figcaption>Learn daily · Grow daily</figcaption>
        </figure>

        <SidebarPanel variant="tint" heading="Where things live" icon="shield">
          <p class="privacy-copy">
            Saved items and quiz results are stored only in this browser. Clearing
            site data clears them — there is no account to recover them from.
          </p>
          <ul class="chevron-list">
            <li><a href="/dashboard/saved/">Saved items</a></li>
            <li><a href="/dashboard/quiz-history/">Quiz history</a></li>
            <li><a href="/practice/">Practice questions</a></li>
          </ul>
        </SidebarPanel>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { readSaved, readQuizHistory, fmtDate } from '../../scripts/local-data';

  const escape = (value: string) =>
    value.replace(/[&<>"']/g, (ch) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch]!,
    );

  // --- stats ------------------------------------------------------------
  const saved = readSaved();
  const history = readQuizHistory();

  const tiles = document.querySelectorAll<HTMLElement>('[data-dash-stats] .stat-value');
  const avg = history.length
    ? Math.round(history.reduce((sum, r) => sum + r.pct, 0) / history.length)
    : null;

  const values = [
    String(saved.length),
    String(history.length),
    history.length ? `${avg}%` : '—',
    history.length ? `${Math.max(...history.map((r) => r.pct))}%` : '—',
  ];
  tiles.forEach((tile, i) => {
    tile.textContent = values[i] ?? '—';
  });

  // --- recent quizzes -----------------------------------------------------
  const list = document.querySelector<HTMLElement>('[data-quiz-list]');
  const empty = document.querySelector<HTMLElement>('[data-quiz-empty]');

  if (list) {
    const recent = history.slice(0, 3);
    if (recent.length === 0) {
      list.hidden = true;
      empty?.removeAttribute('hidden');
    } else {
      list.innerHTML = recent
        .map(
          (r) => `
          <li class="quiz-row panel">
            <span class="quiz-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="4.5" width="14" height="17" rx="2"/><path d="M9 4.5h6v3H9z"/><path d="M9 13.5l2.2 2.2 4-4.2"/></svg>
            </span>
            <div class="quiz-text">
              <h3>${escape(r.subject)} MCQs</h3>
              <p class="quiz-meta">${fmtDate(r.date)} · ${r.total} question${r.total === 1 ? '' : 's'} · ${r.correct}/${r.total} correct</p>
            </div>
            <div class="quiz-row-side">
              <span class="quiz-score">${r.pct}%</span>
              <a class="btn btn-sm btn-secondary" href="/practice/quiz/${encodeURIComponent(r.subjectSlug)}/">Retake</a>
            </div>
          </li>`,
        )
        .join('');
    }
  }
</script>

<style>
  /* --- hero chip ---------------------------------------------------------- */
  .dash-chip {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--quote-surface);
  }

  .dash-chip-icon {
    color: var(--primary);
  }

  .dash-chip-label {
    margin-top: var(--space-3);
    color: var(--primary);
    font-size: var(--text-micro);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .dash-chip-body {
    margin-top: var(--space-2);
    max-width: 24ch;
    color: var(--mute);
    font-size: var(--text-caption);
    line-height: var(--leading-normal);
  }

  .page-body {
    padding-block: var(--space-12) var(--space-16);
  }

  .stats-note {
    margin-top: var(--space-4);
    color: var(--mute);
    font-size: var(--text-body-sm);
  }

  /* --- layout ---------------------------------------------------------------- */
  .dash-layout {
    display: grid;
    gap: var(--space-10);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .dash-layout {
      grid-template-columns: minmax(0, 1fr) 20rem;
    }
  }

  .dash-rail {
    display: grid;
    gap: var(--space-5);
  }

  .privacy-copy {
    color: var(--ink);
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
  }

  /* --- keep learning ------------------------------------------------------------ */
  .continue-list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .continue-item {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3);
    border-radius: var(--radius-lg);
  }

  .continue-art {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    background: var(--quote-surface);
    color: var(--primary);
  }

  .continue-art img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .continue-text {
    min-width: 0;
    flex: 1;
  }

  .continue-item h3 {
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  .continue-item h3 a {
    color: inherit;
    text-decoration: none;
  }

  .continue-item h3 a:hover {
    color: var(--primary);
    text-decoration: underline;
  }

  .continue-meta {
    margin-top: var(--space-1);
    color: var(--mute);
    font-size: var(--text-caption);
  }

  .continue-btn {
    flex-shrink: 0;
  }

  /* --- quiz rows -------------------------------------------------------------------- */
  .quiz-list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .quiz-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3);
    border-radius: var(--radius-lg);
  }

  .quiz-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--quote-surface);
    color: var(--primary);
  }

  .quiz-text {
    min-width: 0;
    flex: 1;
  }

  .quiz-row h3 {
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  .quiz-meta {
    margin-top: var(--space-1);
    color: var(--mute);
    font-size: var(--text-caption);
  }

  .quiz-row-side {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .quiz-score {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3rem;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-tag);
    background: var(--quote-surface);
    color: var(--primary);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
  }

  .empty-state h3 {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-body-lg);
    font-weight: var(--weight-semibold);
  }

  .empty-state p {
    margin: var(--space-2) 0 var(--space-4);
    color: var(--body);
    font-size: var(--text-body-sm);
  }

  .empty-state[hidden] {
    display: none;
  }

  /* --- study tip card (rail) --------------------------------------------------------- */
  .dash-tip {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--quote-surface);
  }

  .dash-tip-icon {
    color: var(--primary);
  }

  .dash-tip blockquote {
    margin: var(--space-4) 0 0;
  }

  .dash-tip p {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-body-sm);
    font-style: italic;
    line-height: 1.55;
    text-wrap: balance;
  }

  .dash-tip figcaption {
    margin-top: var(--space-4);
    color: var(--primary);
    font-size: var(--text-micro);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
</style>
