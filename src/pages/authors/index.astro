---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getNotes, getBlogPosts } from '../../utils/collections';
import { getCollection } from '../../utils/collections';

const [authors, notes, posts] = await Promise.all([
  getCollection('authors'),
  getNotes(),
  getBlogPosts(),
]);

const authorsWithCounts = authors.map((author) => ({
  author,
  noteCount: notes.filter((n) => n.data.author === author.slug).length,
  postCount: posts.filter((p) => p.data.author === author.slug).length,
}));
---

<Layout
  title="Authors — Who Writes devsyllabus | devsyllabus"
  description="Meet the devsyllabus author team: backgrounds, expertise, and the notes and articles each author has published."
  path="/authors/"
>
  <Breadcrumbs crumbs={[{ label: 'Authors' }]} />

  <div class="doc">
  <h1>Authors</h1>
  <p>
    Every note and article on devsyllabus carries a named author, and
    technical content is reviewed before publication. See our
    <a href="/editorial-policy/">editorial policy</a> for how we write,
    review, and update material.
  </p>

  <ul>
    {authorsWithCounts.map(({ author, noteCount, postCount }) => (
      <li>
        <a href={`/authors/${author.slug}/`}>{author.data.title}</a>
        <span> — {author.data.role}, {noteCount} note{noteCount === 1 ? '' : 's'}, {postCount} article{postCount === 1 ? '' : 's'}</span>
      </li>
    ))}
  </ul>
  </div>
</Layout>
