---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from '../../utils/collections';
import { listAuthorCounts, listSubjects } from '../../utils/content';

export const prerender = false;

const [authors, counts, subjectRows] = await Promise.all([
  getCollection('authors'),
  listAuthorCounts(Astro.locals),
  listSubjects(Astro.locals),
]);

// Edge caching: browsers get 5 min, Cloudflare revalidates daily.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=86400');

const footerSubjects = subjectRows.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.title,
}));
---

<Layout
  title="Authors — Who Writes devsyllabus | devsyllabus"
  description="Meet the devsyllabus author team: backgrounds, expertise, and the notes and articles each author has published."
  path="/authors/"
  footerSubjects={footerSubjects}
>
  <Breadcrumbs crumbs={[{ label: 'Authors' }]} />

  <div class="doc">
  <h1>Authors</h1>
  <p>
    Every note and article on devsyllabus carries a named author, and
    technical content is reviewed before publication. See our
    <a href="/editorial-policy/">editorial policy</a> for how we write,
    review, and update material.
  </p>

  <ul>
    {authors.map((author) => {
      const c = counts[author.slug] ?? { notes: 0, articles: 0 };
      return (
        <li>
          <a href={`/authors/${author.slug}/`}>{author.data.title}</a>
          <span>
            {' '}— {author.data.role}, {c.notes} note{c.notes === 1 ? '' : 's'},{' '}
            {c.articles} article{c.articles === 1 ? '' : 's'}
          </span>
        </li>
      );
    })}
  </ul>
  </div>
</Layout>
