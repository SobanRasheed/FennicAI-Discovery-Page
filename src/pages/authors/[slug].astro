---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JsonLd from '../../components/JsonLd.astro';
import NoteCard from '../../components/NoteCard.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from '../../utils/collections';
import { listPublishedByAuthor, listSubjects } from '../../utils/content';

export const prerender = false;

const slug = String(Astro.params.slug ?? '');
const authors = await getCollection('authors');
const author = authors.find((a) => a.slug === slug);
if (!author) {
  return new Response('Not found', { status: 404 });
}
const { data } = author;

const [noteRows, postRows, subjectRows] = await Promise.all([
  listPublishedByAuthor(Astro.locals, author.slug, { articleType: 'study-note' }),
  listPublishedByAuthor(Astro.locals, author.slug, { articleType: 'article' }),
  listSubjects(Astro.locals),
]);

// Edge caching: browsers get 5 min, Cloudflare revalidates daily.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=86400');

const authorNotes = noteRows.map((n) => ({
  slug: n.slug,
  title: n.title,
  description: n.excerpt,
  subject: n.subject_slug,
  subjectLabel: n.subject_title,
  level: null,
  updated: n.updated_at,
  image: n.media_key ? { src: `/media/${n.media_key}/`, alt: n.media_alt } : null,
}));

const authorPosts = postRows.map((p) => ({
  slug: p.slug,
  title: p.title,
  description: p.excerpt,
  category: p.category,
  published: p.published_at,
  updated: p.updated_at,
  image: p.media_key ? { src: `/media/${p.media_key}/`, alt: p.media_alt } : null,
}));

const site = Astro.site!;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: data.title,
  jobTitle: data.role,
  description: data.bio,
  url: new URL(`/authors/${author.slug}/`, site).href,
  knowsAbout: data.expertise,
};

const footerSubjects = subjectRows.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.title,
}));
---

<Layout
  title={`${data.title} — ${data.role} | devsyllabus`}
  description={`${data.title}, ${data.role} at devsyllabus. ${data.bio.slice(0, 120)}`}
  path={`/authors/${author.slug}/`}
  footerSubjects={footerSubjects}
>
  <JsonLd data={personSchema} />

  <Breadcrumbs crumbs={[{ label: 'Authors', href: '/authors/' }, { label: data.title }]} />

  <div class="doc">
  <h1>{data.title}</h1>
  <p class="role">{data.role}</p>

  <p>{data.bio}</p>

  {data.expertise.length > 0 && (
    <section>
      <h2>Areas of expertise</h2>
      <ul>
        {data.expertise.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  )}

  {data.credentials.length > 0 && (
    <section>
      <h2>Credentials</h2>
      <ul>
        {data.credentials.map((credential) => <li>{credential}</li>)}
      </ul>
    </section>
  )}

  {authorNotes.length > 0 && (
    <section>
      <h2>Study notes ({authorNotes.length})</h2>
      {authorNotes.map((note) => <NoteCard note={note} />)}
    </section>
  )}

  {authorPosts.length > 0 && (
    <section>
      <h2>Articles ({authorPosts.length})</h2>
      {authorPosts.map((post) => <PostCard post={post} />)}
    </section>
  )}
  </div>
</Layout>

<style>
  .role {
    font-size: 1.05rem;
    color: #555;
  }
</style>
