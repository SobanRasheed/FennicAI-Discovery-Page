---
/**
 * Site search.
 *
 * Every indexed entry renders server-side as a real result row, so the page
 * is a browsable index without JavaScript. The client script then filters,
 * sorts and counts those rows in place — no JSON payload to rebuild markup
 * from, which keeps the thumbs (subject art, drawings) as real components.
 *
 * The form is still a genuine GET to /search/, so a shared /search/?q=...
 * URL reproduces the result.
 */
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import Illustration, { illustrationForSubject } from '../components/Illustration.astro';
import { getNotes, getBlogPosts, getQuestions, getCollection } from '../utils/collections';

const [notes, posts, questions, subjects, topics, levels] = await Promise.all([
  getNotes(),
  getBlogPosts(),
  getQuestions(),
  getCollection('subjects'),
  getCollection('topics'),
  getCollection('levels'),
]);

const subjectLabel = (slug: string) =>
  subjects.find((s) => s.slug === slug)?.data.title ?? slug;

/** The design abbreviates September as "Sep", but en-GB short gives "Sept". */
const fmt = (d: Date) =>
  d
    .toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
    .replace('Sept ', 'Sep ');

type Kind = 'note' | 'article' | 'mcq' | 'subject' | 'topic' | 'level';

interface Entry {
  title: string;
  url: string;
  excerpt: string;
  kind: Kind;
  label: string;
  keywords: string;
  /** Subject slug, for the subject filter and the row's thumb. */
  subject: string;
  /** Trailing meta line, e.g. "Microbiology · Updated 4 Sep 2026". */
  meta: string;
  /** Timestamp for the date sort; entries without a date sort last. */
  date: number;
}

const searchIndex: Entry[] = [
  ...notes.map((note) => ({
    title: note.data.title,
    url: `/notes/${note.slug}/`,
    excerpt: note.data.description,
    kind: 'note' as const,
    label: 'Study note',
    keywords:
      `${note.data.title} ${note.data.description} ${note.data.overview} ${note.data.summary} ${note.data.keyTerms.map((t) => t.term).join(' ')}`.toLowerCase(),
    subject: note.data.subject,
    meta: `${subjectLabel(note.data.subject)} · Updated ${fmt(note.data.updatedDate)}`,
    date: note.data.updatedDate.valueOf(),
  })),
  ...posts.map((post) => ({
    title: post.data.title,
    url: `/blog/${post.slug}/`,
    excerpt: post.data.description,
    kind: 'article' as const,
    label: 'Article',
    keywords: `${post.data.title} ${post.data.description} ${post.data.category}`.toLowerCase(),
    subject: '',
    meta: `${post.data.category} · ${fmt(post.data.publishedDate)}`,
    date: post.data.publishedDate.valueOf(),
  })),
  ...questions.map((q) => ({
    title: q.data.question,
    url: `/practice/${q.slug}/`,
    excerpt: q.data.explanation.slice(0, 180),
    kind: 'mcq' as const,
    label: q.data.type === 'mcq' ? 'MCQ' : 'Practice question',
    keywords: `${q.data.question} ${q.data.answer} ${q.data.explanation}`.toLowerCase(),
    subject: q.data.subject,
    meta: subjectLabel(q.data.subject),
    date: 0,
  })),
  ...subjects.map((subject) => ({
    title: `${subject.data.title} study notes`,
    url: `/subjects/${subject.slug}/`,
    excerpt: subject.data.description,
    kind: 'subject' as const,
    label: 'Subject',
    keywords:
      `${subject.data.title} ${subject.data.description} ${subject.data.chapters.map((c) => c.title).join(' ')}`.toLowerCase(),
    subject: subject.slug,
    meta: 'Subject hub',
    date: 0,
  })),
  ...topics.map((topic) => ({
    title: topic.data.title,
    url: `/topics/${topic.slug}/`,
    excerpt: topic.data.description,
    kind: 'topic' as const,
    label: 'Topic',
    keywords:
      `${topic.data.title} ${topic.data.description} ${topic.data.beginnerExplanation}`.toLowerCase(),
    subject: '',
    meta: 'Topic hub',
    date: 0,
  })),
  ...levels.map((level) => ({
    title: level.data.title,
    url: `/levels/${level.slug}/`,
    excerpt: level.data.description,
    kind: 'level' as const,
    label: 'Education level',
    keywords: `${level.data.title} ${level.data.description}`.toLowerCase(),
    subject: '',
    meta: 'Level overview',
    date: 0,
  })),
];

/** Content-type filters with real counts from the index. */
const filters = (['note', 'mcq', 'article', 'subject', 'topic'] as const).map((kind) => ({
  value: kind,
  label:
    {
      note: 'Study Notes',
      mcq: 'MCQs',
      article: 'Articles',
      subject: 'Subjects',
      topic: 'Topics',
    }[kind],
  count: searchIndex.filter((entry) => entry.kind === kind).length,
}));

/** Subjects with at least one indexed entry, for the subject filter. */
const filterSubjects = subjects.filter((subject) =>
  searchIndex.some((entry) => entry.subject === subject.slug),
);

/** Rail: subjects by how much material they have, with real counts. */
const railSubjects = subjects
  .map((subject) => ({
    subject,
    noteCount: notes.filter((n) => n.data.subject === subject.slug).length,
    mcqCount: questions.filter((q) => q.data.subject === subject.slug).length,
  }))
  .filter((row) => row.noteCount > 0 || row.mcqCount > 0)
  .sort((a, b) => b.noteCount - a.noteCount);

const railCounts = (noteCount: number, mcqCount: number) => {
  const parts = [
    noteCount > 0 ? `${noteCount} ${noteCount === 1 ? 'note' : 'notes'}` : null,
    mcqCount > 0 ? `${mcqCount} MCQs` : null,
  ].filter(Boolean);
  return parts.length > 0 ? parts.join(' · ') : 'Study subject';
};

/** Subjects with a PNG icon in /assets/landing/; the rest fall back to a drawing. */
const pngSubjects = new Set([
  'anatomy',
  'biochemistry',
  'community-medicine',
  'forensic-medicine',
  'microbiology',
  'pathology',
  'pharmacology',
  'physiology',
]);

const subjectIcon = (slug: string) =>
  pngSubjects.has(slug) ? `/assets/landing/subject-${slug}.png` : undefined;

/** The row thumb: subject art when the entry has a subject, a drawing otherwise. */
const thumbIllustration = (entry: Entry) =>
  entry.subject ? illustrationForSubject(entry.subject) : 'open-book';

const initialQuery = Astro.url.searchParams.get('q') ?? '';

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.data.title,
}));
---

<Layout
  title="Search — Study Notes, Articles, and MCQs | Medical Study Notes"
  description="Search every study note, article, topic hub, and practice question on Medical Study Notes from one place."
  path="/search/"
  footerSubjects={footerSubjects}
  noindex
  wide
>
  <PageHeader
    kicker="Search Results"
    title="Search Medical Study Notes"
    lead="Find study notes, MCQs, articles and more."
    crumbs={[{ href: '/', label: 'Home' }, { label: 'Search' }]}
    tone="band"
    asideWide
  >
    <form class="search-field" role="search" action="/search/" method="get">
      <label class="visually-hidden" for="search-input">Search Medical Study Notes</label>
      <span class="sf-icon" aria-hidden="true"><Icon name="search" size={18} /></span>
      <input
        id="search-input"
        type="search"
        name="q"
        value={initialQuery}
        placeholder="Search study notes, MCQs, articles…"
        autocomplete="off"
      />
      <button class="sf-clear" type="button" data-clear aria-label="Clear search" hidden>
        <Icon name="close" size={16} />
      </button>
      <button class="sf-submit" type="submit">Search</button>
    </form>

    <Fragment slot="aside">
      <div class="search-side">
        <img
          class="search-art"
          src="/assets/images/hero-heart.png"
          alt=""
          width="246"
          height="241"
          loading="lazy"
          decoding="async"
        />
        <figure class="search-quote">
          <blockquote>
            <p>In the fields of observation, chance favors only the prepared mind.</p>
          </blockquote>
          <span class="quote-rule" aria-hidden="true"></span>
          <figcaption>
            Louis Pasteur<br />French Microbiologist
          </figcaption>
        </figure>
      </div>
    </Fragment>
  </PageHeader>

  <div class="container results-wrap">
    <div class="results-layout">
      <aside class="results-filters" aria-label="Filter results">
        <h2 class="filters-title">
          <Icon name="filter" size={18} />
          Filter results
        </h2>

        <div class="filters-body">
          <p class="filters-label">Content type</p>
          <div class="kind-checks">
            <input type="checkbox" id="kind-all" value="all" checked />
            <label for="kind-all">All types ({searchIndex.length})</label>

            {filters.map((filter) => (
              <>
                <input type="checkbox" id={`kind-${filter.value}`} value={filter.value} />
                <label for={`kind-${filter.value}`}>
                  {filter.label} ({filter.count})
                </label>
              </>
            ))}
          </div>

          <div class="field">
            <label for="search-subject">Subject</label>
            <select id="search-subject">
              <option value="">All Subjects</option>
              {filterSubjects.map((subject) => (
                <option value={subject.slug}>{subject.data.title}</option>
              ))}
            </select>
          </div>

          <button class="btn btn-secondary filters-reset" id="search-reset" type="button">
            <Icon name="refresh" size={14} />
            Reset filters
          </button>
        </div>
      </aside>

      <div class="results-main">
        <div class="results-toolbar">
          <p class="results-count" data-status aria-live="polite"></p>
          <div class="field sort-field">
            <label for="search-sort">Sort by</label>
            <select id="search-sort">
              <option value="relevant">Most relevant</option>
              <option value="newest">Newest first</option>
              <option value="oldest">Oldest first</option>
              <option value="title">Title A–Z</option>
            </select>
          </div>
        </div>

        <ol class="result-list" data-results>
          {searchIndex.map((entry) => (
            <li
              data-kind={entry.kind}
              data-subject={entry.subject}
              data-keywords={entry.keywords}
              data-date={entry.date}
              data-title={entry.title.toLowerCase()}
            >
              <a class="result-row" href={entry.url}>
                <span class="row-thumb" aria-hidden="true">
                  {subjectIcon(entry.subject) ? (
                    <img src={subjectIcon(entry.subject)} alt="" loading="lazy" decoding="async" />
                  ) : (
                    <Illustration name={thumbIllustration(entry)} size={28} />
                  )}
                </span>
                <span class="row-main">
                  <span class="row-kicker">{entry.label}</span>
                  <span class="row-title">{entry.title}</span>
                  {entry.excerpt && <span class="row-desc">{entry.excerpt}</span>}
                  {entry.meta && <span class="row-meta">{entry.meta}</span>}
                </span>
                <span class="row-chev" aria-hidden="true">
                  <Icon name="chevron-right" size={16} />
                </span>
              </a>
            </li>
          ))}
        </ol>

        <div class="results-empty" data-empty hidden>
          <div class="empty-state">
            <h3>No matches</h3>
            <p>
              Try a shorter query or a different term, or browse
              <a href="/notes/">all study notes</a>,
              <a href="/subjects/">subjects</a>, or
              <a href="/practice/">practice questions</a>.
            </p>
          </div>
        </div>

        <noscript>
          <p class="nojs-note">
            Live filtering needs JavaScript — the complete index is listed above.
          </p>
        </noscript>
      </div>

      <aside class="results-rail" aria-label="Search links">
        <section class="rail-card">
          <h2 class="rail-heading">
            <Icon name="grid" size={18} />
            Related subjects
          </h2>
          <ul class="rail-subjects">
            {railSubjects.map(({ subject, noteCount, mcqCount }) => (
              <li>
                <a href={`/subjects/${subject.slug}/`}>
                  <span class="rail-art" aria-hidden="true">
                    {subjectIcon(subject.slug) ? (
                      <img src={subjectIcon(subject.slug)} alt="" loading="lazy" decoding="async" />
                    ) : (
                      <Illustration name={illustrationForSubject(subject.slug)} size={22} />
                    )}
                  </span>
                  <span class="rail-names">
                    <span class="rail-name">{subject.data.title}</span>
                    <span class="rail-count">{railCounts(noteCount, mcqCount)}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          {/* The link-arrow class renders its own trailing arrow. */}
          <a class="link-arrow rail-all" href="/subjects/">View all subjects</a>
        </section>

        <section class="rail-card rail-card-tint">
          <h2 class="rail-heading">
            <Icon name="bulb" size={18} />
            Study tip
          </h2>
          <blockquote class="rail-quote">
            <p>“Review your notes regularly. Consistent revision improves long-term retention.”</p>
          </blockquote>
          <p class="rail-caps">
            Study smarter<br />Remember longer
          </p>
        </section>

        <section class="rail-card">
          <h2 class="rail-help-heading">
            <Icon name="search" size={18} />
            Can’t find what you’re looking for?
          </h2>
          <p class="rail-help">Try different keywords or browse our subjects.</p>
          <a class="btn btn-primary rail-help-btn" href="/subjects/">Browse all subjects</a>
        </section>
      </aside>
    </div>
  </div>
</Layout>

<script>
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-clear]');
  const form = document.querySelector<HTMLFormElement>('.search-field');
  const list = document.querySelector<HTMLElement>('[data-results]');
  const status = document.querySelector<HTMLElement>('[data-status]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const subjectSel = document.getElementById('search-subject') as HTMLSelectElement | null;
  const sortSel = document.getElementById('search-sort') as HTMLSelectElement | null;
  const allCheck = document.getElementById('kind-all') as HTMLInputElement | null;
  const kindChecks = Array.from(
    document.querySelectorAll<HTMLInputElement>('.kind-checks input[value]:not([value="all"])'),
  );

  if (input && list && status && empty) {
    const rows = Array.from(list.children) as HTMLElement[];

    /** Selected kinds; an empty selection or "All types" means no filter. */
    const activeKinds = () => {
      if (!allCheck || allCheck.checked) return null;
      const set = kindChecks.filter((c) => c.checked).map((c) => c.value);
      return set.length > 0 ? set : null;
    };

    function apply() {
      const query = input.value.trim().toLowerCase();
      const words = query ? query.split(/\s+/) : [];
      const subject = subjectSel?.value ?? '';
      const kinds = activeKinds();

      const matches = rows.filter((row) => {
        if (kinds && !kinds.includes(row.dataset.kind!)) return false;
        if (subject && row.dataset.subject !== subject) return false;
        const keywords = row.dataset.keywords ?? '';
        return words.every((word) => keywords.includes(word));
      });

      // The requested order, as a document order pass over the matched rows.
      const ordered = [...matches];
      const mode = sortSel?.value ?? 'relevant';
      if (mode === 'newest') ordered.sort((a, b) => Number(b.dataset.date) - Number(a.dataset.date));
      if (mode === 'oldest') ordered.sort((a, b) => Number(a.dataset.date) - Number(b.dataset.date));
      if (mode === 'title')
        ordered.sort((a, b) => (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '', 'en'));
      for (const row of ordered) list.appendChild(row);

      const noMatches = matches.length === 0 && words.length > 0;
      empty.hidden = !noMatches;
      list.hidden = noMatches;

      status.textContent = words.length
        ? `${matches.length} result${matches.length === 1 ? '' : 's'} for “${input.value.trim()}”`
        : `${matches.length} page${matches.length === 1 ? '' : 's'} indexed. Type to search.`;

      if (clearBtn) clearBtn.hidden = !input.value;
    }

    function reset() {
      input.value = '';
      if (subjectSel) subjectSel.value = '';
      if (allCheck) {
        allCheck.checked = true;
        for (const check of kindChecks) check.checked = false;
      }
      apply();
    }

    input.addEventListener('input', apply);
    subjectSel?.addEventListener('change', apply);
    sortSel?.addEventListener('change', apply);
    document.getElementById('search-reset')?.addEventListener('click', reset);

    clearBtn?.addEventListener('click', () => {
      input.value = '';
      apply();
      input.focus();
    });

    // "All types" and the individual kinds are mutually exclusive masters.
    allCheck?.addEventListener('change', () => {
      if (allCheck.checked) for (const check of kindChecks) check.checked = false;
      apply();
    });
    for (const check of kindChecks) {
      check.addEventListener('change', () => {
        if (check.checked && allCheck) allCheck.checked = false;
        apply();
      });
    }

    // Filter in place rather than reloading; the GET action stays as the
    // no-JS path and keeps ?q=... URLs shareable.
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      apply();
      const url = new URL(location.href);
      if (input.value.trim()) url.searchParams.set('q', input.value.trim());
      else url.searchParams.delete('q');
      history.replaceState(null, '', url);
    });

    // Support /search/?q=term URLs, used by the SearchAction schema and the
    // header form. The page is prerendered, so the server cannot see the
    // query string — it is read here, client-side.
    const initial = new URLSearchParams(location.search).get('q');
    if (initial && !input.value) input.value = initial;

    apply();
  }
</script>

<style>
  /* --- hero search field -------------------------------------------------- */
  .search-field {
    display: flex;
    align-items: stretch;
    margin-top: var(--space-6);
    max-width: 43.875rem; /* 702px, the field width from the design */
    height: 48px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    transition: border-color 0.15s var(--ease), box-shadow 0.15s var(--ease);
  }

  .search-field:focus-within {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 16%, transparent);
  }

  .sf-icon {
    display: inline-flex;
    align-items: center;
    padding-left: var(--space-4);
    color: var(--mute);
    pointer-events: none;
  }

  .search-field input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font-size: 0.8125rem;
    font-weight: var(--weight-semibold);
  }

  .search-field input:focus {
    outline: none;
  }

  .sf-clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    border: 0;
    background: none;
    color: var(--mute);
    cursor: pointer;
  }

  .sf-clear:hover {
    color: var(--ink);
  }

  .sf-submit {
    flex-shrink: 0;
    width: 7.9375rem;
    border: 0;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--primary);
    color: var(--on-primary);
    font-size: 0.875rem;
    font-weight: var(--weight-medium);
    cursor: pointer;
    transition: background-color 0.15s var(--ease);
  }

  .sf-submit:hover {
    background: var(--primary-strong, var(--primary));
    filter: brightness(1.08);
  }

  /* --- header aside: hero image beside the Pasteur quote ------------------ */
  .search-side {
    display: grid;
    gap: var(--space-4);
    align-items: start;
  }

  .search-art {
    display: none;
    width: 100%;
    aspect-ratio: 246 / 241;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .search-quote {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: var(--space-6);
    border-radius: var(--radius-md);
    background: var(--quote-surface);
  }

  .search-quote blockquote {
    margin: 0;
  }

  .search-quote p {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-style: italic;
    font-weight: var(--weight-medium);
    line-height: 1.55;
    text-wrap: balance;
  }

  .quote-rule {
    width: 26px;
    height: 2px;
    margin: var(--space-5) 0 var(--space-3);
    background: var(--primary);
  }

  .search-quote figcaption {
    color: var(--mute);
    font-family: var(--font-sans);
    font-size: 0.6563rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.14em;
    line-height: 1.7;
    text-transform: uppercase;
  }

  @media (min-width: 1024px) {
    .search-side {
      grid-template-columns: minmax(0, 1fr) minmax(0, 14.5rem);
      gap: var(--space-4);
    }

    .search-art {
      display: block;
    }
  }

  /* --- body layout --------------------------------------------------------- */
  .results-wrap {
    padding-block: var(--space-12) var(--space-16);
  }

  .results-layout {
    display: grid;
    gap: var(--space-8);
  }

  .results-main,
  .results-filters,
  .results-rail {
    min-width: 0;
  }

  /* Two columns first (filters + main, rail below), three from 1280. */
  @media (min-width: 1024px) {
    .results-layout {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: var(--space-10);
    }

    .results-rail {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4);
      align-items: start;
    }
  }

  @media (min-width: 1280px) {
    .results-layout {
      grid-template-columns: 15rem minmax(0, 1fr) 17.5rem;
    }

    .results-rail {
      grid-column: auto;
      grid-template-columns: none;
    }
  }

  /* --- filter sidebar ------------------------------------------------------ */
  .results-filters {
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--quote-surface);
    align-self: start;
  }

  .filters-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: var(--weight-semibold);
  }

  .filters-title svg {
    color: var(--primary);
  }

  .filters-body {
    margin-top: var(--space-4);
    display: grid;
    gap: var(--space-4);
  }

  .filters-body .field > label {
    font-size: 0.7813rem;
  }

  .filters-label {
    color: var(--ink);
    font-size: 0.7813rem;
    font-weight: var(--weight-medium);
  }

  /* Checkboxes on the tinted panel, as in the design. */
  .kind-checks {
    display: grid;
    gap: 0.5rem;
  }

  .kind-checks input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .kind-checks label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--ink);
    font-size: 0.8125rem;
    cursor: pointer;
  }

  .kind-checks label::before {
    content: '';
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    background: var(--surface);
    transition: background-color 0.15s var(--ease), border-color 0.15s var(--ease);
  }

  .kind-checks input:checked + label::before {
