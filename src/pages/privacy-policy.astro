---
import LegalLayout, { legalSectionId } from '../layouts/LegalLayout.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from '../utils/collections';

const subjects = await getCollection('subjects');
const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.data.title,
}));

/** Section headings drive both the body and the "On this page" rail. */
const sections = [
  { heading: '1. Introduction' },
  { heading: '2. Information We Collect' },
  { heading: '3. How We Use Your Information' },
  { heading: '4. Cookies and Tracking Technologies' },
  { heading: '5. Third-Party Services' },
  { heading: '6. Data Security' },
  { heading: '7. Your Rights' },
  { heading: "8. Children's Privacy" },
  { heading: '9. Changes to This Policy' },
  { heading: '10. Contact Us' },
];

const id = (n: number) => legalSectionId(sections[n - 1].heading);

const collected = [
  {
    title: 'Personal Information',
    body: 'Such as name, email address and information you provide.',
  },
  {
    title: 'Usage Information',
    body: 'Such as pages visited, time spent, device and browser type.',
  },
  {
    title: 'Content You Provide',
    body: 'Such as comments, questions or messages sent to us.',
  },
  {
    title: 'Account Information',
    body: 'Such as saved notes, quiz progress and preferences.',
  },
];

const uses = [
  'Provide and improve our website, content and services',
  'Personalize your learning experience',
  'Respond to your questions and support requests',
  'Analyze website usage and improve performance',
  'Send important updates (only if you have opted in)',
  'Ensure the security and integrity of our website',
];
---

<LegalLayout
  title="Privacy Policy | Medical Study Notes"
  heading="Privacy Policy"
  description="How Medical Study Notes collects, uses, and protects your information — what we store, which cookies we set, and the rights you have over your data."
  path="/privacy-policy/"
  kicker="Legal"
  standfirst="Your privacy matters to us. This policy explains how Medical Study Notes collects, uses, and protects your information."
  updated={new Date('2026-09-04')}
  readingTime="8 min read"
  {sections}
  heroQuote="Privacy is not an option, it is a fundamental right."
  heroQuoteAttribution="A safer learning tomorrow"
  quote="A trusted learning environment is built on transparency and respect for your privacy."
  contactPrompt="Contact us with any privacy questions."
  {footerSubjects}
>
  <section>
    <h2 id={id(1)}>{sections[0].heading}</h2>
    <p>
      Welcome to Medical Study Notes. We are committed to protecting your privacy
      and ensuring a safe and secure experience on our website. This policy
      covers the site and every study note, MCQ, and resource published on it.
    </p>
  </section>

  <section>
    <h2 id={id(2)}>{sections[1].heading}</h2>
    <p>We may collect the following types of information:</p>
    <div class="grid grid-2 collect-grid">
      {collected.map((item) => (
        <div class="panel panel-pad collect-card">
          <h3 class="collect-title">{item.title}</h3>
          <p class="collect-body">{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2 id={id(3)}>{sections[2].heading}</h2>
    <ul class="check-list">
      {uses.map((use) => (
        <li><Icon name="check" size={15} />{use}</li>
      ))}
    </ul>
  </section>

  <section>
    <h2 id={id(4)}>{sections[3].heading}</h2>
    <p>
      We use cookies and similar technologies to enhance browsing, analyze site
      traffic, and understand how content is used. You can clear or block
      cookies in your browser settings at any time; the site remains readable
      without them. Our <a href="/cookie-policy/">cookie policy</a> lists what
      each cookie does.
    </p>
  </section>

  <section>
    <h2 id={id(5)}>{sections[4].heading}</h2>
    <p>
      We may use third-party services for hosting, analytics, and email
      delivery. These providers process data only on our instructions, and we do
      not sell your personal information to anyone.
    </p>
  </section>

  <section>
    <h2 id={id(6)}>{sections[5].heading}</h2>
    <p>
      We use industry-standard encryption in transit and restrict access to
      stored data. No system is completely secure, so we also keep the data we
      hold to the minimum needed to run the site.
    </p>
  </section>

  <section>
    <h2 id={id(7)}>{sections[6].heading}</h2>
    <p>
      You may request a copy of your data, ask us to correct or delete it, or
      withdraw consent for optional emails. Write to{' '}
      <a href="mailto:support@medicalstudynotes.tech">support@medicalstudynotes.tech</a>{' '}
      and we will respond within 30 days.
    </p>
  </section>

  <section>
    <h2 id={id(8)}>{sections[7].heading}</h2>
    <p>
      Our content is written for medical students and professionals. We do not
      knowingly collect personal information from children under 13. If you
      believe a child has provided us with data, contact us and we will remove
      it.
    </p>
  </section>

  <section>
    <h2 id={id(9)}>{sections[8].heading}</h2>
    <p>
      We may update this policy as the site changes. The "last updated" date at
      the top of this page always reflects the current version, and material
      changes will be announced on the site.
    </p>
  </section>

  <section>
    <h2 id={id(10)}>{sections[9].heading}</h2>
    <p>
      Questions about this policy are welcome at{' '}
      <a href="mailto:support@medicalstudynotes.tech">support@medicalstudynotes.tech</a>{' '}
      or through our <a href="/contact/">contact page</a>. See also the{' '}
      <a href="/terms-of-use/">terms of use</a> and{' '}
      <a href="/disclaimer/">medical disclaimer</a>.
    </p>
  </section>
</LegalLayout>

<style>
  .collect-grid {
    margin-top: var(--space-4);
  }

  .collect-card {
    padding: var(--space-4);
  }

  .collect-title {
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
  }

  .collect-body {
    margin-top: var(--space-1);
    color: var(--mute);
    font-size: var(--text-body-sm);
  }

  /* A ticked list reads as a set of commitments rather than prose. */
  .check-list {
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .check-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    color: var(--body);
    font-size: var(--text-body-sm);
  }

  .check-list li + li {
    border-top: 1px solid var(--border);
  }

  .check-list svg {
    margin-top: 0.15em;
    color: var(--primary);
  }
</style>
