---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import QuestionList from '../../../components/QuestionList.astro';
import { getQuestions, getCollection } from '../../../utils/collections';

export async function getStaticPaths() {
  const [questions, levels] = await Promise.all([
    getQuestions(),
    getCollection('levels'),
  ]);
  return levels
    .filter((level) => questions.some((q) => q.data.level === level.slug))
    .map((level) => ({ params: { level: level.slug }, props: { level } }));
}

const { level } = Astro.props;
const [allQuestions, subjects] = await Promise.all([
  getQuestions(),
  getCollection('subjects'),
]);
const questions = allQuestions.filter((q) => q.data.level === level.slug);

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.data.title,
}));
---

<Layout
  title={`${level.data.title} Practice Questions | Medical Study Notes`}
  description={`Practice questions for ${level.data.title} with full answers and explanations, matched to the syllabus at this level.`}
  path={`/practice/level/${level.slug}/`}
  footerSubjects={footerSubjects}
  wide
>
  <PageHeader
    kicker="Education level"
    title={`${level.data.title} practice questions`}
    lead={`${questions.length} question${questions.length === 1 ? '' : 's'} matched to this level, each with a worked answer.`}
    crumbs={[
      { label: 'Practice', href: '/practice/' },
      { label: level.data.title },
    ]}
  >
    <p class="hub-link">
      Also see the
      <a href={`/levels/${level.slug}/`}>{level.data.title} study notes</a>.
    </p>
  </PageHeader>

  <div class="container page-body">
    <QuestionList {questions} />
  </div>
</Layout>

<style>
  .hub-link {
    margin-top: var(--space-4);
    color: var(--mute);
    font-size: var(--text-body-sm);
  }

  .page-body {
    padding-block: var(--space-8) var(--space-16);
  }
</style>
