---
/**
 * /practice/level/[level]/ — every published MCQ matched to one education
 * level (professional MBBS part). Server-rendered from D1 with edge caching;
 * the level titles come from the file-based levels collection, which stays
 * the taxonomy source.
 */
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import QuestionList from '../../../components/QuestionList.astro';
import { getCollection } from '../../../utils/collections';
import { listSubjects, listPublishedMcqs } from '../../../utils/content';

export const prerender = false;

const levelSlug = String(Astro.params.level ?? '');
const levels = await getCollection('levels');
const level = levels.find((l) => l.slug === levelSlug);
if (!level) {
  return new Response('Not found', { status: 404 });
}

const [questions, subjects] = await Promise.all([
  listPublishedMcqs(Astro.locals, { level: levelSlug }),
  listSubjects(Astro.locals),
]);

Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=86400');

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.title,
}));
---

<Layout
  title={`${level.data.title} Practice Questions | Medical Study Notes`}
  description={`Practice questions for ${level.data.title} with full answers and explanations, matched to the syllabus at this level.`}
  path={`/practice/level/${level.slug}/`}
  footerSubjects={footerSubjects}
  wide
>
  <PageHeader
    kicker="Education level"
    title={`${level.data.title} practice questions`}
    lead={`${questions.length} multiple choice question${questions.length === 1 ? '' : 's'} matched to this level, each with a worked answer.`}
    crumbs={[
      { label: 'Practice', href: '/practice/' },
      { label: level.data.title },
    ]}
  >
    <p class="hub-link">
      {level.data.description?.trim()}
    </p>
  </PageHeader>

  <div class="container page-body">
    <QuestionList {questions} />
  </div>
</Layout>

<style>
  .hub-link {
    margin-top: var(--space-4);
    color: var(--mute);
    font-size: var(--text-body-sm);
  }

  .page-body {
    padding-block: var(--space-8) var(--space-16);
  }
</style>
