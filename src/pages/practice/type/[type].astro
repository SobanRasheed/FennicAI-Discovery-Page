---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getQuestions } from '../../../utils/collections';

const typeLabels: Record<string, { label: string; description: string }> = {
  mcq: { label: 'Multiple Choice Questions', description: 'MCQs with four options and the reasoning behind each distractor.' },
  short: { label: 'Short Answer Questions', description: 'One- to three-line answers for definition and distinction questions.' },
  long: { label: 'Long Answer Questions', description: 'Full worked answers with the structure markers expect.' },
  numerical: { label: 'Numerical Problems', description: 'Problems with a number as the answer and the method behind it.' },
};

export async function getStaticPaths() {
  return Object.keys(typeLabels).map((type) => ({
    params: { type },
    props: { type },
  }));
}

const { type } = Astro.props;
const meta = typeLabels[type];
const questions = (await getQuestions()).filter((q) => q.data.type === type);
---

<Layout
  title={`${meta.label} Practice | devsyllabus`}
  description={`${meta.description} ${questions.length} questions across all subjects with full answers.`}
  path={`/practice/type/${type}/`}
>
  <Breadcrumbs
    crumbs={[
      { label: 'Practice', href: '/practice/' },
      { label: meta.label },
    ]}
  />

  <h1>{meta.label}</h1>
  <p>{meta.description}</p>

  <ul>
    {questions.map((q) => (
      <li>
        <a href={`/practice/${q.slug}/`}>{q.data.question}</a>
        <span> — {q.data.difficulty}</span>
      </li>
    ))}
  </ul>
</Layout>
