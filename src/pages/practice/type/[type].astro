---
/**
 * /practice/type/[type]/ — practice is MCQ-only: 'mcq' renders the full
 * question index from D1; the retired types (short / long / numerical)
 * redirect to the practice hub so old links keep working.
 */
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import QuestionList from '../../../components/QuestionList.astro';
import { listSubjects, listPublishedMcqs } from '../../../utils/content';

export const prerender = false;

const type = String(Astro.params.type ?? '');

if (type !== 'mcq') {
  // Short/long/numerical questions were retired when practice became
  // MCQ-only; their old URLs land on the practice hub.
  return Astro.redirect('/practice/', 301);
}

const [questions, subjects] = await Promise.all([
  listPublishedMcqs(Astro.locals),
  listSubjects(Astro.locals),
]);

Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=86400');

const meta = {
  label: 'Multiple Choice Questions',
  description: 'MCQs with four options and the reasoning behind each distractor.',
};

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.title,
}));
---

<Layout
  title={`${meta.label} | Medical Study Notes`}
  description={`${meta.description} ${questions.length} questions across all subjects with full answers.`}
  path={`/practice/type/${type}/`}
  footerSubjects={footerSubjects}
  wide
>
  <PageHeader
    kicker="Question type"
    title={meta.label}
    lead={meta.description}
    crumbs={[{ label: 'Practice', href: '/practice/' }, { label: meta.label }]}
    stats={[{ value: questions.length, label: 'Questions', icon: 'question' as const }]}
  />

  <div class="container page-body">
    <QuestionList {questions} />
  </div>
</Layout>

<style>
  .page-body {
    padding-block: var(--space-8) var(--space-16);
  }
</style>
