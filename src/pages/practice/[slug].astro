---
/**
 * /practice/[slug]/ — one published MCQ with its options, the answer, and a
 * worked explanation. Server-rendered from D1 with edge caching; these pages
 * are the crawlable surface for practice content (the interactive quiz is
 * noindex).
 */
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getCollection } from '../../utils/collections';
import {
  getPublishedMcqBySlug,
  listPublishedMcqs,
} from '../../utils/content';

export const prerender = false;

const slug = String(Astro.params.slug ?? '');
const mcq = await getPublishedMcqBySlug(Astro.locals, slug);
if (!mcq) {
  return new Response('Not found', { status: 404 });
}

const [related, levels] = await Promise.all([
  listPublishedMcqs(Astro.locals, { subjectSlug: mcq.subject_slug }),
  getCollection('levels'),
]);

Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=86400');

const level = levels.find((l) => l.slug === mcq.level);
const answerText = mcq.options.find((o) => o.is_correct === 1)?.text ?? '';

// The meta description leads with the question text so every practice
// page has a unique, search-relevant description.
const questionExcerpt =
  mcq.question.length > 110 ? `${mcq.question.slice(0, 107).trimEnd()}…` : mcq.question;

// The explanation is stored as plain text; paragraphs split on blank lines.
const explanationParagraphs = mcq.explanation
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);

const site = Astro.site!;

const quizSchema = {
  '@context': 'https://schema.org',
  '@type': 'Question',
  name: mcq.question,
  acceptedAnswer: {
    '@type': 'Answer',
    text: `${answerText} ${mcq.explanation}`,
  },
  ...(mcq.options.length > 0 && {
    suggestedAnswer: mcq.options.map((option) => ({ '@type': 'Answer', text: option.text })),
  }),
  about: { '@type': 'Thing', name: mcq.subject_title },
  eduQuestionType: 'Multiple choice',
};
---

<Layout
  title={`${mcq.question.slice(0, 70)} | Medical Study Notes Practice`}
  description={`${questionExcerpt} Multiple choice practice question with the full answer and explanation.`}
  path={`/practice/${mcq.slug}/`}
>
  <JsonLd data={quizSchema} />

  <Breadcrumbs
    crumbs={[
      { label: 'Practice', href: '/practice/' },
      { label: mcq.subject_title, href: `/practice/subject/${mcq.subject_slug}/` },
      { label: 'Question' },
    ]}
  />

  <article class="doc question-doc">
    <h1>{mcq.question}</h1>

    <p class="meta question-meta">
      MCQ · {mcq.difficulty}
      {mcq.topic_title && <span> · {mcq.topic_title}</span>}
      {level && (
        <span>
          {' '}· <a href={`/practice/level/${level.slug}/`}>{level.data.title}</a>
        </span>
      )}
    </p>

    {mcq.options.length > 0 && (
      <section aria-labelledby="options">
        <h2 id="options">Options</h2>
        <ol class="q-options" type="A">
          {mcq.options.map((option) => (
            <li class={option.is_correct === 1 ? 'is-correct' : undefined}>{option.text}</li>
          ))}
        </ol>
      </section>
    )}

    <section class="q-answer" aria-labelledby="answer">
      <h2 id="answer">Answer</h2>
      <p class="q-answer-text">{answerText}</p>
    </section>

    {explanationParagraphs.length > 0 && (
      <section aria-labelledby="explanation">
        <h2 id="explanation">Explanation</h2>
        <div class="prose">
          {explanationParagraphs.map((p) => <p>{p}</p>)}
        </div>
      </section>
    )}

    {related.filter((q) => q.id !== mcq.id).length > 0 && (
      <section aria-labelledby="more-practice">
        <h2 id="more-practice">More practice on this subject</h2>
        <ul class="chevron-list q-related">
          {related.filter((q) => q.id !== mcq.id).slice(0, 5).map((q) => (
            <li><a href={`/practice/${q.slug}/`}>{q.question}</a></li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Layout>

<style>
  /* The question itself is long-form text, so the title reads slightly
     smaller than a page title. */
  .question-doc > h1 {
    font-size: clamp(1.375rem, 1.2rem + 0.9vw, 1.875rem);
  }

  .q-options {
    margin: var(--space-3) 0 0;
    padding-left: 1.75rem;
    color: var(--body);
    font-size: var(--text-prose);
    line-height: var(--leading-normal);
  }

  .q-options li + li {
    margin-top: var(--space-2);
  }

  /* The correct answer is quietly marked so a returning reader can scan it. */
  .q-options .is-correct {
    color: var(--ink);
    font-weight: var(--weight-semibold);
  }

  /* The answer gets the summary treatment: a ruled panel the eye lands on. */
  .q-answer-text {
    margin-top: var(--space-3);
    padding: var(--space-3) var(--space-5);
    border: 1px solid var(--border);
    border-left: 3px solid var(--primary);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    background: var(--surface);
    color: var(--ink);
    font-size: var(--text-prose);
    line-height: var(--leading-prose);
  }

  .q-related {
    margin-top: var(--space-3);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .q-related a {
    padding-block: var(--space-3);
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
  }
</style>
