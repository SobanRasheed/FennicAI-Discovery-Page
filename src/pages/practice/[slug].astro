---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getQuestions } from '../../utils/collections';
import { render } from 'astro:content';
import { getCollection } from '../../utils/collections';

export async function getStaticPaths() {
  const questions = await getQuestions();
  return questions.map((question) => ({
    params: { slug: question.slug },
    props: { question },
  }));
}

const { question } = Astro.props;
const { data } = question;
const { Content: QuestionBody } = await render(question);

// The meta description leads with the question text so every practice
// page has a unique, search-relevant description.
const questionExcerpt =
  data.question.length > 110
    ? `${data.question.slice(0, 107).trimEnd()}…`
    : data.question;

const [subjects, levels] = await Promise.all([
  getCollection('subjects'),
  getCollection('levels'),
]);

const subject = subjects.find((s) => s.slug === data.subject);
const level = levels.find((l) => l.slug === data.level);

// Related: other questions on the same subject.
const related = (await getQuestions()).filter(
  (q) => q.slug !== question.slug && q.data.subject === data.subject,
);

const site = Astro.site!;

const quizSchema = {
  '@context': 'https://schema.org',
  '@type': 'Question',
  name: data.question,
  acceptedAnswer: {
    '@type': 'Answer',
    text: `${data.answer} ${data.explanation}`,
  },
  ...(data.options.length > 0 && {
    suggestedAnswer: data.options.map((option) => ({ '@type': 'Answer', text: option })),
  }),
  about: subject ? { '@type': 'Thing', name: subject.data.title } : undefined,
  eduQuestionType: data.type === 'mcq' ? 'Multiple choice' : 'Open question',
};
---

<Layout
  title={`${data.question.slice(0, 70)} | devsyllabus Practice`}
  description={`${questionExcerpt} ${data.type} practice question with the full answer and explanation.`}
  path={`/practice/${question.slug}/`}
  noindex={data.noindex}
>
  <JsonLd data={quizSchema} />

  <Breadcrumbs
    crumbs={[
      { label: 'Practice', href: '/practice/' },
      { label: subject?.data.title ?? data.subject, href: `/practice/subject/${data.subject}/` },
      { label: 'Question' },
    ]}
  />

  <article class="doc question-doc">
    <h1>{data.question}</h1>

    <p class="meta question-meta">
      {data.type.toUpperCase()} · {data.difficulty}
      {data.examTag && <span> · {data.examTag}</span>}
      {level && <span> · <a href={`/levels/${level.slug}/`}>{level.data.title}</a></span>}
    </p>

    {data.options.length > 0 && (
      <section aria-labelledby="options">
        <h2 id="options">Options</h2>
        <ol class="q-options" type="A">
          {data.options.map((option) => <li>{option}</li>)}
        </ol>
      </section>
    )}

    <section class="q-answer" aria-labelledby="answer">
      <h2 id="answer">Answer</h2>
      <p class="q-answer-text">{data.answer}</p>
    </section>

    <section aria-labelledby="explanation">
      <h2 id="explanation">Explanation</h2>
      <div class="prose"><QuestionBody /></div>
      <p>{data.explanation}</p>
    </section>

    {related.length > 0 && (
      <section aria-labelledby="more-practice">
        <h2 id="more-practice">More practice on this subject</h2>
        <ul class="chevron-list q-related">
          {related.slice(0, 5).map((q) => (
            <li><a href={`/practice/${q.slug}/`}>{q.data.question}</a></li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Layout>

<style>
  /* The question itself is long-form text, so the title reads slightly
     smaller than a page title. */
  .question-doc > h1 {
    font-size: clamp(1.375rem, 1.2rem + 0.9vw, 1.875rem);
  }

  .q-options {
    margin: var(--space-3) 0 0;
    padding-left: 1.75rem;
    color: var(--body);
    font-size: var(--text-prose);
    line-height: var(--leading-normal);
  }

  .q-options li + li {
    margin-top: var(--space-2);
  }

  /* The answer gets the summary treatment: a ruled panel the eye lands on. */
  .q-answer-text {
    margin-top: var(--space-3);
    padding: var(--space-3) var(--space-5);
    border: 1px solid var(--border);
    border-left: 3px solid var(--primary);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    background: var(--surface);
    color: var(--ink);
    font-size: var(--text-prose);
    line-height: var(--leading-prose);
  }

  .q-related {
    margin-top: var(--space-3);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .q-related a {
    padding-block: var(--space-3);
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
  }
</style>
