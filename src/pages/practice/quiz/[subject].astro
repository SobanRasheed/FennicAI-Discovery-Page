---
/**
 * Interactive quiz for one subject — Screen 08 (MCQ Quiz).
 *
 * Three columns as in the design: the topic nav card (subject header on the
 * tinted band + chapter list with per-chapter progress), the question card
 * (position + progress bar, subject/chapter tags, the question, lettered
 * options, Check Answer) with the answer card on its pale-green surface
 * below it, and a rail with the timer (with a real pause button), the
 * question navigation grid, a study tip, and links to the subject's other
 * questions.
 *
 * The questions ship with the page as JSON; the whole quiz — checking
 * answers, the timer, the navigation grid, the score ring, performance by
 * topic, and answer review — runs client-side on top of that data. This page
 * is a utility, so it is noindex: the per-question pages under /practice/
 * are the crawlable surface for this content.
 *
 * Without JavaScript the quiz cannot run, so the noscript block links to the
 * subject's practice listing where every question and answer is laid out.
 */
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';

import Icon from '../../../components/Icon.astro';
import Illustration, { illustrationForSubject } from '../../../components/Illustration.astro';
import {
  getSubjectBySlug,
  listSubjectsWithCounts,
  listPublishedMcqsWithOptions,
  listPublishedBySubject,
  listPublishedQuizForms,
} from '../../../utils/content';
import { jsonForScript } from '../../../utils/json-script';

export const prerender = false;

const subjectSlug = String(Astro.params.subject ?? '');
const subject = await getSubjectBySlug(Astro.locals, subjectSlug);
if (!subject || !subject.is_active) {
  return new Response('Not found', { status: 404 });
}

const [mcqs, subjects, subjectNotes, subjectFormQuizzes] = await Promise.all([
  listPublishedMcqsWithOptions(Astro.locals, subject.slug),
  listSubjectsWithCounts(Astro.locals),
  listPublishedBySubject(Astro.locals, subject.id, { articleType: 'study-note', perPage: 3 }),
  listPublishedQuizForms(Astro.locals, subject.id).catch(() => []),
]);

Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=86400');

/** Quiz questions: only MCQs with at least one option are playable. */
const questions = mcqs.filter((q) => q.options.length > 0);

const chapterTitle = (topicTitle: string | null) => topicTitle ?? 'General';

/** Which option is the answer: the flagged row, matched in display order. */
const answerIndexFor = (q: (typeof questions)[number]) => {
  const idx = q.options.findIndex((o) => o.is_correct === 1);
  if (idx >= 0) return idx;
  // Legacy fallback: a bare A–D letter label.
  const letter = q.options.findIndex((o) => /^[A-D]$/i.test(o.label.trim()));
  return letter;
};

const quizData = {
  subject: subject.title,
  subjectSlug: subject.slug,
  total: questions.length,
  questions: questions.map((q) => {
    const answer = q.options.find((o) => o.is_correct === 1)?.text ?? '';
    return {
      question: q.question,
      chapter: chapterTitle(q.topic_title),
      options: q.options.map((o) => o.text),
      answerIndex: answerIndexFor(q),
      answer,
      explanation: q.explanation,
      difficulty: q.difficulty,
      url: `/practice/${q.slug}/`,
    };
  }),
};

/** Topic nav: chapters in quiz order, with per-chapter counts. */
const sections = quizData.questions.reduce<{ chapter: string; count: number }[]>(
  (acc, q) => {
    const found = acc.find((s) => s.chapter === q.chapter);
    if (found) found.count += 1;
    else acc.push({ chapter: q.chapter, count: 1 });
    return acc;
  },
  [],
);

/** Other playable questions in this subject, for the rail. */
const relatedQuestions = quizData.questions.slice(0, 4);

/** Recommended notes: this subject's most recently published. */
const recommendedNotes = subjectNotes.rows;

/** Other subjects with MCQs, for "Keep going". */
const keepGoing = subjects.filter((s) => s.slug !== subject.slug && s.mcq_count > 0);

/** Subjects with a PNG icon in /assets/landing/; the rest fall back to a drawing. */
const pngSubjects = new Set([
  'anatomy',
  'biochemistry',
  'community-medicine',
  'forensic-medicine',
  'microbiology',
  'pathology',
  'pharmacology',
  'physiology',
]);

const subjectIcon = (slug: string) =>
  pngSubjects.has(slug) ? `/assets/landing/subject-${slug}.png` : undefined;

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.title,
}));

const quizDataJson = jsonForScript(quizData);
---

<Layout
  title={`${subject.title} MCQ Quiz — Interactive Practice | Medical Study Notes`}
  description={`Take a timed interactive ${subject.title} MCQ quiz: answer one question at a time, check each answer, and see your score and performance by topic.`}
  path={`/practice/quiz/${subject.slug}/`}
  footerSubjects={footerSubjects}
  noindex
  wide
>
  <Breadcrumbs
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'MCQs', href: '/practice/' },
      { label: subject.title, href: `/practice/subject/${subject.slug}/` },
      { label: 'Quiz' },
    ]}
  />

  <div class="container quiz-body">
    <div class="quiz-layout" id="quiz-root">
      {/* --- topic nav card ------------------------------------------------ */}
      <aside class="quiz-side" aria-label="Quiz topics" data-quiz-side>
        <header class="quiz-side-head">
          <span class="quiz-side-art" aria-hidden="true">
            {subjectIcon(subject.slug) ? (
              <img src={subjectIcon(subject.slug)} alt="" width="64" height="60" loading="lazy" decoding="async" />
            ) : (
              <Illustration name={illustrationForSubject(subject.slug)} size={32} />
            )}
          </span>
          <span class="quiz-side-meta">
            <span class="quiz-side-title">{subject.title} MCQs</span>
            <span class="quiz-side-sub">Interactive quiz</span>
            <span class="quiz-side-sub">
              {questions.length} question{questions.length === 1 ? '' : 's'}
            </span>
          </span>
        </header>

        <ol class="quiz-sections" data-quiz-sections>
          {sections.map((section, i) => (
            <li data-chapter={section.chapter}>
              <span class="quiz-section-name">{i + 1}. {section.chapter}</span>
              <span class="quiz-section-progress" data-quiz-ch-progress>
                0/{section.count}
              </span>
            </li>
          ))}
        </ol>
      </aside>

      {/* --- main column + rail --------------------------------------------- */}
      <div class="quiz-work">
        <div class="quiz-main">
          {/* --- quiz view ---------------------------------------------------- */}
          <section class="quiz-view" data-quiz-view>
            <div class="quiz-card">
              <header class="quiz-card-head">
                <p class="q-position" data-quiz-position aria-live="polite"></p>
                <div
                  class="q-progress"
                  role="progressbar"
                  aria-label="Quiz progress"
                  aria-valuemin="0"
                  aria-valuemax="100"
                  data-quiz-progress
                >
                  <span class="q-progress-fill" data-quiz-fill></span>
                </div>
                <p class="q-pct" data-quiz-pct>0%</p>
              </header>

              <div class="quiz-card-body" data-quiz-card></div>
            </div>

            <div class="answer-card" data-feedback hidden aria-live="polite"></div>

            <div class="quiz-pager">
              <button class="btn btn-secondary" type="button" data-quiz-prev>
                <Icon name="arrow-right" size={15} data-icon-flip />
                Previous question
              </button>
              <button class="btn btn-primary" type="button" data-quiz-next>
                Next question
              </button>
            </div>
          </section>

          {/* --- results view -------------------------------------------------- */}
          <section class="results-view" data-results-view hidden>
            {/* trophy + verdict, with the quote panel beside them when wide */}
            <div class="results-head">
              <img
                class="results-trophy"
                src="/assets/icons/trophy.png"
                alt=""
                width="228"
                height="193"
                decoding="async"
              />
              <div class="results-head-text">
                <p class="kicker">Quiz complete</p>
                <h1 class="results-title" data-results-heading>Great effort!</h1>
                <p class="results-sub" data-results-sub>
                  You’ve completed the {subject.title} MCQs.
                </p>
                <p class="results-motto">“Consistent practice leads to real progress.”</p>
              </div>
              <div class="results-quote-panel">
                <span class="quote-mark" aria-hidden="true">”</span>
                <p>“Success in medicine comes from preparation today.”</p>
                <span class="quote-rule" aria-hidden="true"></span>
                <p class="rail-caps">A brighter you<br />A healthier tomorrow</p>
              </div>
            </div>

            {/* score card: ring, counts, session details, actions */}
            <div class="results-card">
              <div class="results-score-grid">
                <div class="score-ring" data-score-ring>
                  <svg viewBox="0 0 120 120" aria-hidden="true">
                    <circle class="ring-track" cx="60" cy="60" r="54"></circle>
                    <circle class="ring-fill" cx="60" cy="60" r="54" data-ring-fill></circle>
                  </svg>
                  <div class="ring-center">
                    <span class="ring-score" data-ring-score>0/0</span>
                    <span class="ring-pct" data-ring-pct>0%</span>
                    <span class="ring-label">Correct</span>
                  </div>
                </div>

                <span class="score-divider" aria-hidden="true"></span>

                <ul class="score-counts">
                  <li>
                    <img src="/assets/icons/check-badge.svg" alt="" width="30" height="30" />
                    <span class="count-value" data-stat-correct>0</span>
                    <span class="count-name">Correct</span>
                  </li>
                  <li>
                    <img src="/assets/icons/count-badge-incorrect.svg" alt="" width="30" height="30" />
                    <span class="count-value" data-stat-incorrect>0</span>
                    <span class="count-name">Incorrect</span>
                  </li>
                  <li>
                    <img src="/assets/icons/count-badge-skipped.svg" alt="" width="30" height="30" />
                    <span class="count-value" data-stat-skipped>0</span>
                    <span class="count-name">Skipped</span>
                  </li>
                </ul>

                <span class="score-divider" aria-hidden="true"></span>

                <dl class="score-details">
                  <div class="detail-row">
                    <Icon name="clock" size={20} />
                    <dt>Time taken</dt>
                    <dd data-stat-time>—</dd>
                  </div>
                  <div class="detail-row">
                    <Icon name="file" size={20} />
                    <dt>Total questions</dt>
                    <dd data-stat-total>—</dd>
                  </div>
                  <div class="detail-row">
                    <img src="/assets/icons/bar-chart.svg" alt="" width="20" height="20" />
                    <dt>Difficulty level</dt>
                    <dd data-stat-difficulty>—</dd>
                  </div>
                </dl>
              </div>

              <div class="results-actions">
                <button class="btn btn-primary" type="button" data-results-retry>
                  <img
                    src="/assets/icons/circle-dash.svg"
                    alt=""
                    width="18"
                    height="18"
                    aria-hidden="true"
                  />
                  Try Again
                </button>
                <button class="btn btn-secondary" type="button" data-results-review>
                  <Icon name="list" size={18} />
                  Review Answers
                </button>
                <a class="btn btn-secondary" href={`/subjects/${subject.slug}/`}>
                  <Icon name="book-open" size={18} />
                  Study Related Notes
                </a>
                <button class="btn btn-secondary" type="button" data-results-share>
                  <Icon name="share" size={18} />
                  Share Result
                </button>
              </div>
            </div>

            {/* --- performance by topic ------------------------------------------ */}
            <section class="results-panel" aria-labelledby="perf-title">
              <div class="results-panel-head">
                <h2 id="perf-title">Performance by topic</h2>
                <p>See how you performed in each topic.</p>
              </div>
              <div class="table-wrap">
                <table class="results-table">
                  <thead>
                    <tr>
                      <th scope="col">Topic</th>
                      <th scope="col">Correct</th>
                      <th scope="col">Total</th>
                      <th scope="col">Accuracy</th>
                    </tr>
                  </thead>
                  <tbody data-perf-tbody></tbody>
                </table>
              </div>
            </section>

            {/* --- next steps ------------------------------------------------------ */}
            <section class="results-panel" aria-labelledby="next-steps">
              <div class="results-panel-head">
                <h2 id="next-steps">Next steps</h2>
                <p>Continue your learning journey.</p>
              </div>
              <div class="next-steps">
                <button class="step-row" type="button" data-results-retry>
                  <span class="step-icon" aria-hidden="true">
                    <img src="/assets/icons/play-circle.svg" alt="" width="20" height="20" />
                  </span>
                  <span class="step-body">
                    <span class="step-title">Try Again</span>
                    <span class="step-desc">Improve your score by taking this quiz again.</span>
                  </span>
                  <span class="step-chev" aria-hidden="true">
                    <Icon name="chevron-right" size={18} />
                  </span>
                </button>
                <a class="step-row" href={`/subjects/${subject.slug}/`}>
                  <span class="step-icon" aria-hidden="true">
                    <Icon name="book-open" size={20} />
                  </span>
                  <span class="step-body">
                    <span class="step-title">Study Notes</span>
                    <span class="step-desc">
                      Review related study notes to strengthen your concepts.
                    </span>
                  </span>
                  <span class="step-chev" aria-hidden="true">
                    <Icon name="chevron-right" size={18} />
                  </span>
                </a>
                <a class="step-row" href="/practice/">
                  <span class="step-icon" aria-hidden="true">
                    <Icon name="list" size={20} />
                  </span>
                  <span class="step-body">
                    <span class="step-title">Practice More</span>
                    <span class="step-desc">
                      Explore more MCQ sets from {subject.title}.
                    </span>
                  </span>
                  <span class="step-chev" aria-hidden="true">
                    <Icon name="chevron-right" size={18} />
                  </span>
                </a>
              </div>
            </section>

            {/* --- results rail panels --------------------------------------------- */}
            <aside class="results-rail">
              {keepGoing.length > 0 && (
                <div class="rail-card">
                  <p class="rail-heading">
                    <img src="/assets/icons/bar-chart.svg" alt="" width="24" height="24" />
                    Keep going!
                  </p>
                  <p class="rail-help">Practice more MCQs to strengthen your knowledge.</p>
                  <ul class="rail-rows">
                    {keepGoing.slice(0, 4).map((s) => (
                      <li>
                        <a href={`/practice/quiz/${s.slug}/`}>
                          {s.title} MCQs
                          <span class="rail-row-chev" aria-hidden="true">
                            <Icon name="chevron-right" size={16} />
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                  <a class="link-arrow" href="/subjects/">View all subjects</a>
                </div>
              )}

              {recommendedNotes.length > 0 && (
                <div class="rail-card">
                  <p class="rail-heading">
                    <Icon name="book-open" size={24} />
                    Recommended study notes
                  </p>
                  <p class="rail-help">Review these notes based on your performance.</p>
                  <ul class="rail-rows rail-notes">
                    {recommendedNotes.map((note) => (
                      <li>
                        <a href={`/notes/${note.slug}/`}>
                          <span class="rail-note-body">
                            <span class="rail-note-title">{note.title}</span>
                            <span class="rail-note-desc">{note.excerpt}</span>
                          </span>
                          <span class="rail-row-chev" aria-hidden="true">
                            <Icon name="chevron-right" size={16} />
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                  <a class="link-arrow" href={`/subjects/${subject.slug}/`}>
                    View more study notes
                  </a>
                </div>
              )}

              <div class="rail-card rail-card-tint">
                <p class="rail-heading">
                  <Icon name="bulb" size={22} />
                  Study tip
                </p>
                <blockquote class="rail-quote">
                  <p>
                    “Don’t be discouraged by mistakes. They are part of the learning process.
                    Review, understand, and try again.”
                  </p>
                </blockquote>
                <span class="quote-rule" aria-hidden="true"></span>
                <p class="rail-caps">Practice today<br />Progress tomorrow</p>
              </div>
            </aside>
          </section>

          {/* --- review view ------------------------------------------------------ */}
          <section class="review-view" data-review-view hidden>
            <div class="section-head-row review-head">
              <div>
                <h2>Answer review</h2>
                <p>
                  Every question with the correct answer and your pick.
                  <span data-review-summary></span>
                </p>
              </div>
              <button class="btn btn-secondary" type="button" data-review-back>
                Back to results
              </button>
            </div>
            <div class="review-list" data-review-list></div>
          </section>

          <noscript>
            <div class="notice notice-info quiz-nojs">
              The interactive quiz needs JavaScript. Every question and answer is
              also available on the
              <a href={`/practice/subject/${subject.slug}/`}>{subject.title} practice page</a>.
            </div>
          </noscript>
        </div>

        {/* --- rail --------------------------------------------------------------- */}
        <aside class="quiz-rail" aria-label="Quiz tools" data-quiz-rail>
          <div class="rail-card rail-timer">
            <img
              class="rail-img"
              src="/assets/icons/stopwatch.svg"
              alt=""
              width="30"
              height="30"
              aria-hidden="true"
            />
            <p class="rail-timer-meta">
              <span class="rail-timer-label">Time elapsed</span>
              <span class="rail-timer-value" data-quiz-timer>00:00</span>
            </p>
            <button class="q-pause" type="button" data-quiz-pause aria-pressed="false">
              <img
                src="/assets/icons/pause.svg"
                alt=""
                width="18"
                height="18"
                aria-hidden="true"
              />
              <span class="visually-hidden">Pause timer</span>
            </button>
          </div>

          <div class="rail-card rail-nav">
            <h2 class="rail-title">Question navigation</h2>
            <p class="quiz-legend">
              <span class="dot dot-answered"></span>Answered
              <span class="dot dot-current"></span>Current
              <span class="dot dot-open"></span>Not answered
            </p>
            <div class="quiz-navgrid" data-quiz-navgrid></div>
            <button class="btn btn-secondary quiz-finish" type="button" data-quiz-finish>
              <img
                src="/assets/icons/flag.svg"
                alt=""
                width="18"
                height="18"
                aria-hidden="true"
              />
              Finish quiz
            </button>
          </div>

          <div class="rail-card rail-card-tint">
            <p class="rail-heading">
              <Icon name="bulb" size={22} />
              Study tip
            </p>
            <blockquote class="rail-quote">
              <p>“Try to understand the reasoning behind each answer, not just memorize it.”</p>
            </blockquote>
            <span class="quote-rule" aria-hidden="true"></span>
            <p class="rail-caps">Better questions<br />Stronger clinicians</p>
          </div>

          {relatedQuestions.length > 0 && (
            <div class="rail-card">
              <p class="rail-heading">
                <Icon name="book-open" size={22} />
                Related questions
              </p>
              <ul class="rail-questions">
                {relatedQuestions.map((q, i) => (
                  <li>
                    <a href={q.url}>
                      <span class="rail-q-num">Q{i + 1}</span>
                      <span class="rail-q-text">{q.question}</span>
                      <span class="rail-q-chev" aria-hidden="true">
                        <Icon name="chevron-right" size={16} />
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {subjectFormQuizzes.length > 0 && (
            <div class="rail-card">
              <p class="rail-heading">
                <Icon name="external-link" size={22} />
                Google Form quizzes
              </p>
              <ul class="rail-questions">
                {subjectFormQuizzes.map((f) => (
                  <li>
                    <a href={f.google_form_url} target="_blank" rel="noopener">
                      <span class="rail-q-num" aria-hidden="true">
                        <Icon name="external-link" size={14} />
                      </span>
                      <span class="rail-q-text">
                        {f.title}{f.topic ? ` — ${f.topic}` : ''}
                        <span class="visually-hidden"> (opens in a new tab on Google Forms)</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </aside>
      </div>
    </div>
  </div>

  <script type="application/json" id="quiz-data" set:html={quizDataJson} is:inline />

  <script>
    interface QuizQuestion {
      question: string;
      chapter: string;
      options: string[];
      answerIndex: number;
      answer: string;
      explanation: string;
      difficulty: string;
      url: string;
    }

    interface QuizData {
      subject: string;
      subjectSlug: string;
      total: number;
      questions: QuizQuestion[];
    }

    const dataEl = document.getElementById('quiz-data');
    const root = document.getElementById('quiz-root');

    if (dataEl && root) {
      const data: QuizData = JSON.parse(dataEl.textContent ?? '{}');
      const questions = data.questions;
      const total = questions.length;

      const $ = <T extends Element = HTMLElement>(sel: string) =>
        root.querySelector<T>(sel);
      const view = $('[data-quiz-view]')!;
      const card = $('[data-quiz-card]')!;
      const feedback = $('[data-feedback]')!;
      const positionEl = $('[data-quiz-position]')!;
      const pctEl = $('[data-quiz-pct]')!;
      const progressEl = $('[data-quiz-progress]')!;
      const fillEl = $('[data-quiz-fill]')!;
      const timerEl = $('[data-quiz-timer]')!;
      const pauseBtn = $('[data-quiz-pause]') as HTMLButtonElement | null;
      const navGrid = $('[data-quiz-navgrid]')!;
      const side = $('[data-quiz-side]')!;
      const rail = $('[data-quiz-rail]')!;
      const resultsView = $('[data-results-view]')!;
      const reviewView = $('[data-review-view]')!;

      // State: picked option per question (null = unanswered), and whether
      // the answer has been revealed.
      const picked: (number | null)[] = new Array(total).fill(null);
      const revealed: boolean[] = new Array(total).fill(false);
      let current = 0;
      let finished = false;

      const escape = (value: string) =>
        value.replace(/[&<>"']/g, (ch) =>
          ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch]!,
        );

      const letters = ['A', 'B', 'C', 'D', 'E', 'F'];

      // --- timer (with a real pause) --------------------------------------------
      let startedAt = Date.now();
      let accumulatedMs = 0; // time from completed (unpaused) segments
      let paused = false;
      let elapsedMs = 0;

      function readClock() {
        const s = Math.floor(elapsedMs / 1000);
        timerEl.textContent = `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
      }

      let timer = startTimer();

      function startTimer() {
        readClock();
        return window.setInterval(() => {
          if (finished || paused) return;
          elapsedMs = accumulatedMs + (Date.now() - startedAt);
          readClock();
        }, 1000);
      }

      pauseBtn?.addEventListener('click', () => {
        if (finished) return;
        if (paused) {
          startedAt = Date.now();
          paused = false;
        } else {
          accumulatedMs += Date.now() - startedAt;
          elapsedMs = accumulatedMs;
          paused = true;
          readClock();
        }
        pauseBtn.setAttribute('aria-pressed', String(paused));
        const label = pauseBtn.querySelector('.visually-hidden');
        if (label) label.textContent = paused ? 'Resume timer' : 'Pause timer';
      });

      // --- navigation grid -------------------------------------------------------
      questions.forEach((_, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'nav-dot';
        btn.textContent = String(i + 1);
        btn.setAttribute('aria-label', `Go to question ${i + 1}`);
        btn.addEventListener('click', () => {
          render(i);
          card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        });
        navGrid.appendChild(btn);
      });
      const dots = [...navGrid.children] as HTMLButtonElement[];

      // --- chapter progress + active chapter --------------------------------------
      const chProgress = [
        ...root.querySelectorAll<HTMLElement>('[data-quiz-ch-progress]'),
      ];
      const sectionEls = [
        ...root.querySelectorAll<HTMLElement>('[data-chapter]'),
      ];
      function updateSections(activeChapter?: string) {
        // Count answered per chapter.
        const counts = new Map<string, { done: number; total: number }>();
        questions.forEach((q) => {
          const entry = counts.get(q.chapter) ?? { done: 0, total: 0 };
          entry.total += 1;
          counts.set(q.chapter, entry);
        });
        questions.forEach((q, i) => {
          if (revealed[i]) counts.get(q.chapter)!.done += 1;
        });
        chProgress.forEach((el, i) => {
          const chapter = sectionEls[i]?.dataset.chapter;
          const c = chapter ? counts.get(chapter) : undefined;
          if (c) el.textContent = `${c.done}/${c.total}`;
        });
        if (activeChapter !== undefined) {
          sectionEls.forEach((el) =>
            el.classList.toggle('active', el.dataset.chapter === activeChapter),
          );
        }
      }

      // --- one question ------------------------------------------------------------
      function render(i: number) {
        current = i;
        const q = questions[i];

        positionEl.textContent = `Question ${i + 1} of ${total}`;
        const answeredCount = revealed.filter(Boolean).length;
        const pct = total > 0 ? Math.round((answeredCount / total) * 100) : 0;
        pctEl.textContent = `${pct}%`;
        fillEl.style.width = `${pct}%`;
        progressEl.setAttribute('aria-valuenow', String(pct));

        dots.forEach((dot, j) => {
          dot.classList.toggle('current', j === i);
          dot.classList.toggle('answered', revealed[j]);
        });

        updateSections(q.chapter);

        const answered = revealed[i];
        feedback.hidden = true;
        feedback.className = 'answer-card';
        feedback.innerHTML = '';

        card.innerHTML = `
          <p class="q-kicker"><span>${escape(data.subject)}</span>${
            q.chapter ? `<span>${escape(q.chapter)}</span>` : ''
          }</p>
          <h2 class="q-text">${escape(q.question)}</h2>
          <div class="q-options" role="group" aria-label="Answer options">
            ${q.options
              .map(
                (opt, j) => `
              <button type="button" class="q-option" data-option="${j}"
                ${answered ? 'disabled' : ''}>
                <span class="q-letter">${letters[j]}</span>
                <span class="q-option-text">${escape(opt)}</span>
              </button>`,
              )
              .join('')}
          </div>
          <div class="q-actions">
            <button type="button" class="btn btn-primary q-check" data-check ${
              answered || picked[i] === null ? 'disabled' : ''
            }>
              <span>Check Answer</span>
              <img src="/assets/icons/arrow-right.svg" alt="" width="18" height="18" aria-hidden="true" />
            </button>
            <a class="q-link" href="${q.url}">Full explanation</a>
          </div>
        `;

        if (answered) showFeedback(i, false);

        card.querySelectorAll<HTMLButtonElement>('[data-option]').forEach((btn) => {
          btn.addEventListener('click', () => {
            if (revealed[i]) return;
            picked[i] = Number(btn.dataset.option);
            card.querySelectorAll('.q-option').forEach((el) =>
              el.classList.remove('selected'),
            );
            btn.classList.add('selected');
            const check = card.querySelector<HTMLButtonElement>('[data-check]');
            if (check) check.disabled = false;
          });
        });

        const check = card.querySelector<HTMLButtonElement>('[data-check]');
        check?.addEventListener('click', () => {
          if (picked[i] === null || revealed[i]) return;
          revealed[i] = true;
          showFeedback(i, true);
          updateSections(q.chapter);
          render(i);
          feedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        });

        const prev = $('[data-quiz-prev]') as HTMLButtonElement;
        const next = $('[data-quiz-next]') as HTMLButtonElement;
        prev.disabled = i === 0;
        next.textContent = '';
        next.append(
          i === total - 1 ? 'Finish quiz' : 'Next question',
          Object.assign(document.createElement('img'), {
            src: '/assets/icons/arrow-right.svg',
            alt: '',
            className: 'pager-arrow',
          }),
        );
        next.dataset.finish = i === total - 1 ? 'true' : 'false';
      }

      function showFeedback(i: number, markOptions: boolean) {
        const q = questions[i];
        const isCorrect = q.answerIndex >= 0 && picked[i] === q.answerIndex;
        const revealOnly = q.answerIndex < 0;

        if (markOptions) {
          card.querySelectorAll<HTMLButtonElement>('[data-option]').forEach((btn) => {
            const j = Number(btn.dataset.option);
            btn.disabled = true;
            if (j === q.answerIndex) btn.classList.add('correct');
            else if (j === picked[i]) btn.classList.add('incorrect');
          });
        }

        feedback.hidden = false;
        feedback.className = `answer-card ${isCorrect ? 'ok' : 'bad'}`;
        feedback.innerHTML = `
          <div class="ans-head">
            ${isCorrect ? '<img class="ans-badge" src="/assets/icons/check-badge.svg" alt="" width="32" height="32" />' : ''}
            <p class="q-verdict">${isCorrect ? 'Correct!' : 'Not quite'}</p>
          </div>
          ${revealOnly ? `<p class="q-answer">Answer: <strong>${escape(q.answer)}</strong></p>` : ''}
          <p class="q-explanation">${escape(q.explanation)}</p>
          <a class="q-link" href="${q.url}">Read the full explanation</a>
        `;
      }

      $('[data-quiz-prev]')?.addEventListener('click', () => {
        if (current > 0) render(current - 1);
      });
      $('[data-quiz-next]')?.addEventListener('click', (event) => {
        const btn = event.currentTarget as HTMLButtonElement;
        if (btn.dataset.finish === 'true') {
          finish();
        } else if (current < total - 1) {
          render(current + 1);
        }
      });

      // --- finish + results ----------------------------------------------------------
      function finish() {
        const answeredCount = revealed.filter(Boolean).length;
        if (answeredCount < total) {
          const proceed = window.confirm(
            `You have answered ${answeredCount} of ${total} questions. Finish anyway?`,
          );
          if (!proceed) return;
        }
        finished = true;
        window.clearInterval(timer);
        if (!paused) elapsedMs = accumulatedMs + (Date.now() - startedAt);

        const correct = questions.reduce(
          (sum, q, i) => sum + (revealed[i] && q.answerIndex >= 0 && picked[i] === q.answerIndex ? 1 : 0),
          0,
        );
        const skipped = total - revealed.filter(Boolean).length;
        const incorrect = total - correct - skipped;
        const pct = total > 0 ? Math.round((correct / total) * 100) : 0;

        // Record the attempt in local quiz history — kept in this browser
        // only, never sent anywhere. Feeds the dashboard and quiz-history
        // pages. Capped so a long-running browser doesn't grow it forever.
        try {
          const HISTORY_KEY = 'msn:quiz-history';
          const history = JSON.parse(localStorage.getItem(HISTORY_KEY) ?? '[]');
          history.unshift({
            subject: data.subject,
            subjectSlug: data.subjectSlug,
            correct,
            total,
            pct,
            seconds: Math.round(elapsedMs / 1000),
            date: new Date().toISOString(),
          });
          localStorage.setItem(HISTORY_KEY, JSON.stringify(history.slice(0, 50)));
        } catch {
          /* storage unavailable (private mode, disabled) — the quiz still works */
        }

        // Heading varies with the score, like the design's encouraging tone.
        const heading = $('[data-results-heading]')!;
        heading.textContent =
          pct >= 80 ? 'Excellent work!' : pct >= 50 ? 'Great effort!' : 'Keep practising!';

        // Score ring.
        const RING_LENGTH = 2 * Math.PI * 54;
        const ringFill = $<SVGCircleElement>('[data-ring-fill]')!;
        ringFill.style.strokeDasharray = `${RING_LENGTH}`;
        ringFill.style.strokeDashoffset = `${RING_LENGTH * (1 - correct / total)}`;
        $('[data-ring-score]')!.textContent = `${correct}/${total}`;
        $('[data-ring-pct]')!.textContent = `${pct}%`;

        $('[data-stat-correct]')!.textContent = String(correct);
        $('[data-stat-incorrect]')!.textContent = String(incorrect);
        $('[data-stat-skipped]')!.textContent = String(skipped);
        $('[data-stat-total]')!.textContent = String(total);

        // Difficulty shown honestly: the single level if the set is uniform,
        // otherwise "Mixed".
        const difficulties = [...new Set(questions.map((q) => q.difficulty))];
        $('[data-stat-difficulty]')!.textContent =
          difficulties.length === 1
            ? difficulties[0]!.charAt(0).toUpperCase() + difficulties[0]!.slice(1)
            : 'Mixed';

        const s = Math.floor(elapsedMs / 1000);
        $('[data-stat-time]')!.textContent =
          `${Math.floor(s / 60)} minute${Math.floor(s / 60) === 1 ? '' : 's'} ${String(s % 60).padStart(2, '0')} seconds`;

        // Performance by topic (chapter), with the accuracy bar from the
        // design: green at 70% and above, red below.
        const topics = new Map<string, { correct: number; total: number }>();
        questions.forEach((q, i) => {
          const entry = topics.get(q.chapter) ?? { correct: 0, total: 0 };
          entry.total += 1;
          if (q.answerIndex >= 0 && picked[i] === q.answerIndex) entry.correct += 1;
          topics.set(q.chapter, entry);
        });
        const tbody = $('[data-perf-tbody]')!;
        tbody.innerHTML = [...topics.entries()]
          .map(([topic, c]) => {
            const acc = Math.round((c.correct / c.total) * 100);
            return `
            <tr>
              <th scope="row">${escape(topic)}</th>
              <td>${c.correct} / ${c.total}</td>
              <td>${acc}%</td>
              <td class="perf-acc">
                <span class="acc-bar">
                  <span class="acc-fill ${acc >= 70 ? 'good' : 'bad'}" style="width:${acc}%"></span>
                </span>
              </td>
            </tr>`;
          })
          .join('');

        view.hidden = true;
        side.hidden = true;
        rail.hidden = true;
        resultsView.hidden = false;
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      $('[data-quiz-finish]')?.addEventListener('click', finish);

      $('[data-results-retry]')?.addEventListener('click', () => {
        picked.fill(null);
        revealed.fill(false);
        finished = false;
        paused = false;
        accumulatedMs = 0;
        elapsedMs = 0;
        startedAt = Date.now();
        pauseBtn?.setAttribute('aria-pressed', 'false');
        const label = pauseBtn?.querySelector('.visually-hidden');
        if (label) label.textContent = 'Pause timer';
        reviewView.hidden = true;
        resultsView.hidden = true;
        view.hidden = false;
        side.hidden = false;
        rail.hidden = false;
        window.clearInterval(timer);
        timer = startTimer();
        render(0);
      });

      // --- review -----------------------------------------------------------------
      $('[data-results-review]')?.addEventListener('click', () => {
        const correct = questions.reduce(
          (sum, q, i) => sum + (q.answerIndex >= 0 && picked[i] === q.answerIndex ? 1 : 0),
          0,
        );
        $('[data-review-summary]')!.textContent = ` You scored ${correct}/${total}.`;

        const list = $('[data-review-list]')!;
        list.innerHTML = questions
          .map((q, i) => {
            const isCorrect = q.answerIndex >= 0 && picked[i] === q.answerIndex;
            return `
            <article class="panel panel-pad review-item ${revealed[i] ? (isCorrect ? 'ok' : 'bad') : 'skipped'}">
              <p class="q-kicker">
                <span>Question ${i + 1}</span>
                ${q.chapter ? `<span>${escape(q.chapter)}</span>` : ''}
              </p>
              <h3 class="q-text">${escape(q.question)}</h3>
              <ul class="review-options">
                ${q.options
                  .map((opt, j) => {
                    const cls = [
                      j === q.answerIndex ? 'correct' : '',
                      j === picked[i] && picked[i] !== q.answerIndex ? 'incorrect' : '',
                    ]
                      .filter(Boolean)
                      .join(' ');
                    return `<li class="${cls}"><span class="q-letter">${letters[j]}</span>${escape(opt)}</li>`;
                  })
                  .join('')}
              </ul>
              <p class="review-verdict">${
                revealed[i] ? (isCorrect ? 'You answered correctly' : 'Correct answer shown above') : 'Not answered'
              }</p>
              <p class="q-explanation">${escape(q.explanation)}</p>
              <a class="q-link" href="${q.url}">Read the full explanation</a>
            </article>`;
          })
          .join('');

        resultsView.hidden = true;
        reviewView.hidden = false;
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      $('[data-review-back]')?.addEventListener('click', () => {
        reviewView.hidden = true;
        resultsView.hidden = false;
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      // --- share --------------------------------------------------------------------
      $('[data-results-share]')?.addEventListener('click', () => {
        const correct = questions.reduce(
          (sum, q, i) => sum + (q.answerIndex >= 0 && picked[i] === q.answerIndex ? 1 : 0),
          0,
        );
        const pct = total > 0 ? Math.round((correct / total) * 100) : 0;
        const text = `I scored ${correct}/${total} (${pct}%) on the ${data.subject} MCQ quiz at Medical Study Notes.`;
        if (navigator.share) {
          navigator.share({ text, url: window.location.href }).catch(() => {});
        } else if (navigator.clipboard) {
          navigator.clipboard.writeText(`${text} ${window.location.href}`);
          const btn = $('[data-results-share]') as HTMLButtonElement;
          btn.textContent = 'Result copied!';
          window.setTimeout(() => {
            btn.textContent = 'Share Result';
          }, 2000);
        }
      });

      updateSections();
      render(0);
    }
  </script>
</Layout>

<style>
