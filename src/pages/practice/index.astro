---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import QuestionList from '../../components/QuestionList.astro';
import { getQuestions, getCollection } from '../../utils/collections';

const [questions, subjects, levels] = await Promise.all([
  getQuestions(),
  getCollection('subjects'),
  getCollection('levels'),
]);

const typeOptions = [
  { slug: 'mcq', label: 'Multiple choice' },
  { slug: 'short', label: 'Short answer' },
  { slug: 'long', label: 'Long answer' },
  { slug: 'numerical', label: 'Numerical' },
];

/** The unfiltered index groups by subject; filter pages live one level down. */
const grouped = subjects
  .map((subject) => ({
    subject,
    questions: questions.filter((q) => q.data.subject === subject.slug),
  }))
  .filter((group) => group.questions.length > 0);

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.data.title,
}));
---

<Layout
  title="MCQs and Practice Questions with Worked Answers | Medical Study Notes"
  description="Practice questions with full answers and explanations: MCQs, short and long answer questions, and numerical problems, filterable by subject, level, and type."
  path="/practice/"
  footerSubjects={footerSubjects}
  wide
>
  <PageHeader
    kicker="MCQs and practice"
    title="Practice questions"
    lead="Every question includes the full answer and a worked explanation, not just a letter. Practise by subject, level, or question type."
    crumbs={[{ label: 'Practice Questions' }]}
    stats={[
      { value: questions.length, label: 'Questions', icon: 'question' },
      { value: grouped.length, label: 'Subjects covered', icon: 'book' },
      { value: typeOptions.length, label: 'Question types', icon: 'list' },
    ]}
  />

  <div class="container page-body">
    {/* Filters: three plain link groups rather than a filter widget, so each
        combination is a real crawlable URL. */}
    <section class="section section-plain" aria-labelledby="filters">
      <div class="section-head">
        <h2 id="filters">Filter questions</h2>
      </div>
      <div class="grid grid-3">
        <div class="filter-col">
          <h3 class="filter-title">By subject</h3>
          <ul class="chevron-list">
            {subjects.map((subject) => (
              <li>
                <a href={`/practice/subject/${subject.slug}/`}>{subject.data.title}</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="filter-col">
          <h3 class="filter-title">By level</h3>
          <ul class="chevron-list">
            {levels.map((level) => (
              <li><a href={`/practice/level/${level.slug}/`}>{level.data.title}</a></li>
            ))}
          </ul>
        </div>
        <div class="filter-col">
          <h3 class="filter-title">By type</h3>
          <ul class="chevron-list">
            {typeOptions.map((option) => (
              <li><a href={`/practice/type/${option.slug}/`}>{option.label}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {grouped.map(({ subject, questions: subjectQuestions }) => (
      <section class="section" aria-labelledby={`q-${subject.slug}`}>
        <div class="section-head-row">
          <div>
            <p class="eyebrow">
              {subjectQuestions.length} question{subjectQuestions.length === 1 ? '' : 's'}
            </p>
            <h2 id={`q-${subject.slug}`}>{subject.data.title}</h2>
          </div>
          <a class="link-arrow" href={`/practice/subject/${subject.slug}/`}>
            Practise {subject.data.title}
          </a>
        </div>
        <QuestionList questions={subjectQuestions} />
      </section>
    ))}
  </div>
</Layout>

<style>
  .page-body {
    padding-bottom: var(--space-16);
  }

  .filter-col {
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .filter-title {
    margin-bottom: var(--space-2);
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
  }
</style>
