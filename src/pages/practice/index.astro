---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getQuestions } from '../../utils/collections';
import { getCollection } from 'astro:content';

const [questions, subjects, levels] = await Promise.all([
  getQuestions(),
  getCollection('subjects'),
  getCollection('levels'),
]);

const subjectOptions = subjects.map((s) => ({ slug: s.slug, label: s.data.title }));
const levelOptions = levels.map((l) => ({ slug: l.slug, label: l.data.title }));
const typeOptions = [
  { slug: 'mcq', label: 'Multiple choice' },
  { slug: 'short', label: 'Short answer' },
  { slug: 'long', label: 'Long answer' },
  { slug: 'numerical', label: 'Numerical' },
];

// The unfiltered index lists everything grouped by subject; filter pages
// live at /practice/subject|level|type/[slug]/.
const grouped = subjectOptions
  .map((option) => ({
    option,
    questions: questions.filter((q) => q.data.subject === option.slug),
  }))
  .filter((group) => group.questions.length > 0);
---

<Layout
  title="Practice Questions — MCQs, Short Answers, and Worked Problems | devsyllabus"
  description="Practice questions for computer science subjects with full answers and explanations: MCQs, short and long answer questions, and numerical problems."
  path="/practice/"
>
  <Breadcrumbs crumbs={[{ label: 'Practice Questions' }]} />

  <h1>Practice questions</h1>
  <p>
    Every question includes the full answer and a worked explanation, not
    just a letter. Practice by subject, level, or question type.
  </p>

  <nav aria-label="Filter questions">
    <h2>Filter</h2>
    <div class="filters">
      <div>
        <h3>By subject</h3>
        <ul>
          {subjectOptions.map((option) => (
            <li><a href={`/practice/subject/${option.slug}/`}>{option.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h3>By level</h3>
        <ul>
          {levelOptions.map((option) => (
            <li><a href={`/practice/level/${option.slug}/`}>{option.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h3>By type</h3>
        <ul>
          {typeOptions.map((option) => (
            <li><a href={`/practice/type/${option.slug}/`}>{option.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </nav>

  <section>
    <h2>All questions ({questions.length})</h2>
    {grouped.map((group) => (
      <div class="subject-group">
        <h3>{group.option.label}</h3>
        <ul>
          {group.questions.map((q) => (
            <li>
              <a href={`/practice/${q.slug}/`}>{q.data.question}</a>
              <span> — {q.data.type}, {q.data.difficulty}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</Layout>

<style>
  .filters {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1rem;
  }
  .subject-group {
    margin-bottom: 1.5rem;
  }
</style>
