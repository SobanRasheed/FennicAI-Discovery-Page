---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Search from '../../components/Search.astro';
import JsonLd from '../../components/JsonLd.astro';
import Illustration, { illustrationForSubject } from '../../components/Illustration.astro';
import { getCollection, getNotes, getQuestions } from '../../utils/collections';

const [subjects, notes, questions] = await Promise.all([
  getCollection('subjects'),
  getNotes(),
  getQuestions(),
]);

/** Subjects with a PNG icon in /assets/landing/; the rest fall back to a drawing. */
const pngSubjects = new Set([
  'anatomy',
  'biochemistry',
  'community-medicine',
  'forensic-medicine',
  'microbiology',
  'pathology',
  'pharmacology',
  'physiology',
]);

const subjectIcon = (slug: string) =>
  pngSubjects.has(slug) ? `/assets/landing/subject-${slug}.png` : undefined;

const rows = subjects.map((subject) => ({
  subject,
  noteCount: notes.filter((n) => n.data.subject === subject.slug).length,
  mcqCount: questions.filter((q) => q.data.subject === subject.slug).length,
}));

/** The two curriculum halves from the design. Anything unlisted lands in
    Clinical Sciences, and an empty group renders nothing. */
const coreSlugs = new Set([
  'anatomy',
  'physiology',
  'biochemistry',
  'pharmacology',
  'pathology',
  'microbiology',
  'forensic-medicine',
  'community-medicine',
]);

const groups = [
  {
    title: 'Core Medical Sciences',
    blurb: 'Build your foundation with the basic medical sciences.',
    rows: rows.filter((r) => coreSlugs.has(r.subject.slug)),
  },
  {
    title: 'Clinical Sciences',
    blurb: 'Explore subjects focused on the diagnosis and management of diseases.',
    rows: rows.filter((r) => !coreSlugs.has(r.subject.slug)),
  },
].filter((g) => g.rows.length > 0);

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.data.title,
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'All medical subjects',
  description:
    'Find study notes, MCQs and educational resources organized by subject.',
  url: new URL('/subjects/', Astro.site).href,
  isPartOf: { '@type': 'WebSite', name: 'Medical Study Notes', url: Astro.site!.href },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: rows.map((r, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: r.subject.data.title,
      url: new URL(`/subjects/${r.subject.slug}/`, Astro.site).href,
    })),
  },
};
---

<Layout
  title="All Subjects | Medical Study Notes"
  description="Explore all medical subjects on Medical Study Notes — study notes, MCQs and educational resources organized by subject, from the core sciences to clinical specialties."
  path="/subjects/"
  footerSubjects={footerSubjects}
  wide
>
  <JsonLd data={jsonLd} />

  <PageHeader
    kicker="All Subjects"
    title="Explore all medical subjects"
    lead="Find study notes, MCQs and educational resources organized by subject."
    crumbs={[{ href: '/', label: 'Home' }, { label: 'Subjects' }]}
  >
    <div class="subjects-search">
      <Search
        variant="hero"
        id="subjects-search"
        placeholder="Search subjects, topics or resources…"
        label="Search subjects, topics or resources"
      />
    </div>

    <Fragment slot="aside">
      <figure class="subjects-quote">
        <blockquote>
          <p>Medicine is a science of uncertainty and an art of probability.</p>
        </blockquote>
        <figcaption>Sir William Osler</figcaption>
      </figure>
    </Fragment>
  </PageHeader>

  <div class="container page-body">
    {groups.map((group) => (
      <section class="section section-plain" aria-labelledby={`group-${group.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
        <div class="section-head-row">
          <div>
            <h2 id={`group-${group.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{group.title}</h2>
            <p>{group.blurb}</p>
          </div>
          <a class="link-arrow" href="/notes/">View all</a>
        </div>

        <div class="grid grid-3 subject-grid">
          {group.rows.map(({ subject, noteCount, mcqCount }) => (
            <a class="subj-card" href={`/subjects/${subject.slug}/`}>
              <span class="subj-art" aria-hidden="true">
                {subjectIcon(subject.slug) ? (
                  <img src={subjectIcon(subject.slug)} alt="" loading="lazy" decoding="async" />
                ) : (
                  <Illustration name={illustrationForSubject(subject.slug)} size={40} />
                )}
              </span>
              <span class="subj-title">{subject.data.title}</span>
              <span class="subj-counts">
                {noteCount > 0 ? `${noteCount} notes` : 'Study notes'}
                {mcqCount > 0 ? ` · ${mcqCount} MCQs` : ''}
              </span>
              <span class="subj-desc">{subject.data.description}</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>

<style>
  .subjects-search {
    margin-top: var(--space-6);
    max-width: 36rem;
  }

  /* The Osler pull-quote in the header aside. */
  .subjects-quote {
    margin: 0;
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-sunken);
  }

  .subjects-quote blockquote {
    margin: 0;
  }

  .subjects-quote p {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-display-sm);
    font-style: italic;
    font-weight: var(--weight-medium);
    line-height: 1.35;
    text-wrap: balance;
  }

  .subjects-quote figcaption {
    margin-top: var(--space-3);
    color: var(--mute);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
  }

  .page-body {
    padding-block: var(--space-12) var(--space-16);
  }

  .subject-grid {
    gap: var(--space-4);
  }

  /* One bordered tile per subject: art well, title, counts, description. */
  .subj-card {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s var(--ease), background-color 0.15s var(--ease);
  }

  .subj-card:hover {
    border-color: var(--primary-border);
    background: var(--primary-surface);
  }

  .subj-art {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.5rem;
    height: 4.5rem;
    margin-bottom: var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-sunken);
    color: var(--primary);
    transition: border-color 0.15s var(--ease), background-color 0.15s var(--ease);
  }

  .subj-card:hover .subj-art {
    border-color: var(--primary-border);
    background: var(--surface);
  }

  .subj-art img {
    width: 2.75rem;
    height: 2.75rem;
    object-fit: contain;
  }

  .subj-title {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-body-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    transition: color 0.15s var(--ease);
  }

  .subj-card:hover .subj-title {
    color: var(--primary);
  }

  .subj-counts {
    color: var(--mute);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    font-variant-numeric: tabular-nums;
  }

  .subj-desc {
    color: var(--mute);
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
  }
</style>
