---
/**
 * /subjects/[slug]/ — a subject hub: the central page for one subject.
 *
 * Figma Screen 02: a quiet hero band with real counts and a quote card, a
 * tab strip of section/page links, chapter cards (D1 topics) with hairline
 * note lists, and a sidebar of quick links, a featured note, and related
 * subjects. Server-rendered from D1 with edge caching; the type filter and
 * pagination are real links, so everything works without JavaScript.
 */
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import Illustration, { illustrationForSubject } from '../../components/Illustration.astro';
import { jsonForScript } from '../../utils/json-script';
import { sanitizeRichText } from '../../utils/richtext';
import {
  getSubjectBySlug,
  listSubjects,
  listTopicsBySubject,
  listPublishedBySubject,
  countPublishedBySubjectType,
  countPublishedMcqsBySubject,
  listMcqCardsBySubject,
  getMediaById,
  type PublicArticleCard,
} from '../../utils/content';

export const prerender = false;

const subjectSlug = String(Astro.params.slug ?? '');
const subject = await getSubjectBySlug(Astro.locals, subjectSlug);
if (!subject || !subject.is_active) {
  return new Response('Not found', { status: 404 });
}

const url = Astro.url;
const page = Math.max(1, Number(url.searchParams.get('page')) || 1);
const typeParam = url.searchParams.get('type');
const articleType = typeParam === 'study-note' || typeParam === 'article' ? typeParam : undefined;

const [
  topics,
  { rows: articles, total },
  typeCounts,
  mcqCount,
  mcqCards,
  subjects,
  subjectImage,
] = await Promise.all([
  listTopicsBySubject(Astro.locals, subject.id),
  listPublishedBySubject(Astro.locals, subject.id, { articleType, page, perPage: 50 }),
  countPublishedBySubjectType(Astro.locals, subject.id),
  countPublishedMcqsBySubject(Astro.locals, subject.id),
  listMcqCardsBySubject(Astro.locals, subject.id, { limit: 6 }),
  listSubjects(Astro.locals),
  subject.image_media_id ? getMediaById(Astro.locals, subject.image_media_id) : Promise.resolve(null),
]);

const totalPages = Math.max(1, Math.ceil(total / 50));
const noteCount = typeCounts['study-note'];
const articleCount = typeCounts.article;
const hasImage = !!subjectImage && subjectImage.mime_type.startsWith('image/');

const title = subject.seo_title || `${subject.title} Study Notes and Practice Questions | Medical Study Notes`;
const description =
  subject.seo_description ||
  subject.description ||
  `${subject.title} study notes, guides, and practice questions.`;
const path = `/subjects/${subject.slug}/`;

Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=86400');

const fmtDate = (d: string) => (d ? new Date(d + 'Z').toISOString().slice(0, 10) : '');
const hrefFor = (a: PublicArticleCard) =>
  a.article_type === 'study-note' ? `/notes/${a.slug}/` : `/blog/${a.slug}/`;
const pageLink = (p: number) => {
  const sp = new URLSearchParams(url.searchParams);
  sp.set('page', String(p));
  return `${path}?${sp.toString()}`;
};

// Group this page's articles by topic for the chapter cards.
const byTopic = new Map<number, PublicArticleCard[]>();
const unfiled: PublicArticleCard[] = [];
for (const a of articles) {
  if (a.topic_id == null) unfiled.push(a);
  else {
    const list = byTopic.get(a.topic_id) ?? [];
    list.push(a);
    byTopic.set(a.topic_id, list);
  }
}
const topicCards = topics.filter((t) => (byTopic.get(t.id)?.length ?? 0) > 0);
const plannedTopics = topics.filter((t) => !(byTopic.get(t.id)?.length ?? 0));

const featuredNote =
  articles.find((a) => a.article_type === 'study-note') ?? articles[0] ?? null;

/** The serif line in the hero quote card — one per core subject, Osler otherwise. */
const subjectQuotes: Record<string, string> = {
  anatomy: 'Structure is the language of the body; learn to read it.',
  physiology: 'To heal the body, first understand how it works.',
  biochemistry: 'Life is chemistry, and chemistry is life.',
  pharmacology: 'The right dose separates a remedy from a poison.',
  pathology: 'Every disease tells a story in the tissue.',
  microbiology: 'To understand disease, we must first understand the unseen.',
  'forensic-medicine': 'Where medicine meets justice, evidence speaks.',
  'community-medicine': 'Prevention is better than cure.',
};
const heroQuote = subjectQuotes[subject.slug] ?? 'Medicine is a science of uncertainty and an art of probability.';

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.title,
}));

const otherSubjects = subjects
  .filter((s) => s.id !== subject.id)
  .map((s) => ({
    href: `/subjects/${s.slug}/`,
    title: s.title,
    context: s.description.split('.')[0],
  }))
  .slice(0, 3);

/** Section tabs: anchors for on-page sections, page links elsewhere. */
const tabs = [
  { href: '#study-notes', label: 'Study Notes' },
  ...(mcqCount > 0 ? [{ href: '#mcqs', label: 'MCQs' }] : []),
  { href: '/past-papers/', label: 'Past Papers' },
  { href: '/resources/', label: 'Recommended Resources' },
];

const introductionHtml = subject.introduction ? sanitizeRichText(subject.introduction) : '';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${Astro.site?.href ?? '/'}subjects/` },
      { '@type': 'ListItem', position: 2, name: subject.title, item: `${Astro.site?.href ?? '/'}${path}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: `${Astro.site?.href ?? '/'}${path}`,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: articles.map((a, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${Astro.site?.href ?? '/'}${hrefFor(a).replace(/^\//, '')}`,
        name: a.title,
      })),
    },
  },
];
---
<Layout
  title={title}
  description={description}
  path={path}
  footerSubjects={footerSubjects}
  wide
>
  <script type="application/ld+json" set:html={jsonForScript(jsonLd)} />

  {/* --- hero band --------------------------------------------------------- */}
  <section class="hero">
    <div class="container">
      <Breadcrumbs crumbs={[{ label: 'Subjects', href: '/subjects/' }, { label: subject.title }]} />
    </div>

    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="kicker hero-kicker">Subject</p>
        <h1 class="hero-title">{subject.title}</h1>
        {subject.description && <p class="hero-lead">{subject.description}</p>}

        <dl class="hero-stats">
          <div class="stat">
            <span class="stat-icon" aria-hidden="true"><Icon name="book" size={14} /></span>
            <div>
              <dt>{noteCount}</dt>
              <dd>Study notes</dd>
            </div>
          </div>
          {articleCount > 0 && (
            <div class="stat">
              <span class="stat-icon" aria-hidden="true"><Icon name="book" size={14} /></span>
              <div>
                <dt>{articleCount}</dt>
                <dd>Articles</dd>
              </div>
            </div>
          )}
          {mcqCount > 0 && (
            <div class="stat">
              <span class="stat-icon" aria-hidden="true"><Icon name="question" size={14} /></span>
              <div>
                <dt>{mcqCount}</dt>
                <dd>MCQs</dd>
              </div>
            </div>
          )}
          <div class="stat">
            <span class="stat-icon" aria-hidden="true"><Icon name="target" size={14} /></span>
            <div>
              <dt>Comprehensive</dt>
              <dd>Exam-focused content</dd>
            </div>
          </div>
        </dl>
      </div>

      <div class="hero-art" aria-hidden={!hasImage}>
        {hasImage ? (
          <img
            src={`/media/${subjectImage!.r2_key}/`}
            alt={subjectImage!.alt_text || subject.title}
            class="hero-img"
          />
        ) : (
          <Illustration name={illustrationForSubject(subject.slug)} size={130} />
        )}
      </div>

      <aside class="hero-quote">
        <span class="hero-quote-mark" aria-hidden="true">“</span>
        <blockquote>
          <p>“{heroQuote}”</p>
        </blockquote>
        <span class="hero-quote-rule" aria-hidden="true"></span>
        <p class="hero-quote-attr">
          {subject.title}<br />Builds a healthier tomorrow
        </p>
      </aside>
    </div>
  </section>

  {/* --- section tabs ------------------------------------------------------- */}
  <nav class="tabs" aria-label="Sections on this page">
    <div class="container">
      <ul>
        {tabs.map((tab) => (
          <li><a href={tab.href}>{tab.label}</a></li>
        ))}
      </ul>
    </div>
  </nav>

  <div class="container">
    <div class="hub">
      <div class="hub-main">
        {/* --- introduction (folded FAQs / key concepts) ------------------- */}
        {introductionHtml && (
          <section class="section-plain" aria-label={`About ${subject.title}`}>
            <div class="prose introduction" set:html={introductionHtml} />
          </section>
        )}

        {/* --- chapters ---------------------------------------------------- */}
        <section class="section-plain" aria-labelledby="study-notes">
          <div class="section-head">
            <h2 id="study-notes">Topics in {subject.title}</h2>
            <p>
              Browse study notes by topic. Each section includes detailed notes,
              diagrams and key points.
            </p>
          </div>

          {/* Segmented type filter — real links, so it works without JavaScript. */}
          <nav class="type-filter" aria-label="Filter by content type">
            <a href={path} class={!articleType ? 'active' : ''}>All</a>
            <a href={`${path}?type=study-note`} class={articleType === 'study-note' ? 'active' : ''}>Study notes</a>
            <a href={`${path}?type=article`} class={articleType === 'article' ? 'active' : ''}>Articles</a>
          </nav>

          {topicCards.length > 0 || unfiled.length > 0 ? (
            <div class="chapters">
              {topicCards.map((topic) => (
                <section class="chapter" aria-labelledby={`topic-${topic.slug}`}>
                  <div class="chapter-head">
                    <span class="chapter-art" aria-hidden="true">
                      <Illustration name={illustrationForSubject(subject.slug)} size={32} />
                    </span>
                    <div>
                      <h3 id={`topic-${topic.slug}`} class="chapter-title">{topic.title}</h3>
                      {topic.description && (
                        <p class="chapter-desc">{topic.description}</p>
                      )}
                    </div>
                  </div>

                  <ul class="chapter-notes">
                    {byTopic.get(topic.id)!.map((a) => (
                      <li>
                        <a href={hrefFor(a)}>
                          <span aria-hidden="true">›</span>
                          {a.title}
                          {a.article_type === 'article' && <em class="chapter-tag">Article</em>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>
              ))}

              {unfiled.length > 0 && (
                <section class="chapter" aria-labelledby="topic-other">
                  <div class="chapter-head">
                    <span class="chapter-art" aria-hidden="true">
                      <Illustration name={illustrationForSubject(subject.slug)} size={32} />
                    </span>
                    <div>
                      <h3 id="topic-other" class="chapter-title">More in {subject.title}</h3>
                      <p class="chapter-desc">Notes and articles not yet filed under a topic.</p>
                    </div>
                  </div>

                  <ul class="chapter-notes">
                    {unfiled.map((a) => (
                      <li>
                        <a href={hrefFor(a)}>
                          <span aria-hidden="true">›</span>
                          {a.title}
                          {a.article_type === 'article' && <em class="chapter-tag">Article</em>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>
              )}
            </div>
          ) : (
            <div class="empty-state">
              <h3>Notes in progress</h3>
              <p>
                No published notes for this subject yet. Browse the
                <a href="/notes/"> full note index</a> in the meantime.
              </p>
            </div>
          )}

          {/* Topics with no notes yet are listed plainly rather than shown
              as empty panels. */}
          {topicCards.length > 0 && plannedTopics.length > 0 && (
            <p class="upcoming">
              Also planned:
              {plannedTopics.map((t, i) => (
                <>
                  {i > 0 && <span aria-hidden="true">, </span>}
                  <span>{t.title}</span>
                </>
              ))}
            </p>
          )}

          {totalPages > 1 && (
            <nav class="pagination" aria-label="Pagination">
              {page > 1 && <a class="btn btn-secondary btn-sm" href={pageLink(page - 1)}>← Previous</a>}
              <span class="page-status">Page {page} of {totalPages}</span>
              {page < totalPages && <a class="btn btn-secondary btn-sm" href={pageLink(page + 1)}>Next →</a>}
            </nav>
          )}
        </section>

        {/* --- MCQs --------------------------------------------------------- */}
        {mcqCount > 0 && (
          <section class="section" aria-labelledby="mcqs">
            <div class="section-head-row">
              <div>
                <h2 id="mcqs">Practice questions</h2>
                <p>
                  {mcqCount} question{mcqCount === 1 ? '' : 's'} on
                  {' '}{subject.title}, each with the full answer and an explanation.
                </p>
              </div>
              <a class="link-arrow" href={`/practice/subject/${subject.slug}/`}>
                Practise all questions
              </a>
            </div>

            <ul class="chevron-list bordered-list">
              {mcqCards.map((q) => (
                <li>
                  <a href={`/practice/${q.slug}/`}>
                    <span class="q-text">{q.question}</span>
                    <span class="tag">{q.difficulty}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>

      {/* --- sidebar -------------------------------------------------------- */}
      <aside class="hub-side" aria-label="Subject links">
        <div class="hub-sticky">
          <section class="side-card">
            <h2>Quick links</h2>
            <ul>
              <li>
                <a href={`/notes/#subject-${subject.slug}`}>All {subject.title} notes</a>
                <span aria-hidden="true">›</span>
              </li>
              {mcqCount > 0 && (
                <li>
                  <a href={`/practice/subject/${subject.slug}/`}>{subject.title} MCQs</a>
                  <span aria-hidden="true">›</span>
                </li>
              )}
              <li>
                <a href="/past-papers/">Past papers</a>
                <span aria-hidden="true">›</span>
              </li>
              <li>
                <a href="/resources/">Recommended books</a>
                <span aria-hidden="true">›</span>
              </li>
              <li>
                <a href="/topics/">Diagrams and images</a>
                <span aria-hidden="true">›</span>
              </li>
            </ul>
          </section>

          {featuredNote && (
            <section class="side-card side-featured">
              <h2>Featured note</h2>
              <div class="feat">
                <div class="feat-copy">
                  <p class="feat-title">
                    <a href={hrefFor(featuredNote)}>{featuredNote.title}</a>
                  </p>
                  <p class="feat-desc">{featuredNote.excerpt}</p>
                  <a class="feat-link" href={hrefFor(featuredNote)}>
                    {subject.title} <span aria-hidden="true">→</span>
                  </a>
                </div>
                <span class="feat-art" aria-hidden="true">
                  <Illustration name={illustrationForSubject(subject.slug)} size={38} />
                </span>
              </div>
            </section>
          )}

          {topicCards.length > 0 && (
            <section class="side-card">
              <h2>Topics covered</h2>
              <ul>
                {topicCards.map((t) => (
                  <li>
                    <a href={`#topic-${t.slug}`}>{t.title}</a>
                    <span aria-hidden="true">›</span>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {otherSubjects.length > 0 && (
            <section class="side-card">
              <h2>Related subjects</h2>
              <ul class="related-subjects">
                {otherSubjects.map((s) => (
                  <li>
                    <a href={s.href}>
                      <span class="rs-icon" aria-hidden="true">
                        <Illustration name={illustrationForSubject(s.href.split('/')[2])} size={16} />
                      </span>
                      <span class="rs-text">
                        <span class="rs-title">{s.title}</span>
                        {s.context && <span class="rs-sub">{s.context}</span>}
                      </span>
                      <span class="rs-chev" aria-hidden="true">›</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </div>
      </aside>
    </div>
  </div>
</Layout>

<style>
  /* --- hero band ---------------------------------------------------------- */
  .hero {
    background: var(--band);
  }

  .hero-inner {
    display: grid;
    gap: var(--space-8);
    align-items: start;
    padding-block: var(--space-4) var(--space-10);
  }

  .hero-copy {
    max-width: 540px;
  }

  .hero-kicker {
    margin-top: var(--space-3);
  }

  .hero-title {
    margin-top: var(--space-3);
    font-size: clamp(2.25rem, 1.4rem + 3.5vw, 3rem);
    line-height: 1.1;
  }

  .hero-lead {
    max-width: 510px;
    margin-top: var(--space-4);
    color: var(--mute);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  /* --- stats row: icon boxes, bold green values, hairline dividers -------- */
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) 0;
    margin: var(--space-7) 0 0;
  }

  .stat {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-inline: var(--space-4);
    border-left: 1px solid var(--border);
  }

  .stat:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .stat-icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--primary-border);
    border-radius: var(--radius-tag);
    background: var(--surface);
    color: var(--primary);
  }

  .hero-stats dt {
    color: var(--primary);
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: var(--weight-bold);
    line-height: 1.2;
  }

  .hero-stats dd {
    margin: 0;
    color: var(--mute);
    font-size: 0.6875rem;
    line-height: 1.4;
  }

  /* --- hero aside: image/illustration panel + quote card ------------------ */
  .hero-art {
    display: none;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--primary-surface);
    color: var(--primary);
  }

  .hero-img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
  }

  .hero-quote {
    display: none;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--space-4) var(--space-5) var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--quote-surface);
  }

  .hero-quote-mark {
    color: var(--primary-muted, #8ab8ad);
    font-family: var(--font-display);
    font-size: 2.1875rem;
    font-weight: var(--weight-display);
    line-height: 0.6;
  }

  .hero-quote p {
    margin: var(--space-2) 0 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .hero-quote-rule {
    width: 34px;
    height: 3px;
    margin: var(--space-4) 0 var(--space-3);
    background: var(--primary);
  }

  .hero-quote-attr {
    margin: 0;
    color: var(--mute);
    font-family: var(--font-sans);
    font-size: 0.5625rem;
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
    line-height: 1.8;
    text-transform: uppercase;
  }

  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 280px);
    }

    .hero-art {
      display: flex;
    }
  }

  @media (min-width: 1200px) {
    .hero-inner {
      grid-template-columns: minmax(0, 540px) minmax(0, 300px) 200px;
      gap: var(--space-8);
    }

    .hero-quote {
      display: flex;
    }
  }

  /* --- tab strip: text-only, active in green with a 3px underline --------- */
  .tabs {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .tabs ul {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
    list-style: none;
  }

  .tabs ul::-webkit-scrollbar {
    display: none;
  }

  .tabs a {
    display: inline-block;
    padding: var(--space-4) var(--space-3);
    border-bottom: 3px solid transparent;
    color: var(--mute);
    font-size: 0.8125rem;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s var(--ease), border-color 0.15s var(--ease);
  }

  .tabs a:hover {
    border-bottom-color: var(--primary-border);
    color: var(--primary);
  }

  /* The first tab — Study Notes — is the section the reader lands on. */
  .tabs li:first-child a {
    color: var(--primary);
    font-weight: var(--weight-bold);
    border-bottom-color: var(--primary);
  }

  /* --- hub layout ---------------------------------------------------------- */
  .hub {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-8) var(--space-16);
  }

  .hub-main,
  .hub-side {
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .hub {
      grid-template-columns: minmax(0, 1fr) 21rem;
      gap: var(--space-10);
    }

    .hub-sticky {
      position: sticky;
      top: calc(var(--header-height) + var(--space-6));
      max-height: calc(100vh - var(--header-height) - var(--space-12));
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
    }
  }

  @media (max-width: 1023px) {
    .hub-side {
      padding-top: var(--space-8);
      border-top: 1px solid var(--border);
    }
  }

  /* --- introduction prose (folded FAQs / key concepts) --------------------- */
  .introduction {
    max-width: 720px;
  }

  /* --- type filter: a quiet segmented link row ----------------------------- */
  .type-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-bottom: var(--space-5);
  }

  .type-filter a {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding-inline: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--body);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    transition: border-color 0.15s var(--ease), background-color 0.15s var(--ease),
      color 0.15s var(--ease);
  }

  .type-filter a:hover {
    border-color: var(--border-strong);
    color: var(--ink);
  }

  .type-filter a.active {
