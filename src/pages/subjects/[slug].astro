---
/**
 * A subject hub: the central page for one subject.
 *
 * Figma Screen 02: a quiet hero band with real counts and a quote card, a
 * tab strip of real section/page links, chapter cards with hairline note
 * lists, and a sidebar of quick links, a featured note, and related
 * subjects. The tabs are anchor links (or page links where the section
 * lives elsewhere), so every section is crawlable and linkable.
 */
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import Icon from '../../components/Icon.astro';
import Illustration, { illustrationForSubject } from '../../components/Illustration.astro';
import {
  getNotesBySubject,
  getQuestionsBySubject,
  getNotes,
  getBlogPosts,
  getCollection,
} from '../../utils/collections';

export async function getStaticPaths() {
  const subjects = await getCollection('subjects');
  return subjects.map((subject) => ({ params: { slug: subject.slug }, props: { subject } }));
}

const { subject } = Astro.props;
const { data } = subject;

const [grouped, questions, notes, posts, topics, subjects] = await Promise.all([
  getNotesBySubject(subject.slug, data.chapters),
  getQuestionsBySubject(subject.slug),
  getNotes(),
  getBlogPosts(),
  getCollection('topics'),
  getCollection('subjects'),
]);

const subjectNotes = notes.filter((n) => n.data.subject === subject.slug);

// Topic hubs whose slugs appear in this subject's notes.
const subjectTopicSlugs = [...new Set(subjectNotes.flatMap((n) => n.data.topics))];
const subjectTopics = topics.filter((t) => subjectTopicSlugs.includes(t.slug));

// Articles connected to this subject through related notes or shared topics.
const subjectNoteSlugs = subjectNotes.map((n) => n.slug);
const relatedPosts = posts.filter(
  (p) =>
    p.data.relatedNotes.some((slug) => subjectNoteSlugs.includes(slug)) ||
    p.data.topics.some((t) => subjectTopicSlugs.includes(t)),
);

// Other subjects, for the sidebar.
const otherSubjects = subjects
  .filter((s) => s.slug !== subject.slug)
  .map((s) => ({
    href: `/subjects/${s.slug}/`,
    title: s.data.title,
    context: s.data.description.split('.')[0],
  }))
  .slice(0, 3);

const groupsWithNotes = grouped.filter((g) => g.notes.length > 0);
const featuredNote = subjectNotes.find((n) => n.data.popular) ?? subjectNotes[0];

/** The serif line in the hero quote card — one per core subject, Osler otherwise. */
const subjectQuotes: Record<string, string> = {
  anatomy: 'Structure is the language of the body; learn to read it.',
  physiology: 'To heal the body, first understand how it works.',
  biochemistry: 'Life is chemistry, and chemistry is life.',
  pharmacology: 'The right dose separates a remedy from a poison.',
  pathology: 'Every disease tells a story in the tissue.',
  microbiology: 'To understand disease, we must first understand the unseen.',
  'forensic-medicine': 'Where medicine meets justice, evidence speaks.',
  'community-medicine': 'Prevention is better than cure.',
};

const heroQuote =
  subjectQuotes[subject.slug] ??
  'Medicine is a science of uncertainty and an art of probability.';

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.data.title,
}));

/** Section tabs: anchors for on-page sections, page links elsewhere. */
const tabs = [
  { href: '#study-notes', label: 'Study Notes' },
  ...(questions.length > 0 ? [{ href: '#mcqs', label: 'MCQs' }] : []),
  ...(data.importantConcepts.length > 0
    ? [{ href: '#important-topics', label: 'Important Topics' }]
    : []),
  { href: '/past-papers/', label: 'Past Papers' },
  { href: '/resources/', label: 'Recommended Resources' },
];
---

<Layout
  title={`${data.title} Study Notes and Practice Questions | Medical Study Notes`}
  description={data.description}
  path={`/subjects/${subject.slug}/`}
  footerSubjects={footerSubjects}
  wide
>
  {/* --- hero band --------------------------------------------------------- */}
  <section class="hero">
    <div class="container">
      <Breadcrumbs crumbs={[{ label: 'Subjects', href: '/subjects/' }, { label: data.title }]} />
    </div>

    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="kicker hero-kicker">Subject</p>
        <h1 class="hero-title">{data.title}</h1>
        <p class="hero-lead">{data.introduction}</p>

        <dl class="hero-stats">
          <div class="stat">
            <span class="stat-icon" aria-hidden="true"><Icon name="book" size={14} /></span>
            <div>
              <dt>{subjectNotes.length}</dt>
              <dd>Study notes</dd>
            </div>
          </div>
          <div class="stat">
            <span class="stat-icon" aria-hidden="true"><Icon name="question" size={14} /></span>
            <div>
              <dt>{questions.length}</dt>
              <dd>MCQs</dd>
            </div>
          </div>
          <div class="stat">
            <span class="stat-icon" aria-hidden="true"><Icon name="target" size={14} /></span>
            <div>
              <dt>Comprehensive</dt>
              <dd>Exam-focused content</dd>
            </div>
          </div>
        </dl>
      </div>

      <div class="hero-art" aria-hidden="true">
        <Illustration name={illustrationForSubject(subject.slug)} size={130} />
      </div>

      <aside class="hero-quote">
        <span class="hero-quote-mark" aria-hidden="true">“</span>
        <blockquote>
          <p>“{heroQuote}”</p>
        </blockquote>
        <span class="hero-quote-rule" aria-hidden="true"></span>
        <p class="hero-quote-attr">
          {data.title}<br />Builds a healthier tomorrow
        </p>
      </aside>
    </div>
  </section>

  {/* --- section tabs ------------------------------------------------------- */}
  <nav class="tabs" aria-label="Sections on this page">
    <div class="container">
      <ul>
        {tabs.map((tab) => (
          <li><a href={tab.href}>{tab.label}</a></li>
        ))}
      </ul>
    </div>
  </nav>

  <div class="container">
    <div class="hub">
      <div class="hub-main">
        {/* --- chapters ---------------------------------------------------- */}
        <section class="section-plain" aria-labelledby="study-notes">
          <div class="section-head">
            <h2 id="study-notes">Topics in {data.title}</h2>
            <p>
              Browse study notes by topic. Each section includes detailed notes,
              diagrams and key points.
            </p>
          </div>

          {groupsWithNotes.length > 0 ? (
            <div class="chapters">
              {groupsWithNotes.map(({ chapter, notes: chapterNotes }) => (
                <section class="chapter" aria-labelledby={`ch-${chapter.slug}`}>
                  <div class="chapter-head">
                    <span class="chapter-art" aria-hidden="true">
                      <Illustration name={illustrationForSubject(subject.slug)} size={32} />
                    </span>
                    <div>
                      <h3 id={`ch-${chapter.slug}`} class="chapter-title">{chapter.title}</h3>
                      {chapter.description && (
                        <p class="chapter-desc">{chapter.description}</p>
                      )}
                    </div>
                  </div>

                  <ul class="chapter-notes">
                    {chapterNotes.map((note) => (
                      <li>
                        <a href={`/notes/${note.slug}/`}>
                          <span aria-hidden="true">›</span>
                          {note.data.title}
                        </a>
                      </li>
                    ))}
                  </ul>

                  <a class="chapter-more" href={`/notes/#subject-${subject.slug}`}>
                    View all notes <span aria-hidden="true">→</span>
                  </a>
                </section>
              ))}
            </div>
          ) : (
            <div class="empty-state">
              <h3>Notes in progress</h3>
              <p>
                No published notes for this subject yet. Browse the
                <a href="/notes/"> full note index</a> in the meantime.
              </p>
            </div>
          )}

          {/* Chapters with no notes yet are listed plainly rather than shown
              as empty panels. */}
          {grouped.some((g) => g.notes.length === 0) && (
            <p class="upcoming">
              Also planned:
              {grouped
                .filter((g) => g.notes.length === 0)
                .map((g, i) => (
                  <>
                    {i > 0 && <span aria-hidden="true">, </span>}
                    <span>{g.chapter.title}</span>
                  </>
                ))}
            </p>
          )}
        </section>

        {/* --- MCQs --------------------------------------------------------- */}
        {questions.length > 0 && (
          <section class="section" aria-labelledby="mcqs">
            <div class="section-head-row">
              <div>
                <h2 id="mcqs">Practice questions</h2>
                <p>
                  {questions.length} question{questions.length === 1 ? '' : 's'} on
                  {' '}{data.title}, each with the full answer and an explanation.
                </p>
              </div>
              <a class="link-arrow" href={`/practice/subject/${subject.slug}/`}>
                Practise all questions
              </a>
            </div>

            <ul class="chevron-list bordered-list">
              {questions.slice(0, 6).map((q) => (
                <li>
                  <a href={`/practice/${q.slug}/`}>
                    <span class="q-text">{q.data.question}</span>
                    <span class="tag">{q.data.type}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {/* --- important concepts -------------------------------------------- */}
        {data.importantConcepts.length > 0 && (
          <section class="section" aria-labelledby="important-topics">
            <div class="section-head">
              <h2 id="important-topics">Important topics</h2>
              <p>High-yield concepts examiners return to.</p>
            </div>
            <ul class="concepts">
              {data.importantConcepts.map((concept) => <li>{concept}</li>)}
            </ul>
          </section>
        )}

        {/* --- related articles ----------------------------------------------- */}
        {relatedPosts.length > 0 && (
          <section class="section" aria-labelledby="articles">
            <div class="section-head">
              <h2 id="articles">Related articles</h2>
            </div>
            <ul class="chevron-list bordered-list">
              {relatedPosts.map((post) => (
                <li><a href={`/blog/${post.slug}/`}>{post.data.title}</a></li>
              ))}
            </ul>
          </section>
        )}

        {data.exams.length > 0 && (
          <section class="section" aria-labelledby="exams">
            <div class="section-head">
              <h2 id="exams">Exams and boards</h2>
              <p>This material maps to the following examinations.</p>
            </div>
            <ul class="link-list exam-list">
              {data.exams.map((exam) => <li>{exam}</li>)}
            </ul>
          </section>
        )}

        <Faq faqs={data.faqs} />
      </div>

      {/* --- sidebar -------------------------------------------------------- */}
      <aside class="hub-side" aria-label="Subject links">
        <div class="hub-sticky">
          <section class="side-card">
            <h2>Quick links</h2>
            <ul>
              <li>
                <a href={`/notes/#subject-${subject.slug}`}>All {data.title} notes</a>
                <span aria-hidden="true">›</span>
              </li>
              {questions.length > 0 && (
                <li>
                  <a href={`/practice/subject/${subject.slug}/`}>{data.title} MCQs</a>
                  <span aria-hidden="true">›</span>
                </li>
              )}
              {data.importantConcepts.length > 0 && (
                <li>
                  <a href="#important-topics">Important questions</a>
                  <span aria-hidden="true">›</span>
                </li>
              )}
              <li>
                <a href="/past-papers/">Past papers</a>
                <span aria-hidden="true">›</span>
              </li>
              <li>
                <a href="/resources/">Recommended books</a>
                <span aria-hidden="true">›</span>
              </li>
              <li>
                <a href="/topics/">Diagrams and images</a>
                <span aria-hidden="true">›</span>
              </li>
            </ul>
          </section>

          {featuredNote && (
            <section class="side-card side-featured">
              <h2>Featured note</h2>
              <div class="feat">
                <div class="feat-copy">
                  <p class="feat-title">
                    <a href={`/notes/${featuredNote.slug}/`}>{featuredNote.data.title}</a>
                  </p>
                  <p class="feat-desc">{featuredNote.data.description}</p>
                  <a class="feat-link" href={`/notes/${featuredNote.slug}/`}>
                    {data.title} <span aria-hidden="true">→</span>
                  </a>
                </div>
                <span class="feat-art" aria-hidden="true">
                  <Illustration name={illustrationForSubject(subject.slug)} size={38} />
                </span>
              </div>
            </section>
          )}

          {subjectTopics.length > 0 && (
            <section class="side-card">
              <h2>Topics covered</h2>
              <ul>
                {subjectTopics.map((topic) => (
                  <li>
                    <a href={`/topics/${topic.slug}/`}>{topic.data.title}</a>
                    <span aria-hidden="true">›</span>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {otherSubjects.length > 0 && (
            <section class="side-card">
              <h2>Related subjects</h2>
              <ul class="related-subjects">
                {otherSubjects.map((s) => (
                  <li>
                    <a href={s.href}>
                      <span class="rs-icon" aria-hidden="true">
                        <Illustration name={illustrationForSubject(s.href.split('/')[2])} size={16} />
                      </span>
                      <span class="rs-text">
                        <span class="rs-title">{s.title}</span>
                        {s.context && <span class="rs-sub">{s.context}</span>}
                      </span>
                      <span class="rs-chev" aria-hidden="true">›</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </div>
      </aside>
    </div>
  </div>
</Layout>

<style>
  /* --- hero band ---------------------------------------------------------- */
  .hero {
    background: var(--band);
  }

  .hero-inner {
    display: grid;
    gap: var(--space-8);
    align-items: start;
    padding-block: var(--space-4) var(--space-10);
  }

  .hero-copy {
    max-width: 540px;
  }

  .hero-kicker {
    margin-top: var(--space-3);
  }

  .hero-title {
    margin-top: var(--space-3);
    font-size: clamp(2.25rem, 1.4rem + 3.5vw, 3rem);
    line-height: 1.1;
  }

  .hero-lead {
    max-width: 510px;
    margin-top: var(--space-4);
    color: var(--mute);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  /* --- stats row: icon boxes, bold green values, hairline dividers -------- */
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) 0;
    margin: var(--space-7) 0 0;
  }

  .stat {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-inline: var(--space-4);
    border-left: 1px solid var(--border);
  }

  .stat:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .stat-icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--primary-border);
    border-radius: var(--radius-tag);
    background: var(--surface);
    color: var(--primary);
  }

  .hero-stats dt {
    color: var(--primary);
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: var(--weight-bold);
    line-height: 1.2;
  }

  .hero-stats dd {
    margin: 0;
    color: var(--mute);
    font-size: 0.6875rem;
    line-height: 1.4;
  }

  /* --- hero aside: drawing panel + quote card ------------------------------ */
  .hero-art {
    display: none;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--primary-surface);
    color: var(--primary);
  }

  .hero-quote {
    display: none;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--space-4) var(--space-5) var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--quote-surface);
  }

  .hero-quote-mark {
    color: var(--primary-muted, #8ab8ad);
    font-family: var(--font-display);
    font-size: 2.1875rem;
    font-weight: var(--weight-display);
    line-height: 0.6;
  }

  .hero-quote p {
    margin: var(--space-2) 0 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .hero-quote-rule {
    width: 34px;
    height: 3px;
    margin: var(--space-4) 0 var(--space-3);
    background: var(--primary);
  }

  .hero-quote-attr {
    margin: 0;
    color: var(--mute);
    font-family: var(--font-sans);
    font-size: 0.5625rem;
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
    line-height: 1.8;
    text-transform: uppercase;
  }

  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 280px);
    }

    .hero-art {
      display: flex;
    }
  }

  @media (min-width: 1200px) {
    .hero-inner {
      grid-template-columns: minmax(0, 540px) minmax(0, 300px) 200px;
      gap: var(--space-8);
    }

    .hero-quote {
      display: flex;
    }
  }

  /* --- tab strip: text-only, active in green with a 3px underline --------- */
  .tabs {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .tabs ul {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
    list-style: none;
  }

  .tabs ul::-webkit-scrollbar {
    display: none;
  }

  .tabs a {
    display: inline-block;
    padding: var(--space-4) var(--space-3);
    border-bottom: 3px solid transparent;
    color: var(--mute);
    font-size: 0.8125rem;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s var(--ease), border-color 0.15s var(--ease);
  }

  .tabs a:hover {
    border-bottom-color: var(--primary-border);
    color: var(--primary);
  }

  /* The first tab — Study Notes — is the page the reader is on. */
  .tabs li:first-child a {
    color: var(--primary);
    font-weight: var(--weight-bold);
    border-bottom-color: var(--primary);
  }

  /* --- hub layout ---------------------------------------------------------- */
  .hub {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-8) var(--space-16);
  }

  .hub-main,
  .hub-side {
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .hub {
      grid-template-columns: minmax(0, 1fr) 21rem;
      gap: var(--space-10);
    }

    .hub-sticky {
      position: sticky;
      top: calc(var(--header-height) + var(--space-6));
      max-height: calc(100vh - var(--header-height) - var(--space-12));
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
    }
  }

  @media (max-width: 1023px) {
    .hub-side {
      padding-top: var(--space-8);
      border-top: 1px solid var(--border);
    }
  }

  /* --- chapter cards -------------------------------------------------------- */
  .chapters {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 700px) {
    .chapters {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3) var(--space-4);
    }
  }

  .chapter {
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  .chapter-head {
    display: flex;
    gap: 15px;
    align-items: flex-start;
  }

  .chapter-art {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 66px;
    height: 66px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--primary-surface);
    color: var(--primary);
  }

  .chapter-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: var(--weight-display);
    line-height: 1.25;
  }

  .chapter-desc {
    margin-top: 4px;
    color: var(--mute);
    font-size: 0.6875rem;
    line-height: 1.5;
  }

  .chapter-notes {
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .chapter-notes li {
    border-bottom: 1px solid var(--border);
  }

  .chapter-notes a {
    display: flex;
    gap: 8px;
    padding-block: 8px;
    color: var(--mute);
    font-size: 0.6875rem;
    line-height: 1.45;
    text-decoration: none;
  }

  .chapter-notes a span {
    color: var(--faint);
  }

  .chapter-notes a:hover {
    color: var(--primary);
  }

  .chapter-more {
    display: inline-block;
    margin-top: var(--space-4);
    color: var(--primary);
    font-size: 0.75rem;
    font-weight: var(--weight-bold);
    text-decoration: none;
  }

  .chapter-more:hover {
    color: var(--primary-hover);
  }

  .upcoming {
    margin-top: var(--space-6);
    color: var(--faint);
    font-size: var(--text-body-sm);
  }

  /* --- shared list treatments ------------------------------------------------ */
  .bordered-list {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .bordered-list a {
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }

  .q-text {
    flex: 1;
  }

  .concepts {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .concepts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2) var(--space-6);
    }
  }

  .concepts li {
    position: relative;
    padding-left: var(--space-6);
    color: var(--body);
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
  }

  .concepts li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.625rem;
    height: 2px;
    background: var(--primary);
  }

  .exam-list li {
    color: var(--body);
    font-size: var(--text-body-sm);
  }

  /* --- sidebar cards ---------------------------------------------------------- */
  .side-card {
    padding: var(--space-5) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  .side-card + .side-card {
    margin-top: var(--space-3);
  }

  .side-card h2 {
    margin-bottom: var(--space-3);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: var(--weight-display);
    color: var(--ink);
  }

  .side-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .side-card ul li {
    border-bottom: 1px solid var(--border);
