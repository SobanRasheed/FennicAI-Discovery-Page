---
/**
 * Past papers.
 *
 * We hold no actual board/university paper files, so this page presents the
 * honest equivalent of the design's paper library: the question collection
 * filtered by its real exam-pattern tags. Every count, subject, and chip below
 * is derived from real content; rows link to the full worked question instead
 * of a download.
 *
 * Structure follows the design: a band hero with a papers illustration and the
 * pull-quote, three coverage features, a filter bar (search, subject, exam
 * pattern, type), a section head with sort and list/grid view controls, and a
 * rail of popular subjects, a study tip, and where to get help.
 */
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import JsonLd from '../components/JsonLd.astro';
import Icon from '../components/Icon.astro';
import Illustration, { illustrationForSubject } from '../components/Illustration.astro';
import { getQuestions, getCollection } from '../utils/collections';

const [questions, subjects] = await Promise.all([
  getQuestions(),
  getCollection('subjects'),
]);

const subjectTitle = (slug: string) =>
  subjects.find((s) => s.slug === slug)?.data.title ?? slug;

const chapterTitle = (subject: string, chapter?: string) => {
  if (!chapter) return 'General';
  return (
    subjects.find((s) => s.slug === subject)?.data.chapters.find((c) => c.slug === chapter)
      ?.title ?? chapter
  );
};

const typeLabel: Record<string, string> = {
  mcq: 'Multiple choice',
  short: 'Short answer',
  long: 'Long answer',
  numerical: 'Numerical',
};

/** Exam-pattern groups from the real examTag values, largest first. */
const patterns = [
  ...new Set(questions.map((q) => q.data.examTag).filter((t): t is string => Boolean(t))),
]
  .map((tag) => ({
    tag,
    count: questions.filter((q) => q.data.examTag === tag).length,
  }))
  .sort((a, b) => b.count - a.count);

/** Subjects that carry questions, for the filter and rail. */
const filterSubjects = subjects
  .map((subject) => ({
    subject,
    count: questions.filter((q) => q.data.subject === subject.slug).length,
  }))
  .filter((row) => row.count > 0)
  .sort((a, b) => b.count - a.count);

/** Question rows: everything the client-side filter, sort, and search need. */
const rows = questions.map((q) => ({
  slug: q.slug,
  question: q.data.question,
  subject: q.data.subject,
  subjectTitle: subjectTitle(q.data.subject),
  chapter: chapterTitle(q.data.subject, q.data.chapter),
  examTag: q.data.examTag ?? '',
  type: q.data.type,
  typeLabel: typeLabel[q.data.type],
  difficulty: q.data.difficulty,
  illustration: illustrationForSubject(q.data.subject),
  keywords: `${q.data.question} ${q.data.answer} ${q.data.examTag ?? ''} ${subjectTitle(q.data.subject)} ${chapterTitle(q.data.subject, q.data.chapter)}`.toLowerCase(),
}));

const totalTagged = questions.filter((q) => q.data.examTag).length;

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.data.title,
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Past papers — exam-pattern practice questions',
  description:
    'Practice questions grouped by exam pattern: board exam pattern, university midterms, and university finals, each with the full answer and explanation.',
  url: new URL('/past-papers/', Astro.site).href,
  isPartOf: { '@type': 'WebSite', name: 'Medical Study Notes', url: Astro.site!.href },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: patterns.map((pattern, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${pattern.tag} questions`,
      numberOfItems: pattern.count,
    })),
  },
};
---
<Layout
  title="Past Papers — Exam-Pattern Practice Questions | Medical Study Notes"
  description="Practice with questions tagged to real exam patterns — board exams, university midterms, and finals — each with the full answer and a worked explanation."
  path="/past-papers/"
  footerSubjects={footerSubjects}
  wide
>
  <JsonLd data={jsonLd} />

  <PageHeader
    kicker="Past Papers"
    title="Practice Past Papers"
    lead="Practice with exam-pattern questions — board exams, university midterms, and finals. Every question carries the full answer and a worked explanation, so you learn from every attempt."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Past Papers' }]}
    tone="band"
    asideWide
  >
    <ul class="pp-features">
      <li>
        <Icon name="grid" size={22} />
        <div>
          <strong>Wide coverage</strong>
          <span>{filterSubjects.length} subjects · {patterns.length} exam patterns</span>
        </div>
      </li>
      <li>
        <Icon name="clipboard-check" size={22} />
        <div>
          <strong>Exam preparation</strong>
          <span>{totalTagged} pattern-tagged questions</span>
        </div>
      </li>
      <li>
        <Icon name="chart" size={22} />
        <div>
          <strong>Better performance</strong>
          <span>Answers and explanations included</span>
        </div>
      </li>
    </ul>

    <Fragment slot="aside">
      <div class="pp-hero-side">
        <img
          class="pp-hero-art"
          src="/assets/images/papers-hero.png"
          alt=""
          width="720"
          height="564"
          loading="eager"
          decoding="async"
        />

        <figure class="pp-quote">
          <span class="quote-mark" aria-hidden="true">”</span>
          <blockquote>
            <p>The more you practice, the more prepared you become.</p>
          </blockquote>
          <span class="quote-rule" aria-hidden="true"></span>
          <figcaption>Success favors the prepared</figcaption>
        </figure>
      </div>
    </Fragment>
  </PageHeader>

  <div class="container page-body">
    <div class="pp-layout">
      <div class="pp-main">
        <section class="section" aria-labelledby="paper-list">
          <div class="section-head-row">
            <div>
              <h2 id="paper-list">Past papers</h2>
              <p>Browse and filter the question bank by subject, exam pattern, or type.</p>
            </div>
            <div class="list-controls">
              <label class="sort-field" for="pp-sort">
                Sort by
                <select id="pp-sort" data-sort>
                  <option value="pattern">Exam pattern</option>
                  <option value="subject">Subject A–Z</option>
                  <option value="difficulty">Difficulty</option>
                </select>
              </label>
              <div class="view-toggle" role="group" aria-label="Result view">
                <button type="button" data-view="list" aria-pressed="true">
                  <Icon name="list" size={14} />
                  List
                </button>
                <button type="button" data-view="grid" aria-pressed="false">
                  <Icon name="grid" size={14} />
                  Grid
                </button>
              </div>
            </div>
          </div>

          <div class="panel panel-pad filter-panel">
            <div class="filter-grid">
              <div class="field field-search">
                <label for="pp-search">Search</label>
                <div class="search-wrap">
                  <span aria-hidden="true"><Icon name="search" size={16} /></span>
                  <input
                    id="pp-search"
                    type="search"
                    placeholder="Search questions (e.g. SELECT, HTTP, recursion…)"
                    autocomplete="off"
                  />
                </div>
              </div>

              <div class="field">
                <label for="pp-subject">Subject</label>
                <select id="pp-subject">
                  <option value="">All subjects</option>
                  {filterSubjects.map(({ subject }) => (
                    <option value={subject.slug}>{subject.data.title}</option>
                  ))}
                </select>
              </div>

              <div class="field">
                <label for="pp-pattern">Exam pattern</label>
                <select id="pp-pattern">
                  <option value="">All patterns</option>
                  {patterns.map((pattern) => (
                    <option value={pattern.tag}>{pattern.tag}</option>
                  ))}
                </select>
              </div>

              <div class="field">
                <label for="pp-type">Type</label>
                <select id="pp-type">
                  <option value="">All types</option>
                  {Object.entries(typeLabel).map(([value, label]) => (
                    <option value={value}>{label}</option>
                  ))}
                </select>
              </div>
            </div>

            <div class="filter-foot">
              <p class="filter-status" data-status aria-live="polite">
                Showing all {rows.length} question{rows.length === 1 ? '' : 's'}
              </p>
              <button class="btn btn-sm btn-secondary" type="button" data-clear>
                <Icon name="close" size={14} />
                Clear filters
              </button>
            </div>
          </div>

          <ul class="paper-list" data-list>
            {rows.map((row) => (
              <li
                data-row
                data-subject={row.subject}
                data-pattern={row.examTag}
                data-type={row.type}
                data-difficulty={row.difficulty}
                data-sort-subject={row.subjectTitle}
                data-keywords={row.keywords}
              >
                <a class="paper-entry" href={`/practice/${row.slug}/`}>
                  <span class="paper-art" aria-hidden="true">
                    <Illustration name={row.illustration} size={34} />
                  </span>
                  <span class="paper-text">
                    <span class="paper-title">{row.question}</span>
                    <span class="paper-sub">{row.subjectTitle} · {row.chapter}</span>
                    <span class="paper-chips">
                      {row.examTag && <span class="chip chip-pattern">{row.examTag}</span>}
                      <span class="chip">{row.typeLabel}</span>
                      <span class="chip chip-{row.difficulty}">{row.difficulty}</span>
                    </span>
                  </span>
                  <span class="paper-view">
                    View
                    <Icon name="arrow-right" size={14} />
                  </span>
                </a>
              </li>
            ))}
          </ul>

          <div class="empty-state" data-empty hidden>
            <h3>No questions match</h3>
            <p>
              Try a different filter or search term, or browse
              <a href="/practice/">all practice questions</a>.
            </p>
          </div>

          <noscript>
            <div class="notice notice-info nojs-notice">
              Filtering needs JavaScript. All {rows.length} questions are listed above.
            </div>
          </noscript>
        </section>
      </div>

      {/* --- rail ------------------------------------------------------------ */}
      <aside class="pp-side" aria-label="Past paper links">
        <section class="rail-card">
          <h2 class="rail-heading">
            <Icon name="grid" size={22} />
            Popular subjects
          </h2>
          <ul class="rail-subjects">
            {filterSubjects.map(({ subject, count }) => (
              <li>
                <a href={`/practice/subject/${subject.slug}/`}>
                  <span>{subject.data.title}</span>
                  <span class="rail-count">
                    {count} question{count === 1 ? '' : 's'}
                  </span>
                  <span class="rail-chev" aria-hidden="true">
                    <Icon name="chevron-right" size={16} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <a class="link-arrow" href="/subjects/">View all subjects</a>
        </section>

        <section class="rail-card rail-card-tint">
          <h2 class="rail-heading">
            <Icon name="bulb" size={22} />
            Study tip
          </h2>
          <blockquote class="rail-quote">
            <p>“Solving past papers helps you understand the exam pattern and manage your time better.”</p>
          </blockquote>
          <span class="quote-rule" aria-hidden="true"></span>
          <p class="rail-quote-attr">Practice Smarter<br />Score Higher</p>
        </section>

        <section class="rail-card">
          <h2 class="rail-heading">
            <Icon name="question" size={22} />
            Need help?
          </h2>
          <p class="rail-help">
            Not sure which questions to solve first? Read our study guides on technique,
            revision, and exam preparation.
          </p>
          <a class="btn btn-secondary rail-help-btn" href="/blog/category/study-techniques/">
            View study guides
          </a>
        </section>
      </aside>
    </div>
  </div>

  <script>
    const searchEl = document.getElementById('pp-search') as HTMLInputElement | null;
    const subjectEl = document.getElementById('pp-subject') as HTMLSelectElement | null;
    const patternEl = document.getElementById('pp-pattern') as HTMLSelectElement | null;
    const typeEl = document.getElementById('pp-type') as HTMLSelectElement | null;
    const sortEl = document.getElementById('pp-sort') as HTMLSelectElement | null;
    const list = document.querySelector<HTMLElement>('[data-list]');
    const rows = [...document.querySelectorAll<HTMLElement>('[data-row]')];
    const status = document.querySelector<HTMLElement>('[data-status]');
    const empty = document.querySelector<HTMLElement>('[data-empty]');

    const difficultyRank: Record<string, number> = { easy: 0, medium: 1, hard: 2 };

    function apply() {
      const query = (searchEl?.value ?? '').trim().toLowerCase();
      const subject = subjectEl?.value ?? '';
      const pattern = patternEl?.value ?? '';
      const type = typeEl?.value ?? '';

      let visible = 0;
      rows.forEach((row) => {
        const match =
          (!subject || row.dataset.subject === subject) &&
          (!pattern || row.dataset.pattern === pattern) &&
          (!type || row.dataset.type === type) &&
          (!query || (row.dataset.keywords ?? '').includes(query));
        row.toggleAttribute('hidden', !match);
        if (match) visible += 1;
      });

      if (empty) empty.hidden = visible > 0;
      if (status) {
        status.textContent =
          visible === rows.length
            ? `Showing all ${rows.length} question${rows.length === 1 ? '' : 's'}`
            : `${visible} of ${rows.length} question${rows.length === 1 ? '' : 's'}${
                query ? ` matching “${(searchEl?.value ?? '').trim()}”` : ''
              }`;
      }
    }

    /** Re-order the row elements in the DOM by the chosen key. */
    function sortRows() {
      if (!list) return;
      const mode = sortEl?.value ?? 'pattern';
      const items = [...list.querySelectorAll<HTMLElement>('[data-row]')];
      items.sort((a, b) => {
        if (mode === 'subject') {
          return (a.dataset.sortSubject ?? '').localeCompare(b.dataset.sortSubject ?? '');
        }
        if (mode === 'difficulty') {
          return (
            (difficultyRank[a.dataset.difficulty ?? ''] ?? 9) -
            (difficultyRank[b.dataset.difficulty ?? ''] ?? 9)
          );
        }
        return 0;
      });
      items.forEach((item) => list.append(item));
    }

    searchEl?.addEventListener('input', apply);
    subjectEl?.addEventListener('change', apply);
    patternEl?.addEventListener('change', apply);
    typeEl?.addEventListener('change', apply);
    sortEl?.addEventListener('change', sortRows);

    document.querySelector('[data-clear]')?.addEventListener('click', () => {
      if (searchEl) searchEl.value = '';
      if (subjectEl) subjectEl.value = '';
      if (patternEl) patternEl.value = '';
      if (typeEl) typeEl.value = '';
      apply();
    });

    document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const view = btn.dataset.view ?? 'list';
        if (list) list.classList.toggle('is-grid', view === 'grid');
        document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((other) => {
          other.setAttribute('aria-pressed', String(other === btn));
        });
      });
    });
  </script>
</Layout>

<style>
  /* --- hero features ------------------------------------------------------ */
  .pp-features {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-8);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .pp-features li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .pp-features svg {
    flex-shrink: 0;
    color: var(--primary);
  }

  .pp-features strong {
    display: block;
    color: var(--ink);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
  }

  .pp-features span {
    display: block;
    color: var(--mute);
    font-size: var(--text-caption);
  }

  /* --- header aside: papers illustration beside the quote panel ----------- */
  .pp-hero-side {
    display: grid;
    gap: var(--space-4);
    align-items: center;
  }

  .pp-hero-art {
    display: none;
    width: 100%;
    aspect-ratio: 720 / 564;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .pp-quote {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: var(--space-6);
    border-radius: 6px;
    background: var(--quote-surface);
  }

  .quote-mark {
    color: var(--primary);
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: var(--weight-semibold);
    line-height: 0.5;
    margin-bottom: var(--space-4);
  }

  .pp-quote blockquote {
    margin: 0;
  }

  .pp-quote p {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-style: italic;
    font-weight: var(--weight-medium);
    line-height: 1.5;
    text-wrap: balance;
  }

  .quote-rule {
    width: 26px;
    height: 2px;
    margin: var(--space-5) 0 var(--space-3);
    background: var(--primary);
  }

  .pp-quote figcaption {
    color: var(--mute);
    font-family: var(--font-sans);
    font-size: 0.6563rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  @media (min-width: 1024px) {
    .pp-hero-side {
      grid-template-columns: minmax(0, 1fr) minmax(0, 15.5rem);
      gap: var(--space-4);
    }

    .pp-hero-art {
      display: block;
    }
  }

  /* --- main + rail layout ------------------------------------------------- */
  .page-body {
    padding-block: var(--space-12) var(--space-16);
  }

  .pp-layout {
    display: grid;
    gap: var(--space-8);
  }

  .pp-main,
  .pp-side {
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .pp-layout {
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: var(--space-12);
    }
  }

  /* --- section-head controls: sort + view toggle -------------------------- */
  .list-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .sort-field {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--mute);
    font-size: var(--text-body-sm);
  }

  .sort-field select {
    min-width: 10rem;
  }

  .view-toggle {
    display: inline-flex;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .view-toggle button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-3);
    border: 0;
    background: var(--surface);
    color: var(--mute);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-medium);
    cursor: pointer;
    transition: background-color 0.15s var(--ease), color 0.15s var(--ease);
  }

  .view-toggle button + button {
    border-left: 1px solid var(--border);
  }

  .view-toggle button[aria-pressed='true'] {
    background: var(--primary-surface);
    color: var(--primary);
  }

  /* --- filter panel ------------------------------------------------------------ */
  .filter-grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 900px) {
    .filter-grid {
      grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    }
  }

  .search-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .search-wrap svg {
    flex-shrink: 0;
    color: var(--mute);
  }

  .search-wrap input {
    flex: 1;
    min-width: 0;
  }

  .filter-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .filter-status {
    margin: 0;
    color: var(--mute);
    font-size: var(--text-body-sm);
  }

  /* --- question rows ---------------------------------------------------------------- */
  .paper-list {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  /* The grid view from the design: the same rows, two-up. */
  @media (min-width: 760px) {
    .paper-list.is-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .paper-entry {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s var(--ease), background-color 0.15s var(--ease);
  }

  .paper-entry:hover {
    border-color: var(--primary-border);
    background: var(--primary-surface);
  }

  .paper-art {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface-sunken);
    color: var(--primary);
    transition: border-color 0.15s var(--ease), background-color 0.15s var(--ease);
  }

  .paper-entry:hover .paper-art {
    border-color: var(--primary-border);
    background: var(--surface);
  }

  .paper-text {
    flex: 1;
    min-width: 0;
    display: grid;
    gap: var(--space-2);
  }

  .paper-title {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    transition: color 0.15s var(--ease);
  }

  .paper-entry:hover .paper-title {
    color: var(--primary);
  }

  .paper-sub {
    color: var(--mute);
    font-size: var(--text-body-sm);
  }

  .paper-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .chip {
    padding: 2px var(--space-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--body);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.02em;
    text-transform: capitalize;
    white-space: nowrap;
  }

  .chip-pattern {
    border-color: var(--primary-border);
    background: var(--primary-surface);
    color: var(--primary);
  }

  .chip-easy {
    color: var(--primary);
  }

  .chip-hard {
    color: #b4232a;
  }

  .paper-view {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--space-1);
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
  }

  .paper-view svg {
    transition: transform 0.15s var(--ease);
  }

  .paper-entry:hover .paper-view svg {
    transform: translateX(2px);
  }

  .nojs-notice {
    margin-top: var(--space-4);
  }

  /* --- rail --------------------------------------------------------------------------- */
  .pp-side {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .rail-card {
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
