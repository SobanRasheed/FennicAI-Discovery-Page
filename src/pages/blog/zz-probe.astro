---
/**
 * TEMPORARY probe page for debugging the truncated /blog/ render.
 * Delete after use.
 */
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Search from '../../components/Search.astro';
import { getCollection } from '../../utils/collections';
import { listPublishedArticles } from '../../utils/content';

export const prerender = false;

const [{ rows: posts }, subjects] = await Promise.all([
  listPublishedArticles(Astro.locals, { articleType: 'article', perPage: 24 }),
  getCollection('subjects'),
]);
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=86400');

const asDate = (s: string | null) => (s ? new Date(s + 'Z') : undefined);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.data.title,
}));
---

<Layout
  title="Probe | Medical Study Notes"
  description="probe"
  path="/blog/__probe/"
  footerSubjects={footerSubjects}
  wide
>
  <p>STEP-1 after layout</p>
  <PageHeader
    kicker="Medical Education Blog"
    title="Study Smarter. Go Further."
    lead="probe lead"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Blog' }]}
    tone="band"
    asideWide
  >
    <div class="blog-search">
      <Search
        variant="hero"
        id="blog-search"
        placeholder="Search articles…"
        label="Search articles"
      />
    </div>
    <Fragment slot="aside">
      <div class="blog-hero-side">
        <img class="blog-hero-art" src="/assets/icons/blog-hero-books.png" alt="" width="808" height="641" loading="lazy" decoding="async" />
      </div>
    </Fragment>
  </PageHeader>

  <p>STEP-2 after pageheader</p>

  <div>
    {posts.map((post) => (
      <p>
        {post.slug} —
        {asDate(post.published_at ?? post.updated_at) && (
          <time datetime={asDate(post.published_at ?? post.updated_at)!.toISOString()}>
            {fmt(asDate(post.published_at ?? post.updated_at)!)}
          </time>
        )}
      </p>
    ))}
  </div>

  <p>STEP-3 after posts map</p>
</Layout>
<script>
  // plain JS, no TS syntax
  var input = document.getElementById('blog-search');
  if (input) {
    input.addEventListener('input', function () {
      console.log(input.value.trim().toLowerCase());
    });
  }
</script>
