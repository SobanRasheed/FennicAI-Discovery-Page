---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import BlogListing from '../../../components/BlogListing.astro';
import { getCollection } from '../../../utils/collections';
import { listPublishedArticles } from '../../../utils/content';

export const prerender = false;

const POSTS_PER_PAGE = 6;

const currentPage = Number(Astro.params.page);

// Page 1 lives at /blog/.
if (!Number.isInteger(currentPage) || currentPage < 2) {
  return Astro.redirect('/blog/', 301);
}

const [{ rows: posts, total }, subjects] = await Promise.all([
  listPublishedArticles(Astro.locals, {
    articleType: 'article',
    page: currentPage,
    perPage: POSTS_PER_PAGE,
  }),
  getCollection('subjects'),
]);

// Out-of-range pages don't exist.
const totalPages = Math.ceil(total / POSTS_PER_PAGE);
if (currentPage > totalPages) {
  return new Response('Not found', { status: 404 });
}

// Edge caching: browsers get 5 min, Cloudflare revalidates daily.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=86400');

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.data.title,
}));
---

<Layout
  title={`Blog — Page ${currentPage} | Medical Study Notes`}
  description={`All Medical Study Notes articles, page ${currentPage}. Study technique, exam preparation, and medical education guides.`}
  path={`/blog/page/${currentPage}/`}
  footerSubjects={footerSubjects}
  wide
>
  <PageHeader
    kicker={`Page ${currentPage}`}
    title="Articles and study guides"
    crumbs={[{ label: 'Blog', href: '/blog/' }, { label: `Page ${currentPage}` }]}
  />

  <div class="container listing">
    <BlogListing
      posts={posts}
      totalPosts={total}
      currentPage={currentPage}
      perPage={POSTS_PER_PAGE}
    />
  </div>
</Layout>

<style>
  .listing {
    padding-block: var(--space-8) var(--space-16);
  }
</style>
