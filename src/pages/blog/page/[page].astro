---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BlogListing from '../../components/BlogListing.astro';
import { getBlogPosts } from '../../utils/collections';

const POSTS_PER_PAGE = 6;

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
  return Array.from({ length: totalPages }, (_, i) => ({
    params: { page: String(i + 1) },
  })).slice(1); // page 1 lives at /blog/
}

const { page } = Astro.params;
const currentPage = Number(page);
const posts = await getBlogPosts();
const pagePosts = posts.slice(
  (currentPage - 1) * POSTS_PER_PAGE,
  currentPage * POSTS_PER_PAGE,
);
---

<Layout
  title={`Blog — Page ${currentPage} | devsyllabus`}
  description={`All devsyllabus articles, page ${currentPage}. Study techniques, exam preparation, and computer science guides.`}
  path={`/blog/page/${currentPage}/`}
>
  <Breadcrumbs crumbs={[{ label: 'Blog', href: '/blog/' }, { label: `Page ${currentPage}` }]} />

  <h1>All articles</h1>
  <BlogListing posts={pagePosts} totalPosts={posts.length} currentPage={currentPage} />
</Layout>
