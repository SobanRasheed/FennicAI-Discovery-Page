---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import BlogListing from '../../../components/BlogListing.astro';
import { getBlogPosts, getCollection } from '../../../utils/collections';

const POSTS_PER_PAGE = 6;

export async function getStaticPaths() {
  // getStaticPaths is hoisted into its own module and cannot see the
  // component-scope constant above, so it gets its own copy.
  const POSTS_PER_PAGE = 6;
  const posts = await getBlogPosts();
  const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
  return Array.from({ length: totalPages }, (_, i) => ({
    params: { page: String(i + 1) },
  })).slice(1); // page 1 lives at /blog/
}

const { page } = Astro.params;
const currentPage = Number(page);
const [posts, subjects] = await Promise.all([getBlogPosts(), getCollection('subjects')]);
const pagePosts = posts.slice(
  (currentPage - 1) * POSTS_PER_PAGE,
  currentPage * POSTS_PER_PAGE,
);

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.data.title,
}));
---

<Layout
  title={`Blog — Page ${currentPage} | Medical Study Notes`}
  description={`All Medical Study Notes articles, page ${currentPage}. Study technique, exam preparation, and medical education guides.`}
  path={`/blog/page/${currentPage}/`}
  footerSubjects={footerSubjects}
  wide
>
  <PageHeader
    kicker={`Page ${currentPage}`}
    title="Articles and study guides"
    crumbs={[{ label: 'Blog', href: '/blog/' }, { label: `Page ${currentPage}` }]}
  />

  <div class="container listing">
    <BlogListing posts={pagePosts} totalPosts={posts.length} currentPage={currentPage} />
  </div>
</Layout>

<style>
  .listing {
    padding-block: var(--space-8) var(--space-16);
  }
</style>
