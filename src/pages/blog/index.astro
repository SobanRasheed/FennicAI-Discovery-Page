---
/**
 * Blog index.
 *
 * Structure follows the design: a band hero with article search, a books
 * illustration and the Yeats pull-quote; category chips with icon squares; a
 * featured article as an image card; the rest as image-top cards; and a rail
 * of popular topics, a study tip and where to get new articles. The search
 * input filters the cards client-side, so it works instantly and still
 * degrades to the full listing without JavaScript.
 *
 * Server-rendered from D1: published article_type='article', newest first.
 * Cards show the article's featured image when one exists; the decorative
 * PNGs from the design stand in otherwise.
 */
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Search from '../../components/Search.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from '../../utils/collections';
import { listPublishedArticles, listBlogCategoryCounts } from '../../utils/content';

export const prerender = false;

const [{ rows: posts, total }, categoryCounts, subjects] = await Promise.all([
  listPublishedArticles(Astro.locals, { articleType: 'article', perPage: 24 }),
  listBlogCategoryCounts(Astro.locals),
  getCollection('subjects'),
]);

// Edge caching: browsers get 5 min, Cloudflare revalidates daily.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=86400');

/** D1 timestamps are UTC without a zone suffix. */
const asDate = (s: string | null) => (s ? new Date(s + 'Z') : undefined);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

// The featured slot goes to the newest article that actually has a featured
// image; without one, the plain newest article leads.
const featured = posts.find((p) => p.media_key) ?? posts[0];
const latest = featured ? posts.filter((p) => p !== featured) : posts;

/** Tab subtitles for the real categories. */
const categoryBlurbs: Record<string, string> = {
  'study-techniques': 'Learn effectively',
  'exam-preparation': 'Score higher',
  'subject-guides': 'Study smarter per subject',
};

const categoryLabel = (slug: string | null) => (slug ?? 'article').replace(/-/g, ' ');

/** The design's chip icons, mapped onto the real categories. */
const categoryIcons: Record<string, string> = {
  'study-techniques': '/assets/icons/lightbulb.svg',
  'exam-preparation': '/assets/icons/clipboard-check.svg',
  'subject-guides': '/assets/icons/briefcase.svg',
};

/**
 * Articles without an uploaded image use the decorative PNGs from the
 * design, committed as real assets.
 */
const articleImages = [
  '/assets/icons/blog-article-stethoscope.png',
  '/assets/icons/blog-article-anatomy.png',
  '/assets/icons/blog-article-notes.png',
];
const articleImage = (i: number) => articleImages[i % articleImages.length] ?? '';

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.data.title,
}));
---
<Layout
  title="Blog — Study Techniques and Subject Guides | Medical Study Notes"
  description="Articles on study technique, exam preparation, and the subjects we publish notes for. Practical guides with worked examples."
  path="/blog/"
  footerSubjects={footerSubjects}
  wide
>
  <PageHeader
    kicker="Medical Education Blog"
    title="Study Smarter. Go Further."
    lead="Practical guidance, study strategies, and insights to help you succeed in your studies and beyond."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Blog' }]}
    tone="band"
    asideWide
  >
    <div class="blog-search">
      <Search
        variant="hero"
        id="blog-search"
        placeholder="Search articles (e.g. study tips, exam preparation, note taking…)"
        label="Search articles"
      />
    </div>

    <Fragment slot="aside">
      <div class="blog-hero-side">
        <img
          class="blog-hero-art"
          src="/assets/icons/blog-hero-books.png"
          alt=""
          width="808"
          height="641"
          loading="lazy"
          decoding="async"
        />

        <figure class="blog-quote">
          <span class="quote-mark" aria-hidden="true">”</span>
          <blockquote>
            <p>Education is not the filling of a pail, but the lighting of a fire.</p>
          </blockquote>
          <span class="quote-rule" aria-hidden="true"></span>
          <figcaption>W.B. Yeats</figcaption>
        </figure>
      </div>
    </Fragment>
  </PageHeader>

  {categoryCounts.length > 0 && (
    <nav class="cats" aria-label="Article categories">
      <div class="container">
        <ul>
          <li>
            <a href="/blog/" aria-current="page">
              <span class="cat-art" aria-hidden="true">
                <img src="/assets/icons/home.svg" alt="" width="18" height="18" />
              </span>
              <span class="cat-text">
                <span class="cat-title">All Articles</span>
                <span class="cat-blurb">Latest and popular</span>
              </span>
            </a>
          </li>
          {categoryCounts.map(({ category }) => (
            <li>
              <a href={`/blog/category/${category}/`}>
                <span class="cat-art" aria-hidden="true">
                  <img src={categoryIcons[category] ?? '/assets/icons/heart.svg'} alt="" width="20" height="20" />
                </span>
                <span class="cat-text">
                  <span class="cat-title">{categoryLabel(category)}</span>
                  <span class="cat-blurb">{categoryBlurbs[category] ?? 'Articles'}</span>
                </span>
              </a>
            </li>
          ))}
          <li>
            <a href="/blog/archive/">
              <span class="cat-art" aria-hidden="true">
                <Icon name="book-open" size={18} />
              </span>
              <span class="cat-text">
                <span class="cat-title">Archive</span>
                <span class="cat-blurb">Everything, by date</span>
              </span>
            </a>
          </li>
        </ul>
      </div>
    </nav>
  )}

  <div class="container page-body">
    <div class="blog-layout">
      <div class="blog-main">
        <p class="search-status" data-status aria-live="polite"></p>

        {/* --- featured article ------------------------------------------- */}
        {featured && (
          <section class="section" aria-labelledby="featured-article" data-featured>
            <div class="section-head-row">
              <div>
                <h2 id="featured-article">Featured article</h2>
                <p>Our most recent piece.</p>
              </div>
              <a class="link-arrow" href="/blog/archive/">View all articles</a>
            </div>

            <a class="featured-card" href={`/blog/${featured.slug}/`} data-article>
              <figure class="featured-art">
                <img
                  src={featured.media_key ? `/media/${featured.media_key}/` : '/assets/icons/blog-featured.png'}
                  alt={featured.media_key ? featured.media_alt ?? '' : ''}
                  width="994"
                  height="476"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <div class="featured-copy">
                <span class="tag-pill">{categoryLabel(featured.category)}</span>
                <span class="featured-title">{featured.title}</span>
                <span class="featured-excerpt">{featured.excerpt}</span>
                <span class="featured-meta">
                  <span class="meta-item">
                    <img src="/assets/icons/calendar.svg" alt="" width="16" height="16" />
                    {asDate(featured.published_at ?? featured.updated_at) && (
                      <time datetime={asDate(featured.published_at ?? featured.updated_at)!.toISOString()}>
                        {fmt(asDate(featured.published_at ?? featured.updated_at)!)}
                      </time>
                    )}
                  </span>
                  <span class="meta-item">
                    <img src="/assets/icons/clock-icon.svg" alt="" width="16" height="16" />
                    <span>{featured.reading_minutes} min read</span>
                  </span>
                </span>
                <span class="link-arrow featured-cta">Read article</span>
              </div>
            </a>
          </section>
        )}

        {/* --- latest articles ---------------------------------------------- */}
        <section class="section" aria-labelledby="latest-articles">
          <div class="section-head-row">
            <div>
              <h2 id="latest-articles">Latest articles</h2>
              <p>Fresh perspectives, practical advice and helpful resources.</p>
            </div>
            <a class="link-arrow" href="/blog/archive/">View all articles</a>
          </div>

          {latest.length > 0 && (
            <div class="grid grid-3 article-grid">
              {latest.map((post, i) => (
                <a
                  class="article-card"
                  href={`/blog/${post.slug}/`}
                  data-article
                  data-keywords={`${post.title} ${post.excerpt} ${categoryLabel(post.category)}`.toLowerCase()}
                >
                  <figure class="article-art">
                    <img
                      src={post.media_key ? `/media/${post.media_key}/` : articleImage(i)}
                      alt={post.media_key ? post.media_alt ?? '' : ''}
                      width="619"
                      height="235"
                      loading="lazy"
                      decoding="async"
                    />
                  </figure>
                  <div class="article-body">
                    <span class="tag-pill">{categoryLabel(post.category)}</span>
                    <span class="article-title">{post.title}</span>
                    <span class="article-excerpt">{post.excerpt}</span>
                    <span class="article-meta">
                      <span class="meta-item">
                        <img src="/assets/icons/calendar.svg" alt="" width="16" height="16" />
                        {asDate(post.published_at ?? post.updated_at) && (
                          <time datetime={asDate(post.published_at ?? post.updated_at)!.toISOString()}>
                            {fmt(asDate(post.published_at ?? post.updated_at)!)}
                          </time>
                        )}
                      </span>
                      <span class="meta-item">
                        <img src="/assets/icons/clock-icon.svg" alt="" width="16" height="16" />
                        <span>{post.reading_minutes} min read</span>
                      </span>
                    </span>
                  </div>
                </a>
              ))}
            </div>
          )}

          {/* Always in the DOM so the live search can reveal it. Hidden by
              default while there are articles to show. */}
          <div class="empty-state" data-none hidden={latest.length > 0}>
            <h3>No matches</h3>
            <p>
              No articles match that search. Browse the
              <a href="/blog/archive/">full archive</a> or read the
              <a href="/notes/">study notes</a>.
            </p>
          </div>

          <noscript>
            <p class="nojs-note">
              Live search needs JavaScript. All articles are listed above.
            </p>
          </noscript>
        </section>
      </div>

      {/* --- rail ---------------------------------------------------------- */}
      <aside class="blog-side" aria-label="Blog links">
        {categoryCounts.length > 0 && (
          <section class="rail-card">
            <h2 class="rail-heading">
              <img src="/assets/icons/bar-chart-24.svg" alt="" width="24" height="24" />
              Popular topics
            </h2>
            <ul class="rail-topics">
              {categoryCounts.map(({ category, count }) => (
                <li>
                  <a href={`/blog/category/${category}/`}>
                    <span class="rail-topic-name">{categoryLabel(category)}</span>
                    <span class="rail-count">{count}</span>
                    <span class="rail-chev" aria-hidden="true">
                      <Icon name="chevron-right" size={16} />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
            <a class="link-arrow" href="/blog/archive/">View the archive</a>
          </section>
        )}

        <section class="rail-card rail-card-tint">
          <h2 class="rail-heading">
            <img src="/assets/icons/lightbulb.svg" alt="" width="24" height="24" />
            Study tip
          </h2>
          <blockquote class="rail-quote">
            <p>“Spaced repetition and active recall are among the most effective learning techniques.”</p>
          </blockquote>
          <span class="quote-rule" aria-hidden="true"></span>
          <p class="rail-quote-attr">Study Smarter<br />Remember Longer</p>
        </section>

        <section class="rail-card">
          <h2 class="rail-heading">
            <img src="/assets/icons/envelope.svg" alt="" width="24" height="24" />
            Get new articles
          </h2>
          <p class="rail-help">
            Stay updated with our latest articles, study tips and resources.
          </p>
          <ul class="chevron-list">
            <li><a href="/blog/archive/">Browse the archive</a></li>
            <li><a href="/contact/">Suggest a topic</a></li>
          </ul>
        </section>
      </aside>
    </div>
  </div>

  <script>
    const input = document.getElementById('blog-search') as HTMLInputElement | null;
    const cards = [...document.querySelectorAll<HTMLElement>('[data-article]')];
    const featuredWrap = document.querySelector<HTMLElement>('[data-featured]');
    const status = document.querySelector<HTMLElement>('[data-status]');
    const empty = document.querySelector<HTMLElement>('[data-none]');

    if (input && cards.length > 0) {
      input.addEventListener('input', () => {
        const query = input.value.trim().toLowerCase();
        let shown = 0;

        cards.forEach((card) => {
          const keywords = card.dataset.keywords ?? card.textContent?.toLowerCase() ?? '';
          const match = !query || keywords.includes(query);
          card.closest('li')?.toggleAttribute('hidden', !match);
          card.toggleAttribute('hidden', !match);
          if (match) shown += 1;
        });

        // While searching, the featured card folds into the regular results.
        if (featuredWrap) featuredWrap.hidden = Boolean(query);

        if (empty) {
          const latestCards = cards.slice(featuredWrap ? 1 : 0);
          const noneVisible = latestCards.every(
            (card) => card.hasAttribute('hidden') || (card.closest('li')?.hasAttribute('hidden') ?? false),
          );
          empty.hidden = !noneVisible;
        }

        if (status) {
          status.textContent = query
            ? `${shown} article${shown === 1 ? '' : 's'} matching “${input.value.trim()}”`
            : '';
        }
      });
    }
  </script>
</Layout>

<style>
  .blog-search {
    margin-top: var(--space-6);
    max-width: 40rem;
  }

  /* --- header aside: books illustration beside the quote panel ------------ */
  .blog-hero-side {
    display: grid;
    gap: var(--space-4);
    align-items: center;
  }

  .blog-hero-art {
    display: none;
    width: 100%;
    aspect-ratio: 808 / 641;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  /* The Yeats pull-quote on its pearl panel, as in the design. */
  .blog-quote {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: var(--space-6);
    border-radius: 6px;
    background: var(--quote-surface);
  }

  .quote-mark {
    color: var(--primary);
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: var(--weight-semibold);
    line-height: 0.5;
    margin-bottom: var(--space-4);
  }

  .blog-quote blockquote {
    margin: 0;
  }

  .blog-quote p {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-style: italic;
    font-weight: var(--weight-medium);
    line-height: 1.5;
    text-wrap: balance;
  }

  .quote-rule {
    width: 26px;
    height: 2px;
    margin: var(--space-5) 0 var(--space-3);
    background: var(--primary);
  }

  .blog-quote figcaption {
    color: var(--mute);
    font-family: var(--font-sans);
    font-size: 0.6563rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  @media (min-width: 1024px) {
    .blog-hero-side {
      grid-template-columns: minmax(0, 1fr) minmax(0, 15.5rem);
      gap: var(--space-4);
    }

    .blog-hero-art {
      display: block;
    }
  }

  /* --- category chips ---------------------------------------------------- */
  .cats {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .cats ul {
    display: flex;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
    list-style: none;
  }

  .cats ul::-webkit-scrollbar {
    display: none;
  }

  /* Hairline dividers between the chips, as in the design. */
  .cats li + li {
    border-left: 1px solid var(--border);
  }

  .cats a {
    display: flex;
    flex: 1 0 auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    color: var(--body);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s var(--ease);
  }

  .cats a:hover {
    background: var(--band);
  }

  .cats a[aria-current='page'] {
    background: var(--quote-surface);
  }

  .cat-art {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: var(--quote-surface);
    color: var(--primary);
  }

  .cats a[aria-current='page'] .cat-art {
    background: var(--primary);
  }

  .cat-text {
    display: grid;
    gap: 2px;
  }

  .cat-title {
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    text-transform: capitalize;
  }

  .cat-blurb {
    color: var(--mute);
    font-size: var(--text-caption);
  }

  /* --- layout ------------------------------------------------------------- */
  .page-body {
    padding-block: var(--space-12) var(--space-16);
  }

  .blog-layout {
    display: grid;
    gap: var(--space-8);
  }

  .blog-main,
  .blog-side {
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .blog-layout {
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: var(--space-12);
    }
  }

  .search-status {
    margin: 0 0 var(--space-2);
    color: var(--mute);
    font-size: var(--text-body-sm);
  }

  .search-status:empty {
    display: none;
  }

  /* --- shared card bits ------------------------------------------------------ */
  .tag-pill {
    justify-self: start;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--quote-surface);
    color: var(--primary);
    font-size: var(--text-micro);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--mute);
    font-size: var(--text-caption);
    font-variant-numeric: tabular-nums;
  }

  /* --- featured card --------------------------------------------------------- */
  .featured-card {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s var(--ease);
  }

  .featured-card:hover {
    border-color: var(--primary-border);
  }

  .featured-art {
    margin: 0;
  }

  .featured-art img {
    display: block;
    width: 100%;
    aspect-ratio: 994 / 476;
    object-fit: cover;
  }

  .featured-copy {
    display: grid;
    gap: var(--space-3);
    align-content: center;
    padding: var(--space-6);
  }

  @media (min-width: 768px) {
    .featured-card {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    }

    .featured-art img {
      height: 100%;
      aspect-ratio: auto;
    }

    .featured-copy {
      padding: var(--space-8);
    }
  }

  .featured-title {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.4375rem);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    text-wrap: balance;
    transition: color 0.15s var(--ease);
  }

  .featured-card:hover .featured-title {
    color: var(--primary);
  }

  .featured-excerpt {
    color: var(--body);
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
  }

  .featured-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  .featured-cta {
    margin-top: var(--space-2);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
  }

  /* --- article cards ------------------------------------------------------------ */
  .article-grid {
    gap: var(--space-4);
  }

  .article-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s var(--ease), background-color 0.15s var(--ease);
  }

  .article-card:hover {
    border-color: var(--primary-border);
    background: var(--primary-surface);
  }

  .article-art {
    margin: 0;
  }

  .article-art img {
    display: block;
    width: 100%;
    aspect-ratio: 619 / 235;
    object-fit: cover;
  }

  .article-body {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-5);
  }

  .article-title {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    transition: color 0.15s var(--ease);
  }

  .article-card:hover .article-title {
    color: var(--primary);
  }

  .article-excerpt {
    color: var(--mute);
    font-size: 0.8125rem;
    line-height: var(--leading-normal);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-1);
  }

  .nojs-note {
    margin-top: var(--space-4);
    color: var(--mute);
    font-size: var(--text-body-sm);
  }

  /* --- rail ------------------------------------------------------------------------ */
  .blog-side {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .rail-card {
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .rail-card-tint {
    background: var(--quote-surface);
  }

  .rail-heading {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: var(--weight-display);
  }

  .rail-topics {
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  .rail-topics li + li {
    border-top: 1px solid var(--border);
  }

  .rail-topics a {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) 0;
    color: var(--ink);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    text-transform: capitalize;
    transition: color 0.15s var(--ease);
  }

  .rail-topics a:hover {
    color: var(--primary);
  }

  .rail-topic-name {
    flex: 1;
    min-width: 0;
  }

  .rail-count {
    flex-shrink: 0;
    color: var(--mute);
    font-size: var(--text-body-sm);
