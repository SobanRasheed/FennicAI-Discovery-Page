---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import BlogListing from '../../components/BlogListing.astro';
import { getBlogPosts, getBlogCategories, getCollection } from '../../utils/collections';

const POSTS_PER_PAGE = 6;

const [posts, categories, subjects] = await Promise.all([
  getBlogPosts(),
  getBlogCategories(),
  getCollection('subjects'),
]);
const pagePosts = posts.slice(0, POSTS_PER_PAGE);

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.data.title,
}));
---

<Layout
  title="Blog — Study Techniques and Medical Education | Medical Study Notes"
  description="Articles on study technique, exam preparation, and medical education, written for students. Practical guides with worked examples."
  path="/blog/"
  footerSubjects={footerSubjects}
  wide
>
  <PageHeader
    kicker="Blog"
    title="Articles and study guides"
    lead="Writing on study technique, exam preparation, and the subjects we publish notes for. Every article is written by a named author and reviewed before publication."
    crumbs={[{ label: 'Blog' }]}
  />

  {categories.length > 0 && (
    <nav class="cats" aria-label="Article categories">
      <div class="container">
        <ul>
          <li><a href="/blog/" aria-current="page">All</a></li>
          {categories.map((category) => (
            <li>
              <a href={`/blog/category/${category}/`}>{category.replace(/-/g, ' ')}</a>
            </li>
          ))}
          <li><a href="/blog/archive/">Archive</a></li>
        </ul>
      </div>
    </nav>
  )}

  <div class="container listing">
    <BlogListing posts={pagePosts} totalPosts={posts.length} currentPage={1} />
  </div>
</Layout>

<style>
  .cats {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .cats ul {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
    list-style: none;
  }

  .cats ul::-webkit-scrollbar {
    display: none;
  }

  .cats a {
    display: inline-block;
    padding: var(--space-4) var(--space-3);
    border-bottom: 2px solid transparent;
    color: var(--body);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    white-space: nowrap;
    text-transform: capitalize;
    transition: color 0.15s var(--ease), border-color 0.15s var(--ease);
  }

  .cats a:hover {
    border-bottom-color: var(--primary-border);
    color: var(--primary);
  }

  .cats a[aria-current='page'] {
    border-bottom-color: var(--primary);
    color: var(--primary);
  }

  .listing {
    padding-block: var(--space-8) var(--space-16);
  }
</style>
