---
import Layout from '../../../../../layouts/Layout.astro';
import PageHeader from '../../../../../components/PageHeader.astro';
import BlogListing from '../../../../../components/BlogListing.astro';
import { BLOG_CATEGORIES, listPublishedArticles, listSubjects } from '../../../../../utils/content';

export const prerender = false;

const POSTS_PER_PAGE = 6;

const category = String(Astro.params.category ?? '');
const currentPage = Number(Astro.params.page);

// Only the known blog categories resolve.
if (!(BLOG_CATEGORIES as readonly string[]).includes(category)) {
  return new Response('Not found', { status: 404 });
}

// Page 1 lives at the category root.
if (!Number.isInteger(currentPage) || currentPage < 2) {
  return Astro.redirect(`/blog/category/${category}/`, 301);
}

const [{ rows: posts, total }, subjects] = await Promise.all([
  listPublishedArticles(Astro.locals, {
    articleType: 'article',
    category,
    page: currentPage,
    perPage: POSTS_PER_PAGE,
  }),
  listSubjects(Astro.locals),
]);

// Out-of-range pages don't exist.
const totalPages = Math.ceil(total / POSTS_PER_PAGE);
if (total === 0 || currentPage > totalPages) {
  return new Response('Not found', { status: 404 });
}

// Edge caching: browsers get 5 min, Cloudflare revalidates daily.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=86400');

const label = category.replace(/-/g, ' ');

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.title,
}));
---

<Layout
  title={`${label} Articles — Page ${currentPage} | Medical Study Notes`}
  description={`All ${label} articles on Medical Study Notes, page ${currentPage}.`}
  path={`/blog/category/${category}/page/${currentPage}/`}
  footerSubjects={footerSubjects}
  wide
>
  <PageHeader
    kicker={`Page ${currentPage}`}
    title={label}
    crumbs={[
      { label: 'Blog', href: '/blog/' },
      { label, href: `/blog/category/${category}/` },
      { label: `Page ${currentPage}` },
    ]}
  />

  <div class="container listing">
    <BlogListing
      posts={posts}
      totalPosts={total}
      currentPage={currentPage}
      basePath={`/blog/category/${category}`}
      perPage={POSTS_PER_PAGE}
    />
  </div>
</Layout>

<style>
  .listing {
    padding-block: var(--space-8) var(--space-16);
  }
</style>
