---
import Layout from '../../../../../layouts/Layout.astro';
import PageHeader from '../../../../../components/PageHeader.astro';
import BlogListing from '../../../../../components/BlogListing.astro';
import { getPostsByCategory, getCollection } from '../../../../../utils/collections';

const POSTS_PER_PAGE = 6;

export async function getStaticPaths() {
  // getStaticPaths is hoisted into its own module and cannot see the
  // component-scope constant above, so it gets its own copy.
  const POSTS_PER_PAGE = 6;
  const categories = ['api-design', 'study-techniques', 'databases', 'web-development'];
  const paths = [];
  for (const category of categories) {
    const posts = await getPostsByCategory(category);
    const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
    for (let page = 2; page <= totalPages; page++) {
      paths.push({ params: { category, page: String(page) }, props: { category, page } });
    }
  }
  return paths;
}

const { category, page } = Astro.props;
const currentPage = Number(page);
const [posts, subjects] = await Promise.all([
  getPostsByCategory(category),
  getCollection('subjects'),
]);
const pagePosts = posts.slice(
  (currentPage - 1) * POSTS_PER_PAGE,
  currentPage * POSTS_PER_PAGE,
);
const label = category.replace(/-/g, ' ');

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.data.title,
}));
---

<Layout
  title={`${label} Articles — Page ${currentPage} | Medical Study Notes`}
  description={`All ${label} articles on Medical Study Notes, page ${currentPage}.`}
  path={`/blog/category/${category}/page/${currentPage}/`}
  footerSubjects={footerSubjects}
  wide
>
  <PageHeader
    kicker={`Page ${currentPage}`}
    title={label}
    crumbs={[
      { label: 'Blog', href: '/blog/' },
      { label, href: `/blog/category/${category}/` },
      { label: `Page ${currentPage}` },
    ]}
  />

  <div class="container listing">
    <BlogListing
      posts={pagePosts}
      totalPosts={posts.length}
      currentPage={currentPage}
      basePath={`/blog/category/${category}`}
      perPage={POSTS_PER_PAGE}
    />
  </div>
</Layout>

<style>
  .listing {
    padding-block: var(--space-8) var(--space-16);
  }
</style>
