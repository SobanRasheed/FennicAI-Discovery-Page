---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import BlogListing from '../../../components/BlogListing.astro';
import { BLOG_CATEGORIES, listPublishedArticles, listSubjects } from '../../../utils/content';

export const prerender = false;

const POSTS_PER_PAGE = 6;

const categoryLabels: Record<string, string> = {
  'study-techniques': 'Study Techniques',
  'exam-preparation': 'Exam Preparation',
  'subject-guides': 'Subject Guides',
};

const category = String(Astro.params.category ?? '');

// Only the known blog categories resolve; empty ones 404, matching the static
// build where a category without posts simply had no page.
if (!(BLOG_CATEGORIES as readonly string[]).includes(category)) {
  return new Response('Not found', { status: 404 });
}

const [{ rows: posts, total }, subjects] = await Promise.all([
  listPublishedArticles(Astro.locals, { articleType: 'article', category, perPage: POSTS_PER_PAGE }),
  listSubjects(Astro.locals),
]);

if (total === 0) {
  return new Response('Not found', { status: 404 });
}

// Edge caching: browsers get 5 min, Cloudflare revalidates daily.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=86400');

const label = categoryLabels[category] ?? category.replace(/-/g, ' ');

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.title,
}));
---

<Layout
  title={`${label} Articles | Medical Study Notes`}
  description={`All ${label.toLowerCase()} articles on Medical Study Notes, ${total} in total, with new articles added regularly.`}
  path={`/blog/category/${category}/`}
  footerSubjects={footerSubjects}
  wide
>
  <PageHeader
    kicker="Category"
    title={label}
    lead={`${total} article${total === 1 ? '' : 's'} in this category.`}
    crumbs={[{ label: 'Blog', href: '/blog/' }, { label }]}
  />

  <div class="container listing">
    <BlogListing
      posts={posts}
      totalPosts={total}
      currentPage={1}
      basePath={`/blog/category/${category}`}
      perPage={POSTS_PER_PAGE}
    />
    <p class="listing-back"><a class="link-arrow" href="/blog/">All articles</a></p>
  </div>
</Layout>

<style>
  .listing {
    padding-block: var(--space-8) var(--space-16);
  }

  .listing-back {
    margin-top: var(--space-8);
  }
</style>
