---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import BlogListing from '../../../components/BlogListing.astro';
import { getPostsByCategory, getBlogCategories, getCollection } from '../../../utils/collections';

const POSTS_PER_PAGE = 6;

const categoryLabels: Record<string, string> = {
  'study-techniques': 'Study Techniques',
  'exam-preparation': 'Exam Preparation',
  'subject-guides': 'Subject Guides',
};

export async function getStaticPaths() {
  const categories = await getBlogCategories();
  return categories.map((category) => ({
    params: { category },
    props: { category },
  }));
}

const { category } = Astro.props;
const [posts, subjects] = await Promise.all([
  getPostsByCategory(category),
  getCollection('subjects'),
]);
const label = categoryLabels[category] ?? category.replace(/-/g, ' ');
const pagePosts = posts.slice(0, POSTS_PER_PAGE);

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.data.title,
}));
---

<Layout
  title={`${label} Articles | Medical Study Notes`}
  description={`All ${label.toLowerCase()} articles on Medical Study Notes, ${posts.length} in total, with new articles added regularly.`}
  path={`/blog/category/${category}/`}
  footerSubjects={footerSubjects}
  wide
>
  <PageHeader
    kicker="Category"
    title={label}
    lead={`${posts.length} article${posts.length === 1 ? '' : 's'} in this category.`}
    crumbs={[{ label: 'Blog', href: '/blog/' }, { label }]}
  />

  <div class="container listing">
    <BlogListing
      posts={pagePosts}
      totalPosts={posts.length}
      currentPage={1}
      basePath={`/blog/category/${category}`}
      perPage={POSTS_PER_PAGE}
    />
    <p class="listing-back"><a class="link-arrow" href="/blog/">All articles</a></p>
  </div>
</Layout>

<style>
  .listing {
    padding-block: var(--space-8) var(--space-16);
  }

  .listing-back {
    margin-top: var(--space-8);
  }
</style>
