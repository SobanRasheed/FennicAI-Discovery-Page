---
/**
 * Complete crawlable archive: every published blog article on one page,
 * newest first, grouped by year. Complements the paginated /blog/ listing.
 * Server-rendered from D1.
 */
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { listPublishedArticles, listBlogCategoryCounts, listSubjects } from '../../utils/content';

export const prerender = false;

const [{ rows: posts }, categories, subjects] = await Promise.all([
  listPublishedArticles(Astro.locals, { articleType: 'article', perPage: 1000 }),
  listBlogCategoryCounts(Astro.locals),
  listSubjects(Astro.locals),
]);

// Edge caching: browsers get 5 min, Cloudflare revalidates daily.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=86400');

/** D1 timestamps are UTC without a zone suffix. */
const asDate = (s: string | null) => (s ? new Date(s + 'Z') : new Date());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = asDate(post.published_at ?? post.updated_at).getFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.title,
}));
---

<Layout
  title="Article Archive — Every Post Since the Beginning | devsyllabus"
  description="The complete devsyllabus article archive, grouped by year, with categories. Every article ever published, on one crawlable page."
  path="/blog/archive/"
  footerSubjects={footerSubjects}
>
  <Breadcrumbs crumbs={[{ label: 'Blog', href: '/blog/' }, { label: 'Archive' }]} />

  <div class="doc">
  <h1>Article archive</h1>
  <p>
    Every article published on devsyllabus, newest first. For browsing by
    category instead of date, see the
    <a href="/blog/">blog categories</a>.
  </p>

  {years.map((year) => (
    <section>
      <h2>{year}</h2>
      <ul>
        {byYear.get(year)!.map((post) => (
          <li>
            <time datetime={asDate(post.published_at ?? post.updated_at).toISOString()}>
              {fmt(asDate(post.published_at ?? post.updated_at))}
            </time>
            — <a href={`/blog/${post.slug}/`}>{post.title}</a>
            {post.category && <span> ({post.category})</span>}
          </li>
        ))}
      </ul>
    </section>
  ))}

  {categories.length > 0 && (
    <p>
      Categories in use:
      {categories.map(({ category }, i) => (
        <>
          {i > 0 && <span>, </span>}
          <a href={`/blog/category/${category}/`}>{category.replace(/-/g, ' ')}</a>
        </>
      ))}
    </p>
  )}
  </div>
</Layout>
