---
/**
 * A blog article. Same reading shell as a study note, but the sidebar carries
 * related notes and the author rather than quick facts, since an article has
 * no chapter taxonomy behind it.
 */
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ArticleHeader from '../../components/ArticleHeader.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import SidebarPanel from '../../components/SidebarPanel.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import ReferenceList from '../../components/ReferenceList.astro';
import Faq from '../../components/Faq.astro';
import JsonLd from '../../components/JsonLd.astro';
import Icon from '../../components/Icon.astro';
import { getBlogPosts, getNotes, getCollection, isoDate } from '../../utils/collections';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { data } = post;
const { Content: PostBody, headings } = await render(post);

const [authors, allNotes, allPosts, subjects] = await Promise.all([
  getCollection('authors'),
  getNotes(),
  getBlogPosts(),
  getCollection('subjects'),
]);

const author = authors.find((a) => a.slug === data.author);
const relatedNotes = allNotes.filter((n) => data.relatedNotes.includes(n.slug));

// Prev/next in published order.
const index = allPosts.findIndex((p) => p.slug === post.slug);
const newer = index > 0 ? allPosts[index - 1] : undefined;
const older = index < allPosts.length - 1 ? allPosts[index + 1] : undefined;

const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug && p.data.topics.some((t) => data.topics.includes(t)))
  .slice(0, 4);

const tocHeadings = [
  ...headings.filter((h) => h.depth === 2 || h.depth === 3),
  ...(data.references.length > 0
    ? [{ depth: 2, text: 'References', slug: 'references' }]
    : []),
];

const categoryLabel = data.category.replace(/-/g, ' ');
const title = data.seoTitle ?? data.title;
const site = Astro.site!;

/** Reading time at 200 words per minute, from the raw markdown. */
const readingMinutes = Math.max(
  1,
  Math.round((post.body ?? '').split(/\s+/).filter(Boolean).length / 200),
);

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.data.title,
}));

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  datePublished: isoDate(data.publishedDate),
  dateModified: isoDate(data.updatedDate ?? data.publishedDate),
  author: author
    ? {
        '@type': 'Person',
        name: author.data.title,
        url: new URL(`/authors/${author.slug}/`, site).href,
      }
    : undefined,
  publisher: {
    '@type': 'Organization',
    name: 'Medical Study Notes',
    url: site.href,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(`/blog/${post.slug}/`, site).href,
  },
  articleSection: data.category,
};
---

<ArticleLayout
  title={`${title} | Medical Study Notes`}
  description={data.description}
  path={`/blog/${post.slug}/`}
  noindex={data.noindex}
  publishedTime={data.publishedDate}
  modifiedTime={data.updatedDate ?? data.publishedDate}
  footerSubjects={footerSubjects}
  crumbs={[
    { label: 'Blog', href: '/blog/' },
    { label: categoryLabel, href: `/blog/category/${data.category}/` },
    { label: data.title },
  ]}
>
  <JsonLd data={articleSchema} />

  {tocHeadings.length >= 3 && (
    <Fragment slot="rail">
      <TableOfContents headings={tocHeadings} numbered={false} />
    </Fragment>
  )}

  {/* --- article actions: share / print / save --------------------------- */}
  <div class="article-actions" role="group" aria-label="Article actions">
    <button class="action-btn" type="button" data-action="share">
      <Icon name="share" size={15} />
      <span>Share</span>
      <span class="action-feedback" data-feedback="share" role="status"></span>
    </button>
    <button class="action-btn" type="button" data-action="print">
      <Icon name="print" size={15} />
      <span>Print</span>
    </button>
    <button class="action-btn" type="button" data-action="save" data-save-slug={post.slug}>
      <Icon name="bookmark" size={15} />
      <span data-save-label>Save article</span>
      <span class="action-feedback" data-feedback="save" role="status"></span>
    </button>
  </div>

  <ArticleHeader
    title={data.title}
    kicker={categoryLabel}
    kickerHref={`/blog/category/${data.category}/`}
    standfirst={data.description}
    published={data.publishedDate}
    updated={data.updatedDate}
    readingMinutes={readingMinutes}
    author={author?.data.title}
    authorHref={author ? `/authors/${author.slug}/` : undefined}
  />

  <div class="prose post-body">
    <PostBody />
  </div>

  <ReferenceList references={data.references} />

  {(older || newer) && (
    <nav class="prev-next" aria-label="Article navigation">
      {older ? (
        <a class="pn-link pn-prev" href={`/blog/${older.slug}/`} rel="prev">
          <span class="pn-label"><Icon name="chevron-right" size={14} /> Previous</span>
          <span class="pn-title">{older.data.title}</span>
        </a>
      ) : <span />}
      {newer && (
        <a class="pn-link pn-next" href={`/blog/${newer.slug}/`} rel="next">
          <span class="pn-label">Next <Icon name="chevron-right" size={14} /></span>
          <span class="pn-title">{newer.data.title}</span>
        </a>
      )}
    </nav>
  )}

  {author && (
    <section class="author-box" aria-labelledby="about-the-author">
      <h2 id="about-the-author" class="author-heading">About the author</h2>
      <p class="author-name">
        <a href={`/authors/${author.slug}/`}>{author.data.title}</a>
        <span class="author-role">{author.data.role}</span>
      </p>
      <p class="author-bio">{author.data.bio}</p>
    </section>
  )}

  <Faq faqs={data.faqs} level={2} id="post-faq" />

  <Fragment slot="sidebar">
    {relatedNotes.length > 0 && (
      <SidebarPanel heading="Related study notes" icon="book">
        <RelatedContent
          items={relatedNotes.map((n) => ({
            href: `/notes/${n.slug}/`,
            title: n.data.title,
            context: subjects.find((s) => s.slug === n.data.subject)?.data.title,
          }))}
          variant="list"
          heading=""
          level={3}
          id="side-notes"
        />
      </SidebarPanel>
    )}

    {relatedPosts.length > 0 && (
      <SidebarPanel heading="Related articles" icon="notes">
        <RelatedContent
          items={relatedPosts.map((p) => ({
            href: `/blog/${p.slug}/`,
            title: p.data.title,
            context: p.data.category.replace(/-/g, ' '),
          }))}
          variant="list"
          heading=""
          level={3}
          id="side-posts"
        />
      </SidebarPanel>
    )}

    <SidebarPanel variant="tint" heading="Practice what you learn" icon="question">
      <p class="practice-copy">
        Test your knowledge with subject-wise MCQs and track your progress.
      </p>
      <a class="btn btn-secondary practice-btn" href="/practice/">Start Practicing</a>
    </SidebarPanel>

    <SidebarPanel heading="Keep reading" icon="link">
      <ul class="chevron-list">
        <li><a href="/blog/">All articles</a></li>
        <li><a href="/notes/">Study notes</a></li>
        <li><a href="/practice/">Practice questions</a></li>
        <li><a href="/editorial-policy/">Editorial policy</a></li>
      </ul>
    </SidebarPanel>
  </Fragment>

  <script>
    const actions = document.querySelector<HTMLElement>('[data-action]')?.parentElement;
    const SAVE_KEY = 'msn:saved-articles';

    const savedList = (): { slug: string; title: string; href: string }[] => {
      try {
        return JSON.parse(localStorage.getItem(SAVE_KEY) ?? '[]');
      } catch {
        return [];
      }
    };

    const writeSaved = (list: { slug: string; title: string; href: string }[]) => {
      try {
        localStorage.setItem(SAVE_KEY, JSON.stringify(list));
      } catch {
        /* storage unavailable (private mode, disabled) — saving just won't persist */
      }
    };

    const flash = (key: string, message: string) => {
      const el = document.querySelector<HTMLElement>(`[data-feedback="${key}"]`);
      if (!el) return;
      el.textContent = message;
      window.setTimeout(() => {
        el.textContent = '';
      }, 2000);
    };

    const saveBtn = document.querySelector<HTMLButtonElement>('[data-action="save"]');
    const saveLabel = document.querySelector<HTMLElement>('[data-save-label]');

    const syncSaveState = () => {
      if (!saveBtn || !saveLabel) return;
      const slug = saveBtn.dataset.saveSlug!;
      const isSaved = savedList().some((item) => item.slug === slug);
      saveBtn.classList.toggle('is-saved', isSaved);
      saveBtn.setAttribute('aria-pressed', String(isSaved));
      saveLabel.textContent = isSaved ? 'Saved' : 'Save article';
    };

    actions?.addEventListener('click', async (event) => {
      const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-action]');
      if (!btn) return;

      const action = btn.dataset.action;

      if (action === 'print') {
        window.print();
        return;
      }

      if (action === 'share') {
        const url = location.href;
        try {
          if (navigator.share) {
            await navigator.share({ title: document.title, url });
            return;
          }
          await navigator.clipboard.writeText(url);
          flash('share', 'Link copied!');
        } catch {
          /* user cancelled the share sheet, or clipboard denied */
        }
        return;
      }

      if (action === 'save') {
        const slug = btn.dataset.saveSlug!;
        const list = savedList();
        if (list.some((item) => item.slug === slug)) {
          writeSaved(list.filter((item) => item.slug !== slug));
          flash('save', 'Removed');
        } else {
          writeSaved([
            ...list,
            {
              slug,
              title: document.querySelector('h1')?.textContent?.trim() ?? slug,
              href: location.pathname,
            },
          ]);
          flash('save', 'Saved!');
        }
        syncSaveState();
      }
    });

    syncSaveState();
  </script>
</ArticleLayout>

<style>
  /* --- article actions --------------------------------------------------- */
  .article-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .action-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--body);
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-medium);
    cursor: pointer;
    transition: border-color 0.15s var(--ease), background-color 0.15s var(--ease),
      color 0.15s var(--ease);
  }

  .action-btn:hover {
    border-color: var(--border-strong);
    color: var(--ink);
  }

  .action-btn svg {
    color: var(--primary);
  }

  .action-btn.is-saved {
    border-color: var(--primary-border);
    background: var(--primary-surface);
    color: var(--primary);
  }

  .action-btn:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .action-feedback {
    position: absolute;
    top: 100%;
    left: 0;
    padding-top: var(--space-1);
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
  }

  /* --- practice panel ------------------------------------------------------ */
  .practice-copy {
    color: var(--ink);
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
  }

  .practice-btn {
    margin-top: var(--space-4);
  }

  .post-body {
    margin-top: var(--space-8);
  }

  /* --- prev / next ----------------------------------------------------- */
  .prev-next {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  @media (min-width: 640px) {
    .prev-next {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .pn-link {
    display: block;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s var(--ease), background-color 0.15s var(--ease);
  }

  .pn-link:hover {
    border-color: var(--primary-border);
    background: var(--primary-surface);
  }

  .pn-next {
    text-align: right;
  }

  .pn-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--mute);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
  }

  .pn-prev .pn-label svg {
    transform: rotate(180deg);
  }

  .pn-title {
    display: block;
    margin-top: var(--space-1);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .pn-link:hover .pn-title {
    color: var(--primary);
  }

  /* --- author ---------------------------------------------------------- */
  .author-box {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .author-heading {
    font-size: var(--text-display-md);
  }

  .author-name {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: baseline;
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-body-lg);
    font-weight: var(--weight-semibold);
  }

  .author-role {
    color: var(--mute);
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-body);
  }

  .author-bio {
    max-width: 68ch;
    margin-top: var(--space-2);
    color: var(--body);
    font-size: var(--text-body-sm);
    line-height: var(--leading-prose);
  }
</style>
