---
/**
 * A blog article. Opens with a band hero — tag pill, serif headline, byline
 * with the author's initials, and hero art (the article's featured image when
 * one exists, a decorative asset otherwise) — then the same reading shell as
 * a study note. The left rail carries the contents, share links, and a quote;
 * the right rail carries related reading and practice links.
 *
 * Server-rendered from D1: the published article with article_type='article'.
 */
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ReferenceList from '../../components/ReferenceList.astro';
import JsonLd from '../../components/JsonLd.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from '../../utils/collections';
import {
  getPublishedArticleBySlug,
  getArticleExtras,
  getPublishedNeighbors,
  listRelatedByTag,
  listBlogCategoryCounts,
  getMediaById,
} from '../../utils/content';

export const prerender = false;

const slug = String(Astro.params.slug ?? '');

const article = await getPublishedArticleBySlug(Astro.locals, slug, 'article');
if (!article) {
  return new Response('Not found', { status: 404 });
}

const [extras, neighbors, relatedPosts, categoryCounts, subjects, featuredMedia] = await Promise.all([
  getArticleExtras(Astro.locals, article.id),
  getPublishedNeighbors(Astro.locals, article.slug, 'article'),
  listRelatedByTag(Astro.locals, article.id, 'article', 3),
  listBlogCategoryCounts(Astro.locals),
  getCollection('subjects'),
  article.featured_media_id
    ? getMediaById(Astro.locals, article.featured_media_id)
    : Promise.resolve(null),
]);

// The stored HTML is sanitized on save; re-sanitize on output as defense in
// depth (§17: output sanitization).
const { sanitizeRichText } = await import('../../utils/richtext');
let contentHtml = sanitizeRichText(article.content_html ?? '');

/**
 * Stored headings carry no ids, so inject slug ids at render time and collect
 * them for the table of contents. The input here is our own sanitized HTML
 * with a known, small tag set, so a scan over the h2/h3 tags is safe.
 */
const slugify = (s: string) =>
  s
    .toLowerCase()
    .replace(/<[^>]+>/g, '')
    .replace(/&[a-z#0-9]+;/g, ' ')
    .replace(/[^a-z0-9\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-') || 'section';

const tocHeadings: { depth: 2 | 3; text: string; slug: string }[] = [];
const usedSlugs = new Set<string>();
contentHtml = contentHtml.replace(
  /<h([23])([^>]*)>([\s\S]*?)<\/h\1>/g,
  (_m, level: string, attrs: string, inner: string) => {
    const text = inner.replace(/<[^>]+>/g, '').trim();
    let id = slugify(inner);
    while (usedSlugs.has(id)) id = `${id}-x`;
    usedSlugs.add(id);
    tocHeadings.push({ depth: Number(level) as 2 | 3, text, slug: id });
    return `<h${level}${attrs} id="${id}">${inner}</h${level}>`;
  },
);
tocHeadings.push(
  ...(extras.references.length > 0
    ? [{ depth: 2 as const, text: 'References', slug: 'references' }]
    : []),
);

// Author identity comes from the D1 users table — no public author pages
// exist, so the name is plain text and no role is invented.
const authorName = article.author_name;
const authorBio = article.author_bio || null;
const initials = (authorName ?? 'Medical Study Notes')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word.charAt(0))
  .join('')
  .toUpperCase();

// Uncategorized articles keep the pill but link back to the blog itself.
const categoryLabel = (article.category ?? 'article').replace(/-/g, ' ');
const categoryHref = article.category ? `/blog/category/${article.category}/` : '/blog/';

const title = article.seo_title || article.title;
const description = article.meta_description || article.excerpt || '';
const noindex = !article.robots.startsWith('index');
const site = Astro.site!;
const publicPath = `/blog/${article.slug}/`;
const canonical = article.canonical_url || new URL(publicPath, site).href;

/** D1 timestamps are UTC without a zone suffix. */
const asDate = (d: string | null) => (d ? new Date(d + 'Z') : undefined);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const readingMinutes = article.reading_minutes;

// Real share intents for the rail card — only the copy-link button needs JS.
const shareTitle = encodeURIComponent(article.title);
const shareUrl = encodeURIComponent(canonical);
const xShare = `https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareTitle}`;
const linkedinShare = `https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`;
const facebookShare = `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`;
const emailShare = `mailto:?subject=${shareTitle}&body=${shareUrl}`;

const popularTopics = categoryCounts;

// Related study notes come from the editor's related-content picks.
const relatedNotes = extras.related.filter((r) => r.article_type === 'study-note');

// Decorative art for the related-article rows without an uploaded image.
const relatedImages = [
  '/assets/icons/related-notes.png',
  '/assets/icons/related-anatomy.png',
  '/assets/icons/related-exam.png',
];
const relatedImage = (i: number) => relatedImages[i % relatedImages.length] ?? '';

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.data.title,
}));

// Edge caching (§16): browsers get 5 min, Cloudflare revalidates daily.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=86400');

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description,
  mainEntityOfPage: canonical,
  datePublished: asDate(article.published_at)?.toISOString(),
  dateModified: asDate(article.updated_at)?.toISOString(),
  author: authorName ? { '@type': 'Person', name: authorName } : undefined,
  publisher: {
    '@type': 'Organization',
    name: 'Medical Study Notes',
    url: site.href,
  },
  articleSection: article.category ?? undefined,
  image: featuredMedia ? new URL(`/media/${featuredMedia.r2_key}/`, site).href : undefined,
};
---
<ArticleLayout
  title={`${title} | Medical Study Notes`}
  description={description}
  path={publicPath}
  noindex={noindex}
  publishedTime={asDate(article.published_at)}
  modifiedTime={asDate(article.updated_at) ?? asDate(article.published_at)}
  footerSubjects={footerSubjects}
  crumbs={[
    { label: 'Blog', href: '/blog/' },
    ...(article.category ? [{ label: categoryLabel, href: categoryHref }] : []),
    { label: article.title },
  ]}
>
  <JsonLd data={articleSchema} />

  {/* --- band hero: tag / headline / lead / byline / art ------------------- */}
  <Fragment slot="hero">
    <div class="post-hero">
      <div class="post-hero-copy">
        <a class="tag-pill" href={categoryHref}>{categoryLabel}</a>
        <h1 class="post-hero-title">{article.title}</h1>
        <p class="post-hero-lead">{article.excerpt}</p>

        <div class="post-byline">
          {authorName && (
            <span class="byline-who">
              <span class="byline-avatar" aria-hidden="true">{initials}</span>
              <span class="byline-text">
                <span class="byline-name">{authorName}</span>
              </span>
            </span>
          )}
          {asDate(article.published_at) && (
            <span class="meta-item">
              <img src="/assets/icons/calendar.svg" width="16" height="16" alt="" />
              <time datetime={asDate(article.published_at)!.toISOString()}>
                {fmt(asDate(article.published_at)!)}
              </time>
            </span>
          )}
          <span class="meta-item">
            <img src="/assets/icons/clock-icon.svg" width="16" height="16" alt="" />
            {readingMinutes} min read
          </span>
          <button
            class="save-btn"
            type="button"
            data-action="save"
            data-save-slug={article.slug}
            aria-pressed="false"
          >
            <Icon name="bookmark" size={15} />
            <span data-save-label>Save article</span>
            <span class="save-feedback" data-feedback="save" role="status"></span>
          </button>
        </div>
      </div>

      <img
        class="post-hero-art"
        src={featuredMedia ? `/media/${featuredMedia.r2_key}/` : '/assets/icons/blog-article-hero.png'}
        width="326"
        height="320"
        alt={featuredMedia?.alt_text ?? ''}
        loading="lazy"
      />
    </div>
  </Fragment>

  {/* --- left rail: contents / share / quote ------------------------------- */}
  {tocHeadings.length >= 3 && (
    <Fragment slot="rail">
      <div class="rail-box">
        <TableOfContents headings={tocHeadings} numbered={false} />
      </div>

      <div class="rail-card">
        <h2 class="rail-heading">
          <img src="/assets/icons/share-link.svg" width="24" height="24" alt="" />
          Share this article
        </h2>
        <ul class="share-row" role="list">
          <li>
            <button class="share-btn" type="button" data-action="share" aria-label="Copy link">
              <img src="/assets/icons/share-link.svg" width="20" height="20" alt="" />
            </button>
          </li>
          <li>
            <a
              class="share-btn"
              href={xShare}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Share on X"
            >
              <img src="/assets/icons/x-twitter.svg" width="18" height="18" alt="" />
            </a>
          </li>
          <li>
            <a
              class="share-btn"
              href={linkedinShare}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Share on LinkedIn"
            >
              <img src="/assets/icons/linkedin.svg" width="20" height="20" alt="" />
            </a>
          </li>
          <li>
            <a
              class="share-btn"
              href={facebookShare}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Share on Facebook"
            >
              <img src="/assets/icons/facebook.svg" width="20" height="20" alt="" />
            </a>
          </li>
          <li>
            <a class="share-btn" href={emailShare} aria-label="Share by email">
              <img src="/assets/icons/envelope.svg" width="20" height="20" alt="" />
            </a>
          </li>
        </ul>
        <span class="share-feedback" data-feedback="share" role="status"></span>
      </div>

      <div class="rail-card rail-card-tint">
        <figure class="rail-quote">
          <span class="quote-mark" aria-hidden="true">&rdquo;</span>
          <blockquote>
            <p>Discipline today builds the doctor you hope to be tomorrow.</p>
          </blockquote>
          <span class="quote-rule" aria-hidden="true"></span>
          <figcaption>Unknown</figcaption>
        </figure>
      </div>
    </Fragment>
  )}

  {/* --- article body ------------------------------------------------------ */}
  <div class="prose post-body" set:html={contentHtml} />

  <ReferenceList references={extras.references} />

  {(neighbors.older || neighbors.newer) && (
    <nav class="prev-next" aria-label="Article navigation">
      {neighbors.older ? (
        <a class="pn-link pn-prev" href={`/blog/${neighbors.older.slug}/`} rel="prev">
          <span class="pn-label"><Icon name="chevron-right" size={14} /> Previous</span>
          <span class="pn-title">{neighbors.older.title}</span>
        </a>
      ) : <span />}
      {neighbors.newer && (
        <a class="pn-link pn-next" href={`/blog/${neighbors.newer.slug}/`} rel="next">
          <span class="pn-label">Next <Icon name="chevron-right" size={14} /></span>
          <span class="pn-title">{neighbors.newer.title}</span>
        </a>
      )}
    </nav>
  )}

  {authorName && (
    <section class="author-box" aria-labelledby="about-the-author">
      <h2 id="about-the-author" class="author-heading">About the author</h2>
      <p class="author-name">{authorName}</p>
      {authorBio && <p class="author-bio">{authorBio}</p>}
    </section>
  )}

  {/* --- right rail: related reading / topics / practice ------------------- */}
  <Fragment slot="sidebar">
    {relatedPosts.length > 0 && (
      <div class="rail-card">
        <h2 class="rail-heading">
          <Icon name="notes" size={22} />
          Related articles
        </h2>
        <ul class="rail-posts" role="list">
          {relatedPosts.map((p, i) => (
            <li>
              <a class="rail-post" href={`/blog/${p.slug}/`}>
                <img
                  class="rail-post-art"
                  src={p.media_key ? `/media/${p.media_key}/` : relatedImage(i)}
                  width="112"
                  height="96"
                  alt={p.media_key ? p.media_alt ?? '' : ''}
                  loading="lazy"
                />
                <span class="rail-post-body">
                  <span class="tag-pill">{(p.category ?? 'article').replace(/-/g, ' ')}</span>
                  <span class="rail-post-title">{p.title}</span>
                  <span class="rail-post-meta">{p.reading_minutes} min read</span>
                </span>
                <span class="rail-chev"><Icon name="chevron-right" size={16} /></span>
              </a>
            </li>
          ))}
        </ul>
        <a class="link-arrow rail-all" href="/blog/">View all articles</a>
      </div>
    )}

    {relatedNotes.length > 0 && (
      <div class="rail-card">
        <h2 class="rail-heading">
          <Icon name="book" size={22} />
          Related study notes
        </h2>
        <ul class="rail-notes" role="list">
          {relatedNotes.map((n) => (
            <li>
              <a href={`/notes/${n.slug}/`}>
                <span class="rail-note-title">{n.title}</span>
                <span class="rail-note-ctx">
                  {subjects.find((s) => s.slug === n.subject_slug)?.data.title}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    {popularTopics.length > 0 && (
      <div class="rail-card">
        <h2 class="rail-heading">
          <img src="/assets/icons/bar-chart-24.svg" width="24" height="24" alt="" />
          Popular topics
        </h2>
        <ul class="rail-topics" role="list">
          {popularTopics.map(({ category, count }) => (
            <li>
              <a href={`/blog/category/${category}/`}>
                <span class="rail-topic-name">{category.replace(/-/g, ' ')}</span>
                <span class="rail-count">{count}</span>
                <span class="rail-chev"><Icon name="chevron-right" size={16} /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="rail-card">
      <h2 class="rail-heading">
        <img src="/assets/icons/envelope.svg" width="24" height="24" alt="" />
        Get new articles
      </h2>
      <p class="rail-help">
        Stay updated with our latest articles, study tips and resources.
      </p>
      <ul class="chevron-list">
        <li><a href="/blog/archive/">Browse the archive</a></li>
        <li><a href="/contact/">Suggest a topic</a></li>
      </ul>
    </div>

    <div class="rail-card">
      <h2 class="rail-heading">
        <Icon name="target" size={22} />
        Practice what you learn
      </h2>
      <p class="rail-help">
        Test your knowledge with subject-wise MCQs and track your progress.
      </p>
      <a class="btn btn-secondary practice-btn" href="/practice/">Start Practicing</a>
    </div>
  </Fragment>

  <script>
    const SAVE_KEY = 'msn:saved-articles';

    const savedList = (): { slug: string; title: string; href: string }[] => {
      try {
        return JSON.parse(localStorage.getItem(SAVE_KEY) ?? '[]');
      } catch {
        return [];
      }
    };

    const writeSaved = (list: { slug: string; title: string; href: string }[]) => {
      try {
        localStorage.setItem(SAVE_KEY, JSON.stringify(list));
      } catch {
        /* storage unavailable (private mode, disabled) — saving just won't persist */
      }
    };

    const flash = (key: string, message: string) => {
      const el = document.querySelector<HTMLElement>(`[data-feedback="${key}"]`);
      if (!el) return;
      el.textContent = message;
      window.setTimeout(() => {
        el.textContent = '';
      }, 2000);
    };

    const saveBtn = document.querySelector<HTMLButtonElement>('[data-action="save"]');
    const saveLabel = document.querySelector<HTMLElement>('[data-save-label]');

    const syncSaveState = () => {
      if (!saveBtn || !saveLabel) return;
      const slug = saveBtn.dataset.saveSlug!;
      const isSaved = savedList().some((item) => item.slug === slug);
      saveBtn.classList.toggle('is-saved', isSaved);
      saveBtn.setAttribute('aria-pressed', String(isSaved));
      saveLabel.textContent = isSaved ? 'Saved' : 'Save article';
    };

    document.addEventListener('click', async (event) => {
      const btn = (event.target as HTMLElement).closest<HTMLElement>('[data-action]');
      if (!btn) return;

      const action = btn.dataset.action;

      if (action === 'share') {
        try {
          await navigator.clipboard.writeText(location.href);
          flash('share', 'Link copied!');
        } catch {
          /* clipboard denied — nothing to fall back to silently */
        }
        return;
      }

      if (action === 'save') {
        const slug = btn.dataset.saveSlug!;
        const list = savedList();
        if (list.some((item) => item.slug === slug)) {
          writeSaved(list.filter((item) => item.slug !== slug));
          flash('save', 'Removed');
        } else {
          writeSaved([
            ...list,
            {
              slug,
              title: document.querySelector('h1')?.textContent?.trim() ?? slug,
              href: location.pathname,
            },
          ]);
          flash('save', 'Saved!');
        }
        syncSaveState();
      }
    });

    syncSaveState();
  </script>
</ArticleLayout>

<style>
  /* --- band hero ----------------------------------------------------------- */
  .post-hero {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-6) var(--space-8);
  }

  .post-hero-copy {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
  }

  .tag-pill {
    justify-self: start;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--quote-surface);
    color: var(--primary);
    font-size: var(--text-micro);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    text-decoration: none;
  }

  .post-hero-title {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.3rem + 2vw, 2.5rem);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    text-wrap: balance;
  }

  .post-hero-lead {
    margin: 0;
    max-width: 60ch;
    color: var(--body);
    font-size: var(--text-body-lg);
    line-height: var(--leading-normal);
  }

  .post-byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-2);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }

  .byline-who {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  .byline-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--quote-surface);
    color: var(--primary);
    font-size: .8125rem;
    font-weight: var(--weight-semibold);
    letter-spacing: .04em;
  }

  .byline-text {
    display: grid;
    gap: 1px;
  }

  .byline-name {
    color: var(--ink);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--mute);
    font-size: var(--text-caption);
    font-variant-numeric: tabular-nums;
  }

  .meta-item img {
    display: block;
  }

  .save-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--body);
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-medium);
    cursor: pointer;
    transition: border-color 0.15s var(--ease), background-color 0.15s var(--ease),
      color 0.15s var(--ease);
  }

  .save-btn:hover {
    border-color: var(--border-strong);
    color: var(--ink);
  }

  .save-btn :global(svg) {
    color: var(--primary);
  }

  .save-btn.is-saved {
    border-color: var(--primary-border);
    background: var(--primary-surface);
    color: var(--primary);
  }

  .save-btn:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .save-feedback {
    position: absolute;
    top: 100%;
    left: 0;
    padding-top: var(--space-1);
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
  }

  .post-hero-art {
    display: none;
    width: 100%;
    aspect-ratio: 326 / 320;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  @media (min-width: 1024px) {
    .post-hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 17rem);
      align-items: center;
      gap: var(--space-10);
    }

    .post-hero-art {
      display: block;
    }
  }

  /* --- left rail ----------------------------------------------------------- */
  .rail-box {
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  /* Below 1024px the table of contents renders its own bordered disclosure
     card, so the wrapper would just double the frame. */
  @media (max-width: 1023px) {
    .rail-box {
      padding: 0;
      border: 0;
      background: none;
    }
  }

  .share-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: var(--quote-surface);
    transition: border-color 0.15s var(--ease), background-color 0.15s var(--ease);
  }

  .share-btn:hover {
    border-color: var(--primary-border);
    background: var(--primary-surface);
  }

  .share-btn:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .share-feedback {
    display: block;
    margin-top: var(--space-2);
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
  }

  .share-feedback:empty {
    display: none;
  }

  .rail-quote {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

