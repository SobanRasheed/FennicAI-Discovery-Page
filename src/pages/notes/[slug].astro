---
/**
 * A study note: the site's flagship reading page.
 *
 * Layout is the three-region article shell — TOC rail, reading column, sidebar
 * of quick facts and related material. The note's own structured fields
 * (objectives, key terms, formulas, important points, summary) are rendered as
 * real sections inside the reading column so they sit in the table of contents
 * alongside the markdown headings.
 */
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ArticleHeader from '../../components/ArticleHeader.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import SidebarPanel from '../../components/SidebarPanel.astro';
import FactList from '../../components/FactList.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import ReferenceList from '../../components/ReferenceList.astro';
import MedicalCallout from '../../components/MedicalCallout.astro';
import Faq from '../../components/Faq.astro';
import JsonLd from '../../components/JsonLd.astro';
import Icon from '../../components/Icon.astro';
import { getNotes, getQuestions, getCollection, isoDate } from '../../utils/collections';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({ params: { slug: note.slug }, props: { note } }));
}

const { note } = Astro.props;
const { data } = note;
const { Content: NoteBody, headings } = await render(note);

const [subjects, levels, authors, allNotes, allQuestions] = await Promise.all([
  getCollection('subjects'),
  getCollection('levels'),
  getCollection('authors'),
  getNotes(),
  getQuestions(),
]);

const subject = subjects.find((s) => s.slug === data.subject);
const level = levels.find((l) => l.slug === data.level);
const author = authors.find((a) => a.slug === data.author);

const chapterEntry = subject?.data.chapters.find((c) => c.slug === data.chapter);
const chapterTitle = chapterEntry?.title ?? data.chapter;

const relatedNotes = allNotes
  .filter((n) => n.slug !== note.slug && n.data.subject === data.subject)
  .slice(0, 6);

const relatedQuestions = allQuestions.filter(
  (q) => q.data.subject === data.subject && q.data.chapter === data.chapter,
);

const subjectQuestions = allQuestions.filter((q) => q.data.subject === data.subject);

// The next note in this subject (most recent first), wrapping around, for the
// "Continue studying" rail.
const subjectNotesByDate = [...allNotes]
  .filter((n) => n.data.subject === data.subject)
  .sort((a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf());
const currentIndex = subjectNotesByDate.findIndex((n) => n.slug === note.slug);
const nextNote =
  subjectNotesByDate.length > 1
    ? subjectNotesByDate[(currentIndex + 1) % subjectNotesByDate.length]
    : undefined;

/** Reading time from the raw markdown, at 200 words per minute. */
const wordCount = (note.body ?? '').split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));

const subjectTopics = (await getCollection('topics')).filter((t) =>
  data.topics.includes(t.slug),
);

/**
 * The rail's table of contents lists the note's fixed sections first, then the
 * markdown headings, then the closing sections — matching document order so a
 * reader following the list never jumps backwards.
 */
const tocHeadings = [
  { depth: 2, text: 'Learning objectives', slug: 'learning-objectives' },
  ...(data.keyTerms.length > 0
    ? [{ depth: 2, text: 'Key terms', slug: 'key-terms' }]
    : []),
  ...headings.filter((h) => h.depth === 2 || h.depth === 3),
  ...(data.formulas.length > 0
    ? [{ depth: 2, text: 'Formulas', slug: 'formulas' }]
    : []),
  ...(data.importantPoints.length > 0
    ? [{ depth: 2, text: 'Important points', slug: 'important-points' }]
    : []),
  { depth: 2, text: 'Summary', slug: 'summary' },
  ...(relatedQuestions.length > 0
    ? [{ depth: 2, text: 'Practice questions', slug: 'practice-questions' }]
    : []),
  ...(data.references.length > 0
    ? [{ depth: 2, text: 'References', slug: 'references' }]
    : []),
];

const title = data.seoTitle ?? data.title;
const site = Astro.site!;

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.data.title,
}));

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  datePublished: isoDate(data.publishedDate),
  dateModified: isoDate(data.updatedDate),
  author: author
    ? {
        '@type': 'Person',
        name: author.data.title,
        url: new URL(`/authors/${author.slug}/`, site).href,
      }
    : undefined,
  publisher: {
    '@type': 'Organization',
    name: 'Medical Study Notes',
    url: site.href,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(`/notes/${note.slug}/`, site).href,
  },
  about: subject ? { '@type': 'Thing', name: subject.data.title } : undefined,
};
---

<ArticleLayout
  title={`${title} | Medical Study Notes`}
  description={data.description}
  path={`/notes/${note.slug}/`}
  noindex={data.noindex}
  publishedTime={data.publishedDate}
  modifiedTime={data.updatedDate}
  footerSubjects={footerSubjects}
  crumbs={[
    { label: subject?.data.title ?? data.subject, href: `/subjects/${data.subject}/` },
    { label: chapterTitle },
    { label: data.title },
  ]}
>
  <JsonLd data={articleSchema} />

  {/* --- left rail: table of contents plus page actions ----------------- */}
  <Fragment slot="rail">
    <TableOfContents headings={tocHeadings} />

    <div class="rail-actions">
      <button class="rail-action" type="button" data-note-action="print">
        <Icon name="download" size={15} />
        <span class="rail-action-label">Save as PDF</span>
      </button>
      <button class="rail-action" type="button" data-note-action="print">
        <Icon name="print" size={15} />
        <span class="rail-action-label">Print this page</span>
      </button>
      <button class="rail-action" type="button" data-note-action="share">
        <Icon name="share" size={15} />
        <span class="rail-action-label">Share this page</span>
      </button>
      <button
        class="rail-action"
        type="button"
        data-note-action="save"
        data-save-slug={note.slug}
        aria-pressed="false"
      >
        <Icon name="bookmark" size={15} />
        <span class="rail-action-label" data-save-label>Save note</span>
      </button>
      <a class="rail-action" href="#references">
        <Icon name="file" size={15} />
        Jump to references
      </a>
      <a class="rail-action" href={`/subjects/${data.subject}/`}>
        <Icon name="book" size={15} />
        All {subject?.data.title ?? data.subject} notes
      </a>
    </div>
  </Fragment>

  {/* --- reading column ------------------------------------------------- */}
  <ArticleHeader
    title={data.title}
    kicker={subject?.data.title ?? data.subject}
    kickerHref={`/subjects/${data.subject}/`}
    standfirst={data.overview}
    updated={data.updatedDate}
    readingMinutes={readingMinutes}
    author={author?.data.title}
    authorHref={author ? `/authors/${author.slug}/` : undefined}
  />

  <section class="note-section" aria-labelledby="learning-objectives">
    <h2 id="learning-objectives">Learning objectives</h2>
    <p class="note-section-intro">After working through this note you should be able to:</p>
    <ul class="objectives">
      {data.learningObjectives.map((objective) => (
        <li>{objective}</li>
      ))}
    </ul>
  </section>

  {data.keyTerms.length > 0 && (
    <section class="note-section" aria-labelledby="key-terms">
      <h2 id="key-terms">Key terms</h2>
      <dl class="terms">
        {data.keyTerms.map((term) => (
          <div class="term">
            <dt>{term.term}</dt>
            <dd>{term.definition}</dd>
          </div>
        ))}
      </dl>
    </section>
  )}

  <div class="prose note-body">
    <NoteBody />
  </div>

  {data.formulas.length > 0 && (
    <section class="note-section" aria-labelledby="formulas">
      <h2 id="formulas">Formulas and definitions</h2>
      <dl class="terms terms-mono">
        {data.formulas.map((formula) => (
          <div class="term">
            <dt><code>{formula.expression}</code></dt>
            <dd>{formula.meaning}</dd>
          </div>
        ))}
      </dl>
    </section>
  )}

  {data.importantPoints.length > 0 && (
    <section class="note-section" aria-labelledby="important-points">
      <h2 id="important-points">Important points</h2>
      <MedicalCallout kind="key-point" label="Remember">
        <ul>
          {data.importantPoints.map((point) => <li>{point}</li>)}
        </ul>
      </MedicalCallout>
    </section>
  )}

  <section class="note-section" aria-labelledby="summary">
    <h2 id="summary">Summary</h2>
    <p class="summary-text">{data.summary}</p>
  </section>

  {relatedQuestions.length > 0 && (
    <section class="note-section" aria-labelledby="practice-questions">
      <h2 id="practice-questions">Practice questions</h2>
      <p class="note-section-intro">
        {relatedQuestions.length} question{relatedQuestions.length === 1 ? '' : 's'} on
        this chapter, each with a worked answer.
      </p>
      <ul class="chevron-list question-list">
        {relatedQuestions.map((q) => (
          <li>
            <a href={`/practice/${q.slug}/`}>
              <span class="question-text">{q.data.question}</span>
              <span class="tag">{q.data.type}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <ReferenceList references={data.references} />

  {author && (
    <section class="note-section author-box" aria-labelledby="about-the-author">
      <h2 id="about-the-author" class="author-heading">About the author</h2>
      <p class="author-name">
        <a href={`/authors/${author.slug}/`}>{author.data.title}</a>
        <span class="author-role">{author.data.role}</span>
      </p>
      <p class="author-bio">{author.data.bio}</p>
    </section>
  )}

  <Faq faqs={data.faqs} level={2} id="note-faq" />

  {/* --- sidebar -------------------------------------------------------- */}
  <Fragment slot="sidebar">
    <SidebarPanel heading="Quick facts" icon="file" variant="tint">
      <FactList
        items={[
          `Subject: ${subject?.data.title ?? data.subject}`,
          `Chapter: ${chapterTitle}`,
          ...(level ? [`Level: ${level.data.title}`] : []),
          `${data.keyTerms.length} key term${data.keyTerms.length === 1 ? '' : 's'}`,
          `${data.learningObjectives.length} learning objectives`,
        ]}
      />
    </SidebarPanel>

    {/* The red at-a-glance card: the first of the note's important points,
        the one thing to walk away remembering. */}
    {data.importantPoints.length > 0 && (
      <aside class="alert-panel" aria-label="Important">
        <p class="alert-label">
          <Icon name="alert" size={14} />
          Important
        </p>
        <p class="alert-text">{data.importantPoints[0]}</p>
      </aside>
    )}

    {relatedNotes.length > 0 && (
      <SidebarPanel heading="Related study notes" icon="book">
        <RelatedContent
          items={relatedNotes.map((n) => ({
            href: `/notes/${n.slug}/`,
            title: n.data.title,
            context: subjects.find((s) => s.slug === n.data.subject)?.data.title,
          }))}
          variant="list"
          heading=""
          level={3}
          id="side-related"
          moreHref={`/subjects/${data.subject}/`}
          moreLabel={`View all ${subject?.data.title ?? ''} notes`}
        />
      </SidebarPanel>
    )}

    <SidebarPanel heading="Continue studying" icon="target">
      <RelatedContent
        items={[
          {
            href: `/subjects/${data.subject}/`,
            title: `${subject?.data.title ?? data.subject} study notes`,
            context: 'Complete subject notes',
          },
          ...(subjectQuestions.length > 0
            ? [
                {
                  href: `/practice/subject/${data.subject}/`,
                  title: `${subject?.data.title ?? data.subject} MCQs`,
                  context: 'Practice questions',
                },
              ]
            : []),
          ...(nextNote
            ? [
                {
                  href: `/notes/${nextNote.slug}/`,
                  title: nextNote.data.title,
                  context: 'Next in this subject',
                },
              ]
            : []),
          {
            href: '/past-papers/',
            title: 'Past papers',
            context: 'Exam practice by board',
          },
        ]}
        variant="list"
        heading=""
        level={3}
        id="side-continue"
        moreHref="/subjects/"
        moreLabel="Explore more related topics"
      />
    </SidebarPanel>

    {subjectTopics.length > 0 && (
      <SidebarPanel heading="Topic hubs" icon="layers">
        <ul class="chevron-list">
          {subjectTopics.map((topic) => (
            <li><a href={`/topics/${topic.slug}/`}>{topic.data.title}</a></li>
          ))}
        </ul>
      </SidebarPanel>
    )}
  </Fragment>
</ArticleLayout>

<style>
  /* --- section numbers --------------------------------------------------
     The reading column numbers its h2s in document order ("1. Definition",
     "2. Structure"), matching the numbering the TOC rail shows. The trailing
     apparatus (author box, FAQ) is not in the TOC, so it stays unnumbered. */
  :global(.art-main) {
    counter-reset: note-section;
  }

  :global(.art-main h2) {
    counter-increment: note-section;
  }

  :global(.art-main h2)::before {
    content: counter(note-section) '. ';
  }

  :global(.art-main h2.author-heading),
  :global(.art-main h2.faq-heading) {
    counter-increment: none;
  }

  :global(.art-main h2.author-heading)::before,
  :global(.art-main h2.faq-heading)::before {
    content: none;
  }

  /* --- sidebar important alert ----------------------------------------- */
  .alert-panel {
    margin-top: var(--space-3);
    padding: var(--space-4);
    border: 1px solid color-mix(in srgb, var(--danger) 35%, var(--border));
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--danger) 7%, var(--surface));
  }

  .alert-label {
    display: flex;
    gap: 6px;
    align-items: center;
    margin: 0;
    color: var(--danger);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: var(--weight-bold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .alert-text {
    margin: var(--space-2) 0 0;
    color: var(--ink);
    font-size: 0.8125rem;
    line-height: var(--leading-normal);
  }

  /* --- rail ----------------------------------------------------------- */
  .rail-actions {
    display: none;
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }

  @media (min-width: 1024px) {
    .rail-actions {
      display: grid;
      gap: var(--space-1);
    }
  }

  .rail-action {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: 0;
    background: none;
    color: var(--mute);
    font: inherit;
    font-size: var(--text-body-sm);
    text-align: left;
    text-decoration: none;
    line-height: var(--leading-snug);
    cursor: pointer;
  }

  .rail-action:hover {
    color: var(--primary);
  }

  .rail-action[aria-pressed='true'] {
    color: var(--primary);
  }

  /* --- reading column sections ---------------------------------------- */
  .note-section {
    margin-top: var(--space-12);
  }

  .note-section > h2 {
    font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem);
  }

  .note-section-intro {
    margin-top: var(--space-3);
    color: var(--mute);
    font-size: var(--text-body-sm);
  }

  .note-body {
    margin-top: var(--space-12);
  }

  /* Objectives read as a checklist, so they get a green rule marker rather
     than a bullet. */
  .objectives {
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .objectives li {
    position: relative;
    padding: var(--space-2) 0 var(--space-2) var(--space-6);
    color: var(--ink);
    font-size: var(--text-prose);
    line-height: var(--leading-normal);
  }

  .objectives li + li {
    border-top: 1px solid var(--border);
  }

  .objectives li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.05em;
    width: 0.625rem;
    height: 2px;
    background: var(--primary);
  }

  /* --- definition lists ----------------------------------------------- */
  .terms {
    margin: var(--space-4) 0 0;
  }

  .term {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border);
  }

  .term:first-child {
    border-top: 1px solid var(--border);
  }

  .terms dt {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-body-lg);
    font-weight: var(--weight-semibold);
  }

  .terms-mono dt code {
    font-size: var(--text-body-sm);
  }

  .terms dd {
    margin: var(--space-2) 0 0;
    color: var(--body);
    font-size: var(--text-body-lg);
    line-height: var(--leading-prose);
  }

  /* --- summary -------------------------------------------------------- */
  .summary-text {
    margin-top: var(--space-4);
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--border);
    border-left: 3px solid var(--primary);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    background: var(--surface);
    color: var(--ink);
    font-size: var(--text-prose);
    line-height: var(--leading-prose);
  }

  /* --- practice questions --------------------------------------------- */
  .question-list {
    margin-top: var(--space-4);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .question-list a {
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }

  .question-text {
    flex: 1;
  }

  /* --- author --------------------------------------------------------- */
  .author-box {
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .author-heading {
    font-size: var(--text-display-md);
  }

  .author-name {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: baseline;
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-body-lg);
    font-weight: var(--weight-semibold);
  }

  .author-role {
    color: var(--mute);
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-body);
  }

  .author-bio {
    max-width: 68ch;
    margin-top: var(--space-2);
    color: var(--body);
    font-size: var(--text-body-sm);
    line-height: var(--leading-prose);
  }
</style>

<script>
  // Page actions. The two print actions open the print dialog (where every
  // browser offers "Save as PDF"); share uses the Web Share API with a
  // clipboard fallback that confirms on the button itself; save bookmarks the
  // note into the same local list the blog articles use, so the Saved page
  // shows everything in one place.

  const SAVE_KEY = 'msn:saved-articles';
  type SavedItem = { slug: string; title: string; href: string };

  const savedList = (): SavedItem[] => {
    try {
      return JSON.parse(localStorage.getItem(SAVE_KEY) ?? '[]');
    } catch {
      return [];
    }
  };

  const writeSaved = (list: SavedItem[]) => {
    try {
      localStorage.setItem(SAVE_KEY, JSON.stringify(list));
    } catch {
      /* storage unavailable (private mode, disabled) — saving just won't persist */
    }
  };

  document.querySelectorAll<HTMLButtonElement>('[data-note-action]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const action = btn.getAttribute('data-note-action');
      if (action === 'print') {
        window.print();
        return;
      }

      if (action === 'save') {
        const slug = btn.dataset.saveSlug!;
        const list = savedList();
        const label = btn.querySelector('[data-save-label]');
        if (list.some((item) => item.slug === slug)) {
          writeSaved(list.filter((item) => item.slug !== slug));
          btn.setAttribute('aria-pressed', 'false');
          if (label) label.textContent = 'Save note';
        } else {
          writeSaved([
            ...list,
            {
              slug,
              title: document.querySelector('h1')?.textContent?.trim() ?? slug,
              href: window.location.pathname,
            },
          ]);
          btn.setAttribute('aria-pressed', 'true');
          if (label) label.textContent = 'Saved';
        }
        return;
      }

      const url = window.location.href;
      const title = document.title;
      if (navigator.share) {
        navigator.share({ title, url }).catch(() => {});
      } else if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(() => {
          const label = btn.querySelector('.rail-action-label');
          if (!label) return;
          const original = label.textContent;
          label.textContent = 'Link copied!';
          window.setTimeout(() => {
            label.textContent = original;
          }, 2000);
        });
      }
    });
  });

  // Reflect an existing bookmark when the page loads.
  const saveBtn = document.querySelector<HTMLButtonElement>('[data-note-action="save"]');
  if (saveBtn) {
    const isSaved = savedList().some((item) => item.slug === saveBtn.dataset.saveSlug);
    saveBtn.setAttribute('aria-pressed', String(isSaved));
    const label = saveBtn.querySelector('[data-save-label]');
    if (label) label.textContent = isSaved ? 'Saved' : 'Save note';
  }
</script>
