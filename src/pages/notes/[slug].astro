---
/**
 * /notes/[slug]/ (§15, §16) — the study note: the site's flagship reading page.
 *
 * Server-rendered from D1 (article_type='study-note'). Layout is the
 * three-region article shell — TOC rail, reading column at the prose measure,
 * sidebar of quick facts and related material. The note body is flat rich
 * text: its sections (objectives, key terms, formulas, summary …) live in the
 * stored HTML, so the TOC is built from the body's h2/h3 at render time.
 * Attached MCQs render as collapsible blocks that work without JavaScript;
 * responses are cached at the edge.
 */
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ArticleHeader from '../../components/ArticleHeader.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import SidebarPanel from '../../components/SidebarPanel.astro';
import FactList from '../../components/FactList.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import ReferenceList from '../../components/ReferenceList.astro';
import JsonLd from '../../components/JsonLd.astro';
import Icon from '../../components/Icon.astro';
import { jsonForScript } from '../../utils/json-script';
import {
  getPublishedArticleBySlug,
  getArticleExtras,
  getMcqsForArticle,
  listTopicsBySubject,
  listPublishedBySubject,
  listSubjects,
  countPublishedMcqsBySubject,
} from '../../utils/content';

export const prerender = false;

const slug = String(Astro.params.slug ?? '');

const article = await getPublishedArticleBySlug(Astro.locals, slug, 'study-note');
if (!article || !article.subject_id) {
  return new Response('Not found', { status: 404 });
}

const [extras, mcqs, topics, subjectNotes, subjects, subjectMcqCount] = await Promise.all([
  getArticleExtras(Astro.locals, article.id),
  getMcqsForArticle(Astro.locals, article.id, true),
  listTopicsBySubject(Astro.locals, article.subject_id),
  listPublishedBySubject(Astro.locals, article.subject_id, { articleType: 'study-note', perPage: 50 }),
  listSubjects(Astro.locals),
  countPublishedMcqsBySubject(Astro.locals, article.subject_id),
]);

const topic = article.topic_id ? topics.find((t) => t.id === article.topic_id) : null;
const subjectTitle = article.subject_title ?? '';
const subjectSlug = article.subject_slug ?? '';

// Other notes in this subject, newest first, plus the next one after this for
// the "Continue studying" rail.
const otherNotes = subjectNotes.rows.filter((n) => n.id !== article.id);
const currentIndex = subjectNotes.rows.findIndex((n) => n.id === article.id);
const nextNote =
  subjectNotes.rows.length > 1
    ? subjectNotes.rows[(currentIndex + 1) % subjectNotes.rows.length]
    : undefined;

// Curated related articles (admin picks), mapped to their public URL by type.
const curated = extras.related.slice(0, 6).map((r) => ({
  href: r.article_type === 'study-note' ? `/notes/${r.slug}/` : `/blog/${r.slug}/`,
  title: r.title,
  context: r.subject_slug,
}));
// Same-subject study notes fill the rail when the admin hasn't curated any.
const relatedNotes = curated.length > 0
  ? curated
  : otherNotes.slice(0, 6).map((n) => ({
      href: `/notes/${n.slug}/`,
      title: n.title,
      context: n.subject_title,
    }));

const subjectHasMcqs = subjectMcqCount > 0;

// The stored HTML is sanitized on save; re-sanitize on output as defense in
// depth (§17: output sanitization).
const { sanitizeRichText } = await import('../../utils/richtext');
let contentHtml = sanitizeRichText(article.content_html ?? '');

/**
 * Stored headings carry no ids, so inject slug ids at render time and collect
 * them for the table of contents. The input here is our own sanitized HTML
 * with a known, small tag set, so a scan over the h2/h3 tags is safe.
 */
const slugify = (s: string) =>
  s
    .toLowerCase()
    .replace(/<[^>]+>/g, '')
    .replace(/&[a-z#0-9]+;/g, ' ')
    .replace(/[^a-z0-9\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-') || 'section';

const tocHeadings: { depth: 2 | 3; text: string; slug: string }[] = [];
const usedSlugs = new Set<string>();
contentHtml = contentHtml.replace(
  /<h([23])([^>]*)>([\s\S]*?)<\/h\1>/g,
  (_m, level: string, attrs: string, inner: string) => {
    const text = inner.replace(/<[^>]+>/g, '').trim();
    let id = slugify(inner);
    while (usedSlugs.has(id)) id = `${id}-x`;
    usedSlugs.add(id);
    tocHeadings.push({ depth: Number(level) as 2 | 3, text, slug: id });
    return `<h${level}${attrs} id="${id}">${inner}</h${level}>`;
  },
);
tocHeadings.push(
  ...(mcqs.length > 0 ? [{ depth: 2 as const, text: 'Practice questions', slug: 'practice-questions' }] : []),
  ...(extras.references.length > 0 ? [{ depth: 2 as const, text: 'References', slug: 'references' }] : []),
);

const title = article.seo_title || article.title;
const description = article.meta_description || article.excerpt || '';
const noindex = !article.robots.startsWith('index');
const site = Astro.site!;
const publicPath = `/notes/${article.slug}/`;
const canonical = article.canonical_url || new URL(publicPath, site).href;

const asDate = (d: string | null) => (d ? new Date(d + 'Z') : undefined);

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.title,
}));

// Edge caching (§16): browsers get 5 min, Cloudflare revalidates daily.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=86400');

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description,
  datePublished: article.published_at ? new Date(article.published_at + 'Z').toISOString() : undefined,
  dateModified: article.updated_at ? new Date(article.updated_at + 'Z').toISOString() : undefined,
  author: article.author_name ? { '@type': 'Person', name: article.author_name } : undefined,
  publisher: { '@type': 'Organization', name: 'Medical Study Notes', url: site.href },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  articleSection: subjectTitle || undefined,
  ...(extras.references.length > 0 && {
    citation: extras.references.map((r) => ({
      '@type': 'CreativeWork',
      name: r.title,
      author: r.authors || undefined,
      datePublished: r.year || undefined,
      url: r.url || undefined,
    })),
  }),
};
---

<ArticleLayout
  title={`${title} | Medical Study Notes`}
  description={description}
  path={publicPath}
  noindex={noindex}
  publishedTime={asDate(article.published_at)}
  modifiedTime={asDate(article.updated_at)}
  footerSubjects={footerSubjects}
  crumbs={[
    ...(subjectSlug ? [{ label: subjectTitle, href: `/subjects/${subjectSlug}/` }] : []),
    ...(topic ? [{ label: topic.title }] : []),
    { label: article.title },
  ]}
  crumbSchema={false}
>
  <script type="application/ld+json" set:html={jsonForScript(articleSchema)} />
  <script
    type="application/ld+json"
    set:html={jsonForScript({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { name: 'Home', url: new URL('/', site).href },
        ...(subjectSlug
          ? [{ name: subjectTitle, url: new URL(`/subjects/${subjectSlug}/`, site).href }]
          : []),
        { name: article.title, url: canonical },
      ].map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: b.url })),
    })}
  />

  {/* --- left rail: table of contents plus page actions ----------------- */}
  <Fragment slot="rail">
    <TableOfContents headings={tocHeadings} />

    <div class="rail-actions">
      <button class="rail-action" type="button" data-note-action="print">
        <Icon name="download" size={15} />
        <span class="rail-action-label">Save as PDF</span>
      </button>
      <button class="rail-action" type="button" data-note-action="print">
        <Icon name="print" size={15} />
        <span class="rail-action-label">Print this page</span>
      </button>
      <button class="rail-action" type="button" data-note-action="share">
        <Icon name="share" size={15} />
        <span class="rail-action-label">Share this page</span>
      </button>
      <button
        class="rail-action"
        type="button"
        data-note-action="save"
        data-save-slug={article.slug}
        aria-pressed="false"
      >
        <Icon name="bookmark" size={15} />
        <span class="rail-action-label" data-save-label>Save note</span>
      </button>
      {extras.references.length > 0 && (
        <a class="rail-action" href="#references">
          <Icon name="file" size={15} />
          Jump to references
        </a>
      )}
      {subjectSlug && (
        <a class="rail-action" href={`/subjects/${subjectSlug}/`}>
          <Icon name="book" size={15} />
          All {subjectTitle} notes
        </a>
      )}
    </div>
  </Fragment>

  {/* --- reading column ------------------------------------------------- */}
  <ArticleHeader
    title={article.title}
    kicker={subjectTitle || 'Study note'}
    kickerHref={subjectSlug ? `/subjects/${subjectSlug}/` : undefined}
    standfirst={article.excerpt}
    updated={asDate(article.updated_at)}
    published={asDate(article.published_at)}
    readingMinutes={article.reading_minutes}
    author={article.author_name ?? undefined}
  />

  <div class="prose note-body" set:html={contentHtml} />

  {mcqs.length > 0 && (
    <section class="note-section" aria-labelledby="practice-questions">
      <h2 id="practice-questions">Practice questions</h2>
      <p class="note-section-intro">
        {mcqs.length} question{mcqs.length === 1 ? '' : 's'} on this note, each with the full
        answer and an explanation.
      </p>
      {mcqs.map((m, i) => (
        <div class="mcq">
          <p class="mcq-question"><strong>Q{i + 1}.</strong> {m.question}</p>
          <ol class="mcq-options" type="A">
            {m.options.map((o) => (
              <li>{o.text}{o.is_correct === 1 && <span class="answer-mark" aria-label="(correct answer)">✓</span>}</li>
            ))}
          </ol>
          <details class="mcq-answer">
            <summary>Show answer &amp; explanation</summary>
            <p><strong>Answer:</strong> {m.options.filter((o) => o.is_correct === 1).map((o) => o.label).join(', ')}</p>
            <p>{m.explanation}</p>
          </details>
        </div>
      ))}
    </section>
  )}

  <ReferenceList references={extras.references} />

  {article.author_name && (
    <section class="note-section author-box" aria-labelledby="about-the-author">
      <h2 id="about-the-author" class="author-heading">About the author</h2>
      <p class="author-name">
        {article.author_name}
      </p>
      {article.author_bio && <p class="author-bio">{article.author_bio}</p>}
    </section>
  )}

  <RelatedContent
    items={relatedNotes}
    heading="Continue studying"
    moreHref={subjectSlug ? `/subjects/${subjectSlug}/` : '/notes/'}
    moreLabel={subjectSlug ? `All ${subjectTitle} notes` : 'All study notes'}
  />

  {extras.tags.length > 0 && (
    <p class="tags">
      {extras.tags.map((t) => <span class="tag">{t}</span>)}
    </p>
  )}

  {/* --- sidebar -------------------------------------------------------- */}
  <Fragment slot="sidebar">
    <SidebarPanel heading="Quick facts" icon="file" variant="tint">
      <FactList
        items={[
          ...(subjectTitle ? [`Subject: ${subjectTitle}`] : []),
          ...(topic ? [`Topic: ${topic.title}`] : []),
          `${article.reading_minutes} min read`,
          'Type: Study note',
          ...(article.author_name ? [`Author: ${article.author_name}`] : []),
        ]}
      />
    </SidebarPanel>

    {relatedNotes.length > 0 && (
      <SidebarPanel heading="Related study notes" icon="book">
        <RelatedContent
          items={relatedNotes}
          variant="list"
          heading=""
          level={3}
          id="side-related"
          moreHref={subjectSlug ? `/subjects/${subjectSlug}/` : '/notes/'}
          moreLabel={`View all ${subjectTitle} notes`}
        />
      </SidebarPanel>
    )}

    <SidebarPanel heading="Continue studying" icon="target">
      <RelatedContent
        items={[
          ...(subjectSlug
            ? [
                {
                  href: `/subjects/${subjectSlug}/`,
                  title: `${subjectTitle} study notes`,
                  context: 'Complete subject notes',
                },
              ]
            : []),
          ...(subjectHasMcqs && subjectSlug
            ? [
                {
                  href: `/practice/subject/${subjectSlug}/`,
                  title: `${subjectTitle} MCQs`,
                  context: 'Practice questions',
                },
              ]
            : []),
          ...(nextNote
            ? [
                {
                  href: `/notes/${nextNote.slug}/`,
                  title: nextNote.title,
                  context: 'Next in this subject',
                },
              ]
            : []),
          {
            href: '/past-papers/',
            title: 'Past papers',
            context: 'Exam practice by board',
          },
        ]}
        variant="list"
        heading=""
        level={3}
        id="side-continue"
        moreHref="/subjects/"
        moreLabel="Explore more related topics"
      />
    </SidebarPanel>

    {topics.filter((t) => !t.parent_topic_id).length > 0 && (
      <SidebarPanel heading="Topics in this subject" icon="layers">
        <ul class="chevron-list">
          {topics.filter((t) => !t.parent_topic_id).map((t) => (
            <li><a href={`/subjects/${subjectSlug}/#${t.slug}`}>{t.title}</a></li>
          ))}
        </ul>
      </SidebarPanel>
    )}
  </Fragment>
</ArticleLayout>

<style>
  /* --- section numbers --------------------------------------------------
     The reading column numbers its h2s in document order ("1. Definition",
     "2. Structure"), matching the numbering the TOC rail shows. The trailing
     apparatus (author box) is not in the TOC, so it stays unnumbered. */
  :global(.art-main) {
    counter-reset: note-section;
  }

  :global(.art-main h2) {
    counter-increment: note-section;
  }

  :global(.art-main h2)::before {
    content: counter(note-section) '. ';
  }

  :global(.art-main h2.author-heading)::before {
    counter-increment: none;
    content: none;
  }

  /* --- rail ----------------------------------------------------------- */
  .rail-actions {
    display: none;
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }

  @media (min-width: 1024px) {
    .rail-actions {
      display: grid;
      gap: var(--space-1);
    }
  }

  .rail-action {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: 0;
    background: none;
    color: var(--mute);
    font: inherit;
    font-size: var(--text-body-sm);
    text-align: left;
    text-decoration: none;
    line-height: var(--leading-snug);
    cursor: pointer;
  }

  .rail-action:hover {
    color: var(--primary);
  }

  .rail-action[aria-pressed='true'] {
    color: var(--primary);
  }

  /* --- reading column sections ---------------------------------------- */
  .note-section {
    margin-top: var(--space-12);
  }

  .note-section > h2 {
    font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem);
  }

  .note-section-intro {
    margin-top: var(--space-3);
    color: var(--mute);
    font-size: var(--text-body-sm);
  }

  .note-body {
    margin-top: var(--space-12);
  }

  /* --- practice questions --------------------------------------------- */
  .mcq + .mcq {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .mcq-question {
    margin: 0;
    color: var(--ink);
    font-size: var(--text-prose);
    line-height: var(--leading-prose);
  }

  .mcq-options {
    margin: var(--space-3) 0 0;
    padding-left: 1.5rem;
    color: var(--body);
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
  }

  .mcq-options li + li {
    margin-top: var(--space-1);
  }

  .answer-mark {
    margin-left: var(--space-2);
    color: var(--success);
    font-weight: var(--weight-bold);
  }

  .mcq-answer {
    margin-top: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface-sunken);
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
  }

  .mcq-answer summary {
    color: var(--primary);
    font-weight: var(--weight-medium);
    cursor: pointer;
  }

  .mcq-answer p {
    margin: var(--space-2) 0 0;
    color: var(--body);
  }

  /* --- author --------------------------------------------------------- */
  .author-box {
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .author-heading {
    font-size: var(--text-display-md);
  }

  .author-name {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: baseline;
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-body-lg);
    font-weight: var(--weight-semibold);
  }

  .author-bio {
    max-width: 68ch;
    margin-top: var(--space-2);
    color: var(--body);
    font-size: var(--text-body-sm);
    line-height: var(--leading-prose);
  }

  /* --- tags ------------------------------------------------------------ */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-10);
  }
</style>

<script>
  // Page actions. The two print actions open the print dialog (where every
  // browser offers "Save as PDF"); share uses the Web Share API with a
  // clipboard fallback that confirms on the button itself; save bookmarks the
  // note into the same local list the blog articles use, so the Saved page
  // shows everything in one place.

  const SAVE_KEY = 'msn:saved-articles';
  type SavedItem = { slug: string; title: string; href: string };

  const savedList = (): SavedItem[] => {
    try {
      return JSON.parse(localStorage.getItem(SAVE_KEY) ?? '[]');
    } catch {
      return [];
    }
  };

  const writeSaved = (list: SavedItem[]) => {
    try {
      localStorage.setItem(SAVE_KEY, JSON.stringify(list));
    } catch {
      /* storage unavailable (private mode, disabled) — saving just won't persist */
    }
  };

  document.querySelectorAll<HTMLButtonElement>('[data-note-action]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const action = btn.getAttribute('data-note-action');
      if (action === 'print') {
        window.print();
        return;
      }

      if (action === 'save') {
        const slug = btn.dataset.saveSlug!;
        const list = savedList();
        const label = btn.querySelector('[data-save-label]');
        if (list.some((item) => item.slug === slug)) {
          writeSaved(list.filter((item) => item.slug !== slug));
          btn.setAttribute('aria-pressed', 'false');
          if (label) label.textContent = 'Save note';
        } else {
          writeSaved([
            ...list,
            {
              slug,
              title: document.querySelector('h1')?.textContent?.trim() ?? slug,
              href: window.location.pathname,
            },
          ]);
          btn.setAttribute('aria-pressed', 'true');
          if (label) label.textContent = 'Saved';
        }
        return;
      }

      const url = window.location.href;
      const title = document.title;
      if (navigator.share) {
        navigator.share({ title, url }).catch(() => {});
      } else if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(() => {
          const label = btn.querySelector('.rail-action-label');
          if (!label) return;
          const original = label.textContent;
          label.textContent = 'Link copied!';
          window.setTimeout(() => {
            label.textContent = original;
          }, 2000);
        });
      }
    });
  });

  // Reflect an existing bookmark when the page loads.
  const saveBtn = document.querySelector<HTMLButtonElement>('[data-note-action="save"]');
  if (saveBtn) {
    const isSaved = savedList().some((item) => item.slug === saveBtn.dataset.saveSlug);
    saveBtn.setAttribute('aria-pressed', String(isSaved));
    const label = saveBtn.querySelector('[data-save-label]');
    if (label) label.textContent = isSaved ? 'Saved' : 'Save note';
  }
</script>
