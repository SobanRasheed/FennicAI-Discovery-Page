---
/**
 * /notes/ — the study note index.
 *
 * The full note list is rendered as real links (so every note is crawlable
 * from here), with the design's filter rail layered on top as client-side
 * filtering: subject, topic, sort, and the hero search field all narrow the
 * list in place. Without JavaScript the hero search still submits to
 * /search/.
 *
 * Server-rendered from D1: published article_type='study-note', newest
 * first. Notes carry no level of their own (levels belong to MCQs), so the
 * design's level filter is dropped here. Rows show the note's featured image
 * when one exists, with the subject icon as the fallback.
 *
 * Subject pages link here as /notes/#subject-{slug}; a matching hash
 * pre-selects that subject in the filter. The rail's per-subject rows carry
 * the anchor targets, so the browser has something real to scroll to.
 */
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Search from '../../components/Search.astro';
import Icon from '../../components/Icon.astro';
import Illustration, { illustrationForSubject } from '../../components/Illustration.astro';
import JsonLd from '../../components/JsonLd.astro';
import { listPublishedArticles, listTopics, listSubjects } from '../../utils/content';

export const prerender = false;

const [{ rows: notes }, topics, subjects] = await Promise.all([
  listPublishedArticles(Astro.locals, { articleType: 'study-note', perPage: 100 }),
  listTopics(Astro.locals),
  listSubjects(Astro.locals),
]);

// Edge caching: browsers get 5 min, Cloudflare revalidates daily.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=86400');

/** D1 timestamps are UTC without a zone suffix. */
const asDate = (s: string | null) => (s ? new Date(s + 'Z') : undefined);

/** The note's last-touched timestamp: what "most recent" sorts by. */
const sortDate = (s: string | null, fallback: string | null) => s ?? fallback ?? '';

// The design abbreviates September as "Sep", but en-GB short gives "Sept".
const fmt = (d: Date) =>
  d
    .toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
    .replace('Sept ', 'Sep ');

const topicById = new Map(topics.map((t) => [t.id, t]));

/** Filter rail: every topic that has notes, A–Z. */
const topicMap = new Map<number, string>();
for (const note of notes) {
  if (note.topic_id && !topicMap.has(note.topic_id)) {
    const title = topicById.get(note.topic_id)?.title;
    if (title) topicMap.set(note.topic_id, title);
  }
}
const topicRows = [...topicMap.entries()].sort((a, b) => a[1].localeCompare(b[1], 'en'));

/** Rail: every subject that has notes, busiest first, with real counts. */
const subjectMap = new Map<string, { title: string; count: number }>();
for (const note of notes) {
  const entry = subjectMap.get(note.subject_slug) ?? { title: note.subject_title ?? note.subject_slug, count: 0 };
  entry.count += 1;
  subjectMap.set(note.subject_slug, entry);
}
const subjectRows = [...subjectMap.entries()]
  .map(([slug, { title, count }]) => ({ slug, title, count }))
  .sort((a, b) => b.count - a.count);

/** Subjects with a PNG icon in /assets/landing/; the rest fall back to a drawing. */
const pngSubjects = new Set([
  'anatomy',
  'biochemistry',
  'community-medicine',
  'forensic-medicine',
  'microbiology',
  'pathology',
  'pharmacology',
  'physiology',
]);

const subjectIcon = (slug: string) =>
  pngSubjects.has(slug) ? `/assets/landing/subject-${slug}.png` : undefined;

const footerSubjects = subjects.map((s) => ({
  href: `/subjects/${s.slug}/`,
  label: s.title,
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'All study notes',
  description:
    'Browse our complete collection of medical study notes — clear explanations, diagrams and exam-focused content for medical students.',
  url: new URL('/notes/', Astro.site).href,
  isPartOf: { '@type': 'WebSite', name: 'Medical Study Notes', url: Astro.site!.href },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: notes.map((note, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: note.title,
      url: new URL(`/notes/${note.slug}/`, Astro.site).href,
    })),
  },
};
---

<Layout
  title="All Study Notes | Medical Study Notes"
  description="Browse our complete collection of medical study notes — clear explanations, diagrams and exam-focused content for medical students, organised by subject and level."
  path="/notes/"
  footerSubjects={footerSubjects}
  wide
>
  <JsonLd data={jsonLd} />

  <PageHeader
    kicker="Study Notes"
    title="All study notes"
    lead="Browse our complete collection of medical study notes. Clear explanations, diagrams and exam-focused content for medical students."
    crumbs={[{ href: '/', label: 'Home' }, { label: 'Study Notes' }]}
    tone="band"
    asideWide
  >
    <div class="notes-search">
      <Search
        variant="hero"
        id="notes-search"
        placeholder="Search study notes (e.g. cranial nerves, gram staining, cardiac cycle...)"
        label="Search study notes"
      />
    </div>

    <Fragment slot="aside">
      <div class="notes-aside">
        <figure class="notes-quote">
          <blockquote>
            <p>The more you learn, the more you realize how much there is to learn.</p>
          </blockquote>
          <span class="quote-rule" aria-hidden="true"></span>
          <figcaption>Sir William Osler</figcaption>
        </figure>

        <img
          class="notes-art"
          src="/assets/images/hero-heart.png"
          alt=""
          width="201"
          height="294"
          loading="lazy"
          decoding="async"
        />
      </div>
    </Fragment>
  </PageHeader>

  <div class="container page-body">
    <div class="notes-layout">
      {/* --- filter rail --------------------------------------------------- */}
      <aside class="notes-filters" aria-label="Filter study notes">
        <h2 class="filters-title">
          <Icon name="filter" size={18} />
          Filter notes
        </h2>
        <div class="filters-body">
          <div class="field">
            <label for="notes-subject">Subject</label>
            <select id="notes-subject">
              <option value="">All Subjects</option>
              {subjectRows.map(({ slug, title }) => (
                <option value={slug}>{title}</option>
              ))}
            </select>
          </div>
          <div class="field">
            <label for="notes-topic">Topic</label>
            <select id="notes-topic">
              <option value="">All Topics</option>
              {topicRows.map(([id, label]) => (
                <option value={id}>{label}</option>
              ))}
            </select>
          </div>
          <div class="field">
            <label for="notes-sort">Sort by</label>
            <select id="notes-sort">
              <option value="recent">Most Recent</option>
              <option value="oldest">Oldest First</option>
              <option value="title">Title A–Z</option>
            </select>
          </div>
          <button class="btn btn-secondary filters-reset" id="notes-reset" type="button">
            <Icon name="refresh" size={14} />
            Reset filters
          </button>
        </div>
      </aside>

      {/* --- toolbar + list ------------------------------------------------ */}
      <div class="notes-main">
        <div class="notes-results" id="notes-results">
          <div class="notes-toolbar">
            <p class="notes-count" id="notes-count" aria-live="polite">
              {notes.length} study note{notes.length === 1 ? '' : 's'}
            </p>
            <div class="view-toggle" role="group" aria-label="Choose a view">
              <button class="view-btn" type="button" data-view="list" aria-pressed="true">
                <Icon name="list" size={16} />
                List view
              </button>
              <button class="view-btn" type="button" data-view="grid" aria-pressed="false">
                <Icon name="grid" size={16} />
                Grid view
              </button>
            </div>
          </div>

          <ol class="note-list" id="note-list">
            {notes.map((note) => {
              const date = asDate(note.updated_at ?? note.published_at);
              return (
                <li
                  class="note-row"
                  data-subject={note.subject_slug}
                  data-topic={note.topic_id ? String(note.topic_id) : ''}
                  data-date={sortDate(note.updated_at, note.published_at)}
                  data-title={note.title.toLowerCase()}
                  data-search={`${note.title} ${note.excerpt} ${note.subject_title ?? ''}`
                    .toLowerCase()}
                >
                  <a href={`/notes/${note.slug}/`}>
                    <span class="row-thumb" aria-hidden="true">
                      {note.media_key ? (
                        <img
                          src={`/media/${note.media_key}/`}
                          alt=""
                          loading="lazy"
                          decoding="async"
                        />
                      ) : subjectIcon(note.subject_slug) ? (
                        <img
                          src={subjectIcon(note.subject_slug)}
                          alt=""
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <Illustration name={illustrationForSubject(note.subject_slug)} size={28} />
                      )}
                    </span>
                    <span class="row-main">
                      <span class="row-kicker">{note.subject_title}</span>
                      <span class="row-title">{note.title}</span>
                      <span class="row-desc">{note.excerpt}</span>
                    </span>
                    {date && (
                      <time class="row-date" datetime={date.toISOString()}>
                        {fmt(date)}
                      </time>
                    )}
                    <span class="row-chev" aria-hidden="true">
                      <Icon name="chevron-right" size={16} />
                    </span>
                  </a>
                </li>
              );
            })}
          </ol>

          <div class="empty-state" id="notes-empty" hidden>
            <h3>No notes match your filters</h3>
            <p>Try a different search term, or reset the filters to see every study note.</p>
            <button class="btn btn-secondary" id="notes-empty-reset" type="button">
              Reset filters
            </button>
          </div>
        </div>
      </div>

      {/* --- rail ------------------------------------------------------------ */}
      <aside class="notes-rail" aria-label="Study notes links">
        <section class="rail-card">
          <h2 class="rail-heading">
            <Icon name="grid" size={18} />
            Popular subjects
          </h2>
          <ul class="rail-subjects">
            {subjectRows.map(({ slug, title, count }) => (
              <li id={`subject-${slug}`}>
                <a href={`/subjects/${slug}/`}>
                  <span class="rail-art" aria-hidden="true">
                    {subjectIcon(slug) ? (
                      <img src={subjectIcon(slug)} alt="" loading="lazy" decoding="async" />
                    ) : (
                      <Illustration name={illustrationForSubject(slug)} size={22} />
                    )}
                  </span>
                  <span class="rail-names">
                    <span class="rail-name">{title}</span>
                    <span class="rail-count">{count} note{count === 1 ? '' : 's'}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <a class="link-arrow rail-all" href="/subjects/">View all subjects</a>
        </section>

        <section class="rail-card">
          <h2 class="rail-heading">
            <Icon name="bulb" size={18} />
            Study tip
          </h2>
          <blockquote class="rail-quote">
            <p>“Active recall and spaced repetition are more effective than passive reading.”</p>
          </blockquote>
          <p class="rail-caps">Study smarter<br />Remember longer</p>
        </section>

        <section class="rail-card">
          <h2 class="rail-heading">
            <Icon name="search" size={20} />
            Need something specific?
          </h2>
          <p class="rail-help">Use search to quickly find notes on any topic.</p>
          <a class="btn btn-primary rail-search-btn" href="/search/">Search study notes</a>
        </section>
      </aside>
    </div>
  </div>
</Layout>

<style>
  /* --- header aside: quote panel beside the hero image ------------------- */
  .notes-search {
    margin-top: var(--space-6);
    max-width: 42.625rem;
  }

  .notes-aside {
    display: grid;
    gap: var(--space-4);
    align-items: start;
  }

  /* The Osler pull-quote on its pearl panel, as in the design. */
  .notes-quote {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: var(--space-6);
    border-radius: var(--radius-md);
    background: var(--quote-surface);
  }

  .notes-quote blockquote {
    margin: 0;
  }

  .notes-quote p {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-style: italic;
    font-weight: var(--weight-medium);
    line-height: 1.55;
    text-wrap: balance;
  }

  .quote-rule {
    width: 26px;
    height: 2px;
    margin: var(--space-5) 0 var(--space-3);
    background: var(--primary);
  }

  .notes-quote figcaption {
    color: var(--mute);
    font-family: var(--font-sans);
    font-size: 0.6563rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* The heart illustration joins the quote from the wide-aside breakpoint. */
  .notes-art {
    display: none;
    width: 100%;
    aspect-ratio: 201 / 294;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  @media (min-width: 1024px) {
    .notes-aside {
      grid-template-columns: minmax(0, 15.1875rem) minmax(0, 1fr);
      gap: var(--space-4);
    }

    .notes-art {
      display: block;
    }
  }

  .page-body {
    padding-block: var(--space-10) var(--space-16);
  }

  /* --- three-column layout: filter rail | list | links rail --------------- */
  .notes-layout {
    display: grid;
    gap: var(--space-8);
  }

  .notes-main,
  .notes-rail {
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .notes-layout {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: var(--space-8);
      align-items: start;
    }

    /* Below the wide breakpoint the links rail drops under everything and
       spreads its cards out in a row. */
    .notes-rail {
      grid-column: 1 / -1;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1280px) {
    .notes-layout {
      grid-template-columns: 15rem minmax(0, 1fr) 17.5rem;
    }

    .notes-rail {
      grid-column: auto;
      grid-template-columns: none;
    }
  }

  /* --- filter rail --------------------------------------------------------- */
  .notes-filters {
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .filters-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: var(--weight-semibold);
  }

  .filters-title svg {
    color: var(--primary);
  }

  .filters-body {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  /* The design's field labels are a touch smaller than the form default. */
  .filters-body .field > label {
    font-size: 0.7813rem;
  }

  .filters-reset {
    width: 100%;
    height: 42px;
    color: var(--primary);
    font-size: 0.8125rem;
    font-weight: var(--weight-semibold);
  }

  /* --- toolbar -------------------------------------------------------------- */
  .notes-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .notes-count {
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 1.375rem;
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
  }

  .view-toggle {
    display: flex;
    gap: var(--space-2);
  }

  .view-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 37px;
    padding-inline: var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 0.7813rem;
    font-weight: var(--weight-semibold);
    cursor: pointer;
    transition: background-color 0.15s var(--ease), border-color 0.15s var(--ease),
      color 0.15s var(--ease);
  }

  .view-btn svg {
    flex-shrink: 0;
  }

  .view-btn[aria-pressed='true'] {
    border-color: var(--primary);
    background: var(--primary);
    color: var(--on-primary);
  }

  /* --- note rows: hairline-separated list, not cards ------------------------- */
  .note-list {
    display: grid;
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .note-row + .note-row {
    border-top: 1px solid var(--border);
  }

  .note-row[hidden] {
    display: none;
  }

  .note-row a {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-3);
    color: inherit;
    text-decoration: none;
  }

  .row-thumb {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 123px;
    aspect-ratio: 123 / 61;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--surface-sunken);
    color: var(--primary);
  }

  .row-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 479px) {
    .row-thumb {
      width: 96px;
    }
  }

  .row-main {
    flex: 1;
    min-width: 0;
    display: grid;
    gap: 3px;
  }

  .row-kicker {
    color: var(--primary);
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: var(--weight-display);
    letter-spacing: 0.0625em;
    text-transform: uppercase;
  }

  .row-title {
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: var(--weight-semibold);
    line-height: 1.35;
    transition: color 0.15s var(--ease);
  }

  .note-row a:hover .row-title {
    color: var(--primary);
  }

  .row-desc {
    color: var(--mute);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    line-height: 1.45;
  }

  .row-date {
    flex-shrink: 0;
    color: var(--faint);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .row-chev {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--faint);
    transition: color 0.15s var(--ease), transform 0.15s var(--ease-out);
  }

  .note-row a:hover .row-chev {
    color: var(--primary);
    transform: translateX(2px);
  }

  /* Grid view: the same rows as tiles. */
  @media (min-width: 640px) {
    .note-list.view-grid {
      grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
      gap: var(--space-4);
    }
  }

  .note-list.view-grid .note-row + .note-row {
    border-top: 0;
  }

  .note-list.view-grid .note-row {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .note-list.view-grid .note-row a {
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-3);
    padding: var(--space-3);
  }

  .note-list.view-grid .row-thumb {
    width: 100%;
    aspect-ratio: 167 / 94;
  }

  .note-list.view-grid .row-chev {
    display: none;
  }

  #notes-empty {
    margin-top: var(--space-5);
  }

  #notes-empty .btn {
    margin-top: var(--space-4);
  }

  /* --- links rail ----------------------------------------------------------- */
  .notes-rail {
    display: grid;
    gap: var(--space-4);
  }

  .rail-card {
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .rail-heading {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: var(--weight-semibold);
  }

  .rail-heading svg {
    flex-shrink: 0;
    color: var(--primary);
  }

  .rail-subjects {
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .rail-subjects a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    color: inherit;
    text-decoration: none;
  }

  .rail-art {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 37px;
    height: 37px;
    overflow: hidden;
    border-radius: 50%;
    background: var(--surface-sunken);
    color: var(--primary);
  }

  .rail-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rail-names {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .rail-name {
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: var(--weight-semibold);
    transition: color 0.15s var(--ease);
  }

  .rail-subjects a:hover .rail-name {
    color: var(--primary);
  }

  .rail-count {
    color: var(--mute);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
  }

  .rail-all {
    margin-top: var(--space-3);
    font-size: 0.7813rem;
  }

  .rail-quote {
    margin: var(--space-3) 0 0;
  }

  .rail-quote p {
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.45;
    text-wrap: balance;
  }

  .rail-caps {
    margin: var(--space-3) 0 0;
    color: var(--mute);
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: var(--weight-display);
    letter-spacing: 0.0625em;
    line-height: 1.7;
    text-transform: uppercase;
  }

  .rail-help {
    margin: var(--space-3) 0 0;
    color: var(--mute);
    font-family: var(--font-sans);
    font-size: 0.75rem;
  }

  .rail-search-btn {
    width: 100%;
    height: 37px;
    margin-top: var(--space-4);
    font-size: 0.8125rem;
  }
</style>

<script>
  // Client-side filtering over the server-rendered list. Everything still
  // works without this script: the full list is server-rendered and the hero
  // search submits to /search/ as a plain GET form.
  const heroForm = document.querySelector<HTMLFormElement>('.notes-search form');
  const queryInput = heroForm?.querySelector<HTMLInputElement>('input[name="q"]') ?? null;
  const subjectSel = document.getElementById('notes-subject') as HTMLSelectElement;
  const topicSel = document.getElementById('notes-topic') as HTMLSelectElement;
  const sortSel = document.getElementById('notes-sort') as HTMLSelectElement;
  const countEl = document.getElementById('notes-count');
  const emptyEl = document.getElementById('notes-empty');
  const list = document.getElementById('note-list');

  if (list && subjectSel && topicSel && sortSel && countEl && emptyEl) {
    const rows = Array.from(list.querySelectorAll<HTMLElement>('.note-row'));

    const comparators: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
      recent: (a, b) => b.dataset.date!.localeCompare(a.dataset.date!),
      oldest: (a, b) => a.dataset.date!.localeCompare(b.dataset.date!),
      title: (a, b) => a.dataset.title!.localeCompare(b.dataset.title!, 'en'),
    };

    function apply() {
      const q = (queryInput?.value ?? '').trim().toLowerCase();
      const subject = subjectSel.value;
      const topic = topicSel.value;

      let visible = 0;
      rows.forEach((row) => {
        const matches =
          (!q || row.dataset.search!.includes(q)) &&
          (!subject || row.dataset.subject === subject) &&
          (!topic || row.dataset.topic === topic);
        row.hidden = !matches;
        if (matches) visible++;
      });

      const compare = comparators[sortSel.value] ?? comparators.recent;
      [...rows].sort(compare).forEach((row) => list.appendChild(row));

      countEl.textContent = `${visible} study note${visible === 1 ? '' : 's'}`;
      emptyEl.hidden = visible > 0;
    }

    function reset() {
      if (queryInput) queryInput.value = '';
      subjectSel.value = '';
      topicSel.value = '';
      sortSel.value = 'recent';
      apply();
    }

    subjectSel.addEventListener('change', apply);
    topicSel.addEventListener('change', apply);
    sortSel.addEventListener('change', apply);
    queryInput?.addEventListener('input', apply);
    document.getElementById('notes-reset')?.addEventListener('click', reset);
    document.getElementById('notes-empty-reset')?.addEventListener('click', reset);

    // The hero search filters this page's list in place; without JS it falls
    // through to /search/?q=... as a real form submission.
    heroForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      apply();
      document.getElementById('notes-results')?.scrollIntoView({ behavior: 'smooth' });
    });

    // Subject pages link here as /notes/#subject-{slug}: pre-select that
    // subject and bring the list into view.
    function fromHash() {
      const match = location.hash.match(/^#subject-([a-z0-9-]+)$/);
      if (!match) return;
      if (!subjectSel.querySelector(`option[value="${match[1]}"]`)) return;
      subjectSel.value = match[1];
      apply();
      document.getElementById('notes-results')?.scrollIntoView();
    }

    window.addEventListener('hashchange', fromHash);
    fromHash();

    // List / Grid view toggle.
    document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((other) => {
          other.setAttribute('aria-pressed', String(other === btn));
        });
        list.classList.toggle('view-grid', btn.dataset.view === 'grid');
      });
    });
  }
</script>
